generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String?
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  WorkspaceMember[]
}

model Workspace {
  id                    String                 @id @default(cuid())
  name                  String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  members               WorkspaceMember[]
  businesses            Business[]
  keywords              Keyword[]
  providerConnections   ProviderConnection[]
  keywordOutcomeActions KeywordOutcomeAction[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  role        String    @default("OWNER")
  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Business {
  id            String         @id @default(cuid())
  name          String
  industry      String?
  location      String?
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  websites      Website[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  businessFacts BusinessFact[]

  @@index([workspaceId])
}

model Website {
  id                       String                    @id @default(cuid())
  url                      String
  ga4PropertyId            String?
  businessId               String
  business                 Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  analyses                 Analysis[]
  audienceSegments         AudienceSegment[]
  cmsConnection            CMSConnection?
  cloudflareConnection     CloudflareConnection?
  contentBriefs            ContentBrief[]
  competitors              Competitor[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  contentEvidenceSnapshots ContentEvidenceSnapshot[]
  keywordOutcomeActions    KeywordOutcomeAction[]

  @@index([businessId])
}

model Analysis {
  id                String        @id @default(cuid())
  status            String        @default("QUEUED")
  errorMessage      String?
  websiteId         String
  website           Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  pages             Page[]
  issues            SEOIssue[]
  opportunities     Opportunity[]
  overallScore      Int?
  technicalScore    Int?
  contentScore      Int?
  structureScore    Int?
  indexabilityScore Int?
  pagesCount        Int?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([websiteId])
}

model Page {
  id               String   @id @default(cuid())
  url              String
  statusCode       Int?
  title            String?
  metaDescription  String?
  h1               String?
  h2s              String[]
  canonical        String?
  robots           String?
  wordCount        Int?
  internalLinks    Int?
  externalLinks    Int?
  imagesCount      Int?
  imagesWithoutAlt Int?
  hasJsonLd        Boolean  @default(false)
  responseTime     Int?
  depth            Int?
  incomingLinks    Int?
  analysisId       String
  analysis         Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([analysisId])
}

model SEOIssue {
  id             String       @id @default(cuid())
  type           String
  severity       String
  pageUrl        String?
  description    String
  evidence       String?
  recommendation String
  analysisId     String
  analysis       Analysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  appliedFixes   AppliedFix[]

  @@index([analysisId])
  @@index([severity])
}

model Opportunity {
  id             String         @id @default(cuid())
  title          String
  type           String
  priority       String
  score          Int
  reason         String
  recommendation String
  affectedPages  Int            @default(0)
  appliedFixes   AppliedFix[]
  contentBriefs  ContentBrief[]
  analysisId     String
  analysis       Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@index([analysisId])
  @@index([score])
}

enum ProviderType {
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_ANALYTICS_4
}

enum ProviderStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum KeywordIntent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
}

model ProviderConnection {
  id              String         @id @default(cuid())
  workspaceId     String
  provider        ProviderType
  status          ProviderStatus @default(DISCONNECTED)
  accessTokenRef  String?
  refreshTokenRef String?
  expiresAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

model Keyword {
  id             String                 @id @default(cuid())
  workspaceId    String
  text           String
  normalized     String
  intent         KeywordIntent?
  cluster        String?
  volume         Int?
  difficulty     Int?
  cpc            Decimal?               @db.Decimal(10, 4)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshots      KeywordSnapshot[]
  marketMetrics  KeywordMarketMetric[]
  outcomeActions KeywordOutcomeAction[]

  @@unique([workspaceId, normalized])
  @@index([workspaceId])
}

model KeywordMarketMetric {
  id               String   @id @default(cuid())
  keywordId        String
  market           String
  language         String
  volume           Int?
  difficulty       Int?
  cpc              Decimal? @db.Decimal(10, 4)
  competitionIndex Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, market, language])
  @@index([keywordId])
  @@index([market])
}

model KeywordSuggestionCache {
  id         String   @id @default(cuid())
  normalized String
  source     String
  payload    Json
  fetchedAt  DateTime @default(now())

  @@unique([normalized, source])
}

model ApiUsageCounter {
  id          String   @id @default(cuid())
  workspaceId String
  counterType String
  date        DateTime @db.Date
  count       Int      @default(0)

  @@unique([workspaceId, counterType, date])
  @@index([workspaceId])
}

model KeywordSnapshot {
  id          String   @id @default(cuid())
  keywordId   String
  date        DateTime @db.Date
  position    Decimal? @db.Decimal(6, 2)
  clicks      Int?
  impressions Int?
  ctr         Decimal? @db.Decimal(8, 4)
  device      String   @default("DESKTOP")
  country     String   @default("us")
  source      String   @default("GOOGLE_SEARCH_CONSOLE")
  pageUrl     String?
  retrievedAt DateTime @default(now())
  keyword     Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, date, device, country, source, pageUrl])
  @@index([keywordId])
  @@index([date])
}

model AudienceSegment {
  id        String   @id @default(cuid())
  websiteId String
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  name      String
  criteria  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots AudienceSnapshot[]

  @@unique([websiteId, name])
  @@index([websiteId])
}

model AudienceSnapshot {
  id          String          @id @default(cuid())
  segmentId   String
  segment     AudienceSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  date        DateTime        @db.Date
  userCount   Int
  source      String          @default("GOOGLE_ANALYTICS_4")
  retrievedAt DateTime        @default(now())

  @@unique([segmentId, date, source])
  @@index([segmentId])
  @@index([date])
}

enum CMSType {
  CUSTOM_API
  WORDPRESS
}

enum CMSConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model CMSConnection {
  id              String              @id @default(cuid())
  websiteId       String              @unique
  website         Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  cmsType         CMSType
  status          CMSConnectionStatus @default(DISCONNECTED)
  siteUrl         String
  usernameRef     String?
  credentialRef   String
  lastConnectedAt DateTime?
  lastError       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  appliedFixes    AppliedFix[]

  @@index([status])
}

enum AppliedFixStatus {
  PENDING
  SUCCESS
  FAILED
  ROLLED_BACK
}

enum FixType {
  META_TITLE
  META_DESCRIPTION
  H1
  ALT_TEXT
  CANONICAL
  INTERNAL_LINK
  CONTENT
}

enum FixRiskLevel {
  SAFE
  REVIEW
  DANGEROUS
}

model AppliedFix {
  id              String           @id @default(cuid())
  opportunityId   String?
  opportunity     Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  issueId         String?
  issue           SEOIssue?        @relation(fields: [issueId], references: [id], onDelete: SetNull)
  cmsConnectionId String
  cmsConnection   CMSConnection    @relation(fields: [cmsConnectionId], references: [id], onDelete: Cascade)
  pageUrl         String
  fixType         FixType
  riskLevel       FixRiskLevel
  previousValue   String?
  newValue        String
  status          AppliedFixStatus @default(PENDING)
  errorMessage    String?
  appliedAt       DateTime?
  verifiedAt      DateTime?
  rolledBackAt    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([cmsConnectionId])
  @@index([opportunityId])
  @@index([issueId])
  @@index([status])
  @@index([appliedAt])
}

enum BusinessFactType {
  CAPABILITY
  METRIC
  DATA_SOURCE
  POLICY
  DIFFERENTIATOR
  COMPLIANCE
  OTHER
}

enum BusinessFactStatus {
  PROPOSED
  VERIFIED
  REJECTED
  ARCHIVED
}

enum BusinessFactEvidenceStatus {
  UNCHECKED
  FRESH
  DRIFTED
  UNAVAILABLE
}

model BusinessFact {
  id                    String                     @id @default(cuid())
  businessId            String
  business              Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type                  BusinessFactType
  claim                 String
  status                BusinessFactStatus         @default(PROPOSED)
  sourceUrl             String?
  sourceLabel           String?
  evidence              String?
  confidence            Float?
  evidenceStatus        BusinessFactEvidenceStatus @default(UNCHECKED)
  evidenceHash          String?
  sourceContentHash     String?
  lastEvidenceCheckedAt DateTime?
  lastEvidenceSeenAt    DateTime?
  evidenceCheckError    String?
  version               Int                        @default(1)
  supersedesId          String?
  supersedes            BusinessFact?              @relation("BusinessFactVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  revisions             BusinessFact[]             @relation("BusinessFactVersion")
  createdByUserId       String?
  verifiedByUserId      String?
  verifiedAt            DateTime?
  events                BusinessFactEvent[]
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@index([businessId, status])
  @@index([businessId, status, evidenceStatus])
  @@index([businessId, type])
  @@index([supersedesId])
}

model BusinessFactEvent {
  id             String              @id @default(cuid())
  businessFactId String
  businessFact   BusinessFact        @relation(fields: [businessFactId], references: [id], onDelete: Cascade)
  action         String
  actorUserId    String?
  previousStatus BusinessFactStatus?
  nextStatus     BusinessFactStatus?
  metadata       Json?
  createdAt      DateTime            @default(now())

  @@index([businessFactId, createdAt])
}

model ContentEvidenceSnapshot {
  id             String       @id @default(cuid())
  briefId        String       @unique
  brief          ContentBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  websiteId      String
  website        Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  topic          String
  primaryKeyword String
  searchIntent   String
  plan           Json
  businessFacts  Json
  keywordContext Json?
  plannerVersion String
  gateVersion    String
  generatorModel String
  createdAt      DateTime     @default(now())

  @@index([websiteId, createdAt])
}

enum ContentBriefStatus {
  DRAFT
  READY
}

model ContentBrief {
  id            String       @id @default(cuid())
  websiteId     String
  website       Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  outcomeActionId   String?                  @unique
  outcomeAction     KeywordOutcomeAction?    @relation(fields: [outcomeActionId], references: [id], onDelete: SetNull)
  topic             String
  searchIntent      String
  primaryKeyword    String
  secondaryKeywords String[]
  outline           Json
  status            ContentBriefStatus       @default(DRAFT)
  generatedBy       String
  articles          ContentArticle[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  evidenceSnapshot  ContentEvidenceSnapshot?

  @@index([websiteId])
  @@index([opportunityId])
}

enum ContentArticleStatus {
  GENERATING
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  PUBLISH_FAILED
  REJECTED
}

model ContentArticle {
  id              String               @id @default(cuid())
  briefId         String
  brief           ContentBrief         @relation(fields: [briefId], references: [id], onDelete: Cascade)
  title           String
  metaDescription String
  h1              String
  bodyMarkdown    String
  status          ContentArticleStatus @default(GENERATING)
  generatedBy     String
  publishedUrl    String?
  publishedAt     DateTime?
  publishError    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([briefId])
  @@index([status])
}

model Competitor {
  id        String               @id @default(cuid())
  websiteId String
  website   Website              @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  domain    String
  name      String?
  addedAt   DateTime             @default(now())
  snapshots CompetitorSnapshot[]

  @@unique([websiteId, domain])
  @@index([websiteId])
}

model CompetitorSnapshot {
  id                  String     @id @default(cuid())
  competitorId        String
  competitor          Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  capturedAt          DateTime   @default(now())
  title               String?
  metaDescription     String?
  h1                  String?
  wordCount           Int?
  imagesCount         Int?
  imagesWithoutAlt    Int?
  hasJsonLd           Boolean?
  rankedKeywordsCount Int?
  topKeywords         Json?
  gapKeywords         Json?
  fromCache           Boolean    @default(false)

  @@index([competitorId])
}

model CloudflareConnection {
  id                String   @id @default(cuid())
  websiteId         String   @unique
  website           Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  zoneId            String
  apiTokenEncrypted String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  snapshots TrafficSnapshot[]
}

model TrafficSnapshot {
  id           String               @id @default(cuid())
  connectionId String
  connection   CloudflareConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  date         DateTime             @db.Date

  totalRequests         Int
  unclassifiedRequests  Int
  verifiedBotRequests   Int
  unverifiedBotRequests Int?
  threatsBlocked        Int?
  bandwidthBytes        BigInt
  uniqueVisitors        Int
  countryBreakdown      Json?
  deviceBreakdown       Json?
  botCategoryBreakdown  Json?

  createdAt DateTime @default(now())

  @@unique([connectionId, date])
  @@index([connectionId, date])
}

enum KeywordOutcomeDecision {
  CREATE
  UPDATE
  SKIP
}

enum KeywordOutcomeActionStatus {
  PLANNED
  EXECUTED
  CANCELLED
}

enum KeywordOutcomeCheckpoint {
  BASELINE
  DAY_7
  DAY_14
  DAY_28
}

enum KeywordOutcomeLiveRankState {
  FOUND
  NOT_TOP_100
  UNAVAILABLE
}

enum KeywordOutcomeObservationSource {
  ACTION_BASELINE
  LIVE_SERP
  GOOGLE_SEARCH_CONSOLE
  COMBINED
  MANUAL
}

model KeywordOutcomeAction {
  id                      String                            @id @default(cuid())
  workspaceId             String
  websiteId               String
  keywordId               String?
  keywordText             String
  normalizedKeyword       String
  market                  String
  language                String                            @default("en")
  device                  String                            @default("desktop")
  decision                KeywordOutcomeDecision
  compatibilityStatus     KeywordOutcomeCompatibilityStatus
  compatibilityReason     String
  compatibilitySnapshot   Json
  compatibilityCheckedAt  DateTime                          @default(now())
  status                  KeywordOutcomeActionStatus        @default(PLANNED)
  targetPageUrl           String?
  rationale               String
  evidence                Json
  planSnapshot            Json
  source                  String                            @default("GROWTH_OS_ACTION_PLAN_V1")
  baselineLiveRank        Int?
  baselineLiveRankState   KeywordOutcomeLiveRankState
  baselineImpressions     Int?
  baselineClicks          Int?
  baselineCtr             Decimal?                          @db.Decimal(8, 4)
  baselineAveragePosition Decimal?                          @db.Decimal(6, 2)
  baselineGscSnapshotDate DateTime?                         @db.Date
  appliedFixId            String?
  contentArticleId        String?
  supersedesActionId      String?                           @unique
  executedAt              DateTime?
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt

  workspace        Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  website          Website                     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  keyword          Keyword?                    @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  observations     KeywordOutcomeObservation[]
  contentBrief     ContentBrief?
  supersedesAction KeywordOutcomeAction?       @relation("KeywordOutcomeActionRevision", fields: [supersedesActionId], references: [id], onDelete: SetNull)
  supersededBy     KeywordOutcomeAction?       @relation("KeywordOutcomeActionRevision")

  @@index([workspaceId])
  @@index([websiteId])
  @@index([keywordId])
  @@index([websiteId, normalizedKeyword, market])
  @@index([status])
  @@index([createdAt])
  @@index([appliedFixId])
  @@index([contentArticleId])
}

model KeywordOutcomeObservation {
  id              String                          @id @default(cuid())
  actionId        String
  checkpoint      KeywordOutcomeCheckpoint
  source          KeywordOutcomeObservationSource
  liveRank        Int?
  liveRankState   KeywordOutcomeLiveRankState
  impressions     Int?
  clicks          Int?
  ctr             Decimal?                        @db.Decimal(8, 4)
  averagePosition Decimal?                        @db.Decimal(6, 2)
  gscSnapshotDate DateTime?                       @db.Date
  pageUrl         String?
  observedAt      DateTime                        @default(now())
  createdAt       DateTime                        @default(now())

  action KeywordOutcomeAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, checkpoint])
  @@index([actionId])
  @@index([checkpoint])
  @@index([observedAt])
}

enum KeywordOutcomeCompatibilityStatus {
  SUPPORTED
  EDUCATIONAL_ONLY
  UNVERIFIED
  CONFLICT
}
