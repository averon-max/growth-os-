import {
  describe,
  expect,
  it,
} from "vitest";

import {
  inspectMasterRuntimeSnapshot,
  buildProductionMasterResearchPack,
} from "./master-runtime-adapter";


function runtime() {
  return {
    version:
      "MASTER_RUNTIME_SNAPSHOT_V1",

    mission: {
      version:
        "SEARCH_MISSION_V1",

      id:
        "mission-1",

      websiteId:
        "site-1",

      topic:
        "what is credit monitoring",

      audience:
        "US consumers",

      readerGoal:
        "Understand credit monitoring.",

      businessRelationship:
        "DIRECT",

      jurisdiction:
        "US",

      language:
        "en",

      location:
        "United States",

      riskClass:
        "YMYL_FINANCE",

      createdAt:
        new Date(
          "2026-09-21T00:00:00.000Z"
        ),
    },

    queryGraph: {
      version:
        "QUERY_GRAPH_V1",

      missionId:
        "mission-1",

      nodes:
        [],

      edges:
        [],

      boundaries:
        [],

      provenance:
        [],
    },

    serpResearch:
      null,

    expectedCoverage: {
      version:
        "EXPECTED_COVERAGE_V1",

      missionId:
        "mission-1",

      queryGraphVersion:
        "QUERY_GRAPH_V1",

      items:
        [],

      requiredTopics:
        [],

      supportingTopics:
        [],

      opportunityTopics:
        [],

      excludedTopics:
        [],

      evidence:
        [],
    },

    gaps: {
      version:
        "GAP_ENGINE_V1",

      missionId:
        "mission-1",

      gaps:
        [],

      byType: {
        MISSION_GAP:
          0,

        EXPECTED_GAP:
          0,

        DEPTH_GAP:
          0,

        CLARITY_GAP:
          0,

        EVIDENCE_GAP:
          0,

        ACTION_GAP:
          0,

        ORIGINAL_VALUE_GAP:
          0,
      },

      criticalCount:
        0,

      majorCount:
        0,

      evidence:
        [],
    },

    originalValue: {
      version:
        "ORIGINAL_VALUE_PLAN_V1",

      missionId:
        "mission-1",

      strength:
        "DEFENSIBLE",

      gate:
        "PASS",

      assets: [
        {
          id:
            "asset-1",

          type:
            "COMPARISON_MATRIX",

          title:
            "Detection matrix",

          description:
            "Original synthesis.",

          firstParty:
            false,

          verified:
            true,
        },
      ],

      commodity: {
        risk:
          "LOW",

        evidence:
          [],
      },

      issues:
        [],

      evidence:
        [],
    },

    evidenceGraph: {
      version:
        "EVIDENCE_GRAPH_V1",

      sources:
        [],

      claimEvidence:
        [],
    },

    claimLedger: {
      version:
        "CLAIM_LEDGER_V1",

      claims:
        [],

      counts: {
        VERIFIED:
          0,

        PARTIAL:
          0,

        UNSUPPORTED:
          0,

        CONTRADICTED:
          0,

        STALE:
          0,

        JURISDICTION_MISMATCH:
          0,
      },

      verified:
        0,

      unsupported:
        0,

      blockingCandidateCount:
        0,
    },

    searchBlueprint: {
      version:
        "MASTER_SEARCH_BLUEPRINT_V1",

      revision:
        1,

      missionId:
        "mission-1",

      action:
        "CREATE",

      primaryQuery:
        "what is credit monitoring",

      queryNodeIds:
        [],

      intent:
        "INFORMATIONAL",

      pageType:
        "ARTICLE",

      requiredTopics:
        [],

      supportingTopics:
        [],

      excludedTopics:
        [],

      requiredEntities:
        [],

      questions:
        [],

      evidenceIds:
        [],

      requiredClaims:
        [],

      forbiddenClaims:
        [],

      competitorStrengths:
        [],

      competitorWeaknesses:
        [],

      gaps:
        [],

      originalAssets: [
        "asset-1",
      ],

      internalLinkTargets:
        [],

      technicalRequirements:
        [],

      fingerprint:
        "blueprint-1",
    },

    sectionBlueprints: {
      version:
        "SECTION_BLUEPRINT_SET_V1",

      blueprintFingerprint:
        "blueprint-1",

      h1Mission:
        "what is credit monitoring",

      sections: [
        {
          heading:
            "What Credit Monitoring Does",

          mission:
            "Explain monitoring.",

          queryNodeIds:
            [],

          requiredClaims:
            [],

          forbiddenClaims:
            [],

          evidenceIds:
            [],

          internalLinks:
            [],

          expectedOutcome:
            "Reader understands monitoring.",
        },
      ],

      rules: [
        "ONE_INFORMATION_JOB_EQUALS_ONE_LOGICAL_SECTION",
      ],
    },

    internalLinkPlan:
      [],

    styleRules: [
      "Direct answers before elaboration.",
    ],
  };
}


describe(
  "Master Runtime Adapter V1",
  () => {
    it(
      "blocks a legacy plan instead of inventing Stage 1-8 artifacts",
      () => {
        const result =
          inspectMasterRuntimeSnapshot({
            strategy: {},
            architecture: {},
            searchBlueprintShadow: {},
            informationGain: {},
            externalEvidenceSources:
              [],
          });

        expect(
          result.readiness
        ).toBe(
          "BLOCKED"
        );

        expect(
          result.blockers
        ).toEqual([
          "MASTER_RUNTIME_SNAPSHOT_MISSING",
        ]);

        expect(
          result.runtime
        ).toBeNull();
      }
    );


    it(
      "accepts an explicitly persisted complete master runtime",
      () => {
        const result =
          inspectMasterRuntimeSnapshot({
            masterRuntime:
              runtime(),
          });

        expect(
          result.readiness
        ).toBe(
          "READY"
        );

        expect(
          result.blockers
        ).toEqual([]);

        expect(
          result.runtime
            ?.version
        ).toBe(
          "MASTER_RUNTIME_SNAPSHOT_V1"
        );
      }
    );


    it(
      "builds the immutable writer pack only from a complete master runtime",
      () => {
        const pack =
          buildProductionMasterResearchPack({
            planSnapshot: {
              masterRuntime:
                runtime(),
            },
          });

        expect(
          pack.version
        ).toBe(
          "IMMUTABLE_RESEARCH_PACK_V1"
        );

        expect(
          pack.searchBlueprint
            .version
        ).toBe(
          "MASTER_SEARCH_BLUEPRINT_V1"
        );

        expect(
          pack.sectionBlueprints
            .version
        ).toBe(
          "SECTION_BLUEPRINT_SET_V1"
        );
      }
    );


    it(
      "blocks NO_GO rather than sending it to the writer",
      () => {
        const value =
          runtime();

        value.searchBlueprint.action =
          "NO_GO";

        value.sectionBlueprints.sections =
          [];

        const result =
          inspectMasterRuntimeSnapshot({
            masterRuntime:
              value,
          });

        expect(
          result.readiness
        ).toBe(
          "BLOCKED"
        );

        expect(
          result.blockers
        ).toContain(
          "MASTER_RUNTIME_NO_GO"
        );
      }
    );


    it(
      "blocks a failed claim publication gate before the writer",
      () => {
        const value =
          runtime();

        value.claimLedger.claims = [
          {
            id:
              "claim-1",

            text:
              "Unsupported financial claim.",

            category:
              "FINANCIAL",

            risk:
              "HIGH",

            evidenceIds:
              [],

            status:
              "UNSUPPORTED",
          },
        ];

        value.claimLedger.counts
          .UNSUPPORTED =
          1;

        value.claimLedger.unsupported =
          1;

        value.claimLedger
          .blockingCandidateCount =
          1;

        const result =
          inspectMasterRuntimeSnapshot({
            masterRuntime:
              value,
          });

        expect(
          result.readiness
        ).toBe(
          "BLOCKED"
        );

        expect(
          result.blockers
        ).toContain(
          "MASTER_RUNTIME_CLAIM_GATE_BLOCKED"
        );
      }
    );


    it(
      "blocks blueprint revision mismatch",
      () => {
        const value =
          runtime();

        value.sectionBlueprints
          .blueprintFingerprint =
          "wrong-revision";

        const result =
          inspectMasterRuntimeSnapshot({
            masterRuntime:
              value,
          });

        expect(
          result.readiness
        ).toBe(
          "BLOCKED"
        );

        expect(
          result.blockers
        ).toContain(
          "MASTER_RUNTIME_BLUEPRINT_REVISION_MISMATCH"
        );
      }
    );


    it(
      "blocks rejected original value before writing",
      () => {
        const value =
          runtime();

        value.originalValue.gate =
          "REJECTED";

        value.originalValue.strength =
          "NONE";

        const result =
          inspectMasterRuntimeSnapshot({
            masterRuntime:
              value,
          });

        expect(
          result.readiness
        ).toBe(
          "BLOCKED"
        );

        expect(
          result.blockers
        ).toContain(
          "MASTER_RUNTIME_ORIGINAL_VALUE_BLOCKED"
        );
      }
    );


    it(
      "never looks at legacy searchBlueprintShadow as a master blueprint",
      () => {
        expect(
          () =>
            buildProductionMasterResearchPack({
              planSnapshot: {
                searchBlueprintShadow: {
                  mode:
                    "SHADOW",

                  version:
                    "SEARCH_BLUEPRINT_V1",
                },
              },
            })
        ).toThrow(
          "MASTER_RUNTIME_BLOCKED:MASTER_RUNTIME_SNAPSHOT_MISSING"
        );
      }
    );
  }
);
