+
+  const data = (await res.json()) as DataForSEORankedResponse;
+
+  if (data.status_code !== 20000) {
+    throw new DataForSEOError(`DataForSEO API error: ${data.status_message}`);
+  }
+
+  const task = data.tasks[0];
+  if (!task || task.status_code !== 20000) {
