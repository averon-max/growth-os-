+            target: targetDomain,
+            location_name: locationName,
+            language_name: languageName,
+            item_types: ["organic"],
+            filters: [["keyword_data.keyword_info.search_volume", ">", 0]],
+            order_by: ["keyword_data.keyword_info.search_volume,desc"],
+            limit,
+          },
+        ]),
+      });
