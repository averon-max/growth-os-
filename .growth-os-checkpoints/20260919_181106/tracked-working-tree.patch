+      const retryAfterHeader = res.headers.get("Retry-After");
+      const retryAfterMs = retryAfterHeader ? Number(retryAfterHeader) * 1000 : BASE_BACKOFF_MS * 2 ** attempt;
+      await sleep(retryAfterMs);
+    } finally {
+      clearTimeout(timeout);
+    }
+  }
