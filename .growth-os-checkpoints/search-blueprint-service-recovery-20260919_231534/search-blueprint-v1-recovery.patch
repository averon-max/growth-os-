+async function analyzeStoredContentPlan({
+  briefId,
+  title,
+  metaDescription,
+  h1,
+  bodyMarkdown,
+  primaryKeyword,
+  secondaryKeywords,
+}: {
+  briefId: string;
+  title: string;
+  metaDescription?: string | null;
+  h1: string;
+  bodyMarkdown: string;
+  primaryKeyword: string;
+  secondaryKeywords?: string[];
+}) {
+  const evidence =
+    await prisma.contentEvidenceSnapshot.findUnique({
+      where: {
+        briefId,
+      },
+
+      select: {
+        plan:
+          true,
+      },
+    });
+
+  return analyzeArticleAgainstPlan({
+    title,
+    metaDescription,
+    h1,
+    bodyMarkdown,
+    primaryKeyword,
+    secondaryKeywords,
+
+    plan:
+      evidence?.plan ??
+      null,
+  });
+}
