import {
  describe,
  expect,
  it,
} from "vitest";

import {
  analyzeQueryOwnership,
  primaryOwnershipCandidates,
  selectProductionPrimaryCandidate,
} from "./query-ownership";

function candidate(
  keyword: string,
  score: number
) {
  return {
    keyword,
    score,

    searchVolume:
      null,

    impressions:
      0,

    clicks:
      0,
  };
}

describe(
  "query ownership guard v1",
  () => {
    it(
      "detects an unrequested entity modifier",
      () => {
        expect(
          analyzeQueryOwnership({
            topic:
              "what is credit monitoring",

            keyword:
              "experian credit monitoring",
          }).status
        ).toBe(
          "UNREQUESTED_ENTITY_MODIFIER"
        );
      }
    );

    it(
      "does not hardcode a brand name",
      () => {
        expect(
          analyzeQueryOwnership({
            topic:
              "what is credit monitoring",

            keyword:
              "examplecorp credit monitoring",
          }).status
        ).toBe(
          "UNREQUESTED_ENTITY_MODIFIER"
        );
      }
    );

    it(
      "allows a branded topic when the entity is part of the requested topic",
      () => {
        expect(
          analyzeQueryOwnership({
            topic:
              "experian credit monitoring",

            keyword:
              "experian credit monitoring",
          }).status
        ).toBe(
          "EXACT_TOPIC"
        );
      }
    );

    it(
      "keeps generic modifiers distinct from entity modifiers",
      () => {
        expect(
          analyzeQueryOwnership({
            topic:
              "what is credit monitoring",

            keyword:
              "free credit monitoring",
          }).status
        ).toBe(
          "GENERIC_MODIFIER"
        );
      }
    );

    it(
      "prevents a foreign entity query from hijacking an explicit informational topic",
      () => {
        const result =
          selectProductionPrimaryCandidate({
            topic:
              "what is credit monitoring",

            candidates: [
              candidate(
                "experian credit monitoring",
                15.6
              ),

              candidate(
                "what is credit monitoring",
                13.5
              ),

              candidate(
                "free credit monitoring",
                6.7
              ),
            ],
          });

        expect(
          result?.keyword
        ).toBe(
          "what is credit monitoring"
        );
      }
    );

    it(
      "removes entity-modified queries from the primary decision pool but retains generic facets",
      () => {
        const result =
          primaryOwnershipCandidates({
            topic:
              "what is credit monitoring",

            candidates: [
              candidate(
                "experian credit monitoring",
                15.6
              ),

              candidate(
                "what is credit monitoring on credit karma",
                11.4
              ),

              candidate(
                "what is credit monitoring",
                13.5
              ),

              candidate(
                "free credit monitoring",
                6.7
              ),

              candidate(
                "3 bureau credit monitoring",
                5.3
              ),
            ],
          });

        expect(
          result.map(
            (item) =>
              item.keyword
          )
        ).toEqual([
          "what is credit monitoring",
          "free credit monitoring",
          "3 bureau credit monitoring",
        ]);
      }
    );

    it(
      "does not override raw ranking when the exact topic has no meaningful evidence",
      () => {
        const result =
          selectProductionPrimaryCandidate({
            topic:
              "what is credit monitoring",

            candidates: [
              candidate(
                "experian credit monitoring",
                80
              ),

              candidate(
                "what is credit monitoring",
                0
              ),
            ],
          });

        expect(
          result?.keyword
        ).toBe(
          "experian credit monitoring"
        );
      }
    );
  }
);
