import type {
  GapAnalysis,
} from "./gap-engine";


export type OriginalValueAssetType =
  | "FIRST_PARTY_DATASET"
  | "ORIGINAL_CALCULATION"
  | "ORIGINAL_RESEARCH"
  | "INTERACTIVE_TOOL"
  | "CALCULATOR"
  | "DECISION_TREE"
  | "COMPARISON_MATRIX"
  | "ORIGINAL_DIAGRAM"
  | "EXPERIMENT"
  | "EXPERT_INTERPRETATION"
  | "PRIMARY_SOURCE_SYNTHESIS"
  | "REAL_SCREENSHOTS"
  | "REAL_TEST"
  | "FIRST_PARTY_TELEMETRY"
  | "ORIGINAL_PROCESS"
  | "CASE_STUDY";


export type OriginalValueStrength =
  | "NONE"
  | "WEAK"
  | "DEFENSIBLE"
  | "STRONG";


export type OriginalValueGate =
  | "REJECTED"
  | "REVIEW"
  | "PASS";


export type CommodityRisk =
  | "UNKNOWN"
  | "LOW"
  | "MEDIUM"
  | "HIGH";


export interface OriginalValueAsset {
  id:
    string;

  type:
    OriginalValueAssetType;

  title:
    string;

  description:
    string;

  firstParty:
    boolean;

  verified:
    boolean;

  evidenceIds?:
    string[];
}


export interface CommoditySignals {
  semanticOverlapWithTopResults?:
    number | null;

  genericParagraphRatio?:
    number | null;

  uniqueClaims?:
    number | null;

  uniqueExamples?:
    number | null;

  firstPartyAssets?:
    number | null;

  originalTables?:
    number | null;

  newSynthesis?:
    number | null;

  newWorkflow?:
    number | null;
}


export interface CommodityAssessment {
  risk:
    CommodityRisk;

  evidence:
    readonly string[];
}


export interface OriginalValuePlan {
  version:
    "ORIGINAL_VALUE_PLAN_V1";

  missionId:
    string;

  strength:
    OriginalValueStrength;

  gate:
    OriginalValueGate;

  assets:
    readonly Readonly<OriginalValueAsset>[];

  commodity:
    Readonly<CommodityAssessment>;

  issues:
    readonly string[];

  evidence:
    readonly string[];
}


function clamp01(
  value: number
): number {
  return Math.max(
    0,
    Math.min(
      1,
      value
    )
  );
}


function countKnownUniqueSignals(
  signals:
    CommoditySignals
): number {
  return [
    signals.uniqueClaims,
    signals.uniqueExamples,
    signals.firstPartyAssets,
    signals.originalTables,
    signals.newSynthesis,
    signals.newWorkflow,
  ].reduce(
    (
      total,
      value
    ) =>
      total +
      (
        typeof value ===
          "number" &&
        Number.isFinite(
          value
        )
          ? Math.max(
              0,
              value
            )
          : 0
      ),
    0
  );
}


export function assessCommodityRisk(
  signals:
    CommoditySignals
): Readonly<CommodityAssessment> {
  const semantic =
    signals.semanticOverlapWithTopResults;

  const generic =
    signals.genericParagraphRatio;

  const uniqueSignals =
    countKnownUniqueSignals(
      signals
    );

  const hasAnyEvidence =
    Object.values(
      signals
    ).some(
      (value) =>
        typeof value ===
          "number" &&
        Number.isFinite(
          value
        )
    );

  if (
    !hasAnyEvidence
  ) {
    return Object.freeze({
      risk:
        "UNKNOWN" as const,

      evidence:
        Object.freeze([
          "COMMODITY_SIGNALS_MISSING",
        ]),
    });
  }

  const evidence:
    string[] =
      [];

  if (
    typeof semantic ===
      "number" &&
    Number.isFinite(
      semantic
    )
  ) {
    evidence.push(
      `SEMANTIC_OVERLAP:${clamp01(semantic).toFixed(4)}`
    );
  }

  if (
    typeof generic ===
      "number" &&
    Number.isFinite(
      generic
    )
  ) {
    evidence.push(
      `GENERIC_PARAGRAPH_RATIO:${clamp01(generic).toFixed(4)}`
    );
  }

  evidence.push(
    `UNIQUE_SIGNAL_COUNT:${uniqueSignals}`
  );

  if (
    typeof semantic ===
      "number" &&
    semantic >=
      0.8 &&
    typeof generic ===
      "number" &&
    generic >=
      0.7 &&
    uniqueSignals ===
      0
  ) {
    return Object.freeze({
      risk:
        "HIGH" as const,

      evidence:
        Object.freeze([
          ...evidence,
          "COULD_BE_SUMMARY_OF_EXISTING_RESULTS",
        ]),
    });
  }

  if (
    (
      typeof semantic ===
        "number" &&
      semantic >=
        0.65
    ) ||
    (
      typeof generic ===
        "number" &&
      generic >=
        0.55
    )
  ) {
    return Object.freeze({
      risk:
        uniqueSignals >
        0
          ? "MEDIUM" as const
          : "HIGH" as const,

      evidence:
        Object.freeze(
          evidence
        ),
    });
  }

  return Object.freeze({
    risk:
      uniqueSignals >
      0
        ? "LOW" as const
        : "MEDIUM" as const,

    evidence:
      Object.freeze(
        evidence
      ),
  });
}


function validateAsset(
  asset:
    OriginalValueAsset
): void {
  if (
    !asset.id.trim()
  ) {
    throw new Error(
      "ORIGINAL_VALUE_ASSET_ID_REQUIRED"
    );
  }

  if (
    !asset.title.trim()
  ) {
    throw new Error(
      "ORIGINAL_VALUE_ASSET_TITLE_REQUIRED"
    );
  }

  if (
    !asset.description.trim()
  ) {
    throw new Error(
      "ORIGINAL_VALUE_ASSET_DESCRIPTION_REQUIRED"
    );
  }
}


export function buildOriginalValuePlan({
  missionId,
  gaps,
  assets,
  commoditySignals = {},
}: {
  missionId:
    string;

  gaps:
    Readonly<GapAnalysis>;

  assets:
    OriginalValueAsset[];

  commoditySignals?:
    CommoditySignals;
}): Readonly<OriginalValuePlan> {
  if (
    gaps.missionId !==
    missionId
  ) {
    throw new Error(
      "ORIGINAL_VALUE_MISSION_GAP_MISMATCH"
    );
  }

  for (
    const asset
    of assets
  ) {
    validateAsset(
      asset
    );
  }

  const commodity =
    assessCommodityRisk(
      commoditySignals
    );

  const frozenAssets =
    assets.map(
      (asset) =>
        Object.freeze({
          ...asset,

          evidenceIds:
            asset.evidenceIds
              ? Object.freeze([
                  ...asset.evidenceIds,
                ])
              : undefined,
        })
    );

  const verified =
    frozenAssets.filter(
      (asset) =>
        asset.verified
    );

  const verifiedFirstParty =
    verified.filter(
      (asset) =>
        asset.firstParty
    );

  const originalGapCount =
    gaps.byType
      .ORIGINAL_VALUE_GAP;

  const issues:
    string[] =
      [];

  let strength:
    OriginalValueStrength;

  let gate:
    OriginalValueGate;

  if (
    frozenAssets.length ===
    0
  ) {
    strength =
      "NONE";

    gate =
      "REJECTED";

    issues.push(
      "CRITICAL:NO_DEFENSIBLE_ORIGINAL_VALUE"
    );
  } else if (
    verified.length ===
    0
  ) {
    strength =
      "WEAK";

    gate =
      "REVIEW";

    issues.push(
      "ORIGINAL_VALUE_ASSETS_UNVERIFIED"
    );
  } else if (
    commodity.risk ===
    "HIGH"
  ) {
    strength =
      "WEAK";

    gate =
      "REVIEW";

    issues.push(
      "HIGH_COMMODITY_RISK"
    );
  } else if (
    verifiedFirstParty.length >=
      1 &&
    verified.length >=
      2 &&
    commodity.risk !==
      "HIGH"
  ) {
    strength =
      "STRONG";

    gate =
      "PASS";
  } else {
    strength =
      "DEFENSIBLE";

    gate =
      "PASS";
  }

  if (
    originalGapCount >
      0 &&
    verified.length ===
      0
  ) {
    issues.push(
      "ORIGINAL_VALUE_GAP_NOT_EXPLOITED"
    );
  }

  const evidence = [
    `PLANNED_ASSETS:${frozenAssets.length}`,
    `VERIFIED_ASSETS:${verified.length}`,
    `VERIFIED_FIRST_PARTY_ASSETS:${verifiedFirstParty.length}`,
    `ORIGINAL_VALUE_GAPS:${originalGapCount}`,
    `COMMODITY_RISK:${commodity.risk}`,
  ];

  return Object.freeze({
    version:
      "ORIGINAL_VALUE_PLAN_V1" as const,

    missionId,

    strength,

    gate,

    assets:
      Object.freeze(
        frozenAssets
      ),

    commodity,

    issues:
      Object.freeze(
        issues
      ),

    evidence:
      Object.freeze(
        evidence
      ),
  });
}
