import {
  analyzeArticle,
  countExactPhrase,
  type ArticleAnalyzerResult,
} from "./article-analyzer";

type UnknownRecord =
  Record<string, unknown>;

export interface ContentPlanCoverageItem {
  text: string;
  covered: boolean;
}

export interface ContentPlanCoverage {
  total: number;
  covered: number;
  missing: number;
  coveragePct: number | null;
  items: ContentPlanCoverageItem[];
}

export interface ContentPlanAnalysis {
  article:
    ArticleAnalyzerResult;

  planAvailable:
    boolean;

  confidence:
    | "HIGH"
    | "MEDIUM"
    | "LOW"
    | null;

  topics:
    ContentPlanCoverage;

  questions:
    ContentPlanCoverage;

  contentGaps:
    string[];

  benchmarkObservation: {
    eligiblePages:
      number | null;

    observedMedianWordCount:
      number | null;

    observedMedianH2:
      number | null;

    observedMedianH3:
      number | null;
  };

  warnings:
    string[];
}

export interface AnalyzeArticleAgainstPlanInput {
  title: string;
  metaDescription?: string | null;
  h1: string;
  bodyMarkdown: string;

  primaryKeyword: string;
  secondaryKeywords?: string[];

  /**
   * The immutable ContentEvidenceSnapshot.plan.
   *
   * Deliberately unknown here so old snapshots
   * cannot crash the analyzer if the plan schema
   * evolves.
   */
  plan?: unknown;
}

function record(
  value: unknown
): UnknownRecord | null {
  if (
    !value ||
    typeof value !==
      "object" ||
    Array.isArray(value)
  ) {
    return null;
  }

  return value as
    UnknownRecord;
}

function stringArray(
  value: unknown
): string[] {
  if (!Array.isArray(value)) {
    return [];
  }

  return value
    .filter(
      (
        item
      ): item is string =>
        typeof item ===
          "string"
    )
    .map(
      (item) =>
        item.trim()
    )
    .filter(Boolean);
}

function finiteNumber(
  value: unknown
): number | null {
  return typeof value ===
      "number" &&
    Number.isFinite(value)
    ? value
    : null;
}

function confidence(
  value: unknown
):
  | "HIGH"
  | "MEDIUM"
  | "LOW"
  | null {
  return value === "HIGH" ||
    value === "MEDIUM" ||
    value === "LOW"
    ? value
    : null;
}


const COVERAGE_STOP_WORDS =
  new Set([
    "a",
    "an",
    "and",
    "are",
    "can",
    "could",
    "do",
    "does",
    "for",
    "from",
    "guide",
    "how",
    "in",
    "introduction",
    "is",
    "me",
    "my",
    "of",
    "on",
    "our",
    "overview",
    "should",
    "the",
    "to",
    "understanding",
    "what",
    "when",
    "where",
    "who",
    "why",
    "with",
    "would",
    "you",
    "your",
    "basics",
  ]);

function coverageTokens(
  value:
    string
): string[] {
  return value
    .toLowerCase()
    .normalize(
      "NFD"
    )
    .replace(
      /[\u0300-\u036f]/g,
      ""
    )
    .replace(
      /[^a-z0-9\s]/g,
      " "
    )
    .split(
      /\s+/
    )
    .map(
      (token) =>
        token.trim()
    )
    .filter(
      (token) =>
        token.length >=
          3 &&
        !COVERAGE_STOP_WORDS.has(
          token
        )
    );
}

function hasCoverageEvidence(
  corpus:
    string,
  target:
    string
): boolean {
  if (
    countExactPhrase(
      corpus,
      target
    ) >
    0
  ) {
    return true;
  }

  const targetTokens =
    Array.from(
      new Set(
        coverageTokens(
          target
        )
      )
    );

  if (
    targetTokens.length ===
    0
  ) {
    return true;
  }

  const corpusTokens =
    new Set(
      coverageTokens(
        corpus
      )
    );

  const matched =
    targetTokens.filter(
      (token) =>
        corpusTokens.has(
          token
        )
    ).length;

  const required =
    targetTokens.length <=
      2
      ? targetTokens.length
      : Math.ceil(
          targetTokens.length *
            0.8
        );

  return matched >=
    required;
}

function coverage(
  corpus: string,
  values: string[]
): ContentPlanCoverage {
  const seen =
    new Set<string>();

  const items:
    ContentPlanCoverageItem[] =
      [];

  for (
    const raw
    of values
  ) {
    const text =
      raw.trim();

    const key =
      text
        .toLocaleLowerCase(
          "en-US"
        )
        .replace(
          /\s+/g,
          " "
        );

    if (
      !text ||
      seen.has(key)
    ) {
      continue;
    }

    seen.add(key);

    items.push({
      text,

      /*
       * This is deliberately lexical evidence.
       * It is NOT branded as semantic coverage.
       */
      covered:
          hasCoverageEvidence(
            corpus,
            text
          ),
    });
  }

  const covered =
    items.filter(
      (item) =>
        item.covered
    ).length;

  return {
    total:
      items.length,

    covered,

    missing:
      items.length -
      covered,

    coveragePct:
      items.length > 0
        ? Math.round(
            (covered /
              items.length) *
              100
          )
        : null,

    items,
  };
}

export function analyzeArticleAgainstPlan(
  input:
    AnalyzeArticleAgainstPlanInput
): ContentPlanAnalysis {
  const root =
    record(
      input.plan
    );

  const architecture =
    record(
      root?.architecture
    );

  const benchmark =
    record(
      root?.benchmark
    );

  const requiredTopics =
    stringArray(
      architecture
        ?.requiredTopics
    );

  const questions =
    stringArray(
      architecture
        ?.questionsToAnswer
    );

  const contentGaps =
    stringArray(
      architecture
        ?.contentGaps
    );

  const article =
    analyzeArticle({
      title:
        input.title,

      metaDescription:
        input.metaDescription,

      h1:
        input.h1,

      bodyMarkdown:
        input.bodyMarkdown,

      primaryKeyword:
        input.primaryKeyword,

      secondaryKeywords:
        input.secondaryKeywords,

      /*
       * Important:
       *
       * FinalContentPlan explicitly says
       * competitor H2/H3/word counts are
       * descriptive observations, not targets.
       *
       * Therefore we MUST NOT convert benchmark
       * medians into analyzer target ranges.
       */
      targets:
        null,
    });

  const corpus = [
    input.title,
    input.h1,
    input.bodyMarkdown,
  ].join(
    "\n"
  );

  const topics =
    coverage(
      corpus,
      requiredTopics
    );

  const questionCoverage =
    coverage(
      corpus,
      questions
    );

  const warnings:
    string[] = [];

  for (
    const item
    of topics.items
  ) {
    if (
      !item.covered
    ) {
      warnings.push(
        `REQUIRED_TOPIC_NOT_LEXICALLY_COVERED: ${item.text}`
      );
    }
  }

  for (
    const item
    of questionCoverage.items
  ) {
    if (
      !item.covered
    ) {
      warnings.push(
        `PLANNED_QUESTION_NOT_LEXICALLY_COVERED: ${item.text}`
      );
    }
  }

  for (
    const issue
    of article.issues
  ) {
    if (
      issue.severity !==
      "INFO"
    ) {
      warnings.push(
        `ARTICLE_${issue.severity}: ${issue.code}`
      );
    }
  }

  return {
    article,

    planAvailable:
      Boolean(root),

    confidence:
      confidence(
        root?.confidence
      ),

    topics,

    questions:
      questionCoverage,

    contentGaps,

    benchmarkObservation: {
      eligiblePages:
        finiteNumber(
          benchmark
            ?.eligiblePages
        ),

      observedMedianWordCount:
        finiteNumber(
          benchmark
            ?.observedMedianWordCount
        ),

      observedMedianH2:
        finiteNumber(
          benchmark
            ?.observedMedianH2
        ),

      observedMedianH3:
        finiteNumber(
          benchmark
            ?.observedMedianH3
        ),
    },

    warnings:
      Array.from(
        new Set(
          warnings
        )
      ),
  };
}
