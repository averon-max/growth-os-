"use client";

import {
  useEffect,
  useState,
} from "react";
import {
  ExternalLink,
  Eye,
  Hash,
  MousePointerClick,
  Search,
  TrendingUp,
} from "lucide-react";
import type { AudienceDays } from "./audience-intelligence";
import styles from "./audience-search-queries.module.css";

interface QueryRow {
  query: string;
  clicks: number;
  impressions: number;
  ctr: number;
  avgPosition:
    | number
    | null;
  topPage:
    | string
    | null;
}

interface ResponseData {
  connected: boolean;
  source:
    "GOOGLE_SEARCH_CONSOLE";
  days: number;
  range:
    | {
        start: string;
        end: string;
      }
    | null;
  summary:
    | {
        clicks: number;
        impressions: number;
        ctr: number;
        avgPosition:
          | number
          | null;
        uniqueQueries: number;
      }
    | null;
  queries: QueryRow[];
}

function formatNumber(
  value: number
) {
  return new Intl.NumberFormat(
    "en-US",
    {
      notation:
        value >= 10000
          ? "compact"
          : "standard",
      maximumFractionDigits: 1,
    }
  ).format(value);
}

function pageLabel(
  page: string
) {
  try {
    const url =
      new URL(page);

    return url.pathname === "/"
      ? url.hostname
      : url.pathname;
  } catch {
    return page;
  }
}

export function AudienceSearchQueries({
  websiteId,
  days,
  refreshKey = 0,
}: {
  websiteId: string;
  days: AudienceDays;
  refreshKey?: number;
}) {
  const [data, setData] =
    useState<ResponseData | null>(
      null
    );

  const [loading, setLoading] =
    useState(true);

  const [error, setError] =
    useState<string | null>(
      null
    );

  useEffect(() => {
    const controller =
      new AbortController();

    async function load() {
      setLoading(true);
      setError(null);

      try {
        const params =
          new URLSearchParams({
            websiteId,
            days: String(days),
          });

        const response =
          await fetch(
            `/api/audience/search-queries?${params.toString()}`,
            {
              cache:
                "no-store",
              signal:
                controller.signal,
            }
          );

        const json =
          (await response.json()) as
            | ResponseData
            | {
                error?: string;
              };

        if (!response.ok) {
          throw new Error(
            "error" in json &&
              json.error
              ? json.error
              : "Could not load Search Console data."
          );
        }

        setData(
          json as ResponseData
        );
      } catch (err) {
        if (
          err instanceof DOMException &&
          err.name ===
            "AbortError"
        ) {
          return;
        }

        setError(
          err instanceof Error
            ? err.message
            : "Could not load Search Console data."
        );
      } finally {
        if (
          !controller.signal
            .aborted
        ) {
          setLoading(false);
        }
      }
    }

    void load();

    return () =>
      controller.abort();
  }, [websiteId, days, refreshKey]);

  return (
    <section
      className={styles.surface}
    >
      <header
        className={styles.header}
      >
        <div>
          <div
            className={
              styles.titleLine
            }
          >
            <Search size={13} />

            <h2>
              Organic search
              discovery
            </h2>

            <span
              className={
                styles.sourceBadge
              }
            >
              Google Search
              Console
            </span>
          </div>

          <p>
            Queries where this
            website actually
            appeared in Google.
          </p>
        </div>

        {data?.range && (
          <div
            className={
              styles.range
            }
          >
            {data.range.start}
            <span>→</span>
            {data.range.end}
          </div>
        )}
      </header>

      {loading && !data ? (
        <State>
          Loading Search Console
          queries…
        </State>
      ) : error ? (
        <State error>
          {error}
        </State>
      ) : data &&
        !data.connected ? (
        <State>
          Google Search Console
          is not connected.
        </State>
      ) : data &&
        data.summary &&
        data.queries.length ===
          0 ? (
        <State>
          No real Google query
          data was reported for
          the selected period.
        </State>
      ) : data &&
        data.summary ? (
        <>
          <div
            className={
              styles.metrics
            }
          >
            <Metric
              icon={
                MousePointerClick
              }
              label="Clicks"
              value={formatNumber(
                data.summary
                  .clicks
              )}
              tone="green"
            />

            <Metric
              icon={Eye}
              label="Impressions"
              value={formatNumber(
                data.summary
                  .impressions
              )}
              tone="cyan"
            />

            <Metric
              icon={TrendingUp}
              label="CTR"
              value={`${data.summary.ctr.toFixed(
                1
              )}%`}
              tone="violet"
            />

            <Metric
              icon={Hash}
              label="Avg. position"
              value={
                data.summary
                  .avgPosition ===
                null
                  ? "—"
                  : data.summary.avgPosition.toFixed(
                      1
                    )
              }
              tone="amber"
            />
          </div>

          <div
            className={
              styles.tableTitle
            }
          >
            <div>
              <strong>
                Search queries
              </strong>

              <span>
                {
                  data.summary
                    .uniqueQueries
                }{" "}
                unique
              </span>
            </div>

            <span>
              Ranked by real
              clicks and
              impressions
            </span>
          </div>

          <div
            className={
              styles.tableViewport
            }
          >
            <table
              className={
                styles.table
              }
            >
              <thead>
                <tr>
                  <th>
                    Query
                  </th>
                  <th>
                    Clicks
                  </th>
                  <th>
                    Impressions
                  </th>
                  <th>
                    CTR
                  </th>
                  <th>
                    Position
                  </th>
                  <th>
                    Landing page
                  </th>
                </tr>
              </thead>

              <tbody>
                {data.queries.map(
                  (
                    query,
                    index
                  ) => (
                    <tr
                      key={
                        query.query
                      }
                    >
                      <td>
                        <div
                          className={
                            styles.queryCell
                          }
                        >
                          <span
                            className={
                              styles.rank
                            }
                          >
                            {String(
                              index +
                                1
                            ).padStart(
                              2,
                              "0"
                            )}
                          </span>

                          <span
                            className={
                              styles.query
                            }
                            title={
                              query.query
                            }
                          >
                            {
                              query.query
                            }
                          </span>
                        </div>
                      </td>

                      <td
                        className={
                          styles.strong
                        }
                      >
                        {formatNumber(
                          query.clicks
                        )}
                      </td>

                      <td>
                        {formatNumber(
                          query.impressions
                        )}
                      </td>

                      <td>
                        {query.ctr.toFixed(
                          1
                        )}
                        %
                      </td>

                      <td>
                        {query.avgPosition ===
                        null
                          ? "—"
                          : query.avgPosition.toFixed(
                              1
                            )}
                      </td>

                      <td>
                        {query.topPage ? (
                          <a
                            href={
                              query.topPage
                            }
                            target="_blank"
                            rel="noreferrer"
                            className={
                              styles.page
                            }
                            title={
                              query.topPage
                            }
                          >
                            <span>
                              {pageLabel(
                                query.topPage
                              )}
                            </span>

                            <ExternalLink
                              size={
                                10
                              }
                            />
                          </a>
                        ) : (
                          "—"
                        )}
                      </td>
                    </tr>
                  )
                )}
              </tbody>
            </table>
          </div>
        </>
      ) : null}
    </section>
  );
}

function Metric({
  icon: Icon,
  label,
  value,
  tone,
}: {
  icon: React.ComponentType<{
    size?: number;
  }>;
  label: string;
  value: string;
  tone:
    | "green"
    | "cyan"
    | "violet"
    | "amber";
}) {
  return (
    <div
      className={styles.metric}
      data-tone={tone}
    >
      <div
        className={
          styles.metricLabel
        }
      >
        <Icon size={12} />
        {label}
      </div>

      <div
        className={
          styles.metricValue
        }
      >
        {value}
      </div>
    </div>
  );
}

function State({
  children,
  error = false,
}: {
  children: React.ReactNode;
  error?: boolean;
}) {
  return (
    <div
      className={
        error
          ? `${styles.state} ${styles.error}`
          : styles.state
      }
    >
      {children}
    </div>
  );
}
