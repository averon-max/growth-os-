/* Stronger Linear-style hierarchy */

.commandBar,
.metrics,
.chartPanel,
.signalPanel,
.mapPanel,
.countryPanel,
.smallPanel {
  background: #0d0f11 !important;

  box-shadow:
    inset 0 1px 0
    rgba(255,255,255,.012);
}

.panelHeading {
  background:
    #101214 !important;
}

.metric {
  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.012),
      transparent
    ) !important;
}

.metric[data-tone="accent"] {
  box-shadow:
    inset 2px 0 0
    rgba(136,118,215,.75);
}

.metric[data-tone="warning"] {
  box-shadow:
    inset 2px 0 0
    rgba(197,156,88,.68);
}

.signal[data-tone="success"] {
