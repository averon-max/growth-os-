.shell {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 14px;
}

.commandBar {
  min-height: 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: linear-gradient(
    180deg,
    rgba(18, 20, 22, 0.96),
    rgba(13, 15, 17, 0.96)
  );
}

.modeSwitch {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  padding: 3px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: #0b0d0f;
}

.modeSwitch button {
  height: 27px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 0 10px;
  border: 0;
  border-radius: 4px;
  background: transparent;
  color: var(--secondary);
  font-size: 11px;
  cursor: pointer;
}

.modeSwitch button[data-active="true"] {
  background: #1a1c1f;
  color: var(--primary);
  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.045);
}

.liveDot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #65b985;
  box-shadow:
    0 0 0 4px rgba(101,185,133,.07);
  animation: pulse 1.8s ease-in-out infinite;
}

.freshness {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--secondary);
  font-size: 10px;
}

.freshness button {
  width: 28px;
  height: 28px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: 5px;
  background: #101214;
  color: var(--secondary);
  cursor: pointer;
}

.error {
  padding: 10px 12px;
  border: 1px solid rgba(206, 96, 103, .22);
  border-radius: 6px;
  background: rgba(206, 96, 103, .055);
  color: #cc777d;
  font-size: 11px;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
  background: #0d0f11;
}

.metric {
  min-height: 112px;
  padding: 17px 18px;
  border-right: 1px solid var(--border);
  background:
    radial-gradient(
      circle at 92% 0%,
      rgba(111, 96, 198, .045),
      transparent 42%
    );
}

.metric:last-child {
  border-right: 0;
}

.metric[data-tone="accent"] {
  background:
    radial-gradient(
      circle at 92% 0%,
      rgba(126, 103, 223, .09),
      transparent 45%
    );
}

.metric[data-tone="warning"] {
  background:
    radial-gradient(
      circle at 92% 0%,
      rgba(196, 151, 72, .07),
      transparent 45%
    );
}

.metricLabel {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--secondary);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .055em;
  text-transform: uppercase;
}

.metric > strong {
  display: block;
  margin-top: 13px;
  color: var(--primary);
  font-size: 25px;
  font-weight: 560;
  letter-spacing: -.045em;
}

.metric > span {
  display: block;
  margin-top: 6px;
  color: var(--secondary);
  font-size: 9px;
}

.primaryGrid {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(280px, .7fr);
  gap: 12px;
}

.chartPanel,
.signalPanel,
.mapPanel,
.countryPanel,
.smallPanel {
  min-width: 0;
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
  background: #0d0f11;
}

.panelHeading {
  min-height: 43px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 0 13px;
  border-bottom: 1px solid var(--border);
  background: #101214;
}

.panelHeading > div {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--secondary);
}

.panelHeading strong {
  color: var(--primary);
  font-size: 11px;
  font-weight: 540;
}

.panelHeading > span {
  color: var(--secondary);
  font-size: 9px;
}

.chart {
  height: 300px;
  padding: 9px 10px 4px;
}

.signalList {
  min-height: 300px;
}

.signal {
  min-height: 75px;
  display: grid;
  grid-template-columns: 8px 1fr;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--border);
}

.signal:last-child {
  border-bottom: 0;
}

.signal > i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #737983;
}

.signal[data-tone="success"] > i {
  background: #63aa7b;
}

.signal[data-tone="warning"] > i {
  background: #c39a55;
}

.signal[data-tone="danger"] > i {
  background: #ca6f74;
}

.signal[data-tone="accent"] > i {
  background: #8c79dd;
}

.signal > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.signal strong {
  color: var(--primary);
  font-size: 10px;
  font-weight: 540;
}

.signal span {
  color: var(--secondary);
  font-size: 9px;
  line-height: 1.55;
}

.geoGrid {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(320px, .75fr);
  gap: 12px;
}

.worldMap {
  position: relative;
  min-height: 370px;
  padding: 10px 14px 36px;
  overflow: hidden;
  background:
    radial-gradient(
      ellipse at 50% 45%,
      rgba(88, 76, 159, .055),
      transparent 55%
    ),
    linear-gradient(
      rgba(255,255,255,.014) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.014) 1px,
      transparent 1px
    );
  background-size:
    auto,
    34px 34px,
    34px 34px;
}

.worldMap svg {
  width: 100%;
  height: 315px;
}

.worldShapes {
  fill: #171a1e;
  stroke: rgba(255,255,255,.065);
  stroke-width: 1.2;
}

.mapDot {
  fill: #8975da;
  stroke: rgba(255,255,255,.55);
  stroke-width: 1;
}

.mapHalo {
  fill: rgba(137,117,218,.10);
}

.mapLegend {
  position: absolute;
  left: 15px;
  right: 15px;
  bottom: 11px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--secondary);
  font-size: 8px;
}

.mapLegend span:first-child {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.mapLegend i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #8975da;
}

.countryTable {
  display: flex;
  flex-direction: column;
}

.countryRow {
  min-height: 47px;
  display: grid;
  grid-template-columns: 25px 27px 1fr auto;
  align-items: center;
  gap: 7px;
  padding: 0 12px;
  border-bottom: 1px solid var(--border);
}

.countryRow:last-child {
  border-bottom: 0;
}

.rank {
  color: #4f545d;
  font-size: 8px;
  font-variant-numeric: tabular-nums;
}

.flag {
  font-size: 16px;
}

.countryName {
  min-width: 0;
}

.countryName strong {
  display: block;
  overflow: hidden;
  color: var(--primary);
  font-size: 9px;
  font-weight: 520;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.barTrack {
  width: 100%;
  height: 2px;
  display: block;
  margin-top: 6px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(255,255,255,.045);
}

.barTrack i {
  height: 100%;
  display: block;
  border-radius: inherit;
  background: #7666bd;
}

.countryValue {
  text-align: right;
}

.countryValue strong {
  display: block;
  color: var(--primary);
  font-size: 9px;
  font-weight: 530;
  font-variant-numeric: tabular-nums;
}

.countryValue span {
  display: block;
  margin-top: 3px;
  color: var(--secondary);
  font-size: 8px;
}

.detailGrid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.rankList {
  min-height: 272px;
}

.rankRow {
  min-height: 39px;
  display: grid;
  grid-template-columns: 26px 1fr auto;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  border-bottom: 1px solid var(--border);
}

.rankRow:last-child {
  border-bottom: 0;
}

.rowIcon {
  display: flex;
  align-items: center;
  color: var(--secondary);
  font-size: 8px;
}

.rankRow > div {
  min-width: 0;
}

.rankRow strong {
  display: block;
  overflow: hidden;
  color: var(--primary);
  font-size: 9px;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rankRow > b {
  color: var(--secondary);
  font-size: 8px;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.miniBar {
  width: 100%;
  height: 2px;
  display: block;
  margin-top: 5px;
  background: rgba(255,255,255,.04);
}

.miniBar i {
  height: 100%;
  display: block;
  background: #5b6070;
}

.coverage {
  padding: 24px 18px;
}

.coverage > strong {
  color: var(--primary);
  font-size: 30px;
  font-weight: 550;
  letter-spacing: -.05em;
}

.coverage > strong span {
  color: var(--secondary);
  font-size: 16px;
}

.coverage p {
  margin: 12px 0 0;
  color: var(--secondary);
  font-size: 9px;
  line-height: 1.6;
}

.coverageTrack {
  height: 4px;
  margin-top: 18px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(255,255,255,.05);
}

.coverageTrack i {
  height: 100%;
  display: block;
  background: #8876d7;
}

.coverage > span {
  display: block;
  margin-top: 11px;
  color: #5f6570;
  font-size: 8px;
  line-height: 1.5;
}

.dailyPanel {
  grid-column: span 2;
}

.dailyRows > div {
  min-height: 39px;
  display: grid;
  grid-template-columns: 1fr 1fr auto;
  align-items: center;
  gap: 14px;
  padding: 0 12px;
  border-bottom: 1px solid var(--border);
  font-size: 9px;
}

.dailyRows span {
  color: var(--secondary);
}

.dailyRows strong {
  color: var(--primary);
  font-weight: 500;
}

.dailyRows em {
  min-width: 55px;
  padding: 3px 5px;
  border: 1px solid var(--border);
  border-radius: 4px;
  color: var(--secondary);
  font-size: 8px;
  font-style: normal;
  text-align: center;
}

.dailyRows em[data-full="true"] {
  border-color: rgba(99,170,123,.17);
  background: rgba(99,170,123,.055);
  color: #73b58a;
}

.empty {
  min-height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  color: var(--secondary);
  font-size: 9px;
  text-align: center;
}

.spin {
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes pulse {
  0%,
  100% {
    opacity: .55;
    transform: scale(.88);
  }

  50% {
    opacity: 1;
    transform: scale(1);
  }
}

@media (max-width: 1150px) {
  .primaryGrid,
  .geoGrid {
    grid-template-columns: 1fr;
  }

  .detailGrid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 760px) {
  .metrics {
    grid-template-columns: repeat(2, 1fr);
  }

  .metric:nth-child(2) {
    border-right: 0;
  }

  .metric:nth-child(-n+2) {
    border-bottom: 1px solid var(--border);
  }

  .commandBar {
    align-items: flex-start;
    flex-direction: column;
  }

  .detailGrid {
    grid-template-columns: 1fr;
  }

  .dailyPanel {
    grid-column: auto;
  }

  .worldMap {
    min-height: 285px;
  }

  .worldMap svg {
    height: 235px;
  }
}

