.topbar {
  position: sticky;
  z-index: 35;
  top: 0;

  height: 54px;
  min-height: 54px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 0 25px;

  border-bottom: 1px solid rgba(255,255,255,.052);

  background: rgba(12,13,14,.78);

  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.topbar::after {
  content: "";

  position: absolute;
  pointer-events: none;

  left: 25%;
  right: 20%;
  bottom: -1px;

  height: 1px;

  opacity: .55;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(94,106,210,.18),
      rgba(21,147,161,.065),
      transparent
    );
}

.titleBlock {
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 9px;
}

.title {
  margin: 0;

  color: #e1e1e3;

  font-size: 13px;
  line-height: 1;
  font-weight: 570;

  letter-spacing: -.014em;
}

.subtitle {
  position: relative;

  max-width: 480px;

  margin: 0;
  padding-left: 11px;

  overflow: hidden;

  color: #65676e;

  font-size: 10px;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.subtitle::before {
  content: "";

  position: absolute;

  left: 0;
  top: 50%;

  width: 3px;
  height: 3px;

  border-radius: 50%;

  background: #66616f;

  transform: translateY(-50%);
}

.right {
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 9px;
}

.userEmail {
  max-width: 180px;

  overflow: hidden;

  color: #5a5d64;

  font-size: 10px;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.avatar {
  width: 24px;
  height: 24px;

  border: 1px solid rgba(255,255,255,.09);
  border-radius: 50%;

  background:
    radial-gradient(
      circle at 35% 28%,
      rgba(123,118,232,.28),
      transparent 28%
    ),
    #18191d;
}
