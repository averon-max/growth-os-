.pageBody {
  position: relative;
  z-index: 1;

  width: 100%;
  max-width: 1380px;

  margin: 0 auto;
  padding: 28px 30px 80px;
}

.pageHeader {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 24px;

  margin-bottom: 21px;
}

.pageTitle {
  margin: 0;

  color: #e5e5e7;

  font-size: 20px;
  line-height: 1.2;
  font-weight: 580;

  letter-spacing: -.035em;
}

.pageSubtitle {
  margin: 5px 0 0;

  color: #707279;

  font-size: 11px;
  line-height: 1.5;
}

.sectionTitle {
  margin: 25px 0 8px;

  color: #8a8c93;

  font-size: 11px;
  font-weight: 560;
}

.statGrid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));

  gap: 0;

  margin-bottom: 22px;

  border-top: 1px solid rgba(255,255,255,.055);
  border-bottom: 1px solid rgba(255,255,255,.055);
}

.statCard {
  min-height: 83px;

  padding: 16px 18px 15px;

  border: 0 !important;

  background: transparent;
}

.statCard + .statCard {
  border-left: 1px solid rgba(255,255,255,.045) !important;
}

.statHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 8px;

  margin-bottom: 10px;
}

.statLabel {
  margin: 0;

  color: #686a71;

  font-size: 9px;
  font-weight: 620;

  letter-spacing: .055em;
  text-transform: uppercase;
}

.statAccent {
  width: 5px;
  height: 5px;

  flex: 0 0 auto;

  border-radius: 50%;

  opacity: .85;
}

.statValue {
  margin: 0;

  color: #e3e3e5 !important;

  font-size: 22px;
  line-height: 1;
  font-weight: 570;

  letter-spacing: -.04em;
}

.group {
  position: relative;

  margin-top: 16px;

  overflow: hidden;

  border: 1px solid rgba(255,255,255,.055);
  border-radius: 8px;

  background: #121315;
}

.groupHeader {
  min-height: 40px;

  display: flex;
  align-items: center;

  gap: 8px;

  padding: 0 13px;

  border-bottom: 1px solid rgba(255,255,255,.045);

  background: rgba(255,255,255,.006);
}

.groupLabel {
  color: #aaaab0;

  font-size: 11px;
  font-weight: 560;
}

.groupCount {
  color: #5f6168;

  font-family: var(--font-mono);
  font-size: 9px;
}

.groupHeaderAction {
  margin-left: auto;

  color: #71737a;

  font-size: 10px;
  text-decoration: none;
}

.groupHeaderAction:hover {
  color: #bdbec2;
}

.issueRow {
  min-height: 55px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 18px;

  padding: 8px 13px;

  border-bottom: 1px solid rgba(255,255,255,.035);

  transition: background .11s ease;
}

.issueRow:last-child {
  border-bottom: 0;
}

.issueRow:hover {
  background: rgba(255,255,255,.018);
}

.issueMain {
  min-width: 0;

  display: flex;
  align-items: flex-start;

  gap: 10px;
}

.issueDot {
  width: 7px;
  height: 7px;

  flex: 0 0 auto;

  margin-top: 5px;

  border: 1px solid #595c63;
  border-radius: 50%;

  background: transparent;
}

.issueDot[data-tone="success"] {
  border-color: #4da968;
  background: rgba(77,169,104,.12);
}

.issueDot[data-tone="warning"] {
  border-color: #c9a43d;
  background: rgba(201,164,61,.12);
}

.issueDot[data-tone="danger"] {
  border-color: #d2646d;
  background: rgba(210,100,109,.12);
}

.issueDot[data-tone="accent"] {
  border-color: #716bd7;
  background: rgba(94,106,210,.20);
}

.issueDot[data-tone="muted"] {
  border-color: #50535a;
}

.issueTitle {
  overflow: hidden;

  color: #d0d1d4;

  font-size: 12px;
  line-height: 1.4;
  font-weight: 470;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.issueDesc {
  max-width: 820px;

  margin-top: 2px;

  overflow: hidden;

  color: #64666d;

  font-size: 10px;
  line-height: 1.48;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.issueMeta {
  flex: 0 0 auto;

  color: #696b72;

  font-size: 10px;
  text-align: right;
}

.link {
  color: #85878d;
  text-decoration: none;
}

.link:hover {
  color: #d2d2d5;
}

.awaitingLabel {
  color: #56585f;
  font-size: 10px;
}

.mono {
  font-family: var(--font-mono);
}

.truncate {
  max-width: 340px;

  display: block;
  overflow: hidden;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.badge {
  min-height: 18px;

  display: inline-flex;
  align-items: center;

  padding: 0 6px;

  border: 1px solid rgba(255,255,255,.055);
  border-radius: 5px;

  background: rgba(255,255,255,.018);

  color: #777980;

  font-size: 9px;
  font-weight: 560;
}

.badgeDanger {
  color: #ca737a;
  border-color: rgba(210,100,109,.13);
  background: rgba(210,100,109,.04);
}

.badgeWarning {
  color: #bea149;
  border-color: rgba(201,164,61,.13);
  background: rgba(201,164,61,.04);
}

.badgeAccent {
  color: #8a84df;
  border-color: rgba(94,106,210,.15);
  background: rgba(94,106,210,.055);
}

.badgeMuted {
  color: #6e7077;
}

.badgeSuccess {
  color: #67ae78;
  border-color: rgba(77,169,104,.13);
  background: rgba(77,169,104,.04);
}

.card,
.formCard,
.progressCard,
.errorCard,
.scoreCard {
  border: 1px solid rgba(255,255,255,.055);
  border-radius: 8px;

  background: #121315;

  box-shadow: none;
}

.card {
  padding: 16px;
}

.emptyState {
  min-height: 330px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 42px;

  border: 1px solid rgba(255,255,255,.05);
  border-radius: 8px;

  background: #111214;

  text-align: center;
}

.emptyIconWrap {
  width: 36px;
  height: 36px;

  display: grid;
  place-items: center;

  margin-bottom: 13px;

  border: 1px solid rgba(255,255,255,.07);
  border-radius: 7px;

  background: #17181b;
  color: #85808e;
}

.emptyIcon {
  color: inherit;
}

.emptyTitle {
  margin: 0 0 6px;

  color: #d9dade;

  font-size: 13px;
  font-weight: 560;
}

.emptyDescription {
  max-width: 430px;

  margin: 0;

  color: #686a71;

  font-size: 11px;
  line-height: 1.55;
}

.emptyAction {
  min-height: 29px;

  display: inline-flex;
  align-items: center;

  margin-top: 16px;
  padding: 0 11px;

  border: 1px solid rgba(255,255,255,.09);
  border-radius: 6px;

  background: #e3e3e5;
  color: #151619;

  font-size: 10px;
  font-weight: 620;

  text-decoration: none;
}

.emptyAction:hover {
  background: #ededee;
}

.formGroup {
  display: grid;
  gap: 6px;

  margin-bottom: 14px;
}

.formLabel {
  color: #808289;

  font-size: 10px;
  font-weight: 560;
}

.formInput {
  width: 100%;
  height: 33px;

  padding: 0 9px;

  outline: none;

  border: 1px solid rgba(255,255,255,.065);
  border-radius: 6px;

  background: #0e0f11;
  color: #dedee0;

  font-size: 11px;
}

.formInput:focus {
  border-color: rgba(94,106,210,.30);

  box-shadow:
    0 0 0 3px rgba(94,106,210,.05);
}

.formError {
  color: #cc6871;
  font-size: 10px;
}

.primaryButton {
  min-height: 30px;

  padding: 0 11px;

  border: 1px solid rgba(255,255,255,.09);
  border-radius: 6px;

  background: #6866cf;
  color: #fff;

  font-size: 10px;
  font-weight: 620;

  cursor: pointer;

  box-shadow: none;
}

.primaryButton:hover {
  background: #7471dc;
}

.backLink {
  color: #707279;

  font-size: 10px;
  text-decoration: none;
}

.backLink:hover {
  color: #bcbec2;
}

.scoreGrid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));

  gap: 8px;
}

.scoreCard {
  padding: 16px;
}

.scoreValue {
  margin: 0;

  color: #e0e0e2;

  font-family: var(--font-mono);

  font-size: 22px;
  font-weight: 570;
}

.scoreLabel {
  margin: 6px 0 0;

  color: #66686f;

  font-size: 9px;

  letter-spacing: .05em;
  text-transform: uppercase;
}

.progressTitle,
.errorTitle {
  margin: 0;

  color: #d9dadd;

  font-size: 13px;
  font-weight: 560;
}

.progressStep {
  min-height: 30px;

  display: flex;
  align-items: center;

  gap: 8px;

  color: #696b72;

  font-size: 10px;
}

.progressDot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #6a67d0;
}

.progressStepLabel {
  color: #7c7e85;
}

.progressHint,
.errorDesc {
  margin: 6px 0 0;

  color: #62646b;

  font-size: 10px;
  line-height: 1.5;
}

.pageBody table {
  width: 100%;
  border-collapse: collapse;
}

.pageBody th {
  height: 30px;

  color: #7b7d84;

  font-size: 10px;
  font-weight: 560;
}

.pageBody td {
  color: #c6c7ca;

  font-size: 11px;
}

@media (max-width: 900px) {
  .pageBody {
    padding: 22px 18px 60px;
  }

  .statGrid,
  .scoreGrid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

@media (max-width: 600px) {
  .statGrid,
  .scoreGrid {
    grid-template-columns: 1fr;
  }

  .statCard + .statCard {
    border-left: 0 !important;
    border-top: 1px solid rgba(255,255,255,.045) !important;
  }

  .issueRow {
    align-items: flex-start;
    flex-direction: column;
  }

  .issueMeta {
    width: 100%;
    text-align: left;
  }
}
