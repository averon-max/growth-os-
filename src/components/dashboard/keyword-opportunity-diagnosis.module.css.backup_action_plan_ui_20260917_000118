.panel {
  border-top: 1px solid var(--border);
  background: var(--background);
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 16px;
  border-bottom: 1px solid var(--border);
}

.eyebrow {
  margin: 0 0 4px;
  color: var(--secondary);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.title {
  margin: 0;
  color: var(--primary);
  font-size: 14px;
  font-weight: 600;
}

.subtitle {
  margin: 5px 0 0;
  color: var(--secondary);
  font-size: 10px;
  line-height: 1.5;
}

.close {
  border: 1px solid var(--border);
  border-radius: 4px;
  background: var(--surface);
  color: var(--secondary);
  padding: 5px 8px;
  font: inherit;
  font-size: 9px;
  cursor: pointer;
}

.state {
  padding: 18px 16px;
  color: var(--secondary);
  font-size: 10px;
}

.error {
  color: #df7c7c;
}

.grid {
  display: grid;
  grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
}

.column {
  min-width: 0;
  padding: 14px 16px;
}

.column + .column {
  border-left: 1px solid var(--border);
}

.sectionTitle {
  margin: 0 0 10px;
  color: var(--primary);
  font-size: 11px;
  font-weight: 600;
}

.pageCard,
.finding,
.action,
.competitor {
  padding: 10px 0;
  border-bottom: 1px solid var(--border);
}

.pageCard:first-of-type,
.finding:first-of-type,
.action:first-of-type,
.competitor:first-of-type {
  padding-top: 0;
}

.pageCard:last-child,
.finding:last-child,
.action:last-child,
.competitor:last-child {
  border-bottom: 0;
}

.itemTitle {
  color: var(--primary);
  font-size: 10px;
  font-weight: 600;
  line-height: 1.4;
}

.body {
  margin-top: 4px;
  color: var(--secondary);
  font-size: 9px;
  line-height: 1.55;
}

.evidence {
  margin-top: 6px;
  color: var(--secondary);
  font-size: 9px;
  line-height: 1.5;
}

.evidenceItem {
  margin-top: 2px;
}

.url {
  display: block;
  overflow: hidden;
  margin-top: 5px;
  color: var(--secondary);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.high {
  color: #df7c7c;
}

.medium {
  color: #e2b56f;
}

.info {
  color: #72c891;
}

.actionTitle {
  color: var(--primary);
  font-size: 10px;
  font-weight: 600;
}

.actionIndex {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  margin-right: 7px;
  border: 1px solid var(--border);
  border-radius: 4px;
  color: var(--secondary);
  font-size: 8px;
}

.meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border-bottom: 1px solid var(--border);
}

.metaItem {
  padding: 9px 14px;
  border-right: 1px solid var(--border);
}

.metaItem:last-child {
  border-right: 0;
}

.metaValue {
  display: block;
  color: var(--primary);
  font-size: 11px;
  font-weight: 600;
}

.metaLabel {
  display: block;
  margin-top: 3px;
  color: var(--secondary);
  font-size: 8px;
}

.limitations {
  padding: 10px 16px;
  border-top: 1px solid var(--border);
  color: var(--secondary);
  font-size: 8px;
  line-height: 1.5;
}

@media (max-width: 900px) {
  .grid {
    grid-template-columns: 1fr;
  }

  .column + .column {
    border-left: 0;
    border-top: 1px solid var(--border);
  }
}
