"use client";

import {
  useCallback,
  useEffect,
  useMemo,
  useState,
} from "react";

import {
  Check,
  ChevronDown,
  Database,
  FileSearch,
  Plus,
  ShieldCheck,
  X,
} from "lucide-react";

import styles from "./content-governance.module.css";


const FACT_TYPES = [
  "CAPABILITY",
  "METRIC",
  "DATA_SOURCE",
  "POLICY",
  "DIFFERENTIATOR",
  "COMPLIANCE",
  "OTHER",
] as const;


interface FactRow {
  id: string;
  type: string;
  claim: string;
  status: string;
  sourceUrl: string | null;
  sourceLabel: string | null;
  evidence: string | null;
  confidence: number | null;
  createdAt: string;
  verifiedAt: string | null;
}


interface BriefRow {
  id: string;
  topic: string;
  primaryKeyword: string;
  searchIntent: string;
  status: string;
}


interface EvidenceSnapshot {
  id: string;
  topic: string;
  primaryKeyword: string;
  searchIntent: string;
  plannerVersion: string;
  gateVersion: string;
  generatorModel: string;
  createdAt: string;
  businessFacts: unknown;
  keywordContext: unknown;
  plan: unknown;
}


function registryClaims(
  value: unknown
): string[] {
  if (
    !value ||
    typeof value !== "object" ||
    Array.isArray(value)
  ) {
    return [];
  }

  const raw =
    value as Record<string, unknown>;

  if (
    !Array.isArray(
      raw.verifiedClaims
    )
  ) {
    return [];
  }

  return raw.verifiedClaims.filter(
    (value): value is string =>
      typeof value === "string"
  );
}


function registryFactIds(
  value: unknown
): string[] {
  if (
    !value ||
    typeof value !== "object" ||
    Array.isArray(value)
  ) {
    return [];
  }

  const raw =
    value as Record<string, unknown>;

  if (
    !Array.isArray(
      raw.factIds
    )
  ) {
    return [];
  }

  return raw.factIds.filter(
    (value): value is string =>
      typeof value === "string"
  );
}


function planDecision(
  value: unknown
): string | null {
  if (
    !value ||
    typeof value !== "object" ||
    Array.isArray(value)
  ) {
    return null;
  }

  const plan =
    value as Record<string, unknown>;

  const strategy =
    plan.strategy;

  if (
    !strategy ||
    typeof strategy !== "object" ||
    Array.isArray(strategy)
  ) {
    return null;
  }

  const action =
    (
      strategy as Record<
        string,
        unknown
      >
    ).action;

  if (
    !action ||
    typeof action !== "object" ||
    Array.isArray(action)
  ) {
    return null;
  }

  const type =
    (
      action as Record<
        string,
        unknown
      >
    ).type;

  return typeof type === "string"
    ? type
    : null;
}


export function ContentGovernancePanel({
  websiteId,
}: {
  websiteId: string;
}) {
  const [
    facts,
    setFacts,
  ] =
    useState<FactRow[]>([]);

  const [
    briefs,
    setBriefs,
  ] =
    useState<BriefRow[]>([]);

  const [
    loading,
    setLoading,
  ] =
    useState(true);

  const [
    error,
    setError,
  ] =
    useState<string | null>(
      null
    );

  const [
    showForm,
    setShowForm,
  ] =
    useState(false);

  const [
    busyFactId,
    setBusyFactId,
  ] =
    useState<string | null>(
      null
    );

  const [
    openBriefId,
    setOpenBriefId,
  ] =
    useState<string | null>(
      null
    );

  const [
    evidenceLoadingId,
    setEvidenceLoadingId,
  ] =
    useState<string | null>(
      null
    );

  const [
    evidenceCache,
    setEvidenceCache,
  ] =
    useState<
      Record<
        string,
        EvidenceSnapshot | null
      >
    >({});

  const [
    form,
    setForm,
  ] =
    useState({
      type:
        "CAPABILITY",

      claim:
        "",

      sourceUrl:
        "",

      sourceLabel:
        "",

      evidence:
        "",

      confidence:
        "",
    });


  const load =
    useCallback(
      async () => {
        setLoading(
          true
        );

        setError(
          null
        );

        try {
          const [
            factsResponse,
            briefsResponse,
          ] =
            await Promise.all([
              fetch(
                `/api/content/facts?websiteId=${encodeURIComponent(
                  websiteId
                )}`,
                {
                  cache:
                    "no-store",
                }
              ),

              fetch(
                `/api/content/briefs?websiteId=${encodeURIComponent(
                  websiteId
                )}&limit=100`,
                {
                  cache:
                    "no-store",
                }
              ),
            ]);

          const factsJson =
            await factsResponse.json();

          const briefsJson =
            await briefsResponse.json();

          if (
            !factsResponse.ok
          ) {
            throw new Error(
              factsJson.error ||
                "Could not load Business Fact Registry."
            );
          }

          if (
            !briefsResponse.ok
          ) {
            throw new Error(
              briefsJson.error ||
                "Could not load content briefs."
            );
          }

          setFacts(
            Array.isArray(
              factsJson.items
            )
              ? factsJson.items
              : []
          );

          setBriefs(
            Array.isArray(
              briefsJson.items
            )
              ? briefsJson.items
              : []
          );
        } catch (err) {
          setError(
            err instanceof Error
              ? err.message
              : "Could not load content governance data."
          );
        } finally {
          setLoading(
            false
          );
        }
      },
      [
        websiteId,
      ]
    );


  useEffect(
    () => {
      void load();
    },
    [
      load,
    ]
  );


  const counts =
    useMemo(
      () => ({
        verified:
          facts.filter(
            (fact) =>
              fact.status ===
              "VERIFIED"
          ).length,

        proposed:
          facts.filter(
            (fact) =>
              fact.status ===
              "PROPOSED"
          ).length,

        rejected:
          facts.filter(
            (fact) =>
              fact.status ===
              "REJECTED"
          ).length,
      }),
      [
        facts,
      ]
    );


  const sortedFacts =
    useMemo(
      () => {
        const weight:
          Record<
            string,
            number
          > = {
            PROPOSED:
              0,

            VERIFIED:
              1,

            REJECTED:
              2,

            ARCHIVED:
              3,
          };

        return [
          ...facts,
        ].sort(
          (a, b) =>
            (
              weight[
                a.status
              ] ??
              9
            ) -
            (
              weight[
                b.status
              ] ??
              9
            )
        );
      },
      [
        facts,
      ]
    );


  const createFact =
    async () => {
      const claim =
        form.claim.trim();

      if (!claim) {
        setError(
          "Fact claim is required."
        );

        return;
      }

      setError(
        null
      );

      try {
        const confidence =
          form.confidence.trim()
            ? Number(
                form.confidence
              )
            : undefined;

        const response =
          await fetch(
            "/api/content/facts",
            {
              method:
                "POST",

              headers: {
                "Content-Type":
                  "application/json",
              },

              body:
                JSON.stringify({
                  websiteId,

                  type:
                    form.type,

                  claim,

                  sourceUrl:
                    form.sourceUrl.trim() ||
                    undefined,

                  sourceLabel:
                    form.sourceLabel.trim() ||
                    undefined,

                  evidence:
                    form.evidence.trim() ||
                    undefined,

                  confidence:
                    Number.isFinite(
                      confidence
                    )
                      ? confidence
                      : undefined,
                }),
            }
          );

        const data =
          await response.json();

        if (
          !response.ok
        ) {
          throw new Error(
            data.error ||
              "Could not create fact."
          );
        }

        setForm({
          type:
            "CAPABILITY",

          claim:
            "",

          sourceUrl:
            "",

          sourceLabel:
            "",

          evidence:
            "",

          confidence:
            "",
        });

        setShowForm(
          false
        );

        await load();
      } catch (err) {
        setError(
          err instanceof Error
            ? err.message
            : "Could not create fact."
        );
      }
    };


  const transitionFact =
    async (
      fact:
        FactRow,
      action:
        "verify" |
        "reject"
    ) => {
      setBusyFactId(
        `${action}:${fact.id}`
      );

      setError(
        null
      );

      try {
        const response =
          await fetch(
            `/api/content/facts/${fact.id}/${action}`,
            {
              method:
                "POST",

              headers: {
                "Content-Type":
                  "application/json",
              },

              body:
                JSON.stringify({
                  websiteId,
                }),
            }
          );

        const data =
          await response.json();

        if (
          !response.ok
        ) {
          throw new Error(
            data.error ||
              `Could not ${action} fact.`
          );
        }

        await load();
      } catch (err) {
        setError(
          err instanceof Error
            ? err.message
            : `Could not ${action} fact.`
        );
      } finally {
        setBusyFactId(
          null
        );
      }
    };


  const toggleEvidence =
    async (
      briefId:
        string
    ) => {
      if (
        openBriefId ===
        briefId
      ) {
        setOpenBriefId(
          null
        );

        return;
      }

      setOpenBriefId(
        briefId
      );

      if (
        Object.prototype.hasOwnProperty.call(
          evidenceCache,
          briefId
        )
      ) {
        return;
      }

      setEvidenceLoadingId(
        briefId
      );

      setError(
        null
      );

      try {
        const response =
          await fetch(
            `/api/content/briefs/${briefId}/evidence`,
            {
              cache:
                "no-store",
            }
          );

        const data =
          await response.json();

        if (
          !response.ok
        ) {
          throw new Error(
            data.error ||
              "Could not load evidence snapshot."
          );
        }

        setEvidenceCache(
          (current) => ({
            ...current,

            [briefId]:
              data.evidence ??
              null,
          })
        );
      } catch (err) {
        setError(
          err instanceof Error
            ? err.message
            : "Could not load evidence snapshot."
        );
      } finally {
        setEvidenceLoadingId(
          null
        );
      }
    };


  return (
    <section
      className={
        styles.shell
      }
    >
      <div
        className={
          styles.header
        }
      >
        <div>
          <div
            className={
              styles.eyebrow
            }
          >
            <ShieldCheck
              size={
                13
              }
            />

            Content governance
          </div>

          <div
            className={
              styles.titleRow
            }
          >
            <h2>
              Fact registry
            </h2>

            <div
              className={
                styles.counts
              }
            >
              <span>
                <strong>
                  {
                    counts.verified
                  }
                </strong>{" "}
                verified
              </span>

              <span>
                <strong>
                  {
                    counts.proposed
                  }
                </strong>{" "}
                proposed
              </span>

              <span>
                <strong>
                  {
                    counts.rejected
                  }
                </strong>{" "}
                rejected
              </span>
            </div>
          </div>

          <p>
            Only verified product
            claims enter new
            evidence snapshots.
          </p>
        </div>

        <button
          type="button"
          className={
            styles.primaryButton
          }
          onClick={
            () =>
              setShowForm(
                (value) =>
                  !value
              )
          }
        >
          {
            showForm
              ? (
                <X
                  size={
                    12
                  }
                />
              )
              : (
                <Plus
                  size={
                    12
                  }
                />
              )
          }

          {
            showForm
              ? "Cancel"
              : "Add fact"
          }
        </button>
      </div>


      {
        error && (
          <div
            className={
              styles.error
            }
          >
            {
              error
            }
          </div>
        )
      }


      {
        showForm && (
          <div
            className={
              styles.factForm
            }
          >
            <select
              value={
                form.type
              }
              onChange={
                (event) =>
                  setForm(
                    (
                      current
                    ) => ({
                      ...current,

                      type:
                        event
                          .target
                          .value,
                    })
                  )
              }
            >
              {
                FACT_TYPES.map(
                  (type) => (
                    <option
                      key={
                        type
                      }
                      value={
                        type
                      }
                    >
                      {
                        type
                      }
                    </option>
                  )
                )
              }
            </select>

            <input
              value={
                form.claim
              }
              onChange={
                (event) =>
                  setForm(
                    (
                      current
                    ) => ({
                      ...current,

                      claim:
                        event
                          .target
                          .value,
                    })
                  )
              }
              placeholder="Exact factual claim"
            />

            <input
              value={
                form.sourceUrl
              }
              onChange={
                (event) =>
                  setForm(
                    (
                      current
                    ) => ({
                      ...current,

                      sourceUrl:
                        event
                          .target
                          .value,
                    })
                  )
              }
              placeholder="Evidence URL"
            />

            <input
              value={
                form.sourceLabel
              }
              onChange={
                (event) =>
                  setForm(
                    (
                      current
                    ) => ({
                      ...current,

                      sourceLabel:
                        event
                          .target
                          .value,
                    })
                  )
              }
              placeholder="Source label"
            />

            <input
              value={
                form.evidence
              }
              onChange={
                (event) =>
                  setForm(
                    (
                      current
                    ) => ({
                      ...current,

                      evidence:
                        event
                          .target
                          .value,
                    })
                  )
              }
              placeholder="Evidence note / quote / internal proof"
            />

            <input
              value={
                form.confidence
              }
              onChange={
                (event) =>
                  setForm(
                    (
                      current
                    ) => ({
                      ...current,

                      confidence:
                        event
                          .target
                          .value,
                    })
                  )
              }
              inputMode="decimal"
              placeholder="Confidence 0–1"
            />

            <button
              type="button"
              className={
                styles.primaryButton
              }
              onClick={
                () =>
                  void createFact()
              }
            >
              <Plus
                size={
                  12
                }
              />

              Create proposed fact
            </button>
          </div>
        )
      }


      <div
        className={
          styles.grid
        }
      >
        <div
          className={
            styles.panel
          }
        >
          <div
            className={
              styles.panelHeader
            }
          >
            <span>
              Business facts
            </span>

            <span>
              {
                facts.length
              }
            </span>
          </div>

          {
            loading ? (
              <div
                className={
                  styles.empty
                }
              >
                Loading fact registry…
              </div>
            ) : sortedFacts.length ===
              0 ? (
              <div
                className={
                  styles.empty
                }
              >
                No business facts
                registered yet.
              </div>
            ) : (
              <div>
                {
                  sortedFacts.map(
                    (fact) => {
                      const canVerify =
                        fact.status ===
                          "PROPOSED" &&
                        Boolean(
                          fact.sourceUrl ||
                          fact.evidence
                        );

                      return (
                        <div
                          key={
                            fact.id
                          }
                          className={
                            styles.factRow
                          }
                        >
                          <div
                            className={
                              styles.factMain
                            }
                          >
                            <div
                              className={
                                styles.factMeta
                              }
                            >
                              <span
                                className={`${styles.status} ${
                                  fact.status ===
                                  "VERIFIED"
                                    ? styles.verified
                                    : fact.status ===
                                      "PROPOSED"
                                    ? styles.proposed
                                    : styles.rejected
                                }`}
                              >
                                {
                                  fact.status
                                }
                              </span>

                              <span>
                                {
                                  fact.type
                                }
                              </span>

                              {
                                fact.confidence !==
                                  null && (
                                  <span>
                                    confidence{" "}
                                    {
                                      Math.round(
                                        fact.confidence *
                                          100
                                      )
                                    }
                                    %
                                  </span>
                                )
                              }
                            </div>

                            <strong>
                              {
                                fact.claim
                              }
                            </strong>

                            <div
                              className={
                                styles.factEvidence
                              }
                            >
                              {
                                fact.sourceUrl && (
                                  <a
                                    href={
                                      fact.sourceUrl
                                    }
                                    target="_blank"
                                    rel="noreferrer"
                                  >
                                    {
                                      fact.sourceLabel ||
                                      "Source"
                                    }
                                  </a>
                                )
                              }

                              {
                                fact.evidence && (
                                  <span>
                                    {
                                      fact.evidence
                                    }
                                  </span>
                                )
                              }

                              {
                                !fact.sourceUrl &&
                                !fact.evidence && (
                                  <span
                                    className={
                                      styles.noEvidence
                                    }
                                  >
                                    No evidence attached
                                  </span>
                                )
                              }
                            </div>
                          </div>

                          {
                            fact.status ===
                              "PROPOSED" && (
                              <div
                                className={
                                  styles.factActions
                                }
                              >
                                <button
                                  type="button"
                                  disabled={
                                    !canVerify ||
                                    busyFactId !==
                                      null
                                  }
                                  title={
                                    canVerify
                                      ? "Verify fact"
                                      : "Attach evidence before verification"
                                  }
                                  onClick={
                                    () =>
                                      void transitionFact(
                                        fact,
                                        "verify"
                                      )
                                  }
                                >
                                  <Check
                                    size={
                                      12
                                    }
                                  />

                                  Verify
                                </button>

                                <button
                                  type="button"
                                  disabled={
                                    busyFactId !==
                                    null
                                  }
                                  onClick={
                                    () =>
                                      void transitionFact(
                                        fact,
                                        "reject"
                                      )
                                  }
                                >
                                  <X
                                    size={
                                      12
                                    }
                                  />

                                  Reject
                                </button>
                              </div>
                            )
                          }
                        </div>
                      );
                    }
                  )
                }
              </div>
            )
          }
        </div>


        <div
          className={
            styles.panel
          }
        >
          <div
            className={
              styles.panelHeader
            }
          >
            <span>
              Evidence snapshots
            </span>

            <span>
              {
                briefs.length
              }{" "}
              briefs
            </span>
          </div>

          {
            briefs.length ===
            0 ? (
              <div
                className={
                  styles.empty
                }
              >
                No content briefs yet.
              </div>
            ) : (
              <div>
                {
                  briefs
                    .slice(
                      0,
                      12
                    )
                    .map(
                      (
                        brief
                      ) => {
                        const open =
                          openBriefId ===
                          brief.id;

                        const evidence =
                          evidenceCache[
                            brief.id
                          ];

                        const claims =
                          evidence
                            ? registryClaims(
                                evidence.businessFacts
                              )
                            : [];

                        const factIds =
                          evidence
                            ? registryFactIds(
                                evidence.businessFacts
                              )
                            : [];

                        const decision =
                          evidence
                            ? planDecision(
                                evidence.plan
                              )
                            : null;

                        return (
                          <div
                            key={
                              brief.id
                            }
                            className={
                              styles.evidenceRow
                            }
                          >
                            <button
                              type="button"
                              className={
                                styles.evidenceToggle
                              }
                              onClick={
                                () =>
                                  void toggleEvidence(
                                    brief.id
                                  )
                              }
                            >
                              <FileSearch
                                size={
                                  12
                                }
                              />

                              <div>
                                <strong>
                                  {
                                    brief.topic
                                  }
                                </strong>

                                <span>
                                  {
                                    brief.primaryKeyword
                                  }
                                  {" · "}
                                  {
                                    brief.searchIntent
                                  }
                                </span>
                              </div>

                              <ChevronDown
                                size={
                                  13
                                }
                                className={
                                  open
                                    ? styles.rotate
                                    : undefined
                                }
                              />
                            </button>

                            {
                              open && (
                                <div
                                  className={
                                    styles.evidenceDetails
                                  }
                                >
                                  {
                                    evidenceLoadingId ===
                                    brief.id ? (
                                      <span>
                                        Loading immutable snapshot…
                                      </span>
                                    ) : evidence ===
                                      null ? (
                                      <span
                                        className={
                                          styles.legacy
                                        }
                                      >
                                        Legacy brief — no immutable
                                        Evidence Snapshot exists.
                                      </span>
                                    ) : evidence ? (
                                      <>
                                        <div
                                          className={
                                            styles.evidenceMetrics
                                          }
                                        >
                                          <div>
                                            <span>
                                              Decision
                                            </span>

                                            <strong>
                                              {
                                                decision ||
                                                "—"
                                              }
                                            </strong>
                                          </div>

                                          <div>
                                            <span>
                                              Facts used
                                            </span>

                                            <strong>
                                              {
                                                factIds.length
                                              }
                                            </strong>
                                          </div>

                                          <div>
                                            <span>
                                              Planner
                                            </span>

                                            <strong>
                                              {
                                                evidence.plannerVersion
                                              }
                                            </strong>
                                          </div>

                                          <div>
                                            <span>
                                              Gate
                                            </span>

                                            <strong>
                                              {
                                                evidence.gateVersion
                                              }
                                            </strong>
                                          </div>

                                          <div>
                                            <span>
                                              Model
                                            </span>

                                            <strong>
                                              {
                                                evidence.generatorModel
                                              }
                                            </strong>
                                          </div>
                                        </div>

                                        <div
                                          className={
                                            styles.claimSnapshot
                                          }
                                        >
                                          <span>
                                            Verified claims frozen in snapshot
                                          </span>

                                          {
                                            claims.length >
                                            0 ? (
                                              claims.map(
                                                (
                                                  claim
                                                ) => (
                                                  <div
                                                    key={
                                                      claim
                                                    }
                                                  >
                                                    <Check
                                                      size={
                                                        11
                                                      }
                                                    />

                                                    {
                                                      claim
                                                    }
                                                  </div>
                                                )
                                              )
                                            ) : (
                                              <div>
                                                No verified product claims were
                                                available when this brief was
                                                created.
                                              </div>
                                            )
                                          }
                                        </div>
                                      </>
                                    ) : (
                                      <span>
                                        Open snapshot to load evidence.
                                      </span>
                                    )
                                  }
                                </div>
                              )
                            }
                          </div>
                        );
                      }
                    )
                }
              </div>
            )
          }
        </div>
      </div>
    </section>
  );
}
