.pageBody {
  position: relative;
  z-index: 1;

  width: calc(100% - 58px);
  max-width: 1360px;

  margin: 0 auto;
  padding: 38px 0 110px;
}

.pageBody::before {
  content: "";

  position: absolute;
  z-index: -1;
  pointer-events: none;

  top: -130px;
  left: -100px;
  right: -100px;

  height: 410px;

  background:
    radial-gradient(
      52% 50% at 34% 24%,
      rgba(119,104,220,.035),
      transparent 75%
    );
}

.pageHeader {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 24px;

  margin-bottom: 25px;
}

.pageTitle {
  margin: 0;

  color: #f1f1f3;

  font-size: 22px;
  line-height: 1.15;
  font-weight: 590;
  letter-spacing: -.037em;
}

.pageSubtitle {
  margin: 7px 0 0;

  color: #767983;

  font-size: 12px;
  line-height: 1.5;
}

.sectionTitle {
  margin: 31px 0 10px;

  color: #92949c;

  font-size: 11px;
  font-weight: 560;
}


/* METRICS */

.statGrid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));

  gap: 0;

  margin-bottom: 26px;

  overflow: hidden;

  border: 1px solid rgba(255,255,255,.075);
  border-radius: 12px;

  background:
    radial-gradient(
      480px 150px at 18% -25%,
      rgba(126,111,227,.11),
      transparent 72%
    ),
    radial-gradient(
      420px 150px at 70% -40%,
      rgba(71,127,163,.065),
      transparent 72%
    ),
    #0e1013;

  box-shadow:
    inset 0 1px rgba(255,255,255,.025),
    0 28px 80px rgba(0,0,0,.25);
}

.statCard {
  position: relative;

  min-height: 103px;

  padding: 21px 21px 18px;

  border: 0 !important;

  background: transparent;

  transition: background .15s ease;
}

.statCard + .statCard {
  border-left: 1px solid rgba(255,255,255,.06) !important;
}

.statCard:hover {
  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.025),
      transparent
    );
}

.statValue {
  margin: 0 0 9px;

  color: #f0f0f2 !important;

  font-size: 26px;
  line-height: 1;
  font-weight: 590;
  letter-spacing: -.045em;
}

.statLabel {
  margin: 0;

  color: #6f727c;

  font-size: 9px;
  font-weight: 650;
  letter-spacing: .07em;
  text-transform: uppercase;
}


/* LARGE SURFACES */

.group {
  position: relative;

  margin-top: 20px;

  overflow: hidden;

  border: 1px solid rgba(255,255,255,.072);
  border-radius: 12px;

  background:
    radial-gradient(
      620px 170px at 16% -50px,
      rgba(119,102,218,.052),
      transparent 72%
    ),
    linear-gradient(
      180deg,
      rgba(255,255,255,.012),
      transparent 120px
    ),
    #0d0f12;

  box-shadow:
    inset 0 1px rgba(255,255,255,.022),
    0 28px 85px rgba(0,0,0,.24);
}

.group::after {
  content: "";

  position: absolute;
  pointer-events: none;

  inset: 0;

  border-radius: inherit;

  background:
    linear-gradient(
      115deg,
      rgba(144,128,255,.025),
      transparent 28%,
      transparent 70%,
      rgba(70,132,170,.012)
    );
}

.groupHeader {
  position: relative;
  z-index: 1;

  min-height: 44px;

  display: flex;
  align-items: center;
  gap: 8px;

  padding: 0 16px;

  border-bottom: 1px solid rgba(255,255,255,.052);

  background: rgba(255,255,255,.007);
}

.groupLabel {
  color: #b4b6bd;

  font-size: 11px;
  font-weight: 560;
}

.groupCount {
  min-width: 18px;

  color: #646771;

  font-family: var(--font-mono);
  font-size: 9px;
}

.groupHeaderAction {
  position: relative;
  z-index: 2;

  margin-left: auto;

  color: #777a84;

  font-size: 10px;
  text-decoration: none;

  transition: color .13s ease;
}

.groupHeaderAction:hover {
  color: #cacbd0;
}


/* LIST ROWS */

.issueRow {
  position: relative;
  z-index: 1;

  min-height: 62px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 10px 16px;

  border-bottom: 1px solid rgba(255,255,255,.042);

  transition:
    background .13s ease,
    border-color .13s ease;
}

.issueRow:last-child {
  border-bottom: 0;
}

.issueRow:hover {
  background:
    linear-gradient(
      90deg,
      rgba(119,107,222,.034),
      rgba(255,255,255,.012) 45%,
      transparent
    );
}

.issueMain {
  min-width: 0;

  display: flex;
  align-items: flex-start;

  gap: 11px;
}

.issueDot {
  width: 7px;
  height: 7px;

  flex: 0 0 auto;

  margin-top: 5px;

  border: 1px solid #61646d;
  border-radius: 50%;

  background: transparent;
}

.issueDot[data-tone="success"] {
  border-color: #66bc7d;
  background: rgba(102,188,125,.18);

  box-shadow:
    0 0 10px rgba(102,188,125,.15);
}

.issueDot[data-tone="warning"] {
  border-color: #d5ad52;
  background: rgba(213,173,82,.16);

  box-shadow:
    0 0 10px rgba(213,173,82,.12);
}

.issueDot[data-tone="danger"] {
  border-color: #db6876;
  background: rgba(219,104,118,.17);

  box-shadow:
    0 0 10px rgba(219,104,118,.12);
}

.issueDot[data-tone="accent"] {
  border-color: #8d82ef;
  background: rgba(141,130,239,.20);

  box-shadow:
    0 0 11px rgba(141,130,239,.19);
}

.issueDot[data-tone="muted"] {
  border-color: #545760;
}

.issueTitle {
  overflow: hidden;

  color: #d5d6da;

  font-size: 12px;
  line-height: 1.45;
  font-weight: 480;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.issueDesc {
  max-width: 800px;

  margin-top: 2px;

  overflow: hidden;

  color: #686b74;

  font-size: 10px;
  line-height: 1.5;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.issueMeta {
  flex: 0 0 auto;

  color: #6e717a;

  font-size: 10px;
  text-align: right;
}

.link {
  color: #8f929b;

  text-decoration: none;

  transition: color .13s ease;
}

.link:hover {
  color: #d8d9dc;
}

.awaitingLabel {
  color: #595c65;

  font-size: 10px;
}

.mono {
  font-family: var(--font-mono);
}

.truncate {
  max-width: 340px;

  display: block;
  overflow: hidden;

  white-space: nowrap;
  text-overflow: ellipsis;
}


/* BADGES */

.badge {
  min-height: 19px;

  display: inline-flex;
  align-items: center;

  padding: 0 6px;

  border: 1px solid rgba(255,255,255,.07);
  border-radius: 5px;

  background: rgba(255,255,255,.025);

  color: #868992;

  font-size: 9px;
  font-weight: 570;
  letter-spacing: .015em;
}

.badgeDanger {
  color: #d37a84;

  border-color: rgba(216,102,114,.17);
  background: rgba(216,102,114,.055);
}

.badgeWarning {
  color: #cfaa58;

  border-color: rgba(215,173,88,.16);
  background: rgba(215,173,88,.052);
}

.badgeAccent {
  color: #a69df5;

  border-color: rgba(135,122,239,.18);
  background: rgba(124,111,230,.07);
}

.badgeMuted {
  color: #777a83;
}

.badgeSuccess {
  color: #75be87;

  border-color: rgba(101,183,123,.17);
  background: rgba(101,183,123,.05);
}


/* GENERIC PANELS */

.card,
.formCard,
.progressCard,
.errorCard,
.scoreCard {
  position: relative;

  border: 1px solid rgba(255,255,255,.072);
  border-radius: 12px;

  background:
    radial-gradient(
      520px 150px at 10% -35px,
      rgba(118,104,217,.045),
      transparent 72%
    ),
    #0e1013;

  box-shadow:
    inset 0 1px rgba(255,255,255,.022),
    0 28px 85px rgba(0,0,0,.22);
}

.card {
  padding: 18px;
}


/* EMPTY STATES */

.emptyState {
  position: relative;

  min-height: 410px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 50px;

  overflow: hidden;

  border: 1px solid rgba(255,255,255,.07);
  border-radius: 12px;

  background:
    radial-gradient(
      400px 230px at 50% 14%,
      rgba(121,106,225,.075),
      transparent 72%
    ),
    radial-gradient(
      300px 180px at 75% 28%,
      rgba(58,124,151,.035),
      transparent 72%
    ),
    #0d0f12;

  box-shadow:
    inset 0 1px rgba(255,255,255,.022),
    0 32px 95px rgba(0,0,0,.24);

  text-align: center;
}

.emptyState::after {
  content: "";

  position: absolute;

  width: 260px;
  height: 1px;

  top: 0;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(153,143,255,.20),
      transparent
    );
}

.emptyIconWrap {
  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  margin-bottom: 14px;

  border: 1px solid rgba(255,255,255,.09);
  border-radius: 9px;

  background:
    linear-gradient(
      145deg,
      rgba(127,113,230,.13),
      rgba(255,255,255,.02)
    );

  color: #9790e8;

  box-shadow:
    0 0 26px rgba(121,105,224,.09);
}

.emptyIcon {
  color: inherit;
}

.emptyTitle {
  margin: 0 0 6px;

  color: #e3e4e7;

  font-size: 13px;
  font-weight: 570;
}

.emptyDescription {
  max-width: 440px;

  margin: 0;

  color: #6e717b;

  font-size: 11px;
  line-height: 1.58;
}

.emptyAction {
  min-height: 30px;

  display: inline-flex;
  align-items: center;

  margin-top: 18px;
  padding: 0 11px;

  border: 1px solid rgba(158,146,255,.20);
  border-radius: 6px;

  background:
    linear-gradient(
      180deg,
      #9388ee,
      #7368d8
    );

  color: #fff;

  font-size: 10px;
  font-weight: 620;
  text-decoration: none;

  box-shadow:
    0 5px 18px rgba(93,79,196,.19),
    inset 0 1px rgba(255,255,255,.23);

  transition:
    filter .13s ease,
    transform .13s ease;
}

.emptyAction:hover {
  filter: brightness(1.07);
}


/* FORMS */

.formGroup {
  display: grid;
  gap: 6px;

  margin-bottom: 14px;
}

.formLabel {
  color: #858891;

  font-size: 10px;
  font-weight: 570;
}

.formInput {
  width: 100%;
  height: 34px;

  padding: 0 10px;

  outline: none;

  border: 1px solid rgba(255,255,255,.08);
  border-radius: 6px;

  background: #0a0b0e;
  color: #e4e5e8;

  font-size: 11px;

  transition:
    border-color .13s ease,
    box-shadow .13s ease;
}

.formInput:focus {
  border-color: rgba(139,128,237,.35);

  box-shadow:
    0 0 0 3px rgba(123,110,225,.07);
}

.formError {
  color: #d66a76;

  font-size: 10px;
}

.primaryButton {
  min-height: 31px;

  padding: 0 12px;

  border: 1px solid rgba(154,142,255,.18);
  border-radius: 6px;

  background:
    linear-gradient(
      180deg,
      #958af0,
      #756bda
    );

  color: #fff;

  font-size: 10px;
  font-weight: 630;

  cursor: pointer;

  box-shadow:
    0 5px 18px rgba(93,79,196,.17),
    inset 0 1px rgba(255,255,255,.23);
}

.primaryButton:hover {
  filter: brightness(1.06);
}

.backLink {
  color: #747781;

  font-size: 10px;
  text-decoration: none;
}

.backLink:hover {
  color: #c6c8ce;
}


/* SCORES */

.scoreGrid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));

  gap: 10px;
}

.scoreCard {
  padding: 18px;
}

.scoreValue {
  margin: 0;

  color: #ececef;

  font-family: var(--font-mono);
  font-size: 24px;
  font-weight: 580;
  letter-spacing: -.035em;
}

.scoreLabel {
  margin: 6px 0 0;

  color: #6e717a;

  font-size: 9px;
  letter-spacing: .055em;
  text-transform: uppercase;
}


/* PROGRESS / ERROR */

.progressTitle,
.errorTitle {
  margin: 0;

  color: #e1e2e5;

  font-size: 13px;
  font-weight: 570;
}

.progressStep {
  min-height: 31px;

  display: flex;
  align-items: center;

  gap: 9px;

  color: #70737c;

  font-size: 11px;
}

.progressDot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #8177df;

  box-shadow:
    0 0 9px rgba(129,119,223,.26);
}

.progressStepLabel {
  color: #858891;
}

.progressHint,
.errorDesc {
  margin: 6px 0 0;

  color: #686b74;

  font-size: 10px;
  line-height: 1.5;
}


@media (max-width: 900px) {
  .pageBody {
    width: calc(100% - 30px);
    padding-top: 25px;
  }

  .statGrid,
  .scoreGrid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

@media (max-width: 600px) {
  .statGrid,
  .scoreGrid {
    grid-template-columns: 1fr;
  }

  .statCard + .statCard {
    border-left: 0 !important;
    border-top: 1px solid rgba(255,255,255,.06) !important;
  }

  .issueRow {
    align-items: flex-start;
    flex-direction: column;
  }

  .issueMeta {
    width: 100%;
    text-align: left;
  }
}
