"use client";

import { useSession } from "next-auth/react";
import { WebsiteSwitcher } from "./website-switcher";
import styles from "./topbar.module.css";

interface Props {
  title: string;
  subtitle?: string;
  websiteSwitcher?: {
    workspaceId: string;
    currentWebsiteId: string;
  };
}

export function Topbar({ title, subtitle, websiteSwitcher }: Props) {
  const { data: session } = useSession();
  const email = session?.user?.email ?? null;
  const initial = email?.trim().charAt(0).toUpperCase() ?? null;

  return (
    <div className={styles.topbar}>
      <div className={styles.titleBlock}>
        <span className={styles.pageDot} />
        <p className={styles.title}>{title}</p>
        {subtitle && (
          <>
            <span className={styles.separator}>/</span>
            <p className={styles.subtitle}>{subtitle}</p>
          </>
        )}
      </div>

      <div className={styles.right}>
        {websiteSwitcher && (
          <div className={styles.websiteControl}>
            <WebsiteSwitcher
              workspaceId={websiteSwitcher.workspaceId}
              currentWebsiteId={websiteSwitcher.currentWebsiteId}
            />
          </div>
        )}

        {initial && (
          <div className={styles.avatar} title={email ?? undefined}>
            {initial}
          </div>
        )}
      </div>
    </div>
  );
}
