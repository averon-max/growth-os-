.topbar {
  position: sticky;
  z-index: 25;
  top: 0;

  height: 54px;
  min-height: 54px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;

  padding: 0 24px;

  background: rgba(8,9,11,.72);

  border-bottom: 1px solid rgba(255,255,255,.06);

  backdrop-filter: blur(22px) saturate(120%);
  -webkit-backdrop-filter: blur(22px) saturate(120%);
}

.topbar::after {
  content: "";

  position: absolute;
  pointer-events: none;

  left: 22%;
  right: 18%;
  bottom: -1px;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(122,111,221,.16),
      rgba(87,135,174,.08),
      transparent
    );
}

.titleBlock {
  min-width: 0;

  display: flex;
  align-items: center;
  gap: 9px;
}

.title {
  margin: 0;

  color: #e9eaed;

  font-size: 13px;
  font-weight: 570;
  line-height: 1;
  letter-spacing: -.012em;
}

.subtitle {
  position: relative;

  max-width: 460px;
  margin: 0;
  padding-left: 11px;

  overflow: hidden;

  color: #686b74;

  font-size: 10px;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.subtitle::before {
  content: "";

  position: absolute;
  left: 0;
  top: 50%;

  width: 3px;
  height: 3px;

  border-radius: 50%;

  background: #6d66a0;

  transform: translateY(-50%);
}

.right {
  min-width: 0;

  display: flex;
  align-items: center;
  gap: 9px;
}

.userEmail {
  max-width: 170px;

  overflow: hidden;

  color: #60636b;

  font-size: 10px;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.avatar {
  width: 24px;
  height: 24px;

  border: 1px solid rgba(255,255,255,.10);
  border-radius: 50%;

  background:
    radial-gradient(
      circle at 33% 25%,
      rgba(157,144,255,.38),
      transparent 25%
    ),
    linear-gradient(
      145deg,
      #252631,
      #111217
    );

  box-shadow:
    0 0 16px rgba(116,102,220,.09);
}
