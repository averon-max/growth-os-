.shell {
  margin-bottom: 12px;
  border: 1px solid var(--border, #2a2e33);
  background: #101214;
}

.header {
  min-height: 64px;
  padding: 10px 12px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  border-bottom: 1px solid var(--border, #2a2e33);
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #7f86d9;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.titleRow {
  display: flex;
  align-items: baseline;
  gap: 14px;
  margin-top: 5px;
}

.titleRow h2 {
  margin: 0;
  color: var(--primary, #f7f8f8);
  font-size: 13px;
  font-weight: 550;
}

.header p {
  margin: 4px 0 0;
  color: #747981;
  font-size: 9.5px;
}

.counts {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #737880;
  font-size: 9px;
}

.counts strong {
  color: #b8bbc1;
  font-weight: 550;
}

.primaryButton {
  min-height: 27px;
  padding: 0 9px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  border: 1px solid #4f58a8;
  border-radius: 4px;
  background: #2c3265;
  color: #dfe1ff;
  font: inherit;
  font-size: 9.5px;
  cursor: pointer;
}

.primaryButton:hover {
  background: #353c77;
}

.primaryButton:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.error {
  padding: 7px 10px;
  border-bottom: 1px solid #603737;
  background: rgba(120, 40, 40, 0.12);
  color: #e38a8a;
  font-size: 9.5px;
}

.factForm {
  padding: 8px 10px;
  display: grid;
  grid-template-columns: 130px minmax(220px, 2fr) minmax(180px, 1fr) minmax(130px, 1fr);
  gap: 6px;
  border-bottom: 1px solid var(--border, #2a2e33);
  background: #0d0f11;
}

.factForm input,
.factForm select {
  min-width: 0;
  height: 28px;
  padding: 0 8px;
  border: 1px solid var(--border, #2a2e33);
  border-radius: 3px;
  outline: none;
  background: #151719;
  color: #c9ccd1;
  font: inherit;
  font-size: 9.5px;
}

.factForm input:focus,
.factForm select:focus {
  border-color: #555fa9;
}

.grid {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(360px, 0.75fr);
}

.panel + .panel {
  border-left: 1px solid var(--border, #2a2e33);
}

.panelHeader {
  min-height: 31px;
  padding: 0 10px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border, #2a2e33);
  background: rgba(255, 255, 255, 0.012);
  color: #858a92;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.factRow {
  min-height: 54px;
  padding: 7px 10px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid rgba(42, 46, 51, 0.7);
}

.factRow:last-child {
  border-bottom: 0;
}

.factMain {
  min-width: 0;
}

.factMain strong {
  display: block;
  margin-top: 4px;
  color: #c9ccd0;
  font-size: 10px;
  font-weight: 500;
  line-height: 1.35;
}

.factMeta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
  color: #686d75;
  font-size: 8.5px;
}

.status {
  padding: 1px 5px;
  border: 1px solid #34383d;
  border-radius: 3px;
  font-size: 8px;
}

.verified {
  border-color: #36543e;
  color: #7dbb8b;
}

.proposed {
  border-color: #5b5334;
  color: #cfb96f;
}

.rejected {
  border-color: #5b3535;
  color: #c97c7c;
}

.factEvidence {
  margin-top: 4px;
  display: flex;
  align-items: center;
  gap: 7px;
  min-width: 0;
  color: #70757d;
  font-size: 8.5px;
}

.factEvidence a {
  color: #8992df;
  text-decoration: none;
}

.factEvidence span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.noEvidence {
  color: #9b6f6f;
}

.factActions {
  display: flex;
  align-items: center;
  gap: 5px;
}

.factActions button {
  height: 24px;
  padding: 0 7px;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  border: 1px solid #34383d;
  border-radius: 3px;
  background: #16181a;
  color: #a9adb3;
  font: inherit;
  font-size: 8.5px;
  cursor: pointer;
}

.factActions button:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

.evidenceRow {
  border-bottom: 1px solid rgba(42, 46, 51, 0.7);
}

.evidenceRow:last-child {
  border-bottom: 0;
}

.evidenceToggle {
  width: 100%;
  min-height: 48px;
  padding: 6px 9px;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 8px;
  border: 0;
  background: transparent;
  color: #8f949b;
  text-align: left;
  cursor: pointer;
}

.evidenceToggle:hover {
  background: rgba(255, 255, 255, 0.018);
}

.evidenceToggle strong {
  display: block;
  overflow: hidden;
  color: #bfc2c7;
  font-size: 9.5px;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.evidenceToggle span {
  display: block;
  margin-top: 2px;
  overflow: hidden;
  color: #686d74;
  font-size: 8.5px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rotate {
  transform: rotate(180deg);
}

.evidenceDetails {
  padding: 8px 10px 10px 29px;
  border-top: 1px solid rgba(42, 46, 51, 0.55);
  background: #0d0f10;
  color: #777c84;
  font-size: 9px;
}

.evidenceMetrics {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  border: 1px solid #282c30;
}

.evidenceMetrics > div {
  min-width: 0;
  padding: 6px 7px;
  border-right: 1px solid #282c30;
}

.evidenceMetrics > div:last-child {
  border-right: 0;
}

.evidenceMetrics span {
  display: block;
  color: #62676f;
  font-size: 8px;
  text-transform: uppercase;
}

.evidenceMetrics strong {
  display: block;
  margin-top: 3px;
  overflow: hidden;
  color: #b8bbc1;
  font-size: 8.5px;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.claimSnapshot {
  margin-top: 7px;
}

.claimSnapshot > span {
  display: block;
  margin-bottom: 4px;
  color: #656a72;
  font-size: 8px;
  text-transform: uppercase;
}

.claimSnapshot > div {
  margin-top: 3px;
  display: flex;
  align-items: flex-start;
  gap: 5px;
  color: #93989f;
  line-height: 1.35;
}

.legacy {
  color: #a88168;
}

.empty {
  padding: 18px 10px;
  color: #686d74;
  font-size: 9.5px;
}

@media (max-width: 1100px) {
  .grid {
    grid-template-columns: 1fr;
  }

  .panel + .panel {
    border-left: 0;
    border-top: 1px solid var(--border, #2a2e33);
  }

  .factForm {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 720px) {
  .header,
  .titleRow {
    align-items: stretch;
    flex-direction: column;
  }

  .counts {
    flex-wrap: wrap;
  }

  .factForm {
    grid-template-columns: 1fr;
  }

  .evidenceMetrics {
    grid-template-columns: 1fr 1fr;
  }

  .evidenceMetrics > div {
    border-bottom: 1px solid #282c30;
  }
}
