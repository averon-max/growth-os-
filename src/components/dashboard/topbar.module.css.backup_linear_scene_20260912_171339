.topbar {
  position: sticky;
  z-index: 15;
  top: 0;

  height: 48px;
  min-height: 48px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 18px;

  padding: 0 18px;

  border-bottom: 1px solid var(--border);

  background: rgba(17,18,20,.88);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.titleBlock {
  min-width: 0;

  display: flex;
  align-items: center;
  gap: 7px;
}

.pageDot {
  width: 6px;
  height: 6px;

  flex: 0 0 auto;

  border: 1px solid #6b6e75;
  border-radius: 50%;
}

.title {
  margin: 0;

  color: #dedee1;

  font-size: 12px;
  line-height: 1;
  font-weight: 570;

  letter-spacing: -.01em;
}

.separator {
  color: #46494f;
  font-size: 11px;
}

.subtitle {
  max-width: 420px;

  margin: 0;

  overflow: hidden;

  color: #65686f;

  font-size: 10px;
  line-height: 1;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.right {
  min-width: 0;

  display: flex;
  align-items: center;
  gap: 8px;
}

.websiteSwitcher {
  max-width: 280px;
  height: 29px;

  padding: 0 28px 0 9px;

  outline: none;

  border: 1px solid var(--border);
  border-radius: 6px;

  background: var(--surface);
  color: #aaaeb5;

  box-shadow: none;

  font-size: 10px;
}

.websiteSwitcher:hover {
  border-color: var(--border-hover);
  background: var(--surface-2);
}

.websiteSwitcher:focus {
  border-color: rgba(94,106,210,.32);
}

.websiteControl {
  min-width: 0;
}

.userEmail {
  display: none;
}

.avatar {
  width: 24px;
  height: 24px;

  display: grid;
  place-items: center;

  flex: 0 0 auto;

  border: 1px solid var(--border);
  border-radius: 50%;

  background: var(--surface-2);
  color: #777a81;

  font-size: 9px;
  font-weight: 600;
}
