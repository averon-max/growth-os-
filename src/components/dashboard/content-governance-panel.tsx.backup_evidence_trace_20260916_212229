              </strong>
            </div>

            <div>
              <span>
                Analyzed
              </span>

              <strong>
                {
                  discoveryResult.pagesAnalyzed
                }
              </strong>
            </div>

            <div>
              <span>
                Candidates
              </span>

              <strong>
                {
                  discoveryResult.candidatesExtracted
                }
              </strong>
            </div>

            <div>
              <span>
                Proposed
              </span>

              <strong>
                {
                  discoveryResult.created
                }
              </strong>
            </div>

            <div>
              <span>
                Duplicates
              </span>

              <strong>
                {
                  discoveryResult.duplicatesSkipped
                }
              </strong>
            </div>

            <div>
              <span>
                Invalid
              </span>

              <strong>
                {
                  discoveryResult.invalidCandidatesSkipped
                }
              </strong>
            </div>

            <div>
              <span>
                Model errors
              </span>

              <strong>
                {
                  discoveryResult.modelErrors
                }
              </strong>
            </div>
          </div>
        )
      }


      {
        showForm && (
          <div
            className={
              styles.factForm
            }
          >
            <select
              value={
                form.type
              }
              onChange={
                (event) =>
                  setForm(
                    (
                      current
                    ) => ({
                      ...current,

                      type:
                        event
                          .target
                          .value,
                    })
                  )
              }
            >
              {
                FACT_TYPES.map(
                  (type) => (
                    <option
                      key={
                        type
                      }
                      value={
                        type
                      }
                    >
                      {
                        type
                      }
                    </option>
                  )
                )
              }
            </select>

            <input
              value={
                form.claim
              }
              onChange={
                (event) =>
                  setForm(
                    (
                      current
                    ) => ({
                      ...current,

                      claim:
                        event
                          .target
                          .value,
                    })
                  )
              }
              placeholder="Exact factual claim"
            />

            <input
              value={
                form.sourceUrl
              }
              onChange={
                (event) =>
                  setForm(
                    (
                      current
                    ) => ({
                      ...current,

                      sourceUrl:
                        event
                          .target
                          .value,
                    })
                  )
              }
              placeholder="Evidence URL"
            />

            <input
              value={
                form.sourceLabel
              }
              onChange={
                (event) =>
                  setForm(
                    (
                      current
                    ) => ({
                      ...current,

                      sourceLabel:
                        event
                          .target
                          .value,
                    })
                  )
              }
              placeholder="Source label"
            />

            <input
              value={
                form.evidence
              }
              onChange={
                (event) =>
                  setForm(
                    (
                      current
                    ) => ({
                      ...current,

                      evidence:
                        event
                          .target
                          .value,
                    })
                  )
              }
              placeholder="Evidence note / quote / internal proof"
            />

            <input
              value={
                form.confidence
              }
              onChange={
                (event) =>
                  setForm(
                    (
                      current
                    ) => ({
                      ...current,

                      confidence:
                        event
                          .target
                          .value,
                    })
                  )
              }
              inputMode="decimal"
              placeholder="Confidence 0–1"
            />

            <button
              type="button"
              className={
                styles.primaryButton
              }
              onClick={
                () =>
                  void createFact()
              }
            >
              <Plus
                size={
                  12
                }
              />

              Create proposed fact
            </button>
          </div>
        )
      }


      <div
        className={
          styles.grid
        }
      >
                            <div
            className={
              styles.panel
            }
          >
            <div
              className={
                styles.panelHeader
              }
            >
              <span>
                Business facts
              </span>

              <span>
                {
                  sortedFacts.filter(
                    (fact) =>
                      fact.status ===
                      factFilter
                  ).length
                }{" "}
                /{" "}
                {
                  facts.length
                }
              </span>
            </div>

            <div
              className={
                styles.factFilters
              }
            >
              {
                (
                  [
                    [
                      "PROPOSED",
                      counts.proposed,
                    ],
                    [
                      "VERIFIED",
                      counts.verified,
                    ],
                    [
                      "REJECTED",
                      counts.rejected,
                    ],
                    [
                      "ARCHIVED",
                      counts.archived,
                    ],
                  ] as const
                ).map(
                  ([
                    status,
                    count,
                  ]) => (
                    <button
                      key={
                        status
                      }
                      type="button"
                      className={`${styles.factFilter} ${
                        factFilter ===
                        status
                          ? styles.factFilterActive
                          : ""
                      }`}
                      onClick={
                        () => {
                          setFactFilter(
                            status
                          );

                          setOpenFactId(
                            null
                          );
                        }
                      }
                    >
                      {
                        status
                      }

                      <span>
                        {
                          count
                        }
                      </span>
                    </button>
                  )
                )
              }
            </div>

            {
              loading ? (
                <div
                  className={
                    styles.empty
                  }
                >
                  Loading fact registry…
                </div>
              ) : sortedFacts.filter(
                  (fact) =>
                    fact.status ===
                    factFilter
                ).length ===
                0 ? (
                <div
                  className={
                    styles.empty
                  }
                >
                  No{" "}
                  {
                    factFilter.toLowerCase()
                  }{" "}
                  business facts.
                </div>
              ) : (
                <div
                  className={
                    styles.reviewList
                  }
                >
                  {
                    sortedFacts
                      .filter(
                        (fact) =>
                          fact.status ===
                          factFilter
                      )
                      .map(
                        (fact) => {
                          const canVerify =
                            fact.status ===
                              "PROPOSED" &&
                            Boolean(
                              fact.sourceUrl &&
                              fact.evidence?.trim()
                            );

                          const isOpen =
                            openFactId ===
                            fact.id;

                          const risks =
                            factRiskFlags(
                              fact
                            );

                          const provenance =
                            factProvenance(
                              fact
                            );

                          return (
                            <article
                              key={
                                fact.id
                              }
                              className={
                                styles.reviewRow
                              }
                            >
                              <div
                                className={
                                  styles.reviewHead
                                }
                              >
                                <div
                                  className={
                                    styles.reviewSummary
                                  }
                                >
                                  <div
                                    className={
                                      styles.factMeta
                                    }
                                  >
                                    <span
                                      className={`${styles.status} ${
                                        fact.status ===
                                        "VERIFIED"
                                          ? styles.verified
                                          : fact.status ===
                                              "PROPOSED"
                                            ? styles.proposed
                                            : fact.status ===
                                                "ARCHIVED"
                                              ? styles.archived
                                              : styles.rejected
                                      }`}
                                    >
                                      {
                                        fact.status
                                      }
                                    </span>

                                    <span>
                                      {
                                        fact.type
                                      }
                                    </span>

                                    {
                                      fact.confidence !==
                                        null && (
                                        <span>
                                          confidence{" "}
                                          {
                                            Math.round(
                                              fact.confidence *
                                                100
                                            )
                                          }
                                          %
                                        </span>
                                      )
                                    }

                                    {
                                      risks.map(
                                        (
                                          risk
                                        ) => (
                                          <span
                                            key={
                                              risk
                                            }
                                            className={
                                              styles.riskBadge
                                            }
                                          >
                                            {
                                              risk
                                            }
                                          </span>
                                        )
                                      )
                                    }
                                  </div>

                                  <strong
                                    className={
                                      styles.reviewClaim
                                    }
                                  >
                                    {
                                      fact.claim
                                    }
                                  </strong>

                                  <div
                                    className={
                                      styles.reviewSource
                                    }
                                  >
                                    {
                                      fact.status ===
                                        "VERIFIED" && (
                                        <span
                                          className={`${styles.evidenceFreshnessBadge} ${
                                            fact.evidenceStatus ===
                                            "FRESH"
                                              ? styles.evidenceFresh
                                              : fact.evidenceStatus ===
                                                  "UNCHECKED"
                                                ? styles.evidenceUnchecked
                                                : fact.evidenceStatus ===
                                                    "DRIFTED"
                                                  ? styles.evidenceDrifted
                                                  : styles.evidenceUnavailable
                                          }`}
                                        >
                                          {
                                            fact.evidenceStatus
                                          }
                                        </span>
                                      )
                                    }

                                    {
                                      fact.sourceUrl ? (
                                        <a
                                          href={
                                            fact.sourceUrl
                                          }
                                          target="_blank"
                                          rel="noreferrer"
                                        >
                                          {
                                            fact.sourceLabel ||
                                            formatSourceUrl(
                                              fact.sourceUrl
                                            )
                                          }
                                          {" ↗"}
                                        </a>
                                      ) : (
                                        <span
                                          className={
                                            styles.noEvidence
                                          }
                                        >
                                          No source URL
                                        </span>
                                      )
                                    }

                                    <span>
                                      v
                                      {
                                        fact.version
                                      }
                                    </span>

                                    <span>
                                      {
                                        provenance.atomic
                                          ? "atomic"
                                          : "direct"
                                      }
                                    </span>
                                  </div>
                                </div>

                                <button
                                  type="button"
                                  className={
                                    styles.expandButton
                                  }
                                  aria-expanded={
                                    isOpen
                                  }
                                  title={
                                    isOpen
                                      ? "Hide provenance"
                                      : "Review evidence and provenance"
                                  }
                                  onClick={
                                    () =>
                                      setOpenFactId(
                                        isOpen
                                          ? null
                                          : fact.id
                                      )
                                  }
                                >
                                  <ChevronDown
                                    size={
                                      13
                                    }
                                    className={
                                      isOpen
                                        ? styles.rotate
                                        : undefined
                                    }
                                  />
                                </button>
                              </div>

                              <div
                                className={
                                  styles.reviewEvidence
                                }
                              >
                                <span
                                  className={
                                    styles.reviewLabel
                                  }
                                >
                                  Exact evidence
                                </span>

                                {
                                  fact.evidence ? (
                                    <span>
                                      “
                                      {
                                        fact.evidence
                                      }
                                      ”
                                    </span>
                                  ) : (
                                    <span
                                      className={
                                        styles.noEvidence
                                      }
                                    >
                                      No evidence attached
                                    </span>
                                  )
                                }
                              </div>

                              {
                                isOpen && (
                                  <div
                                    className={
                                      styles.reviewDetails
                                    }
                                  >

                                    {
                                      fact.status ===
                                        "VERIFIED" && (
                                        <div
                                          className={
                                            styles.evidenceFreshnessBox
                                          }
                                        >
                                          <div
                                            className={
                                              styles.evidenceFreshnessHead
                                            }
                                          >
                                            <span>
                                              Evidence freshness
                                            </span>

                                            <strong
                                              className={`${styles.evidenceFreshnessBadge} ${
                                                fact.evidenceStatus ===
                                                "FRESH"
                                                  ? styles.evidenceFresh
                                                  : fact.evidenceStatus ===
                                                      "UNCHECKED"
                                                    ? styles.evidenceUnchecked
                                                    : fact.evidenceStatus ===
                                                        "DRIFTED"
                                                      ? styles.evidenceDrifted
                                                      : styles.evidenceUnavailable
                                              }`}
                                            >
                                              {
                                                fact.evidenceStatus
                                              }
                                            </strong>
                                          </div>

                                          <div
                                            className={
                                              styles.evidenceFreshnessMeta
                                            }
                                          >
                                            <div>
                                              <span>
                                                Last checked
                                              </span>

                                              <strong>
                                                {
                                                  fact.lastEvidenceCheckedAt
                                                    ? new Date(
                                                        fact.lastEvidenceCheckedAt
                                                      ).toLocaleString()
                                                    : "Never"
                                                }
                                              </strong>
                                            </div>

                                            <div>
                                              <span>
                                                Last seen
                                              </span>

                                              <strong>
                                                {
                                                  fact.lastEvidenceSeenAt
                                                    ? new Date(
                                                        fact.lastEvidenceSeenAt
                                                      ).toLocaleString()
                                                    : "Never"
                                                }
                                              </strong>
                                            </div>

                                            <div>
                                              <span>
                                                Evidence hash
                                              </span>

                                              <strong>
                                                {
                                                  fact.evidenceHash
                                                    ? fact.evidenceHash.slice(
                                                        0,
                                                        12
                                                      )
                                                    : "—"
                                                }
                                              </strong>
                                            </div>

                                            <div>
                                              <span>
                                                Source hash
                                              </span>

                                              <strong>
                                                {
                                                  fact.sourceContentHash
                                                    ? fact.sourceContentHash.slice(
                                                        0,
                                                        12
                                                      )
                                                    : "—"
                                                }
                                              </strong>
                                            </div>
                                          </div>

                                          {
                                            fact.evidenceCheckError && (
                                              <div
                                                className={
                                                  styles.evidenceFreshnessError
                                                }
                                              >
                                                {
                                                  fact.evidenceCheckError
                                                }
                                              </div>
                                            )
                                          }
                                        </div>
                                      )
                                    }

                                    <div
                                      className={
                                        styles.provenanceTitle
                                      }
                                    >
                                      <Database
                                        size={
                                          12
                                        }
                                      />

                                      Provenance
                                    </div>

                                    <div
                                      className={
                                        styles.provenanceGrid
                                      }
                                    >
                                      <div>
                                        <span>
                                          Origin
                                        </span>

                                        <strong>
                                          {
                                            provenance.origin
                                          }
                                        </strong>
                                      </div>

                                      <div>
                                        <span>
                                          Discovery
                                        </span>

                                        <strong>
                                          {
                                            provenance.discoveryVersion
                                          }
                                        </strong>
                                      </div>

                                      <div>
                                        <span>
                                          Model
                                        </span>

                                        <strong>
                                          {
                                            provenance.model
                                          }
                                        </strong>
                                      </div>

                                      <div>
                                        <span>
                                          Lineage
                                        </span>

                                        <strong>
                                          {
                                            provenance.lineage
                                          }
                                        </strong>
                                      </div>

                                      <div>
                                        <span>
                                          Atomic
                                        </span>

                                        <strong>
                                          {
                                            provenance.atomic
                                              ? "yes"
                                              : "not recorded"
                                          }
                                        </strong>
                                      </div>

                                      <div>
                                        <span>
                                          Created
                                        </span>

                                        <strong>
                                          {
                                            new Date(
                                              fact.createdAt
                                            ).toLocaleString()
                                          }
                                        </strong>
                                      </div>
                                    </div>

                                    <div
                                      className={
                                        styles.eventHistory
                                      }
                                    >
                                      <span
                                        className={
                                          styles.reviewLabel
                                        }
                                      >
                                        Event history
                                      </span>

                                      {
                                        fact.events.length >
                                          0 ? (
                                          fact.events
                                            .slice(
                                              0,
                                              8
                                            )
                                            .map(
                                              (
                                                event
                                              ) => (
                                                <div
                                                  key={
                                                    event.id
                                                  }
                                                  className={
                                                    styles.eventRow
                                                  }
                                                >
                                                  <strong>
                                                    {
                                                      event.action
                                                    }
                                                  </strong>

                                                  <span>
                                                    {
                                                      event.previousStatus ??
                                                      "—"
                                                    }
                                                    {" → "}
                                                    {
                                                      event.nextStatus ??
                                                      "—"
                                                    }
                                                  </span>

                                                  <time>
                                                    {
                                                      new Date(
                                                        event.createdAt
                                                      ).toLocaleString()
                                                    }
                                                  </time>
                                                </div>
                                              )
                                            )
                                        ) : (
                                          <div
                                            className={
                                              styles.reviewMissing
                                            }
                                          >
                                            No provenance events.
                                          </div>
                                        )
                                      }
                                    </div>
                                  </div>
                                )
                              }

                              {
                                fact.status ===
                                  "PROPOSED" && (
                                  <div
                                    className={
                                      styles.reviewActions
                                    }
                                  >
                                    <span>
                                      {
                                        canVerify
                                          ? "Source + evidence attached"
                                          : "Source URL and exact evidence required"
                                      }
                                    </span>

                                    <div
                                      className={
                                        styles.factActions
                                      }
                                    >
                                      <button
                                        type="button"
                                        disabled={
                                          busyFactId !==
                                          null
                                        }
                                        onClick={
                                          () =>
                                            void transitionFact(
                                              fact,
                                              "reject"
                                            )
                                        }
                                      >
                                        <X
                                          size={
                                            12
                                          }
                                        />

                                        Reject
                                      </button>

                                      <button
                                        type="button"
                                        disabled={
                                          !canVerify ||
                                          busyFactId !==
                                            null
                                        }
                                        title={
                                          canVerify
                                            ? "Verify grounded fact"
                                            : "Source URL and exact evidence are required"
                                        }
                                        onClick={
                                          () =>
                                            void transitionFact(
                                              fact,
                                              "verify"
                                            )
                                        }
                                      >
                                        <Check
                                          size={
                                            12
                                          }
                                        />

                                        Verify
                                      </button>
                                    </div>
                                  </div>
                                )
                              }
                            </article>
                          );
                        }
                      )
                  }
                </div>
              )
            }
          </div>

<div
          className={
            styles.panel
          }
        >
          <div
            className={
              styles.panelHeader
            }
          >
            <span>
              Evidence snapshots
            </span>

            <span>
              {
                briefs.length
              }{" "}
              briefs
            </span>
          </div>

          {
            briefs.length ===
            0 ? (
              <div
                className={
                  styles.empty
                }
              >
                No content briefs yet.
              </div>
            ) : (
              <div>
                {
                  briefs
                    .slice(
                      0,
                      12
                    )
                    .map(
                      (
                        brief
                      ) => {
                        const open =
                          openBriefId ===
                          brief.id;

                        const evidence =
                          evidenceCache[
                            brief.id
                          ];

                        const claims =
                          evidence
                            ? registryClaims(
                                evidence.businessFacts
                              )
                            : [];

                        const factIds =
                          evidence
                            ? registryFactIds(
                                evidence.businessFacts
                              )
                            : [];

                        const decision =
                          evidence
                            ? planDecision(
                                evidence.plan
                              )
                            : null;

                        return (
                          <div
                            key={
                              brief.id
                            }
                            className={
                              styles.evidenceRow
                            }
                          >
                            <button
                              type="button"
                              className={
                                styles.evidenceToggle
                              }
                              onClick={
                                () =>
                                  void toggleEvidence(
                                    brief.id
                                  )
                              }
                            >
                              <FileSearch
                                size={
                                  12
                                }
                              />

                              <div>
                                <strong>
                                  {
                                    brief.topic
                                  }
                                </strong>

                                <span>
                                  {
                                    brief.primaryKeyword
                                  }
                                  {" · "}
                                  {
                                    brief.searchIntent
                                  }
                                </span>
                              </div>

                              <ChevronDown
                                size={
                                  13
                                }
                                className={
                                  open
                                    ? styles.rotate
                                    : undefined
                                }
                              />
                            </button>

                            {
                              open && (
                                <div
                                  className={
                                    styles.evidenceDetails
                                  }
                                >
                                  {
                                    evidenceLoadingId ===
                                    brief.id ? (
                                      <span>
                                        Loading immutable snapshot…
                                      </span>
                                    ) : evidence ===
                                      null ? (
                                      <span
                                        className={
                                          styles.legacy
                                        }
                                      >
                                        Legacy brief — no immutable
                                        Evidence Snapshot exists.
                                      </span>
                                    ) : evidence ? (
                                      <>
                                        <div
                                          className={
                                            styles.evidenceMetrics
                                          }
                                        >
                                          <div>
                                            <span>
                                              Decision
                                            </span>

                                            <strong>
                                              {
                                                decision ||
                                                "—"
                                              }
                                            </strong>
                                          </div>

                                          <div>
                                            <span>
                                              Facts used
                                            </span>

                                            <strong>
                                              {
                                                factIds.length
                                              }
                                            </strong>
                                          </div>

                                          <div>
                                            <span>
                                              Planner
                                            </span>

                                            <strong>
                                              {
                                                evidence.plannerVersion
                                              }
                                            </strong>
                                          </div>

                                          <div>
                                            <span>
                                              Gate
                                            </span>

                                            <strong>
                                              {
                                                evidence.gateVersion
                                              }
                                            </strong>
                                          </div>

                                          <div>
                                            <span>
                                              Model
                                            </span>

                                            <strong>
                                              {
                                                evidence.generatorModel
                                              }
                                            </strong>
                                          </div>
                                        </div>

                                        <div
                                          className={
                                            styles.claimSnapshot
                                          }
                                        >
                                          <span>
                                            Verified claims frozen in snapshot
                                          </span>

                                          {
                                            claims.length >
                                            0 ? (
                                              claims.map(
                                                (
                                                  claim
                                                ) => (
                                                  <div
                                                    key={
                                                      claim
                                                    }
                                                  >
                                                    <Check
                                                      size={
                                                        11
                                                      }
                                                    />

                                                    {
                                                      claim
                                                    }
                                                  </div>
                                                )
                                              )
                                            ) : (
                                              <div>
                                                No verified product claims were
                                                available when this brief was
                                                created.
                                              </div>
                                            )
                                          }
                                        </div>
                                      </>
                                    ) : (
                                      <span>
                                        Open snapshot to load evidence.
                                      </span>
                                    )
                                  }
                                </div>
                              )
                            }
                          </div>
                        );
                      }
                    )
                }
              </div>
            )
          }
        </div>
      </div>
    </section>
  );
}
