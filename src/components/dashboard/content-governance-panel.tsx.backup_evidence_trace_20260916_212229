function registryClaims(
  value: unknown
): string[] {
  if (
    !value ||
    typeof value !== "object" ||
    Array.isArray(value)
  ) {
    return [];
  }

  const raw =
    value as Record<string, unknown>;

  if (
    !Array.isArray(
      raw.verifiedClaims
    )
  ) {
    return [];
  }

  return raw.verifiedClaims.filter(
    (value): value is string =>
      typeof value === "string"
  );
}


function registryFactIds(
  value: unknown
): string[] {
  if (
    !value ||
    typeof value !== "object" ||
    Array.isArray(value)
  ) {
    return [];
  }

  const raw =
    value as Record<string, unknown>;

  if (
    !Array.isArray(
      raw.factIds
    )
  ) {
    return [];
  }

  return raw.factIds.filter(
    (value): value is string =>
      typeof value === "string"
  );
}


function planDecision(
  value: unknown
): string | null {
  if (
    !value ||
    typeof value !== "object" ||
    Array.isArray(value)
  ) {
    return null;
  }

  const plan =
    value as Record<string, unknown>;

  const strategy =
    plan.strategy;

  if (
    !strategy ||
    typeof strategy !== "object" ||
    Array.isArray(strategy)
  ) {
    return null;
  }

  const action =
    (
      strategy as Record<
        string,
        unknown
      >
    ).action;

  if (
    !action ||
    typeof action !== "object" ||
    Array.isArray(action)
  ) {
    return null;
  }

  const type =
    (
      action as Record<
        string,
        unknown
      >
    ).type;

  return typeof type === "string"
    ? type
    : null;
}


function metadataRecord(
  value: unknown
): Record<string, unknown> | null {
  if (
    !value ||
    typeof value !== "object" ||
    Array.isArray(value)
  ) {
    return null;
  }

  return value as Record<string, unknown>;
}


function metadataText(
  value: unknown,
  key: string
): string | null {
  const raw =
    metadataRecord(
      value
    );

  const candidate =
    raw?.[key];

  return typeof candidate === "string"
    ? candidate
    : null;
}


function metadataBoolean(
  value: unknown,
  key: string
): boolean {
  const raw =
    metadataRecord(
      value
    );

  return raw?.[key] === true;
}


function formatSourceUrl(
  value: string | null
): string {
  if (!value) {
    return "No source URL";
  }

  try {
    const url =
      new URL(
        value
      );

    const path =
      url.pathname === "/"
        ? ""
        : url.pathname;

    return `${url.hostname}${path}`;
  } catch {
    return value;
  }
}


function factRiskFlags(
  fact: Pick<
    FactRow,
    "claim" |
    "evidence" |
    "type"
  >
): string[] {
  const text =
    `${fact.claim} ${fact.evidence ?? ""}`
      .toLowerCase();

  const flags: string[] =
    [];

  if (
    /password|k-anonym|plaintext|encrypt|security/i.test(
      text
    )
  ) {
    flags.push(
      "SECURITY"
    );
  }

  if (
    /\$|price|pricing|cost|per month|\/mo|free plan|pro plan|family plan/i.test(
      text
    )
  ) {
    flags.push(
      "PRICING"
    );
  }

  if (
    /guarantee|money back|refund/i.test(
      text
    )
  ) {
    flags.push(
      "GUARANTEE"
    );
  }

  if (
    /data retention|zero retention|retention/i.test(
      text
    )
  ) {
    flags.push(
      "RETENTION"
    );
  }

  if (
    /puppeteer|automatically|every hour|hourly|every month|re-verif/i.test(
      text
    )
  ) {
    flags.push(
      "AUTOMATION"
    );
  }

  if (
    /dark web|breach/i.test(
      text
    )
  ) {
    flags.push(
      "DARK_WEB"
    );
  }

  return [
    ...new Set(
      flags
    ),
  ];
}


function factProvenance(
  fact: FactRow
) {
  const origin =
    fact.events.find(
      (event) =>
        event.action ===
          "DISCOVERED" ||
        event.action ===
          "ATOMIC_SPLIT_CREATED" ||
        event.action ===
          "CREATED"
    ) ??
    fact.events[
      fact.events.length - 1
    ] ??
    null;

  const discoveryVersion =
    origin
      ? metadataText(
          origin.metadata,
          "discoveryVersion"
        )
      : null;

  const transformation =
    origin
      ? metadataText(
          origin.metadata,
          "transformation"
        )
      : null;

  const model =
    origin
      ? metadataText(
          origin.metadata,
          "model"
        )
      : null;

  const atomic =
    Boolean(
      fact.supersedesId
    ) ||
    origin?.action ===
      "ATOMIC_SPLIT_CREATED" ||
    (
      origin
        ? metadataBoolean(
            origin.metadata,
            "atomicValidation"
          )
        : false
    );

  return {
    origin:
      origin?.action ??
      "UNKNOWN",

    discoveryVersion:
      discoveryVersion ??
      transformation ??
      "—",

    model:
      model ??
      "—",

    atomic,

    lineage:
      fact.supersedesId
        ? `split from ${fact.supersedesId}`
        : "direct",
  };
}


export function ContentGovernancePanel({
  websiteId,
}: {
  websiteId: string;
}) {
  const [
    facts,
    setFacts,
  ] =
    useState<FactRow[]>([]);

  const [
    briefs,
    setBriefs,
  ] =
    useState<BriefRow[]>([]);

  const [
    loading,
    setLoading,
  ] =
    useState(true);

  const [
    error,
    setError,
  ] =
    useState<string | null>(
      null
    );

  const [
    showForm,
    setShowForm,
  ] =
    useState(false);

  const [
    busyFactId,
    setBusyFactId,
  ] =
    useState<string | null>(
      null
    );

  const [
    discovering,
    setDiscovering,
  ] =
    useState(
      false
    );

  const [
    discoveryResult,
    setDiscoveryResult,
  ] =
    useState<FactDiscoveryResult | null>(
      null
    );

  const [
    evidenceChecking,
    setEvidenceChecking,
  ] =
    useState(
      false
    );

  const [
    evidenceCheckResult,
    setEvidenceCheckResult,
  ] =
    useState<EvidenceCheckResult | null>(
      null
    );


  const [
    factFilter,
    setFactFilter,
  ] =
    useState<
      | "PROPOSED"
      | "VERIFIED"
      | "REJECTED"
      | "ARCHIVED"
    >(
      "PROPOSED"
    );

  const [
    openFactId,
    setOpenFactId,
  ] =
    useState<string | null>(
      null
    );

  const [
    openBriefId,
    setOpenBriefId,
  ] =
    useState<string | null>(
      null
    );

  const [
    evidenceLoadingId,
    setEvidenceLoadingId,
  ] =
    useState<string | null>(
      null
    );

  const [
    evidenceCache,
    setEvidenceCache,
  ] =
    useState<
      Record<
        string,
        EvidenceSnapshot | null
      >
    >({});

  const [
    form,
    setForm,
  ] =
    useState({
      type:
        "CAPABILITY",

      claim:
        "",

      sourceUrl:
        "",

      sourceLabel:
        "",

      evidence:
        "",

      confidence:
        "",
    });


  const load =
    useCallback(
      async () => {
        setLoading(
          true
        );

        setError(
          null
        );

        try {
          const [
            factsResponse,
            briefsResponse,
          ] =
            await Promise.all([
              fetch(
                `/api/content/facts?websiteId=${encodeURIComponent(
                  websiteId
                )}`,
                {
                  cache:
                    "no-store",
                }
              ),

              fetch(
                `/api/content/briefs?websiteId=${encodeURIComponent(
                  websiteId
                )}&limit=100`,
                {
                  cache:
                    "no-store",
                }
              ),
            ]);

          const factsJson =
            await factsResponse.json();

          const briefsJson =
            await briefsResponse.json();

          if (
            !factsResponse.ok
          ) {
            throw new Error(
              factsJson.error ||
                "Could not load Business Fact Registry."
            );
          }

          if (
            !briefsResponse.ok
          ) {
            throw new Error(
              briefsJson.error ||
                "Could not load content briefs."
            );
          }

          setFacts(
            Array.isArray(
              factsJson.items
            )
              ? factsJson.items
              : []
          );

          setBriefs(
            Array.isArray(
              briefsJson.items
            )
              ? briefsJson.items
              : []
          );
        } catch (err) {
          setError(
            err instanceof Error
              ? err.message
              : "Could not load content governance data."
          );
        } finally {
          setLoading(
            false
          );
        }
      },
      [
        websiteId,
      ]
    );


  useEffect(
    () => {
      void load();
    },
    [
      load,
    ]
  );


  const counts =
    useMemo(
      () => ({
        verified:
          facts.filter(
            (fact) =>
              fact.status ===
              "VERIFIED"
          ).length,

        proposed:
          facts.filter(
            (fact) =>
              fact.status ===
              "PROPOSED"
          ).length,

        rejected:
          facts.filter(
            (fact) =>
              fact.status ===
              "REJECTED"
          ).length,



        archived:


          facts.filter(


            (fact) =>


              fact.status ===


              "ARCHIVED"


          ).length,
      }),
      [
        facts,
      ]
    );


  const sortedFacts =
    useMemo(
      () => {
        const weight:
          Record<
            string,
            number
          > = {
            PROPOSED:
              0,

            VERIFIED:
              1,

            REJECTED:
              2,

            ARCHIVED:
              3,
          };

        return [
          ...facts,
        ].sort(
          (a, b) =>
            (
              weight[
                a.status
              ] ??
              9
            ) -
            (
              weight[
                b.status
              ] ??
              9
            )
        );
      },
      [
        facts,
      ]
    );


  const createFact =
    async () => {
      const claim =
        form.claim.trim();

      if (!claim) {
        setError(
          "Fact claim is required."
        );

        return;
      }

      setError(
        null
      );

      try {
        const confidence =
          form.confidence.trim()
            ? Number(
                form.confidence
              )
            : undefined;

        const response =
          await fetch(
            "/api/content/facts",
            {
              method:
                "POST",

              headers: {
                "Content-Type":
                  "application/json",
              },

              body:
                JSON.stringify({
                  websiteId,

                  type:
                    form.type,

                  claim,

                  sourceUrl:
                    form.sourceUrl.trim() ||
                    undefined,

                  sourceLabel:
                    form.sourceLabel.trim() ||
                    undefined,

                  evidence:
                    form.evidence.trim() ||
                    undefined,

                  confidence:
                    Number.isFinite(
                      confidence
                    )
                      ? confidence
                      : undefined,
                }),
            }
          );

        const data =
          await response.json();

        if (
          !response.ok
        ) {
          throw new Error(
            data.error ||
              "Could not create fact."
          );
        }

        setForm({
          type:
            "CAPABILITY",

          claim:
            "",

          sourceUrl:
            "",

          sourceLabel:
            "",

          evidence:
            "",

          confidence:
            "",
        });

        setShowForm(
          false
        );

        await load();
      } catch (err) {
        setError(
          err instanceof Error
            ? err.message
            : "Could not create fact."
        );
      }
    };


  const checkEvidenceFreshness =
    async () => {
      setEvidenceChecking(
        true
      );

      setEvidenceCheckResult(
        null
      );

      setError(
        null
      );

      try {
        const response =
          await fetch(
            "/api/content/facts/check-evidence",
            {
              method:
                "POST",

              headers: {
                "Content-Type":
                  "application/json",
              },

              body:
                JSON.stringify({
                  websiteId,
                }),
            }
          );

        const data =
          await response.json() as {
            result?: EvidenceCheckResult;
            error?: string;
          };

        if (
          !response.ok ||
          !data.result
        ) {
          throw new Error(
            data.error ||
              "Could not check evidence freshness."
          );
        }

        setEvidenceCheckResult(
          data.result
        );

        await load();
      } catch (err) {
        setError(
          err instanceof Error
            ? err.message
            : "Could not check evidence freshness."
        );
      } finally {
        setEvidenceChecking(
          false
        );
      }
    };


  const discoverFacts =
    async () => {
      setDiscovering(
        true
      );

      setDiscoveryResult(
        null
      );

      setError(
        null
      );

      try {
        const response =
          await fetch(
            "/api/content/facts/discover",
            {
              method:
                "POST",

              headers: {
                "Content-Type":
                  "application/json",
              },

              body:
                JSON.stringify({
                  websiteId,
                }),
            }
          );

        const data =
          await response.json();

        if (
          !response.ok
        ) {
          throw new Error(
            data.error ||
              "Could not discover business facts."
          );
        }

        setDiscoveryResult(
          data.result ??
            null
        );

        await load();
      } catch (err) {
        setError(
          err instanceof Error
            ? err.message
            : "Could not discover business facts."
        );
      } finally {
        setDiscovering(
          false
        );
      }
    };


  const transitionFact =
    async (
      fact:
        FactRow,
      action:
        "verify" |
        "reject"
    ) => {
      setBusyFactId(
        `${action}:${fact.id}`
      );

      setError(
        null
      );

      try {
        const response =
          await fetch(
            `/api/content/facts/${fact.id}/${action}`,
            {
              method:
                "POST",

              headers: {
                "Content-Type":
                  "application/json",
              },

              body:
                JSON.stringify({
                  websiteId,
                }),
            }
          );

        const data =
          await response.json();

        if (
          !response.ok
        ) {
          throw new Error(
            data.error ||
              `Could not ${action} fact.`
          );
        }

        await load();
      } catch (err) {
        setError(
          err instanceof Error
            ? err.message
            : `Could not ${action} fact.`
        );
      } finally {
        setBusyFactId(
          null
        );
      }
    };


  const toggleEvidence =
    async (
      briefId:
        string
    ) => {
      if (
        openBriefId ===
        briefId
      ) {
        setOpenBriefId(
          null
        );

        return;
      }

      setOpenBriefId(
        briefId
      );

      if (
        Object.prototype.hasOwnProperty.call(
          evidenceCache,
          briefId
        )
      ) {
        return;
      }

      setEvidenceLoadingId(
        briefId
      );

      setError(
        null
      );

      try {
        const response =
          await fetch(
            `/api/content/briefs/${briefId}/evidence`,
            {
              cache:
                "no-store",
            }
          );

        const data =
          await response.json();

        if (
          !response.ok
        ) {
          throw new Error(
            data.error ||
              "Could not load evidence snapshot."
          );
        }

        setEvidenceCache(
          (current) => ({
            ...current,

            [briefId]:
              data.evidence ??
              null,
          })
        );
      } catch (err) {
        setError(
          err instanceof Error
            ? err.message
            : "Could not load evidence snapshot."
        );
      } finally {
        setEvidenceLoadingId(
          null
        );
      }
    };


  return (
    <section
      className={
        styles.shell
      }
    >
      <div
        className={
          styles.header
        }
      >
        <div>
          <div
            className={
              styles.eyebrow
            }
          >
            <ShieldCheck
              size={
                13
              }
            />

            Content governance
          </div>

          <div
            className={
              styles.titleRow
            }
          >
            <h2>
              Fact registry
            </h2>

            <div
              className={
                styles.counts
              }
            >
              <span>
                <strong>
                  {
                    counts.verified
                  }
                </strong>{" "}
                verified
              </span>

              <span>
                <strong>
                  {
                    counts.proposed
                  }
                </strong>{" "}
                proposed
              </span>

              <span>
                <strong>
                  {
                    counts.rejected
                  }
                </strong>{" "}
                rejected
              </span>

              <span>
                <strong>
                  {
                    counts.archived
                  }
                </strong>{" "}
                archived
              </span>
            </div>
          </div>

          <p>
            Only verified product
            claims enter new
            evidence snapshots.
          </p>
        </div>

        <div
          className={
            styles.headerActions
          }
        >
          <button
            type="button"
            className={
              styles.secondaryButton
            }
            disabled={
              evidenceChecking
            }
            aria-busy={
              evidenceChecking
            }
            title="Re-fetch verified fact sources and validate exact evidence"
            onClick={
              () =>
                void checkEvidenceFreshness()
            }
          >
            <ShieldCheck
              size={
                12
              }
            />

            {
              evidenceChecking
                ? "Checking evidence…"
                : "Check evidence"
            }
          </button>

          <button
            type="button"
            className={
              styles.secondaryButton
            }
            disabled={
              discovering
            }
            onClick={
              () =>
                void discoverFacts()
            }
          >
            <FileSearch
              size={
                12
              }
            />

            {
              discovering
                ? "Discovering…"
                : "Discover facts"
            }
          </button>

          <button
          type="button"
          className={
            styles.primaryButton
          }
          onClick={
            () =>
              setShowForm(
                (value) =>
                  !value
              )
          }
        >
          {
            showForm
              ? (
                <X
                  size={
                    12
                  }
                />
              )
              : (
                <Plus
                  size={
                    12
                  }
                />
              )
          }

          {
            showForm
              ? "Cancel"
              : "Add fact"
          }
        </button>
        </div>
      </div>


      {
        error && (
          <div
            className={
              styles.error
            }
          >
            {
              error
            }
          </div>
        )
      }


      {
        evidenceCheckResult && (
          <div
            className={
              styles.evidenceCheckSummary
            }
          >
            <div>
              <span>
                Checked
              </span>

              <strong>
                {
                  evidenceCheckResult.checked
                }
              </strong>
            </div>

            <div>
              <span>
                Fresh
              </span>

              <strong
                className={
                  styles.evidenceSummaryFresh
                }
              >
                {
                  evidenceCheckResult.fresh
                }
              </strong>
            </div>

            <div>
              <span>
                Drifted
              </span>

              <strong
                className={
                  styles.evidenceSummaryDrifted
                }
              >
                {
                  evidenceCheckResult.drifted
                }
              </strong>
            </div>

            <div>
              <span>
                Unavailable
              </span>

              <strong
                className={
                  styles.evidenceSummaryUnavailable
                }
              >
                {
                  evidenceCheckResult.unavailable
                }
              </strong>
            </div>

            <div>
              <span>
                Sources fetched
              </span>

              <strong>
                {
                  evidenceCheckResult.sourceFetches
                }
              </strong>
            </div>
          </div>
        )
      }


      {
        discoveryResult && (
          <div
            className={
              styles.discoveryResult
            }
          >
            <div>
              <span>
                Crawled
