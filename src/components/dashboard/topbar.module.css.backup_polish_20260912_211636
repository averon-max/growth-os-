.topbar {
  position: sticky;
  z-index: 40;

  top: 0;

  height: 50px;
  min-height: 50px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 0 24px;

  border-bottom: 1px solid rgba(255,255,255,.055);

  background: rgba(18,19,21,.82);

  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

.titleBlock {
  min-width: 0;

  display: flex;
  align-items: center;
  gap: 8px;
}

.contextDot,
.pageDot {
  width: 7px;
  height: 7px;

  flex: 0 0 auto;

  border: 1px solid #6a6d74;
  border-radius: 50%;
}

.title {
  margin: 0;

  color: #dedfe1;

  font-size: 13px;
  font-weight: 570;

  letter-spacing: -.012em;
}

.separator {
  color: #474a50;

  font-size: 12px;
}

.subtitle {
  max-width: 420px;

  margin: 0;

  overflow: hidden;

  color: #6b6f76;

  font-size: 11px;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.right {
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 9px;
}

.websiteControl {
  min-width: 0;
}

.websiteSwitcher {
  max-width: 310px;
  height: 30px;

  padding: 0 30px 0 10px;

  outline: 0;

  border: 1px solid rgba(255,255,255,.065);
  border-radius: 6px;

  background: rgba(255,255,255,.018);
  color: #a6a9af;

  box-shadow: none;

  font-size: 10px;
}

.websiteSwitcher:hover {
  border-color: rgba(255,255,255,.11);

  background: rgba(255,255,255,.03);
}

.websiteSwitcher:focus {
  border-color: rgba(94,106,210,.35);

  box-shadow:
    0 0 0 3px rgba(94,106,210,.045);
}

.userEmail {
  display: none;
}

.avatar {
  width: 26px;
  height: 26px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(255,255,255,.07);
  border-radius: 50%;

  background:
    radial-gradient(
      circle at 38% 28%,
      #26282c,
      #161719 65%
    );

  color: #878a91;

  font-size: 9px;
  font-weight: 600;
}
