.container {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 16px;
  background: var(--surface);
}

.header { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 14px; }
.icon { color: var(--accent); margin-top: 2px; flex-shrink: 0; }
.title { font-size: 0.85rem; font-weight: 600; color: var(--primary); }
.subtitle { font-size: 0.75rem; color: var(--secondary); margin-top: 2px; }

.searchRow { display: flex; gap: 8px; margin-bottom: 12px; }

.searchBox {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--elevated);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 0 10px;
}
.searchIcon { color: var(--secondary); flex-shrink: 0; }
.searchInput {
  background: transparent;
  border: none;
  outline: none;
  color: var(--primary);
  font-size: 0.78rem;
  padding: 8px 0;
  width: 100%;
}
.searchInput::placeholder { color: var(--muted); }

.exploreButton {
  background: var(--accent);
  color: #0b0c0e;
  border: none;
  border-radius: 6px;
  padding: 0 16px;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
}
.exploreButton:disabled { opacity: 0.5; cursor: not-allowed; }

.error { font-size: 0.78rem; color: var(--danger); margin: 8px 0; }
.empty { font-size: 0.78rem; color: var(--secondary); margin: 8px 0; }

.resultCount { font-size: 0.72rem; color: var(--secondary); margin-bottom: 8px; }

.clickableRow { cursor: pointer; }
.clickableRow:hover { background: var(--elevated); }

.trendBadge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.72rem;
  font-family: var(--font-mono);
  padding: 2px 6px;
  border-radius: 4px;
}
.trendUp { color: var(--success); background: color-mix(in srgb, var(--success) 15%, transparent); }
.trendDown { color: var(--danger); background: color-mix(in srgb, var(--danger) 15%, transparent); }
.trendFlat { color: var(--muted); background: var(--elevated); }

.difficultyBadge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 0.72rem;
  font-weight: 600;
}
.difficultyBadge[data-tone="success"] { color: var(--success); background: color-mix(in srgb, var(--success) 15%, transparent); }
.difficultyBadge[data-tone="warning"] { color: var(--warning); background: color-mix(in srgb, var(--warning) 15%, transparent); }
.difficultyBadge[data-tone="danger"] { color: var(--danger); background: color-mix(in srgb, var(--danger) 15%, transparent); }
.difficultyBadge[data-tone="muted"] { color: var(--muted); background: var(--elevated); }

.rateLimitError { font-size: 0.78rem; color: var(--warning); margin: 8px 0; }

.sourceBadge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.68rem;
  font-family: var(--font-mono);
  padding: 1px 6px;
  border-radius: 4px;
  margin-left: 8px;
}
.sourceCache { color: var(--success); background: color-mix(in srgb, var(--success) 15%, transparent); }
.sourceFresh { color: var(--secondary); background: var(--elevated); }

.trendingBlock {
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 10px 12px;
  margin-bottom: 12px;
  background: var(--elevated);
}
.trendingHeader {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 8px;
}
.trendingIcon { color: var(--danger); }
.freeBadge {
  font-size: 0.65rem;
  font-weight: 500;
  color: var(--success);
  background: color-mix(in srgb, var(--success) 15%, transparent);
  padding: 1px 6px;
  border-radius: 4px;
  margin-left: 4px;
}
.trendingChips { display: flex; flex-wrap: wrap; gap: 5px; }
.chip {
  font-size: 0.72rem;
  color: var(--secondary);
  background: var(--surface);
  border: 1px solid var(--border);
  padding: 3px 8px;
  border-radius: 8px;
}
.chipRising { color: var(--secondary); border-color: var(--border); } .chipRising::before { content: ""; display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: var(--danger); margin-right: 5px; }
