.topbar {
  position: sticky;
  z-index: 15;
  top: 0;

  height: 48px;
  min-height: 48px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 18px;

  padding: 0 18px;

  border-bottom: 1px solid rgba(255,255,255,.052);

  background: rgba(16,17,19,.88);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.titleBlock {
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 7px;
}

.pageDot {
  width: 6px;
  height: 6px;

  flex: 0 0 auto;

  border: 1px solid #6b6e75;
  border-radius: 50%;

  background: transparent;
}

.title {
  margin: 0;

  color: #dedee0;

  font-size: 12px;
  font-weight: 570;
  line-height: 1;

  letter-spacing: -.01em;
}

.separator {
  color: #484a50;
  font-size: 11px;
}

.subtitle {
  max-width: 400px;

  margin: 0;

  overflow: hidden;

  color: #65676e;

  font-size: 10px;
  line-height: 1;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.right {
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 9px;
}

.websiteControl {
  min-width: 0;
}

.websiteControl :global(select) {
  width: auto;
  max-width: 330px;
  height: 29px;

  padding: 0 28px 0 9px;

  border: 1px solid rgba(255,255,255,.065) !important;
  border-radius: 6px !important;

  outline: none !important;

  background-color: #151619 !important;
  color: #b8b9be !important;

  box-shadow: none !important;

  font-size: 10px !important;
}

.websiteControl :global(select:hover) {
  border-color: rgba(255,255,255,.10) !important;
  background-color: #17181b !important;
}

.websiteControl :global(select:focus),
.websiteControl :global(select:focus-visible) {
  border-color: rgba(255,255,255,.12) !important;
  outline: none !important;
  box-shadow: none !important;
}

.websiteControl :global(button) {
  min-height: 29px;

  border-color: rgba(255,255,255,.065) !important;
  border-radius: 6px !important;

  background: #151619 !important;
  color: #b8b9be !important;

  box-shadow: none !important;

  font-size: 10px !important;
}

.avatar {
  width: 24px;
  height: 24px;

  display: grid;
  place-items: center;

  flex: 0 0 auto;

  border: 1px solid rgba(255,255,255,.075);
  border-radius: 50%;

  background: #18191c;
  color: #777980;

  font-size: 9px;
  font-weight: 600;
}
