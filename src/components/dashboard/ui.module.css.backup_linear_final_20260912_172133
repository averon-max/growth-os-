.pageBody {
  width: 100%;
  max-width: 1480px;

  margin: 0 auto;
  padding: 34px 38px 84px;
}

.pageHeader {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 24px;

  margin-bottom: 26px;
}

.pageTitle {
  margin: 0;

  color: #ededee;

  font-size: 23px;
  font-weight: 590;

  letter-spacing: -.04em;
}

.pageSubtitle {
  margin: 6px 0 0;

  color: #7b7f87;

  font-size: 12px;
}

.sectionTitle {
  margin: 30px 0 10px;

  color: #95989f;

  font-size: 12px;
  font-weight: 570;
}

.workspaceSurface {
  position: relative;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 12px;

  background:
    radial-gradient(
      600px 220px at 22% -120px,
      rgba(128,134,159,.06),
      transparent 70%
    ),
    linear-gradient(
      180deg,
      rgba(255,255,255,.018),
      rgba(255,255,255,.004)
    ),
    var(--surface);

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.018),
    0 18px 55px rgba(0,0,0,.10);
}

.statGrid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));

  margin-bottom: 18px;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 12px;

  background:
    radial-gradient(
      520px 160px at 16% -70px,
      rgba(121,126,152,.055),
      transparent 70%
    ),
    linear-gradient(
      180deg,
      rgba(255,255,255,.018),
      rgba(255,255,255,.004)
    ),
    var(--surface);

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.018),
    0 18px 50px rgba(0,0,0,.09);
}

.statCard {
  min-height: 108px;

  padding: 20px 20px;

  border: 0 !important;

  background: transparent;
}

.statCard + .statCard {
  border-left: 1px solid var(--border) !important;
}

.statHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  margin-bottom: 15px;
}

.statLabel {
  margin: 0;

  color: #787c84;

  font-size: 10px;
  font-weight: 620;

  letter-spacing: .055em;
  text-transform: uppercase;
}

.statAccent {
  width: 6px;
  height: 6px;

  flex: 0 0 auto;

  border-radius: 50%;

  box-shadow:
    0 0 10px currentColor;
}

.statValue {
  margin: 0;

  color: #ededee;

  font-size: 28px;
  line-height: 1;

  font-weight: 570;

  letter-spacing: -.045em;
}

.group {
  position: relative;

  margin-top: 18px;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 12px;

  background:
    radial-gradient(
      640px 240px at 25% -150px,
      rgba(123,128,151,.052),
      transparent 70%
    ),
    linear-gradient(
      180deg,
      rgba(255,255,255,.014),
      rgba(255,255,255,.003)
    ),
    var(--surface);

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.016),
    0 18px 54px rgba(0,0,0,.08);
}

.groupHeader {
  min-height: 47px;

  display: flex;
  align-items: center;
  gap: 9px;

  padding: 0 16px;

  border-bottom: 1px solid var(--border);

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.012),
      transparent
    );
}

.groupLabel {
  color: #b9bbc0;

  font-size: 12px;
  font-weight: 570;
}

.groupCount {
  color: #656971;

  font-family: var(--font-mono);
  font-size: 10px;
}

.groupHeaderAction {
  margin-left: auto;

  color: #858990;

  font-size: 11px;

  text-decoration: none;
}

.groupHeaderAction:hover {
  color: #d0d1d4;
}

.issueRow {
  min-height: 62px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 10px 16px;

  border-bottom: 1px solid rgba(255,255,255,.041);

  transition:
    background .12s ease,
    box-shadow .12s ease;
}

.issueRow:last-child {
  border-bottom: 0;
}

.issueRow:hover {
  background:
    linear-gradient(
      90deg,
      rgba(255,255,255,.022),
      rgba(255,255,255,.008)
    );
}

.issueMain {
  min-width: 0;

  display: flex;
  align-items: flex-start;

  gap: 11px;
}

.issueDot {
  width: 8px;
  height: 8px;

  flex: 0 0 auto;

  margin-top: 5px;

  border: 1px solid #5f636b;
  border-radius: 50%;
}

.issueDot[data-tone="success"] {
  border-color: var(--success);
  background: rgba(85,184,117,.12);

  box-shadow:
    0 0 9px rgba(85,184,117,.12);
}

.issueDot[data-tone="warning"] {
  border-color: var(--warning);
  background: rgba(208,173,71,.12);
}

.issueDot[data-tone="danger"] {
  border-color: var(--danger);
  background: rgba(217,108,118,.12);
}

.issueDot[data-tone="accent"] {
  border-color: #817ce5;
  background: rgba(112,110,224,.18);
}

.issueDot[data-tone="muted"] {
  border-color: #53575e;
}

.issueTitle {
  overflow: hidden;

  color: #d9dadd;

  font-size: 13px;
  line-height: 1.4;

  font-weight: 480;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.issueDesc {
  max-width: 850px;

  margin-top: 3px;

  overflow: hidden;

  color: #747880;

  font-size: 11px;
  line-height: 1.5;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.issueMeta {
  flex: 0 0 auto;

  color: #777b83;

  font-size: 11px;

  text-align: right;
}

.link {
  color: #93969d;

  text-decoration: none;

  transition: color .12s ease;
}

.link:hover {
  color: #e0e0e2;
}

.awaitingLabel {
  color: #696d75;

  font-size: 11px;
}

.mono {
  font-family: var(--font-mono);

  font-feature-settings: "tnum" 1;
}

.truncate {
  max-width: 360px;

  display: block;
  overflow: hidden;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.badge {
  min-height: 20px;

  display: inline-flex;
  align-items: center;

  padding: 0 7px;

  border: 1px solid rgba(255,255,255,.065);
  border-radius: 5px;

  background: rgba(255,255,255,.022);

  color: #7f8289;

  font-size: 10px;
  font-weight: 560;
}

.badgeDanger {
  color: #d87881;
  border-color: rgba(217,108,118,.15);
  background: rgba(217,108,118,.055);
}

.badgeWarning {
  color: #ccb052;
  border-color: rgba(208,173,71,.15);
  background: rgba(208,173,71,.055);
}

.badgeAccent {
  color: #9994eb;
  border-color: rgba(112,110,224,.17);
  background: rgba(112,110,224,.065);
}

.badgeMuted {
  color: #767a82;
}

.badgeSuccess {
  color: #70c28a;
  border-color: rgba(85,184,117,.15);
  background: rgba(85,184,117,.055);
}

.table {
  width: 100%;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 11px;

  border-collapse: separate;
  border-spacing: 0;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.012),
      rgba(255,255,255,.002)
    ),
    var(--surface);

  box-shadow:
    0 16px 45px rgba(0,0,0,.07);
}

.table th {
  height: 39px;

  padding: 0 13px;

  border-bottom: 1px solid var(--border);

  color: #797d85;

  font-size: 10px;
  font-weight: 580;

  text-align: left;
  white-space: nowrap;
}

.table td {
  height: 47px;

  padding: 7px 13px;

  border-bottom: 1px solid rgba(255,255,255,.038);

  color: #cfd0d3;

  font-size: 12px;
}

.table tbody tr:last-child td {
  border-bottom: 0;
}

.table tbody tr {
  transition: background .11s ease;
}

.table tbody tr:hover {
  background: rgba(255,255,255,.019);
}

.group .table {
  border: 0;
  border-radius: 0;

  box-shadow: none;
}

.emptyState {
  min-height: 310px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 46px;

  text-align: center;
}

.emptyIconWrap {
  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  margin-bottom: 14px;

  border: 1px solid var(--border);
  border-radius: 9px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.035),
      rgba(255,255,255,.008)
    ),
    var(--surface-2);

  color: #918bea;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.025),
    0 12px 32px rgba(0,0,0,.14);
}

.emptyTitle {
  margin: 0 0 6px;

  color: #dedee1;

  font-size: 14px;
  font-weight: 580;
}

.emptyDescription {
  max-width: 450px;

  margin: 0;

  color: #747880;

  font-size: 12px;
  line-height: 1.58;
}

.emptyAction {
  min-height: 32px;

  display: inline-flex;
  align-items: center;

  margin-top: 17px;
  padding: 0 13px;

  border: 1px solid rgba(255,255,255,.09);
  border-radius: 7px;

  background: #e4e4e5;
  color: #151618;

  font-size: 11px;
  font-weight: 620;

  text-decoration: none;

  box-shadow:
    0 4px 14px rgba(0,0,0,.16);
}

.emptyAction:hover {
  background: #f0f0f1;
}

.card,
.formCard,
.progressCard,
.errorCard,
.scoreCard {
  border: 1px solid var(--border);
  border-radius: 11px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.015),
      rgba(255,255,255,.002)
    ),
    var(--surface);

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.015),
    0 16px 44px rgba(0,0,0,.08);
}

.card {
  padding: 18px;
}

.formGroup {
  display: grid;
  gap: 7px;

  margin-bottom: 15px;
}

.formLabel {
  color: #8a8e96;

  font-size: 11px;
  font-weight: 560;
}

.formInput {
  width: 100%;
  height: 36px;

  padding: 0 11px;

  outline: none;

  border: 1px solid var(--border);
  border-radius: 7px;

  background:
    rgba(7,8,9,.5);

  color: #e2e2e4;

  font-size: 12px;
}

.formInput:focus {
  border-color: rgba(112,110,224,.38);

  box-shadow:
    0 0 0 3px rgba(112,110,224,.055);
}

.formError {
  color: #d57079;

  font-size: 11px;
}

.primaryButton {
  min-height: 32px;

  padding: 0 13px;

  border: 1px solid rgba(255,255,255,.08);
  border-radius: 7px;

  background:
    linear-gradient(
      180deg,
      #7472df,
      #6463ca
    );

  color: white;

  font-size: 11px;
  font-weight: 620;

  cursor: pointer;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.12),
    0 5px 16px rgba(55,52,130,.16);
}

.primaryButton:hover {
  filter: brightness(1.07);
}

.backLink {
  color: #7f838b;

  font-size: 11px;

  text-decoration: none;
}

.backLink:hover {
  color: #cfd0d4;
}

.scoreGrid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));

  gap: 10px;
}

.scoreCard {
  padding: 18px;
}

.scoreValue {
  margin: 0;

  color: #e7e7e9;

  font-family: var(--font-mono);

  font-size: 27px;
  font-weight: 570;
}

.scoreLabel {
  margin: 7px 0 0;

  color: #71757d;

  font-size: 10px;

  letter-spacing: .05em;
  text-transform: uppercase;
}

.progressTitle,
.errorTitle {
  margin: 0;

  color: #dedee1;

  font-size: 14px;
  font-weight: 570;
}

.progressStep {
  min-height: 34px;

  display: flex;
  align-items: center;
  gap: 9px;

  color: #747880;

  font-size: 11px;
}

.progressDot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #7773da;

  box-shadow:
    0 0 9px rgba(119,115,218,.17);
}

.progressStepLabel {
  color: #83878f;
}

.progressHint,
.errorDesc {
  margin: 7px 0 0;

  color: #70747c;

  font-size: 11px;
  line-height: 1.55;
}

@media (max-width: 900px) {
  .pageBody {
    padding: 24px 20px 64px;
  }

  .statGrid,
  .scoreGrid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

@media (max-width: 600px) {
  .statGrid,
  .scoreGrid {
    grid-template-columns: 1fr;
  }

  .statCard + .statCard {
    border-left: 0 !important;
    border-top: 1px solid var(--border) !important;
  }

  .issueRow {
    align-items: flex-start;
    flex-direction: column;
  }

  .issueMeta {
    width: 100%;
    text-align: left;
  }
}
