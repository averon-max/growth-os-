// ── Formatters ────────────────────────────────────────────────────────────────
function fmtVol(v: number | null): string {
  if (v === null || !Number.isFinite(v)) return "—";
  if (v >= 10_000_000) return `${(v / 1_000_000).toFixed(1)}M`;
  if (v >= 1_000_000) return `${(v / 1_000_000).toFixed(1)}M`;
  if (v >= 100_000) return `${Math.round(v / 1_000)}K`;
  if (v >= 10_000) return `${Math.round(v / 1_000)}K`;
  if (v >= 1_000) return `${(v / 1_000).toFixed(1)}K`;
  return v.toLocaleString("en-US");
}
function fmtCpc(v: string | number | null): string {
  if (v === null || v === undefined) return "—";
  const n = Number(v);
  if (!Number.isFinite(n) || n === 0) return "—";
  return `$${n.toFixed(2)}`;
}
function fmtImpr(v: number | null): string {
  if (v === null) return "—";
  if (v >= 1_000_000) return `${(v / 1_000_000).toFixed(1)}M`;
  if (v >= 1_000) return `${Math.round(v / 1_000)}K`;
  return String(v);
}

// ── Metric context labels ─────────────────────────────────────────────────────
function kdLabel(kd: number | null): { label: string; desc: string; color: string } {
  if (kd === null) return { label: "—", desc: "No data", color: "var(--secondary)" };
  if (kd < 30) return { label: "Easy", desc: "Low competition", color: "var(--success)" };
  if (kd < 50) return { label: "Possible", desc: "Moderate competition", color: "#60a5fa" };
  if (kd < 70) return { label: "Difficult", desc: "High competition", color: "var(--warning)" };
  return { label: "Hard", desc: "Very high competition", color: "var(--danger)" };
}
function volLabel(v: number | null): string {
  if (v === null || !Number.isFinite(v)) return "";
  if (v >= 100_000) return "Very high";
  if (v >= 10_000) return "High";
  if (v >= 1_000) return "Medium";
  if (v >= 100) return "Low";
  return "Very low";
}
function cpcLabel(v: string | number | null): string {
  if (v === null || v === undefined) return "";
  const n = Number(v);
  if (!Number.isFinite(n) || n === 0) return "";
  if (n >= 10) return "Very high value";
  if (n >= 4) return "Strong value";
  if (n >= 1) return "Moderate value";
  return "Low value";
}
function compLabel(ci: number | null): string {
  if (ci === null) return "—";
  if (ci >= 80) return "Very High";
  if (ci >= 50) return "High";
  if (ci >= 20) return "Medium";
  return "Low";
}
function positionTone(p: number | null): "success" | "warning" | "muted" {
  if (p === null) return "muted";
  if (p < 4) return "success";
  if (p <= 10) return "warning";
  return "muted";
}

// ── Opportunity ───────────────────────────────────────────────────────────────
function oppScore(vol: number | null, kd: number | null): number | null {
  if (vol === null || kd === null) return null;
  const v = Math.min(vol / 100_000, 1) * 60;
  const d = ((100 - Math.min(kd, 100)) / 100) * 40;
  return Math.round(v + d);
}
function oppDecision(vol: number | null, kd: number | null): { action: string; reason: string; color: string } | null {
  if (vol === null || kd === null) return null;
  const highVol = vol >= 1_000;
  const lowKd = kd < 40;
  const midKd = kd < 70;
  if (highVol && lowKd) return { action: "Prioritize", reason: "High demand + manageable difficulty", color: "var(--success)" };
  if (highVol && midKd) return { action: "Long-term", reason: "High demand but competitive", color: "#60a5fa" };
  if (highVol && !midKd) return { action: "Hard target", reason: "High demand but very difficult", color: "var(--warning)" };
  if (!highVol && lowKd) return { action: "Niche", reason: "Low volume but easy win", color: "var(--accent)" };
  return { action: "Low priority", reason: "Low demand and high difficulty", color: "var(--secondary)" };
}

// ── Sort icon ─────────────────────────────────────────────────────────────────
function SortIcon({ field, sortBy, sortDir }: { field: SortField; sortBy: SortField; sortDir: SortDir }) {
  if (sortBy !== field) return <ChevronsUpDown size={11} style={{ opacity: 0.3, marginLeft: 2, verticalAlign: "middle" }} />;
  return sortDir === "asc"
    ? <ChevronUp size={11} style={{ marginLeft: 2, color: "var(--accent)", verticalAlign: "middle" }} />
    : <ChevronDown size={11} style={{ marginLeft: 2, color: "var(--accent)", verticalAlign: "middle" }} />;
}

// ── Metric cell ───────────────────────────────────────────────────────────────
