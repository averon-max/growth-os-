"use client";

import {
  useEffect,
  useState,
} from "react";

import styles from "./keyword-opportunity-diagnosis.module.css";

type Diagnosis = {
  keyword: string;
  market: string;
  domain: string;
  liveRank: number | null;
  rankingStatus:
    | "RANKING"
    | "NOT_TOP_100";

  ownPage: {
    url: string;
    title: string | null;
    h1: string | null;
    wordCount: number | null;
    relevanceScore: number | null;
    inboundInternalLinks: number | null;
  } | null;

  competitors: Array<{
    rank: number;
    domain: string;
    url: string;
    title: string;
    fetched: boolean;
    h1: string | null;
    wordCount: number | null;
  }>;

  serpPattern: string;

  topicGaps: Array<{
    topic: string;
    competitorCoverage: number;
    evidence: string[];
  }>;

  observedCompetitorMedianWordCount:
    number | null;

  findings: Array<{
    code: string;
    severity:
      | "HIGH"
      | "MEDIUM"
      | "INFO";
    title: string;
    explanation: string;
    evidence: string[];
  }>;

  actions: Array<{
    type: string;
    title: string;
    explanation: string;
    evidence: string[];
  }>;

  ownPagesInspected: number;
  competitorPagesFetched: number;
  observedAt: string;
  limitations: string[];
};

function severityClass(
  severity:
    | "HIGH"
    | "MEDIUM"
    | "INFO"
): string {
  if (
    severity ===
    "HIGH"
  ) {
    return styles.high;
  }

  if (
    severity ===
    "MEDIUM"
  ) {
    return styles.medium;
  }

  return styles.info;
}

export function KeywordOpportunityDiagnosis({
  websiteId,
  keyword,
  market,
  onClose,
}: {
  websiteId: string;
  keyword: string;
  market: string;
  onClose: () => void;
}) {
  const [
    diagnosis,
    setDiagnosis,
  ] =
    useState<Diagnosis | null>(
      null
    );

  const [
    loading,
    setLoading,
  ] =
    useState(
      true
    );

  const [
    error,
    setError,
  ] =
    useState<string | null>(
      null
    );

  useEffect(
    () => {
      let active =
        true;

      const load =
        async () => {
          setLoading(
            true
          );

          setError(
            null
          );

          try {
            const params =
              new URLSearchParams({
                websiteId,
                keyword,
                market,
              });

            const response =
              await fetch(
                `/api/keywords/opportunity-diagnosis?${params.toString()}`,
                {
                  cache:
                    "no-store",
                }
              );

            const data =
              await response.json() as {
                diagnosis?: Diagnosis;
                error?: string;
              };

            if (
              !response.ok ||
              !data.diagnosis
            ) {
              throw new Error(
                data.error ??
                  "Не удалось проанализировать возможность."
              );
            }

            if (
              active
            ) {
              setDiagnosis(
                data.diagnosis
              );
            }
          } catch (
            err
          ) {
            if (
              active
            ) {
              setError(
                err instanceof Error
                  ? err.message
                  : "Не удалось проанализировать возможность."
              );
            }
          } finally {
            if (
              active
            ) {
              setLoading(
                false
              );
            }
          }
        };

      void load();

      return () => {
        active =
          false;
      };
    },
    [
      websiteId,
      keyword,
      market,
    ]
  );

  return (
    <div
      className={
        styles.panel
      }
    >
      <div
        className={
          styles.header
        }
      >
        <div>
          <p
            className={
              styles.eyebrow
            }
          >
            Opportunity diagnosis
          </p>

          <h3
            className={
              styles.title
            }
          >
            Что мешает расти по «{keyword}»
          </h3>

          <p
            className={
              styles.subtitle
            }
          >
            Сравниваем ваш сайт с реальными страницами из верхних результатов.
            Это анализ наблюдаемых различий, а не обещание конкретной позиции.
          </p>
        </div>

        <button
          type="button"
          className={
            styles.close
          }
          onClick={
            onClose
          }
        >
          Закрыть
        </button>
      </div>

      {
        loading ? (
          <div
            className={
              styles.state
            }
          >
            Проверяем ваш сайт и страницы конкурентов…
          </div>
        ) : error ? (
          <div
            className={`${styles.state} ${styles.error}`}
          >
            {error}
          </div>
        ) : diagnosis ? (
          <>
            <div
              className={
                styles.meta
              }
            >
              <div
                className={
                  styles.metaItem
                }
              >
                <strong
                  className={
                    styles.metaValue
                  }
                >
                  {
                    diagnosis.liveRank ===
                    null
                      ? "Не в Top 100"
                      : `#${diagnosis.liveRank}`
                  }
                </strong>

                <span
                  className={
                    styles.metaLabel
                  }
                >
                  текущее место
                </span>
              </div>

              <div
                className={
                  styles.metaItem
                }
              >
                <strong
                  className={
                    styles.metaValue
                  }
                >
                  {
                    diagnosis.ownPagesInspected
                  }
                </strong>

                <span
                  className={
                    styles.metaLabel
                  }
                >
                  ваших страниц проверено
                </span>
              </div>

              <div
                className={
                  styles.metaItem
                }
              >
                <strong
                  className={
                    styles.metaValue
                  }
                >
                  {
                    diagnosis.competitorPagesFetched
                  }/{diagnosis.competitors.length}
                </strong>

                <span
                  className={
                    styles.metaLabel
                  }
                >
                  страниц конкурентов прочитано
                </span>
              </div>
            </div>

            <div
              className={
                styles.grid
              }
            >
              <div
                className={
                  styles.column
                }
              >
                <h4
                  className={
                    styles.sectionTitle
                  }
                >
                  Что мы нашли
                </h4>

                <div
                  className={
                    styles.pageCard
                  }
                >
                  <div
                    className={
                      styles.itemTitle
                    }
                  >
                    Лучшая подходящая страница на вашем сайте
                  </div>

                  {
                    diagnosis.ownPage ? (
                      <>
                        <div
                          className={
                            styles.body
                          }
                        >
                          Совпадение с темой:{" "}
                          {
                            diagnosis.ownPage.relevanceScore ===
                            null
                              ? "—"
                              : `${Math.round(
                                  diagnosis.ownPage.relevanceScore *
                                    100
                                )}%`
                          }
                        </div>

                        <span
                          className={
                            styles.url
                          }
                          title={
                            diagnosis.ownPage.url
                          }
                        >
                          {
                            diagnosis.ownPage.url
                          }
                        </span>
                      </>
                    ) : (
                      <div
                        className={
                          styles.body
                        }
                      >
                        Не удалось найти страницу, которая ясно отвечает этому поиску.
                      </div>
                    )
                  }
                </div>

                <div
                  className={
                    styles.pageCard
                  }
                >
                  <div
                    className={
                      styles.itemTitle
                    }
                  >
                    Как выглядит верх выдачи
                  </div>

                  <div
                    className={
                      styles.body
                    }
                  >
                    {
                      diagnosis.serpPattern
                    }
                  </div>
                </div>

                {
                  diagnosis.findings.map(
                    (
                      finding
                    ) => (
                      <div
                        key={
                          finding.code
                        }
                        className={
                          styles.finding
                        }
                      >
                        <div
                          className={`${styles.itemTitle} ${severityClass(
                            finding.severity
                          )}`}
                        >
                          {
                            finding.title
                          }
                        </div>

                        <div
                          className={
                            styles.body
                          }
                        >
                          {
                            finding.explanation
                          }
                        </div>

                        <div
                          className={
                            styles.evidence
                          }
                        >
                          {
                            finding.evidence.map(
                              (
                                evidence
                              ) => (
                                <div
                                  key={
                                    evidence
                                  }
                                  className={
                                    styles.evidenceItem
                                  }
                                >
                                  • {evidence}
                                </div>
                              )
                            )
                          }
                        </div>
                      </div>
                    )
                  )
                }

                <h4
                  className={
                    styles.sectionTitle
                  }
                  style={{
                    marginTop:
                      16,
                  }}
                >
                  Реальные конкуренты
                </h4>

                {
                  diagnosis.competitors.map(
                    (
                      competitor
                    ) => (
                      <div
                        key={`${competitor.rank}-${competitor.url}`}
                        className={
                          styles.competitor
                        }
                      >
                        <div
                          className={
                            styles.itemTitle
                          }
                        >
                          #{competitor.rank}{" "}
                          {competitor.domain}
                        </div>

                        <div
                          className={
                            styles.body
                          }
                        >
                          {
                            competitor.title
                          }
                        </div>

                        <div
                          className={
                            styles.evidence
                          }
                        >
                          Страница прочитана:{" "}
                          {
                            competitor.fetched
                              ? "да"
                              : "нет — используем только SERP evidence"
                          }
                        </div>
                      </div>
                    )
                  )
                }
              </div>

              <div
                className={
                  styles.column
                }
              >
                <h4
                  className={
                    styles.sectionTitle
                  }
                >
                  Что Growth OS предлагает сделать
                </h4>

                {
                  diagnosis.actions.map(
                    (
                      action,
                      index
                    ) => (
                      <div
                        key={`${action.type}-${index}`}
                        className={
                          styles.action
                        }
                      >
                        <div
                          className={
                            styles.actionTitle
                          }
                        >
                          <span
                            className={
                              styles.actionIndex
                            }
                          >
                            {
                              index +
                              1
                            }
                          </span>

                          {
                            action.title
                          }
                        </div>

                        <div
                          className={
                            styles.body
                          }
                        >
                          {
                            action.explanation
                          }
                        </div>

                        {
                          action.evidence.length >
                            0 && (
                            <div
                              className={
                                styles.evidence
                              }
                            >
                              {
                                action.evidence.map(
                                  (
                                    evidence
                                  ) => (
                                    <div
                                      key={
                                        evidence
                                      }
                                      className={
                                        styles.evidenceItem
                                      }
                                    >
                                      • {evidence}
                                    </div>
                                  )
                                )
                              }
                            </div>
                          )
                        }
                      </div>
                    )
                  )
                }

                {
                  diagnosis.topicGaps.length >
                    0 && (
                    <>
                      <h4
                        className={
                          styles.sectionTitle
                        }
                        style={{
                          marginTop:
                            16,
                        }}
                      >
                        Темы, которые стоит проверить
                      </h4>

                      {
                        diagnosis.topicGaps.map(
                          (
                            gap
                          ) => (
                            <div
                              key={
                                gap.topic
                              }
                              className={
                                styles.finding
                              }
                            >
                              <div
                                className={
                                  styles.itemTitle
                                }
                              >
                                {
                                  gap.topic
                                }
                              </div>

                              <div
                                className={
                                  styles.body
                                }
                              >
                                Похожая тема встретилась минимум на{" "}
                                {
                                  gap.competitorCoverage
                                } страницах из верхних результатов.
                              </div>
                            </div>
                          )
                        )
                      }
                    </>
                  )
                }

                {
                  diagnosis.observedCompetitorMedianWordCount !==
                    null && (
                    <div
                      className={
                        styles.pageCard
                      }
                    >
                      <div
                        className={
                          styles.itemTitle
                        }
                      >
                        Наблюдаемая глубина страниц
                      </div>

                      <div
                        className={
                          styles.body
                        }
                      >
                        Медиана прочитанных конкурентных страниц:{" "}
                        {
                          diagnosis.observedCompetitorMedianWordCount
                        } слов. Это наблюдение, а не целевой объём текста.
                      </div>
                    </div>
                  )
                }
              </div>
            </div>

            <div
              className={
                styles.limitations
              }
            >
              {
                diagnosis.limitations.join(
                  " · "
                )
              }
            </div>
          </>
        ) : null
      }
    </div>
  );
}
