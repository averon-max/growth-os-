.root {
  display: flex;
  flex-direction: column;
  gap: 18px;
  width: 100%;
}

.hero {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  min-height: 130px;
  padding: 24px 26px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.065);
  border-radius: 12px;
  background:
    radial-gradient(
      620px 260px at 8% -45%,
      rgba(105,101,218,.14),
      transparent 65%
    ),
    radial-gradient(
      520px 240px at 94% -60%,
      rgba(48,142,157,.10),
      transparent 68%
    ),
    linear-gradient(
      180deg,
      rgba(255,255,255,.025),
      rgba(255,255,255,.008)
    ),
    #111214;
}

.hero::after {
  content: "";
  position: absolute;
  pointer-events: none;
  inset: 0;
  border-radius: inherit;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.035),
    inset 0 -1px 0 rgba(0,0,0,.2);
}

.heroLeft {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.eyebrow {
  margin-bottom: 8px;
  color: #777b84;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.title {
  margin: 0;
  color: #ececef;
  font-size: 21px;
  font-weight: 590;
  letter-spacing: -.035em;
}

.description {
  max-width: 660px;
  margin: 7px 0 0;
  color: #858992;
  font-size: 12px;
  line-height: 1.55;
}

.sources {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 15px;
}

.source {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 26px;
  padding: 0 9px;
  border: 1px solid rgba(255,255,255,.055);
  border-radius: 7px;
  background: rgba(255,255,255,.018);
  color: #8d9199;
  font-size: 9px;
}

.liveDot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #59b977;
  box-shadow: 0 0 8px rgba(89,185,119,.35);
}

.range {
  position: relative;
  z-index: 1;
  display: flex;
  flex-shrink: 0;
  gap: 3px;
  padding: 3px;
  border: 1px solid rgba(255,255,255,.065);
  border-radius: 8px;
  background: rgba(5,6,7,.48);
}

.rangeButton {
  height: 29px;
  padding: 0 11px;
  border: 0;
  border-radius: 5px;
  background: transparent;
  color: #6f737b;
  font-size: 9px;
  font-weight: 560;
  cursor: pointer;
}

.rangeButton:hover {
  color: #b8bac0;
  background: rgba(255,255,255,.025);
}

.rangeButtonActive {
  color: #e1e2e5;
  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.09),
      rgba(255,255,255,.045)
    );
  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.045),
    0 1px 4px rgba(0,0,0,.24);
}

@media (max-width: 780px) {
  .hero {
    align-items: flex-start;
    flex-direction: column;
  }
}
