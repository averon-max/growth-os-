.sidebar {
  position: relative;
  z-index: 20;

  width: 220px;
  min-width: 220px;
  height: 100vh;

  padding: 10px 8px 18px;
  overflow-y: auto;

  border-right: 1px solid var(--border);

  background:
    radial-gradient(
      260px 180px at 30% -30px,
      rgba(94,106,210,.045),
      transparent 72%
    ),
    var(--sidebar);
}

.switcher {
  height: 38px;

  display: flex;
  align-items: center;
  gap: 9px;

  padding: 0 8px;
  margin-bottom: 8px;

  border-radius: 6px;

  color: #e7e7e9;

  transition: background .12s ease;
}

.switcher:hover {
  background: rgba(255,255,255,.035);
}

.logoMark {
  width: 17px;
  height: 17px;
  flex: 0 0 auto;

  border-radius: 5px;

  background:
    linear-gradient(145deg, #918bea, #5966c8);

  box-shadow:
    inset 0 1px rgba(255,255,255,.25);
}

.switcherText {
  flex: 1;
  font-size: 13px;
  font-weight: 590;
  letter-spacing: -.018em;
}

.chevron {
  color: #64676d;
}

.quickActions {
  display: flex;
  gap: 2px;

  padding: 0 5px;
  margin-bottom: 15px;
}

.quickAction {
  width: 28px;
  height: 28px;

  display: grid;
  place-items: center;

  padding: 0;

  border: 0;
  border-radius: 6px;

  background: transparent;
  color: #62656c;

  cursor: pointer;
}

.quickAction:hover {
  background: rgba(255,255,255,.035);
  color: #a8aab0;
}

.navGroup {
  margin-bottom: 10px;
}

.navGroupHeader {
  width: 100%;
  height: 24px;

  display: flex;
  align-items: center;
  gap: 5px;

  padding: 0 7px;

  border: 0;

  background: transparent;
  color: #50535a;

  cursor: pointer;
}

.navGroupChevron {
  transition: transform .13s ease;
}

.navGroupChevron[data-open="false"] {
  transform: rotate(-90deg);
}

.navGroupLabel {
  font-size: 9px;
  font-weight: 650;
  letter-spacing: .075em;
  text-transform: uppercase;
}

.navItems {
  overflow: hidden;
  transition: max-height .15s ease;
}

.navItem {
  height: 31px;

  display: flex;
  align-items: center;
  gap: 9px;

  margin: 1px 0;
  padding: 0 9px;

  border-radius: 6px;

  color: #74777e;

  font-size: 12px;
  font-weight: 450;
  letter-spacing: -.006em;

  text-decoration: none;

  transition:
    color .12s ease,
    background .12s ease;
}

.navItem svg {
  flex: 0 0 auto;
  color: #5c5f66;
}

.navItem:hover {
  background: rgba(255,255,255,.032);
  color: #b7b9be;
}

.navItem:hover svg {
  color: #91949a;
}

.navItemActive {
  background: rgba(255,255,255,.052);
  color: #e0e0e2;

  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.025);
}

.navItemActive svg {
  color: #8f89df;
}

@media (max-width: 900px) {
  .sidebar {
    width: 100%;
    min-width: 0;
    height: auto;

    border-right: 0;
    border-bottom: 1px solid var(--border);
  }
}
