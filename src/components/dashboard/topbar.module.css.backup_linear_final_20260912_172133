.topbar {
  position: sticky;
  z-index: 30;

  top: 0;

  height: 54px;
  min-height: 54px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 22px;

  padding: 0 22px;

  border-bottom: 1px solid var(--border);

  background:
    linear-gradient(
      180deg,
      rgba(17,19,21,.96),
      rgba(17,19,21,.91)
    );

  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);

  box-shadow:
    0 1px 0 rgba(0,0,0,.18);
}

.titleBlock {
  min-width: 0;

  display: flex;
  align-items: center;
  gap: 8px;
}

.contextDot {
  width: 7px;
  height: 7px;

  flex: 0 0 auto;

  border: 1px solid #747880;
  border-radius: 50%;

  background: rgba(255,255,255,.015);
}

.title {
  margin: 0;

  color: #e1e1e3;

  font-size: 13px;
  line-height: 1;

  font-weight: 580;

  letter-spacing: -.015em;
}

.separator {
  color: #4c5057;

  font-size: 12px;
}

.subtitle {
  max-width: 430px;

  margin: 0;

  overflow: hidden;

  color: #70747c;

  font-size: 11px;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.right {
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 9px;
}

.websiteControl {
  min-width: 0;
}

.websiteSwitcher {
  max-width: 320px;
  height: 32px;

  padding: 0 31px 0 10px;

  outline: none;

  border: 1px solid rgba(255,255,255,.08);
  border-radius: 7px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.035),
      rgba(255,255,255,.015)
    ),
    var(--surface);

  color: #afb1b7;

  font-size: 11px;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.018);
}

.websiteSwitcher:hover {
  border-color: rgba(255,255,255,.13);

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.045),
      rgba(255,255,255,.02)
    ),
    var(--surface-2);
}

.websiteSwitcher:focus {
  border-color: rgba(112,110,224,.38);

  box-shadow:
    0 0 0 3px rgba(112,110,224,.055);
}

.userEmail {
  display: none;
}

.avatar {
  width: 28px;
  height: 28px;

  display: grid;
  place-items: center;

  flex: 0 0 auto;

  border: 1px solid rgba(255,255,255,.085);
  border-radius: 50%;

  background:
    radial-gradient(
      circle at 35% 25%,
      #25282c,
      #151719 65%
    );

  color: #9699a0;

  font-size: 10px;
  font-weight: 600;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.04);
}
