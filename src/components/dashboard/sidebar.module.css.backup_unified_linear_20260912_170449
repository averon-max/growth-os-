.sidebar {
  position: relative;
  z-index: 20;

  width: 218px;
  min-width: 218px;
  height: 100vh;

  padding: 10px 8px 18px;

  overflow-y: auto;

  border-right: 1px solid rgba(255,255,255,.052);

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.018),
      transparent 180px
    ),
    #0d0e10;
}

.switcher {
  height: 38px;

  display: flex;
  align-items: center;
  gap: 9px;

  padding: 0 8px;
  margin-bottom: 7px;

  border-radius: 6px;

  color: #e5e5e7;

  transition: background .12s ease;
}

.switcher:hover {
  background: rgba(255,255,255,.035);
}

.logoMark {
  position: relative;

  width: 18px;
  height: 18px;

  flex: 0 0 auto;

  overflow: hidden;

  border-radius: 50%;

  background: #dfdfe1;
}

.logoMark::after {
  content: "";

  position: absolute;
  inset: -3px;

  background:
    repeating-linear-gradient(
      45deg,
      transparent 0 4px,
      rgba(20,21,24,.92) 4px 6px
    );
}

.switcherText {
  flex: 1;

  font-size: 13px;
  font-weight: 590;
  letter-spacing: -.018em;
}

.chevron {
  color: #64666c;
}

.quickActions {
  display: flex;
  align-items: center;
  gap: 2px;

  padding: 0 5px;
  margin-bottom: 15px;
}

.quickAction {
  width: 28px;
  height: 28px;

  display: grid;
  place-items: center;

  padding: 0;

  border: 0;
  border-radius: 6px;

  background: transparent;
  color: #64666d;

  cursor: pointer;
}

.quickAction:hover {
  background: rgba(255,255,255,.035);
  color: #a3a5ab;
}

.navGroup {
  margin-bottom: 10px;
}

.navGroupHeader {
  width: 100%;
  height: 24px;

  display: flex;
  align-items: center;
  gap: 5px;

  padding: 0 7px;

  border: 0;

  background: transparent;
  color: #505259;

  cursor: pointer;
}

.navGroupChevron {
  transition: transform .13s ease;
}

.navGroupChevron[data-open="false"] {
  transform: rotate(-90deg);
}

.navGroupLabel {
  font-size: 9px;
  line-height: 1;
  font-weight: 650;

  letter-spacing: .075em;
  text-transform: uppercase;
}

.navItems {
  overflow: hidden;
  transition: max-height .15s ease;
}

.navItem {
  height: 31px;

  display: flex;
  align-items: center;
  gap: 9px;

  margin: 1px 0;
  padding: 0 9px;

  border-radius: 6px;

  color: #73757c;

  font-size: 12px;
  font-weight: 450;
  letter-spacing: -.006em;

  text-decoration: none;

  transition:
    background .12s ease,
    color .12s ease;
}

.navItem svg {
  flex: 0 0 auto;
  color: #5b5e65;
}

.navItem:hover {
  background: rgba(255,255,255,.032);
  color: #b8b9bd;
}

.navItem:hover svg {
  color: #92949a;
}

.navItemActive {
  background: rgba(255,255,255,.052);
  color: #dfdfe1;

  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.025);
}

.navItemActive svg {
  color: #8984dc;
}

@media (max-width: 900px) {
  .sidebar {
    width: 100%;
    min-width: 0;
    height: auto;

    border-right: 0;
    border-bottom: 1px solid var(--border);
  }
}
