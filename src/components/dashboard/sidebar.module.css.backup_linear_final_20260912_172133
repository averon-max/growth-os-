.sidebar {
  position: relative;
  z-index: 20;

  width: 246px;
  min-width: 246px;
  height: 100%;

  padding: 12px 10px 22px;

  overflow-y: auto;

  border-right: 1px solid var(--border);

  background:
    radial-gradient(
      300px 240px at 40% -90px,
      rgba(120,123,148,.055),
      transparent 72%
    ),
    var(--sidebar);
}

.switcher {
  height: 42px;

  display: flex;
  align-items: center;
  gap: 10px;

  margin-bottom: 9px;
  padding: 0 9px;

  border-radius: 7px;

  color: #e6e6e8;

  transition: background .12s ease;
}

.switcher:hover {
  background: rgba(255,255,255,.035);
}

.logoMark {
  position: relative;

  width: 21px;
  height: 21px;

  flex: 0 0 auto;

  overflow: hidden;

  border-radius: 50%;

  background:
    repeating-linear-gradient(
      135deg,
      #e7e7e9 0px,
      #e7e7e9 2px,
      #777b85 2px,
      #777b85 4px
    );

  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.18),
    0 0 16px rgba(255,255,255,.025);
}

.switcherText {
  flex: 1;

  font-size: 14px;
  font-weight: 590;

  letter-spacing: -.025em;
}

.chevron {
  color: #63676f;
}

.quickActions {
  display: flex;
  gap: 4px;

  padding: 0 7px;

  margin-bottom: 19px;
}

.quickAction {
  width: 30px;
  height: 30px;

  display: grid;
  place-items: center;

  padding: 0;

  border: 0;
  border-radius: 6px;

  background: transparent;

  color: #696d75;

  cursor: pointer;

  transition:
    color .12s ease,
    background .12s ease;
}

.quickAction:hover {
  background: rgba(255,255,255,.04);
  color: #b2b4ba;
}

.navGroup {
  margin-bottom: 13px;
}

.navGroupHeader {
  width: 100%;
  height: 26px;

  display: flex;
  align-items: center;
  gap: 5px;

  padding: 0 8px;

  border: 0;

  background: transparent;

  color: #555960;

  cursor: pointer;
}

.navGroupChevron {
  transition: transform .13s ease;
}

.navGroupChevron[data-open="false"] {
  transform: rotate(-90deg);
}

.navGroupLabel {
  font-size: 9.5px;
  font-weight: 650;

  letter-spacing: .07em;
  text-transform: uppercase;
}

.navItems {
  overflow: hidden;

  transition: max-height .15s ease;
}

.navItem {
  position: relative;

  height: 34px;

  display: flex;
  align-items: center;
  gap: 10px;

  margin: 1px 0;
  padding: 0 10px;

  border-radius: 7px;

  color: #85888f;

  font-size: 13px;
  font-weight: 455;

  letter-spacing: -.006em;

  text-decoration: none;

  transition:
    background .12s ease,
    color .12s ease,
    box-shadow .12s ease;
}

.navItem svg {
  flex: 0 0 auto;

  color: #646870;
}

.navItem:hover {
  background: rgba(255,255,255,.032);
  color: #b7b9be;
}

.navItem:hover svg {
  color: #9699a0;
}

.navItemActive {
  background:
    linear-gradient(
      90deg,
      rgba(255,255,255,.055),
      rgba(255,255,255,.035)
    );

  color: #e1e1e4;

  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.025);
}

.navItemActive::before {
  content: "";

  position: absolute;

  left: 0;
  top: 8px;
  bottom: 8px;

  width: 2px;

  border-radius: 0 2px 2px 0;

  background: #807ae8;

  box-shadow:
    0 0 10px rgba(128,122,232,.25);
}

.navItemActive svg {
  color: #9690ec;
}

@media (max-width: 900px) {
  .sidebar {
    width: 100%;
    min-width: 0;
    height: auto;

    border-right: 0;
    border-bottom: 1px solid var(--border);
  }
}
