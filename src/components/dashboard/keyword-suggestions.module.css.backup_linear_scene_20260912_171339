.container {
  margin: 0;
  padding: 0;

  border: 0;
  border-radius: 0;

  background: transparent;
}

.header {
  min-height: 54px;

  display: flex;
  align-items: center;
  gap: 9px;

  padding: 0 14px;

  border-bottom: 1px solid var(--border);
}

.icon {
  flex-shrink: 0;

  color: #817add;
}

.title {
  color: #b9bac0;

  font-size: 11px;
  font-weight: 570;
}

.subtitle {
  margin-top: 2px;

  color: #62656c;

  font-size: 9px;
}

.searchRow {
  min-height: 45px;

  display: flex;
  align-items: center;
  gap: 7px;

  padding: 7px 13px;

  border-bottom: 1px solid var(--border);
}

.searchBox {
  flex: 1;

  min-height: 30px;

  display: flex;
  align-items: center;
  gap: 6px;

  padding: 0 9px;

  border: 1px solid var(--border);
  border-radius: 5px;

  background: #0e0f11;
}

.searchIcon {
  flex-shrink: 0;

  color: #686b72;
}

.searchInput {
  width: 100%;

  padding: 6px 0;

  outline: none;
  border: 0;

  background: transparent;
  color: var(--primary);

  font-size: 10px;
}

.searchInput::placeholder {
  color: var(--muted);
}

.exploreButton {
  height: 30px;

  padding: 0 12px;

  border: 1px solid rgba(255,255,255,.08);
  border-radius: 5px;

  background: #6565c8;
  color: white;

  font-size: 10px;
  font-weight: 600;

  cursor: pointer;
}

.exploreButton:hover {
  background: #7070d4;
}

.exploreButton:disabled {
  opacity: .45;
  cursor: not-allowed;
}

.error,
.rateLimitError,
.empty {
  margin: 0;
  padding: 10px 13px;

  border-bottom: 1px solid var(--border);

  font-size: 10px;
}

.error {
  color: var(--danger);
}

.rateLimitError {
  color: var(--warning);
}

.empty {
  color: var(--secondary);
}

.resultCount {
  margin: 0;

  color: var(--secondary);

  font-size: 10px;
}

.clickableRow {
  cursor: pointer;
}

.clickableRow:hover {
  background: rgba(255,255,255,.018);
}

.trendBadge {
  display: inline-flex;
  align-items: center;
  gap: 3px;

  padding: 1px 5px;

  border-radius: 4px;

  font-family: var(--font-mono);
  font-size: 9px;
}

.trendUp {
  color: var(--success);
  background: rgba(78,175,109,.075);
}

.trendDown {
  color: var(--danger);
  background: rgba(213,99,110,.075);
}

.trendFlat {
  color: var(--muted);
  background: rgba(255,255,255,.025);
}

.difficultyBadge {
  display: inline-flex;
  align-items: center;

  min-width: 22px;
  min-height: 18px;

  padding: 0 5px;

  border-radius: 4px;

  font-size: 9px;
  font-weight: 600;
}

.difficultyBadge[data-tone="success"] {
  color: var(--success);
  background: rgba(78,175,109,.075);
}

.difficultyBadge[data-tone="warning"] {
  color: var(--warning);
  background: rgba(203,165,63,.075);
}

.difficultyBadge[data-tone="danger"] {
  color: var(--danger);
  background: rgba(213,99,110,.075);
}

.difficultyBadge[data-tone="muted"] {
  color: var(--muted);
  background: rgba(255,255,255,.025);
}

.sourceBadge {
  display: inline-flex;
  align-items: center;
  gap: 3px;

  margin-left: 7px;
  padding: 1px 5px;

  border-radius: 4px;

  font-family: var(--font-mono);
  font-size: 8px;
}

.sourceCache {
  color: var(--success);
  background: rgba(78,175,109,.065);
}

.sourceFresh {
  color: var(--secondary);
  background: rgba(255,255,255,.025);
}

.trendingBlock {
  margin: 0;
  padding: 10px 13px;

  border: 0;
  border-bottom: 1px solid var(--border);
  border-radius: 0;

  background: rgba(255,255,255,.005);
}

.trendingHeader {
  display: flex;
  align-items: center;
  gap: 6px;

  margin-bottom: 8px;

  color: #aeb0b5;

  font-size: 10px;
  font-weight: 560;
}

.trendingIcon {
  color: #ca6670;
}

.freeBadge {
  margin-left: 3px;
  padding: 1px 5px;

  border-radius: 4px;

  background: rgba(78,175,109,.06);
  color: var(--success);

  font-size: 8px;
  font-weight: 500;
}

.trendingChips {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.chip {
  padding: 2px 6px;

  border: 1px solid rgba(255,255,255,.05);
  border-radius: 4px;

  background: transparent;
  color: #777a81;

  font-size: 9px;
}

.chipRising::before {
  content: "";

  width: 4px;
  height: 4px;

  display: inline-block;

  margin-right: 4px;

  border-radius: 50%;

  background: var(--danger);
}
