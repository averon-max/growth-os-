.surface {
  min-height: 480px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.065);
  border-radius: 12px;
  background:
    radial-gradient(
      540px 180px at 82% -100px,
      rgba(67,138,151,.075),
      transparent 72%
    ),
    #111214;
}

.header {
  min-height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 0 17px;
  border-bottom: 1px solid rgba(255,255,255,.055);
}

.titleLine {
  display: flex;
  align-items: center;
  gap: 8px;
}

.titleLine svg {
  color: #797be0;
}

.titleLine h2 {
  margin: 0;
  color: #dedfe2;
  font-size: 12px;
  font-weight: 590;
}

.header p {
  margin: 4px 0 0;
  color: #686c74;
  font-size: 9px;
}

.sourceBadge {
  padding: 2px 6px;
  border: 1px solid rgba(89,170,113,.11);
  border-radius: 4px;
  background: rgba(89,170,113,.06);
  color: #63ae78;
  font-size: 8px;
}

.range {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #5e626a;
  font-family: var(--font-mono);
  font-size: 8px;
}

.state {
  min-height: 414px;
  display: grid;
  place-items: center;
  padding: 24px;
  color: #686c74;
  font-size: 10px;
  text-align: center;
}

.error {
  color: #ce7079;
}

.metrics {
  display: grid;
  grid-template-columns:
    repeat(4,minmax(0,1fr));
  border-bottom: 1px solid rgba(255,255,255,.055);
}

.metric {
  position: relative;
  min-height: 88px;
  padding: 15px;
  overflow: hidden;
}

.metric + .metric {
  border-left: 1px solid rgba(255,255,255,.05);
}

.metric::after {
  content: "";
  position: absolute;
  width: 90px;
  height: 60px;
  top: -35px;
  right: -20px;
  border-radius: 50%;
  filter: blur(25px);
  opacity: .20;
  pointer-events: none;
}

.metric[data-tone="green"]::after {
  background: #55ad72;
}

.metric[data-tone="cyan"]::after {
  background: #3b9aa8;
}

.metric[data-tone="violet"]::after {
  background: #7375dc;
}

.metric[data-tone="amber"]::after {
  background: #c4a347;
}

.metricLabel {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #686c74;
  font-size: 8px;
  font-weight: 600;
  letter-spacing: .05em;
  text-transform: uppercase;
}

.metricValue {
  margin-top: 11px;
  color: #dedfe2;
  font-family: var(--font-mono);
  font-size: 18px;
  font-weight: 570;
}

.tableTitle {
  min-height: 47px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0 15px;
  border-bottom: 1px solid rgba(255,255,255,.045);
}

.tableTitle div {
  display: flex;
  align-items: center;
  gap: 8px;
}

.tableTitle strong {
  color: #aeb1b7;
  font-size: 9px;
  font-weight: 570;
}

.tableTitle span {
  color: #565a62;
  font-size: 8px;
}

.tableViewport {
  height: 360px;
  overflow: auto;
  scrollbar-width: thin;
  scrollbar-color:
    rgba(255,255,255,.1)
    transparent;
}

.table {
  width: 100%;
  border-collapse: collapse;
}

.table thead {
  position: sticky;
  top: 0;
  z-index: 2;
  background: #111214;
}

.table th {
  height: 34px;
  padding: 0 12px;
  border-bottom: 1px solid rgba(255,255,255,.045);
  color: #5e626a;
  font-size: 8px;
  font-weight: 610;
  text-align: left;
  text-transform: uppercase;
  letter-spacing: .04em;
  white-space: nowrap;
}

.table td {
  height: 42px;
  padding: 0 12px;
  border-bottom: 1px solid rgba(255,255,255,.03);
  color: #7d8189;
  font-family: var(--font-mono);
  font-size: 9px;
  white-space: nowrap;
}

.table tbody tr:hover {
  background: rgba(255,255,255,.012);
}

.queryCell {
  min-width: 230px;
  max-width: 390px;
  display: flex;
  align-items: center;
  gap: 9px;
}

.rank {
  width: 18px;
  flex: 0 0 auto;
  color: #484c53;
  font-size: 8px;
}

.query {
  overflow: hidden;
  color: #c1c3c8;
  font-family: var(--font-body);
  font-size: 9px;
  text-overflow: ellipsis;
}

.strong {
  color: #c3c5c9 !important;
}

.page {
  max-width: 220px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  overflow: hidden;
  color: #73777f;
  text-decoration: none;
}

.page span {
  overflow: hidden;
  text-overflow: ellipsis;
}

.page:hover {
  color: #b8bbc0;
}

.surface *,
.surface *::before,
.surface *::after {
  transition-property:
    background-color,
    border-color,
    color,
    opacity;
}

@media (max-width: 760px) {
  .metrics {
    grid-template-columns:
      repeat(2,minmax(0,1fr));
  }

  .metric:nth-child(3) {
    border-left: 0;
    border-top:
      1px solid rgba(255,255,255,.05);
  }

  .metric:nth-child(4) {
    border-top:
      1px solid rgba(255,255,255,.05);
  }
}
