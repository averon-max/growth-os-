.pageBody {
  width: 100%;
  max-width: 1440px;

  margin: 0 auto;
  padding: 24px 28px 72px;
}

.workspaceSurface {
  position: relative;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 10px;

  background: var(--surface);

  box-shadow:
    0 18px 55px rgba(0,0,0,.10);
}

.workspaceSurface + .workspaceSurface {
  margin-top: 14px;
}

.surfaceToolbar {
  min-height: 42px;

  display: flex;
  align-items: center;
  gap: 8px;

  padding: 0 13px;

  border-bottom: 1px solid var(--border);

  background: rgba(255,255,255,.006);
}

.surfaceToolbarTitle {
  color: #b2b3b8;

  font-size: 11px;
  font-weight: 560;
}

.surfaceToolbarMeta {
  margin-left: auto;

  color: var(--muted);

  font-size: 10px;
}

.splitGrid {
  display: grid;
  grid-template-columns: minmax(0,1.45fr) minmax(260px,.55fr);
}

.splitPane {
  min-width: 0;
}

.splitPane + .splitPane {
  border-left: 1px solid var(--border);
}

.pageHeader {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 24px;

  margin-bottom: 20px;
}

.pageTitle {
  margin: 0;

  color: #e4e4e6;

  font-size: 20px;
  font-weight: 580;

  letter-spacing: -.035em;
}

.pageSubtitle {
  margin: 5px 0 0;

  color: #70737a;

  font-size: 11px;
}

.sectionTitle {
  margin: 24px 0 8px;

  color: #8a8c92;

  font-size: 11px;
  font-weight: 560;
}

.statGrid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));

  margin-bottom: 14px;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 10px;

  background: var(--surface);
}

.statCard {
  min-height: 82px;

  padding: 15px 17px;

  border: 0 !important;
  background: transparent;
}

.statCard + .statCard {
  border-left: 1px solid var(--border) !important;
}

.statHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 8px;

  margin-bottom: 10px;
}

.statLabel {
  margin: 0;

  color: #696c73;

  font-size: 9px;
  font-weight: 620;

  letter-spacing: .055em;
  text-transform: uppercase;
}

.statAccent {
  width: 5px;
  height: 5px;

  flex: 0 0 auto;

  border-radius: 50%;
}

.statValue {
  margin: 0;

  color: #e5e5e7 !important;

  font-size: 22px;
  line-height: 1;
  font-weight: 570;

  letter-spacing: -.04em;
}

.group {
  position: relative;

  margin-top: 14px;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 9px;

  background: var(--surface);
}

.workspaceSurface .group {
  margin: 0;

  border: 0;
  border-radius: 0;

  background: transparent;
}

.workspaceSurface .group + .group {
  border-top: 1px solid var(--border);
}

.groupHeader {
  min-height: 40px;

  display: flex;
  align-items: center;
  gap: 8px;

  padding: 0 13px;

  border-bottom: 1px solid var(--border);

  background: rgba(255,255,255,.006);
}

.groupLabel {
  color: #adafb4;

  font-size: 11px;
  font-weight: 560;
}

.groupCount {
  color: #5e6168;

  font-family: var(--font-mono);
  font-size: 9px;
}

.groupHeaderAction {
  margin-left: auto;

  color: #72757c;

  font-size: 10px;
  text-decoration: none;
}

.groupHeaderAction:hover {
  color: #bfc0c4;
}

.issueRow {
  min-height: 52px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 18px;

  padding: 8px 13px;

  border-bottom: 1px solid rgba(255,255,255,.038);

  transition: background .11s ease;
}

.issueRow:last-child {
  border-bottom: 0;
}

.issueRow:hover {
  background: rgba(255,255,255,.018);
}

.issueMain {
  min-width: 0;

  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.issueDot {
  width: 7px;
  height: 7px;

  flex: 0 0 auto;

  margin-top: 5px;

  border: 1px solid #5a5d64;
  border-radius: 50%;
}

.issueDot[data-tone="success"] {
  border-color: var(--success);
  background: rgba(78,175,109,.12);
}

.issueDot[data-tone="warning"] {
  border-color: var(--warning);
  background: rgba(203,165,63,.12);
}

.issueDot[data-tone="danger"] {
  border-color: var(--danger);
  background: rgba(213,99,110,.12);
}

.issueDot[data-tone="accent"] {
  border-color: #7973da;
  background: rgba(94,106,210,.22);
}

.issueDot[data-tone="muted"] {
  border-color: #50535a;
}

.issueTitle {
  overflow: hidden;

  color: #d0d1d4;

  font-size: 12px;
  line-height: 1.4;
  font-weight: 470;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.issueDesc {
  max-width: 820px;

  margin-top: 2px;

  overflow: hidden;

  color: #65686f;

  font-size: 10px;
  line-height: 1.48;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.issueMeta {
  flex: 0 0 auto;

  color: #696c73;

  font-size: 10px;
  text-align: right;
}

.link {
  color: #85888f;

  text-decoration: none;

  transition: color .12s ease;
}

.link:hover {
  color: #d4d4d7;
}

.awaitingLabel {
  color: #5b5e65;
  font-size: 10px;
}

.mono {
  font-family: var(--font-mono);
  font-feature-settings: "tnum" 1;
}

.truncate {
  max-width: 340px;

  display: block;
  overflow: hidden;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.badge {
  min-height: 18px;

  display: inline-flex;
  align-items: center;

  padding: 0 6px;

  border: 1px solid var(--border);
  border-radius: 4px;

  background: rgba(255,255,255,.018);

  color: #777a81;

  font-size: 9px;
  font-weight: 560;
}

.badgeDanger {
  color: #cf747c;
  border-color: rgba(213,99,110,.14);
  background: rgba(213,99,110,.045);
}

.badgeWarning {
  color: #c3a34d;
  border-color: rgba(203,165,63,.14);
  background: rgba(203,165,63,.045);
}

.badgeAccent {
  color: #918be3;
  border-color: rgba(94,106,210,.16);
  background: rgba(94,106,210,.055);
}

.badgeMuted {
  color: #70737a;
}

.badgeSuccess {
  color: #69b77d;
  border-color: rgba(78,175,109,.14);
  background: rgba(78,175,109,.045);
}

.card,
.formCard,
.progressCard,
.errorCard,
.scoreCard {
  border: 1px solid var(--border);
  border-radius: 8px;

  background: var(--surface);

  box-shadow: none;
}

.card {
  padding: 15px;
}

.emptyState {
  min-height: 270px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 38px;

  background: transparent;

  text-align: center;
}

.emptyIconWrap {
  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  margin-bottom: 12px;

  border: 1px solid var(--border);
  border-radius: 7px;

  background: var(--surface-2);
  color: #827ddb;
}

.emptyTitle {
  margin: 0 0 5px;

  color: #d9dade;

  font-size: 13px;
  font-weight: 560;
}

.emptyDescription {
  max-width: 430px;

  margin: 0;

  color: #686b72;

  font-size: 11px;
  line-height: 1.55;
}

.emptyAction {
  min-height: 29px;

  display: inline-flex;
  align-items: center;

  margin-top: 15px;
  padding: 0 11px;

  border: 1px solid rgba(255,255,255,.09);
  border-radius: 6px;

  background: #e1e1e3;
  color: #151619;

  font-size: 10px;
  font-weight: 620;

  text-decoration: none;
}

.emptyAction:hover {
  background: #ededee;
}

.formGroup {
  display: grid;
  gap: 6px;

  margin-bottom: 13px;
}

.formLabel {
  color: #81848b;

  font-size: 10px;
  font-weight: 560;
}

.formInput {
  width: 100%;
  height: 32px;

  padding: 0 9px;

  outline: none;

  border: 1px solid var(--border);
  border-radius: 6px;

  background: #0e0f11;
  color: #dedee0;

  font-size: 11px;
}

.formInput:focus {
  border-color: rgba(94,106,210,.32);

  box-shadow:
    0 0 0 3px rgba(94,106,210,.05);
}

.formError {
  color: #cf6973;
  font-size: 10px;
}

.primaryButton {
  min-height: 29px;

  padding: 0 11px;

  border: 1px solid rgba(255,255,255,.09);
  border-radius: 6px;

  background: #6565c8;
  color: #fff;

  font-size: 10px;
  font-weight: 620;

  cursor: pointer;

  box-shadow: none;
}

.primaryButton:hover {
  background: #7070d5;
}

.backLink {
  color: #70737a;

  font-size: 10px;
  text-decoration: none;
}

.backLink:hover {
  color: #bec0c4;
}

.table {
  width: 100%;

  border-collapse: collapse;
  border-spacing: 0;

  table-layout: auto;
}

.table thead {
  border-bottom: 1px solid var(--border);
}

.table th {
  height: 33px;

  padding: 0 11px;

  color: #74777e;

  font-size: 9px;
  font-weight: 560;

  text-align: left;
  white-space: nowrap;
}

.table td {
  height: 41px;

  padding: 5px 11px;

  border-bottom: 1px solid rgba(255,255,255,.034);

  color: #c6c7ca;

  font-size: 11px;
}

.table tbody tr:last-child td {
  border-bottom: 0;
}

.table tbody tr {
  transition: background .1s ease;
}

.table tbody tr:hover {
  background: rgba(255,255,255,.018);
}

.scoreGrid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));
  gap: 8px;
}

.scoreCard {
  padding: 15px;
}

.scoreValue {
  margin: 0;

  color: #e0e0e2;

  font-family: var(--font-mono);

  font-size: 22px;
  font-weight: 570;
}

.scoreLabel {
  margin: 6px 0 0;

  color: #666970;

  font-size: 9px;

  letter-spacing: .05em;
  text-transform: uppercase;
}

.progressTitle,
.errorTitle {
  margin: 0;

  color: #d9dadd;

  font-size: 13px;
  font-weight: 560;
}

.progressStep {
  min-height: 30px;

  display: flex;
  align-items: center;
  gap: 8px;

  color: #696c73;

  font-size: 10px;
}

.progressDot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #6b69cf;
}

.progressStepLabel {
  color: #7c7f86;
}

.progressHint,
.errorDesc {
  margin: 6px 0 0;

  color: #62656c;

  font-size: 10px;
  line-height: 1.5;
}

@media (max-width: 1000px) {
  .splitGrid {
    grid-template-columns: 1fr;
  }

  .splitPane + .splitPane {
    border-left: 0;
    border-top: 1px solid var(--border);
  }
}

@media (max-width: 900px) {
  .pageBody {
    padding: 20px 18px 60px;
  }

  .statGrid,
  .scoreGrid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

@media (max-width: 600px) {
  .statGrid,
  .scoreGrid {
    grid-template-columns: 1fr;
  }

  .statCard + .statCard {
    border-left: 0 !important;
    border-top: 1px solid var(--border) !important;
  }

  .issueRow {
    align-items: flex-start;
    flex-direction: column;
  }

  .issueMeta {
    width: 100%;
    text-align: left;
  }
}
