.shell {
  margin-bottom: 16px;
  border: 1px solid var(--border);
  background: var(--surface);
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  padding: 15px 16px;
  border-bottom: 1px solid var(--border);
}

.eyebrow {
  margin: 0 0 5px;
  color: var(--secondary);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.title {
  margin: 0;
  color: var(--primary);
  font-size: 14px;
  font-weight: 600;
}

.copy {
  max-width: 720px;
  margin: 5px 0 0;
  color: var(--secondary);
  font-size: 11px;
  line-height: 1.5;
}

.button {
  flex-shrink: 0;
  min-height: 30px;
  padding: 0 11px;
  border: 1px solid var(--border);
  border-radius: 5px;
  background: var(--elevated);
  color: var(--primary);
  font: inherit;
  font-size: 10px;
  cursor: pointer;
}

.button:hover:not(:disabled) {
  border-color: var(--secondary);
}

.button:disabled {
  opacity: .55;
  cursor: wait;
}

.state {
  padding: 18px 16px;
  color: var(--secondary);
  font-size: 11px;
  line-height: 1.5;
}

.error {
  padding: 10px 16px;
  border-bottom: 1px solid var(--border);
  color: #df7c7c;
  font-size: 10px;
}

.summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border-bottom: 1px solid var(--border);
}

.stat {
  padding: 11px 13px;
  border-right: 1px solid var(--border);
}

.stat:last-child {
  border-right: 0;
}

.statValue {
  display: block;
  color: var(--primary);
  font-size: 17px;
  font-weight: 600;
}

.statLabel {
  display: block;
  margin-top: 3px;
  color: var(--secondary);
  font-size: 9px;
}

.tableWrap {
  overflow-x: auto;
}

.table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}

.table th {
  padding: 8px 10px;
  border-bottom: 1px solid var(--border);
  background: var(--background);
  color: var(--secondary);
  font-size: 9px;
  font-weight: 500;
  text-align: left;
}

.table td {
  padding: 10px;
  border-bottom: 1px solid var(--border);
  color: var(--secondary);
  font-size: 10px;
  vertical-align: top;
}

.table tr:last-child td {
  border-bottom: 0;
}

.keyword {
  color: var(--primary);
  font-weight: 500;
}

.rank {
  color: var(--primary);
  font-weight: 600;
}

.good {
  color: #72c891;
}

.warn {
  color: #e2b56f;
}

.bad {
  color: #df7c7c;
}

.priority {
  display: inline-flex;
  margin-top: 5px;
  padding: 2px 5px;
  border: 1px solid var(--border);
  border-radius: 4px;
  color: var(--secondary);
  font-size: 8px;
  text-transform: uppercase;
}

.explanation {
  max-width: 330px;
  line-height: 1.45;
}

.details {
  margin-top: 6px;
  color: var(--secondary);
  font-size: 9px;
}

.details summary {
  cursor: pointer;
}

.detailBody {
  margin-top: 6px;
  padding: 7px 8px;
  border: 1px solid var(--border);
  background: var(--background);
  line-height: 1.5;
}

.url {
  display: block;
  overflow: hidden;
  margin-top: 4px;
  color: var(--secondary);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 9px 12px;
  border-top: 1px solid var(--border);
  background: var(--background);
  color: var(--secondary);
  font-size: 9px;
  line-height: 1.4;
}

@media (max-width: 900px) {
  .header {
    flex-direction: column;
  }

  .summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stat:nth-child(2) {
    border-right: 0;
  }

  .stat:nth-child(-n+2) {
    border-bottom: 1px solid var(--border);
  }
}
