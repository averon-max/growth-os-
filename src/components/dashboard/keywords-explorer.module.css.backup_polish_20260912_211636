.workspace {
  position: relative;

  margin-top: 18px;
  padding: 15px 15px 0;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 11px;

  background:
    radial-gradient(
      600px 220px at 18% -130px,
      rgba(130,135,157,.045),
      transparent 70%
    ),
    var(--surface);
}

.workspace :global(table) {
  width: calc(100% + 30px);

  margin-left: -15px;

  border: 0;
  border-top: 1px solid var(--border);
  border-radius: 0;
}

.loading {
  padding: 28px 3px;

  color: var(--secondary);

  font-size: 11px;
}

.filters {
  display: flex;
  gap: 6px;

  margin-bottom: 13px;
}

.select {
  min-height: 30px;

  padding: 0 9px;

  outline: 0;

  border: 1px solid var(--border);
  border-radius: 5px;

  background: rgba(255,255,255,.018);
  color: #989ba2;

  font-size: 10px;
}

.select:hover {
  border-color: var(--border-hover);

  background: rgba(255,255,255,.03);
}

.searchBox {
  min-height: 30px;

  display: flex;
  align-items: center;
  gap: 6px;

  padding: 0 9px;

  border: 1px solid var(--border);
  border-radius: 5px;

  background: #0e1011;
}

.searchIcon {
  color: #686b72;
}

.searchInput {
  width: 100%;

  padding: 6px 0;

  outline: none;
  border: 0;

  background: transparent;
  color: var(--primary);

  font-size: 10px;
}

.searchInput::placeholder {
  color: var(--muted);
}

.clickableRow {
  cursor: pointer;
}

.pagination {
  min-height: 44px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 12px;

  margin: 0 -15px;

  border-top: 1px solid var(--border);
}

.pageButton {
  padding: 4px 9px;

  border: 0;

  background: transparent;
  color: #7e8188;

  font-size: 10px;

  cursor: pointer;
}

.pageButton:hover {
  color: #d7d8db;
}

.pageButton:disabled {
  color: #4c5056;
}

.pageLabel {
  color: #5f6269;

  font-family: var(--font-mono);
  font-size: 9px;
}

.emptyRow {
  padding: 34px 0 !important;

  color: var(--secondary) !important;

  text-align: center;
}
