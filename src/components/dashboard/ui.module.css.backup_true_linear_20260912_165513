.pageBody {
  position: relative;
  z-index: 1;

  width: calc(100% - 48px);
  max-width: 1420px;

  min-height: calc(100vh - 88px);

  margin: 24px auto 34px;
  padding: 24px;

  overflow: hidden;

  border: 1px solid rgba(255,255,255,.066);
  border-radius: 14px;

  background:
    radial-gradient(
      700px 300px at 16% -10%,
      rgba(94,106,210,.060),
      transparent 72%
    ),
    radial-gradient(
      550px 320px at 87% 8%,
      rgba(21,147,161,.023),
      transparent 72%
    ),
    linear-gradient(
      180deg,
      rgba(255,255,255,.012),
      transparent 150px
    ),
    #111214;

  box-shadow:
    inset 0 1px rgba(255,255,255,.020),
    0 35px 100px rgba(0,0,0,.26);
}

.pageBody::before {
  content: "";

  position: absolute;
  z-index: 0;
  pointer-events: none;

  left: 0;
  right: 0;
  top: 0;

  height: 150px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.010),
      transparent
    );
}

.pageBody > * {
  position: relative;
  z-index: 1;
}

.pageHeader {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 24px;

  margin-bottom: 24px;
}

.pageTitle {
  margin: 0;

  color: #e7e7e9;

  font-size: 21px;
  line-height: 1.2;
  font-weight: 590;

  letter-spacing: -.035em;
}

.pageSubtitle {
  margin: 6px 0 0;

  color: #73757c;

  font-size: 11px;
  line-height: 1.5;
}

.sectionTitle {
  margin: 27px 0 9px;

  color: #8f9197;

  font-size: 11px;
  font-weight: 560;
}


/* METRIC STRIP */

.statGrid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));

  gap: 0;

  margin-bottom: 20px;

  overflow: hidden;

  border: 1px solid rgba(255,255,255,.062);
  border-radius: 9px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.016),
      transparent
    ),
    rgba(8,9,11,.34);
}

.statCard {
  min-height: 88px;

  padding: 18px 18px 15px;

  border: 0 !important;
  background: transparent;

  transition: background .12s ease;
}

.statCard + .statCard {
  border-left: 1px solid rgba(255,255,255,.052) !important;
}

.statCard:hover {
  background: rgba(255,255,255,.014);
}

.statValue {
  margin: 0 0 8px;

  color: #e8e8ea !important;

  font-size: 23px;
  line-height: 1;
  font-weight: 580;

  letter-spacing: -.043em;
}

.statLabel {
  margin: 0;

  color: #666970;

  font-size: 9px;
  font-weight: 620;

  letter-spacing: .06em;
  text-transform: uppercase;
}


/* NESTED PRODUCT PANELS */

.group {
  position: relative;

  margin-top: 16px;

  overflow: hidden;

  border: 1px solid rgba(255,255,255,.058);
  border-radius: 9px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.012),
      transparent 110px
    ),
    rgba(8,9,11,.28);
}

.group::before {
  content: "";

  position: absolute;
  pointer-events: none;

  left: 8%;
  top: -1px;

  width: 34%;
  height: 1px;

  opacity: .35;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(94,106,210,.27),
      transparent
    );
}

.groupHeader {
  min-height: 42px;

  display: flex;
  align-items: center;

  gap: 8px;

  padding: 0 14px;

  border-bottom: 1px solid rgba(255,255,255,.048);

  background: rgba(255,255,255,.006);
}

.groupLabel {
  color: #afb0b5;

  font-size: 11px;
  font-weight: 560;
}

.groupCount {
  min-width: 16px;

  color: #5f6269;

  font-family: var(--font-mono);
  font-size: 9px;
}

.groupHeaderAction {
  margin-left: auto;

  color: #71747b;

  font-size: 10px;
  text-decoration: none;

  transition: color .12s ease;
}

.groupHeaderAction:hover {
  color: #bfc0c4;
}


/* ROWS */

.issueRow {
  min-height: 57px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 9px 14px;

  border-bottom: 1px solid rgba(255,255,255,.037);

  transition: background .12s ease;
}

.issueRow:last-child {
  border-bottom: 0;
}

.issueRow:hover {
  background:
    linear-gradient(
      90deg,
      rgba(94,106,210,.026),
      rgba(255,255,255,.008) 52%,
      transparent
    );
}

.issueMain {
  min-width: 0;

  display: flex;
  align-items: flex-start;

  gap: 10px;
}

.issueDot {
  width: 7px;
  height: 7px;

  flex: 0 0 auto;

  margin-top: 5px;

  border: 1px solid #5b5e65;
  border-radius: 50%;

  background: transparent;
}

.issueDot[data-tone="success"] {
  border-color: #4aad69;
  background: rgba(74,173,105,.14);
}

.issueDot[data-tone="warning"] {
  border-color: #c8a638;
  background: rgba(200,166,56,.13);
}

.issueDot[data-tone="danger"] {
  border-color: #d35f67;
  background: rgba(211,95,103,.14);
}

.issueDot[data-tone="accent"] {
  border-color: #706bd8;
  background: rgba(94,106,210,.22);

  box-shadow:
    0 0 8px rgba(94,106,210,.15);
}

.issueDot[data-tone="muted"] {
  border-color: #52555b;
}

.issueTitle {
  overflow: hidden;

  color: #d0d1d4;

  font-size: 12px;
  line-height: 1.42;
  font-weight: 470;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.issueDesc {
  max-width: 820px;

  margin-top: 2px;

  overflow: hidden;

  color: #64676e;

  font-size: 10px;
  line-height: 1.48;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.issueMeta {
  flex: 0 0 auto;

  color: #696c73;

  font-size: 10px;
  text-align: right;
}

.link {
  color: #84878e;

  text-decoration: none;

  transition: color .12s ease;
}

.link:hover {
  color: #d3d4d7;
}

.awaitingLabel {
  color: #565960;

  font-size: 10px;
}

.mono {
  font-family: var(--font-mono);
}

.truncate {
  max-width: 340px;

  display: block;
  overflow: hidden;

  white-space: nowrap;
  text-overflow: ellipsis;
}


/* BADGES */

.badge {
  min-height: 18px;

  display: inline-flex;
  align-items: center;

  padding: 0 6px;

  border: 1px solid rgba(255,255,255,.06);
  border-radius: 5px;

  background: rgba(255,255,255,.018);

  color: #777a82;

  font-size: 9px;
  font-weight: 560;
}

.badgeDanger {
  color: #cb7077;

  border-color: rgba(211,95,103,.14);
  background: rgba(211,95,103,.045);
}

.badgeWarning {
  color: #c0a048;

  border-color: rgba(203,166,48,.14);
  background: rgba(203,166,48,.045);
}

.badgeAccent {
  color: #928ce5;

  border-color: rgba(94,106,210,.16);
  background: rgba(94,106,210,.060);
}

.badgeMuted {
  color: #6e7178;
}

.badgeSuccess {
  color: #67af79;

  border-color: rgba(72,168,104,.14);
  background: rgba(72,168,104,.045);
}


/* GENERIC INNER SURFACES */

.card,
.formCard,
.progressCard,
.errorCard,
.scoreCard {
  border: 1px solid rgba(255,255,255,.058);
  border-radius: 9px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.012),
      transparent
    ),
    rgba(8,9,11,.30);
}

.card {
  padding: 17px;
}


/* EMPTY STATE */

.emptyState {
  min-height: 390px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 46px;

  border: 1px solid rgba(255,255,255,.055);
  border-radius: 9px;

  background:
    radial-gradient(
      380px 210px at 50% 15%,
      rgba(94,106,210,.045),
      transparent 72%
    ),
    rgba(8,9,11,.28);

  text-align: center;
}

.emptyIconWrap {
  width: 37px;
  height: 37px;

  display: grid;
  place-items: center;

  margin-bottom: 13px;

  border: 1px solid rgba(255,255,255,.075);
  border-radius: 8px;

  background:
    linear-gradient(
      145deg,
      rgba(94,106,210,.09),
      rgba(255,255,255,.012)
    );

  color: #8580d8;
}

.emptyIcon {
  color: inherit;
}

.emptyTitle {
  margin: 0 0 6px;

  color: #dadadd;

  font-size: 13px;
  font-weight: 560;
}

.emptyDescription {
  max-width: 430px;

  margin: 0;

  color: #686b72;

  font-size: 11px;
  line-height: 1.55;
}

.emptyAction {
  min-height: 30px;

  display: inline-flex;
  align-items: center;

  margin-top: 17px;
  padding: 0 11px;

  border: 1px solid rgba(255,255,255,.09);
  border-radius: 6px;

  background: #e3e3e5;
  color: #141518;

  font-size: 10px;
  font-weight: 620;

  text-decoration: none;

  transition:
    background .12s ease,
    transform .12s ease;
}

.emptyAction:hover {
  background: #f0f0f1;
}


/* FORMS */

.formGroup {
  display: grid;

  gap: 6px;

  margin-bottom: 14px;
}

.formLabel {
  color: #81838a;

  font-size: 10px;
  font-weight: 560;
}

.formInput {
  width: 100%;
  height: 34px;

  padding: 0 10px;

  outline: none;

  border: 1px solid rgba(255,255,255,.07);
  border-radius: 6px;

  background: rgba(7,8,10,.55);
  color: #dedee0;

  font-size: 11px;

  transition:
    border-color .12s ease,
    box-shadow .12s ease;
}

.formInput:focus {
  border-color: rgba(94,106,210,.34);

  box-shadow:
    0 0 0 3px rgba(94,106,210,.055);
}

.formError {
  color: #cc626a;

  font-size: 10px;
}

.primaryButton {
  min-height: 30px;

  padding: 0 12px;

  border: 1px solid rgba(255,255,255,.10);
  border-radius: 6px;

  background:
    linear-gradient(
      180deg,
      #6f6cdb,
      #5e63c9
    );

  color: #fff;

  font-size: 10px;
  font-weight: 620;

  cursor: pointer;

  box-shadow:
    inset 0 1px rgba(255,255,255,.14);
}

.primaryButton:hover {
  filter: brightness(1.07);
}

.backLink {
  color: #70737a;

  font-size: 10px;

  text-decoration: none;
}

.backLink:hover {
  color: #bebfc3;
}


/* SCORE PANELS */

.scoreGrid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));

  gap: 8px;
}

.scoreCard {
  padding: 16px;
}

.scoreValue {
  margin: 0;

  color: #e1e1e3;

  font-family: var(--font-mono);

  font-size: 23px;
  font-weight: 580;

  letter-spacing: -.035em;
}

.scoreLabel {
  margin: 6px 0 0;

  color: #666970;

  font-size: 9px;

  letter-spacing: .05em;
  text-transform: uppercase;
}


/* PROGRESS */

.progressTitle,
.errorTitle {
  margin: 0;

  color: #dadadd;

  font-size: 13px;
  font-weight: 560;
}

.progressStep {
  min-height: 30px;

  display: flex;
  align-items: center;

  gap: 8px;

  color: #696c73;

  font-size: 10px;
}

.progressDot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #6768d4;

  box-shadow:
    0 0 8px rgba(94,106,210,.22);
}

.progressStepLabel {
  color: #7c7f86;
}

.progressHint,
.errorDesc {
  margin: 6px 0 0;

  color: #62656c;

  font-size: 10px;
  line-height: 1.5;
}


/* MAKE THIRD-PARTY / FEATURE CONTROLS FEEL PART OF THE SAME APP */

.pageBody button {
  transition:
    border-color .12s ease,
    background .12s ease,
    color .12s ease;
}

.pageBody table {
  width: 100%;
  border-collapse: collapse;
}

.pageBody th {
  color: #8b8d94;
  font-size: 10px;
  font-weight: 560;
}

.pageBody td {
  color: #c7c8cc;
  font-size: 11px;
}

.pageBody hr {
  border: 0;
  border-top: 1px solid rgba(255,255,255,.05);
}


/* MOBILE */

@media (max-width: 900px) {
  .pageBody {
    width: calc(100% - 24px);
    min-height: 0;

    margin: 12px auto 24px;
    padding: 18px;
  }

  .statGrid,
  .scoreGrid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

@media (max-width: 600px) {
  .statGrid,
  .scoreGrid {
    grid-template-columns: 1fr;
  }

  .statCard + .statCard {
    border-left: 0 !important;
    border-top: 1px solid rgba(255,255,255,.05) !important;
  }

  .issueRow {
    align-items: flex-start;
    flex-direction: column;
  }

  .issueMeta {
    width: 100%;
    text-align: left;
  }
}
