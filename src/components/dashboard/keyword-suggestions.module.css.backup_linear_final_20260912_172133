.container {
  position: relative;

  margin: 18px 0 0;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 12px;

  background:
    radial-gradient(
      650px 260px at 10% -150px,
      rgba(112,118,149,.068),
      transparent 70%
    ),
    linear-gradient(
      180deg,
      rgba(255,255,255,.017),
      rgba(255,255,255,.003)
    ),
    var(--surface);

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.018),
    0 20px 55px rgba(0,0,0,.10);
}

.header {
  min-height: 67px;

  display: flex;
  align-items: center;
  gap: 11px;

  padding: 0 17px;

  border-bottom: 1px solid var(--border);
}

.icon {
  flex-shrink: 0;

  color: #8c86e8;

  filter:
    drop-shadow(0 0 8px rgba(140,134,232,.14));
}

.title {
  color: #d0d1d5;

  font-size: 13px;
  font-weight: 580;
}

.subtitle {
  margin-top: 3px;

  color: #73777f;

  font-size: 11px;
}

.searchRow {
  min-height: 55px;

  display: flex;
  align-items: center;
  gap: 8px;

  padding: 10px 16px;

  border-bottom: 1px solid var(--border);
}

.searchBox {
  flex: 1;

  min-height: 34px;

  display: flex;
  align-items: center;
  gap: 7px;

  padding: 0 10px;

  border: 1px solid var(--border);
  border-radius: 7px;

  background:
    rgba(7,8,9,.48);
}

.searchIcon {
  flex-shrink: 0;

  color: #71757d;
}

.searchInput {
  width: 100%;

  padding: 8px 0;

  outline: none;
  border: 0;

  background: transparent;
  color: var(--primary);

  font-size: 11px;
}

.searchInput::placeholder {
  color: var(--muted);
}

.exploreButton {
  height: 34px;

  padding: 0 14px;

  border: 1px solid rgba(255,255,255,.085);
  border-radius: 7px;

  background:
    linear-gradient(
      180deg,
      #7472df,
      #6463ca
    );

  color: white;

  font-size: 11px;
  font-weight: 620;

  cursor: pointer;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.10),
    0 5px 15px rgba(65,62,150,.14);
}

.exploreButton:disabled {
  opacity: .45;

  cursor: not-allowed;
}

.error,
.rateLimitError,
.empty {
  margin: 0;
  padding: 12px 16px;

  border-bottom: 1px solid var(--border);

  font-size: 11px;
}

.error {
  color: var(--danger);
}

.rateLimitError {
  color: var(--warning);
}

.empty {
  color: var(--secondary);
}

.resultCount {
  color: var(--secondary);

  font-size: 11px;
}

.clickableRow {
  cursor: pointer;
}

.clickableRow:hover {
  background: rgba(255,255,255,.02);
}

.trendingBlock {
  margin: 0;
  padding: 13px 16px 15px;

  border: 0;
  border-bottom: 1px solid var(--border);
  border-radius: 0;

  background:
    rgba(255,255,255,.004);
}

.trendingHeader {
  display: flex;
  align-items: center;
  gap: 7px;

  margin-bottom: 10px;

  color: #b7b9be;

  font-size: 11px;
  font-weight: 570;
}

.trendingIcon {
  color: #d26a73;
}

.freeBadge {
  margin-left: 3px;
  padding: 2px 6px;

  border-radius: 5px;

  background: rgba(85,184,117,.07);
  color: #66bd80;

  font-size: 9px;
  font-weight: 520;
}

.trendingChips {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.chip {
  padding: 3px 7px;

  border: 1px solid rgba(255,255,255,.055);
  border-radius: 6px;

  background:
    rgba(255,255,255,.012);

  color: #82858c;

  font-size: 10px;
}

.chipRising::before {
  content: "";

  width: 5px;
  height: 5px;

  display: inline-block;

  margin-right: 5px;

  border-radius: 50%;

  background: #d96c76;
}

.trendBadge {
  display: inline-flex;
  align-items: center;
  gap: 4px;

  padding: 2px 6px;

  border-radius: 5px;

  font-family: var(--font-mono);
  font-size: 10px;
}

.trendUp {
  color: #6cc285;
  background: rgba(85,184,117,.08);
}

.trendDown {
  color: #d6747d;
  background: rgba(217,108,118,.08);
}

.trendFlat {
  color: #767a82;
  background: rgba(255,255,255,.025);
}

.difficultyBadge {
  min-width: 25px;
  min-height: 20px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0 6px;

  border-radius: 5px;

  font-size: 10px;
  font-weight: 620;
}

.difficultyBadge[data-tone="success"] {
  color: #6cc285;
  background: rgba(85,184,117,.08);
}

.difficultyBadge[data-tone="warning"] {
  color: #ceb04d;
  background: rgba(208,173,71,.08);
}

.difficultyBadge[data-tone="danger"] {
  color: #d6747d;
  background: rgba(217,108,118,.08);
}

.difficultyBadge[data-tone="muted"] {
  color: #72767e;
  background: rgba(255,255,255,.025);
}

.sourceBadge {
  display: inline-flex;
  align-items: center;
  gap: 4px;

  margin-left: 8px;
  padding: 2px 6px;

  border-radius: 5px;

  font-family: var(--font-mono);
  font-size: 9px;
}

.sourceCache {
  color: #69c082;
  background: rgba(85,184,117,.07);
}

.sourceFresh {
  color: #858990;
  background: rgba(255,255,255,.025);
}
