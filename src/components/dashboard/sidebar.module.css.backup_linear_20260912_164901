.sidebar {
  position: relative;
  z-index: 30;
  width: 232px;
  min-width: 232px;
  min-height: 100vh;
  padding: 11px 8px 24px;

  background:
    radial-gradient(
      260px 220px at 30% -35px,
      rgba(117,101,204,.095),
      transparent 72%
    ),
    linear-gradient(
      180deg,
      rgba(255,255,255,.018),
      transparent 160px
    ),
    #0b0c0f;

  border-right: 1px solid rgba(255,255,255,.065);
}

.switcher {
  height: 37px;
  display: flex;
  align-items: center;
  gap: 9px;

  margin-bottom: 7px;
  padding: 0 8px;

  border-radius: 7px;
  color: #ececf0;

  transition:
    background .14s ease,
    color .14s ease;
}

.switcher:hover {
  background: rgba(255,255,255,.044);
}

.logoMark {
  width: 18px;
  height: 18px;
  position: relative;
  flex: 0 0 auto;

  border-radius: 6px;

  background:
    linear-gradient(
      135deg,
      #ada5ff 0%,
      #766ce0 45%,
      #5c8fdd 100%
    );

  box-shadow:
    0 0 18px rgba(111,98,218,.20),
    inset 0 1px rgba(255,255,255,.30);
}

.logoMark::after {
  content: "";
  position: absolute;
  inset: 4px;
  border: 1px solid rgba(255,255,255,.65);
  border-radius: 3px;
  transform: rotate(45deg);
}

.switcherText {
  min-width: 0;
  flex: 1;

  font-size: 13px;
  font-weight: 590;
  letter-spacing: -.017em;
}

.chevron {
  color: #676a73;
}

.quickActions {
  display: flex;
  gap: 3px;
  padding: 0 5px;
  margin: 1px 0 15px;
}

.quickAction {
  width: 28px;
  height: 28px;

  display: grid;
  place-items: center;

  border: 0;
  border-radius: 6px;

  background: transparent;
  color: #676a72;

  cursor: pointer;
  transition: all .14s ease;
}

.quickAction:hover {
  background: rgba(255,255,255,.045);
  color: #b1b3ba;
}

.navGroup {
  margin-bottom: 10px;
}

.navGroupHeader {
  width: 100%;
  height: 25px;

  display: flex;
  align-items: center;
  gap: 5px;

  padding: 0 7px;

  border: 0;
  background: transparent;
  color: #555860;

  cursor: pointer;
}

.navGroupLabel {
  font-size: 9px;
  font-weight: 650;
  letter-spacing: .085em;
  text-transform: uppercase;
}

.navGroupChevron {
  transition: transform .15s ease;
}

.navGroupChevron[data-open="false"] {
  transform: rotate(-90deg);
}

.navItems {
  overflow: hidden;
  transition: max-height .17s ease;
}

.navItem {
  position: relative;

  height: 31px;

  display: flex;
  align-items: center;
  gap: 9px;

  margin: 1px 0;
  padding: 0 9px;

  border-radius: 6px;

  color: #7a7d85;

  font-size: 12px;
  font-weight: 460;
  text-decoration: none;

  transition:
    background .12s ease,
    color .12s ease;
}

.navItem svg {
  flex: 0 0 auto;
  color: #60636b;

  transition: color .12s ease;
}

.navItem:hover {
  background: rgba(255,255,255,.036);
  color: #c0c2c8;
}

.navItem:hover svg {
  color: #9a9da5;
}

.navItemActive {
  color: #e6e6e9;

  background:
    linear-gradient(
      90deg,
      rgba(121,109,224,.105),
      rgba(104,100,168,.045)
    );

  box-shadow:
    inset 0 0 0 1px rgba(154,143,255,.07);
}

.navItemActive::before {
  content: "";

  position: absolute;
  left: 0;
  top: 8px;
  bottom: 8px;

  width: 2px;

  border-radius: 99px;

  background: #9186f0;

  box-shadow:
    0 0 9px rgba(136,123,239,.52);
}

.navItemActive svg {
  color: #a79ef6;
}

@media (max-width: 900px) {
  .sidebar {
    width: 100%;
    min-width: 0;
    min-height: auto;

    border-right: 0;
    border-bottom: 1px solid var(--border);
  }
}
