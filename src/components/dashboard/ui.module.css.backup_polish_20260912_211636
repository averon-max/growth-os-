.pageBody {
  position: relative;

  width: 100%;
  max-width: 1480px;

  margin: 0 auto;

  padding: 40px 46px 100px;
}

.pageBody::before {
  content: "";

  position: absolute;
  z-index: -1;

  top: -80px;
  left: 30%;
  right: 5%;

  height: 360px;

  pointer-events: none;

  background:
    radial-gradient(
      ellipse,
      rgba(151,155,172,.045),
      transparent 68%
    );

  filter: blur(18px);
}

.pageHeader {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 24px;

  margin-bottom: 28px;
}

.pageTitle {
  margin: 0;

  color: #e6e7e9;

  font-size: 22px;
  font-weight: 590;

  letter-spacing: -.04em;
}

.pageSubtitle {
  margin: 7px 0 0;

  color: #777a81;

  font-size: 12px;
}

.sectionTitle {
  margin: 30px 0 10px;

  color: #92959c;

  font-size: 12px;
  font-weight: 560;
}

.statGrid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));

  overflow: hidden;

  margin-bottom: 18px;

  border: 1px solid var(--border);
  border-radius: 11px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.018),
      transparent
    ),
    var(--surface);
}

.statCard {
  min-height: 104px;

  padding: 19px 20px;

  border: 0 !important;

  background: transparent;
}

.statCard + .statCard {
  border-left: 1px solid var(--border) !important;
}

.statHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 10px;

  margin-bottom: 14px;
}

.statLabel {
  margin: 0;

  color: #777a82;

  font-size: 9px;
  font-weight: 620;

  letter-spacing: .06em;
  text-transform: uppercase;
}

.statAccent {
  width: 6px;
  height: 6px;

  flex: 0 0 auto;

  border-radius: 50%;
}

.statValue {
  margin: 0;

  color: #e6e7e9 !important;

  font-size: 27px;
  font-weight: 570;

  line-height: 1;

  letter-spacing: -.045em;
}

.group {
  position: relative;

  margin-top: 18px;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 11px;

  background:
    radial-gradient(
      600px 200px at 20% -120px,
      rgba(139,143,160,.045),
      transparent 70%
    ),
    linear-gradient(
      180deg,
      rgba(255,255,255,.014),
      transparent 120px
    ),
    var(--surface);

  box-shadow:
    0 24px 70px rgba(0,0,0,.10);
}

.groupHeader {
  min-height: 45px;

  display: flex;
  align-items: center;
  gap: 9px;

  padding: 0 15px;

  border-bottom: 1px solid var(--border);

  background: rgba(255,255,255,.005);
}

.groupLabel {
  color: #b5b7bc;

  font-size: 11px;
  font-weight: 570;
}

.groupCount {
  color: #62666d;

  font-family: var(--font-mono);
  font-size: 9px;
}

.groupHeaderAction {
  margin-left: auto;

  color: #81858c;

  font-size: 10px;

  text-decoration: none;
}

.groupHeaderAction:hover {
  color: #d2d3d6;
}

.issueRow {
  min-height: 60px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 10px 15px;

  border-bottom: 1px solid rgba(255,255,255,.038);

  transition: background .12s ease;
}

.issueRow:last-child {
  border-bottom: 0;
}

.issueRow:hover {
  background:
    linear-gradient(
      90deg,
      rgba(255,255,255,.022),
      rgba(255,255,255,.008)
    );
}

.issueMain {
  min-width: 0;

  display: flex;
  align-items: flex-start;

  gap: 11px;
}

.issueDot {
  width: 8px;
  height: 8px;

  flex: 0 0 auto;

  margin-top: 5px;

  border: 1px solid #5d6067;
  border-radius: 50%;
}

.issueDot[data-tone="success"] {
  border-color: var(--success);
  background: rgba(78,170,109,.13);
}

.issueDot[data-tone="warning"] {
  border-color: var(--warning);
  background: rgba(201,162,62,.13);
}

.issueDot[data-tone="danger"] {
  border-color: var(--danger);
  background: rgba(213,102,112,.13);
}

.issueDot[data-tone="accent"] {
  border-color: #7f79dd;
  background: rgba(94,106,210,.20);
}

.issueDot[data-tone="muted"] {
  border-color: #51545a;
}

.issueTitle {
  overflow: hidden;

  color: #d7d8db;

  font-size: 12px;
  line-height: 1.45;
  font-weight: 480;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.issueDesc {
  max-width: 850px;

  margin-top: 3px;

  overflow: hidden;

  color: #6e7178;

  font-size: 10px;
  line-height: 1.5;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.issueMeta {
  flex: 0 0 auto;

  color: #73767e;

  font-size: 10px;
  text-align: right;
}

.link {
  color: #8c8f96;

  text-decoration: none;
}

.link:hover {
  color: #e0e1e3;
}

.awaitingLabel {
  color: #63666d;

  font-size: 10px;
}

.mono {
  font-family: var(--font-mono);

  font-feature-settings: "tnum" 1;
}

.truncate {
  max-width: 360px;

  display: block;
  overflow: hidden;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.badge {
  min-height: 19px;

  display: inline-flex;
  align-items: center;

  padding: 0 6px;

  border: 1px solid rgba(255,255,255,.06);
  border-radius: 4px;

  background: rgba(255,255,255,.018);

  color: #7a7d84;

  font-size: 9px;
  font-weight: 560;
}

.badgeDanger {
  color: #d4767e;
  border-color: rgba(213,102,112,.14);
  background: rgba(213,102,112,.045);
}

.badgeWarning {
  color: #c8a64a;
  border-color: rgba(201,162,62,.14);
  background: rgba(201,162,62,.045);
}

.badgeAccent {
  color: #918be4;
  border-color: rgba(94,106,210,.16);
  background: rgba(94,106,210,.055);
}

.badgeMuted {
  color: #70737a;
}

.badgeSuccess {
  color: #66b77b;
  border-color: rgba(78,170,109,.14);
  background: rgba(78,170,109,.045);
}

.table {
  width: 100%;

  border-collapse: separate;
  border-spacing: 0;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 9px;

  background: var(--surface);
}

.table th {
  height: 38px;

  padding: 0 12px;

  border-bottom: 1px solid var(--border);

  color: #74777e;

  font-size: 9px;
  font-weight: 580;

  text-align: left;
  white-space: nowrap;
}

.table td {
  height: 45px;

  padding: 6px 12px;

  border-bottom: 1px solid rgba(255,255,255,.035);

  color: #c8c9cc;

  font-size: 11px;
}

.table tbody tr:last-child td {
  border-bottom: 0;
}

.table tbody tr:hover {
  background: rgba(255,255,255,.018);
}

.card,
.formCard,
.progressCard,
.errorCard,
.scoreCard {
  border: 1px solid var(--border);
  border-radius: 10px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.014),
      transparent
    ),
    var(--surface);

  box-shadow:
    0 20px 60px rgba(0,0,0,.08);
}

.card {
  padding: 17px;
}

.emptyState {
  min-height: 300px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 44px;

  text-align: center;
}

.emptyIconWrap {
  width: 36px;
  height: 36px;

  display: grid;
  place-items: center;

  margin-bottom: 13px;

  border: 1px solid var(--border);
  border-radius: 8px;

  background: var(--surface-2);

  color: #8580dc;
}

.emptyTitle {
  margin: 0 0 6px;

  color: #d9dade;

  font-size: 13px;
  font-weight: 570;
}

.emptyDescription {
  max-width: 440px;

  margin: 0;

  color: #70737a;

  font-size: 11px;
  line-height: 1.55;
}

.emptyAction {
  min-height: 30px;

  display: inline-flex;
  align-items: center;

  margin-top: 16px;
  padding: 0 11px;

  border: 1px solid rgba(255,255,255,.09);
  border-radius: 6px;

  background: #dfdfe1;
  color: #151618;

  font-size: 10px;
  font-weight: 620;

  text-decoration: none;
}

.primaryButton {
  min-height: 30px;

  padding: 0 11px;

  border: 1px solid rgba(255,255,255,.08);
  border-radius: 6px;

  background: #6665ca;
  color: #fff;

  font-size: 10px;
  font-weight: 620;

  cursor: pointer;
}

.formGroup {
  display: grid;

  gap: 6px;

  margin-bottom: 14px;
}

.formLabel {
  color: #83868d;

  font-size: 10px;
  font-weight: 560;
}

.formInput {
  width: 100%;
  height: 34px;

  padding: 0 10px;

  outline: none;

  border: 1px solid var(--border);
  border-radius: 6px;

  background: #0d0f10;
  color: #dddfe1;

  font-size: 11px;
}

.formInput:focus {
  border-color: rgba(94,106,210,.32);

  box-shadow:
    0 0 0 3px rgba(94,106,210,.05);
}

.formError {
  color: var(--danger);

  font-size: 10px;
}

.backLink {
  color: #74777e;

  font-size: 10px;

  text-decoration: none;
}

.scoreGrid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));

  gap: 9px;
}

.scoreCard {
  padding: 17px;
}

.scoreValue {
  margin: 0;

  color: #e1e2e4;

  font-family: var(--font-mono);

  font-size: 24px;
  font-weight: 570;
}

.scoreLabel {
  margin: 6px 0 0;

  color: #686b72;

  font-size: 9px;

  text-transform: uppercase;
}

.progressTitle,
.errorTitle {
  margin: 0;

  color: #dadbde;

  font-size: 13px;
  font-weight: 570;
}

.progressStep {
  min-height: 31px;

  display: flex;
  align-items: center;

  gap: 8px;

  color: #6f7279;

  font-size: 10px;
}

.progressDot {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #6e6bd2;
}

.progressStepLabel {
  color: #7d8087;
}

.progressHint,
.errorDesc {
  margin: 6px 0 0;

  color: #666970;

  font-size: 10px;
  line-height: 1.5;
}

.editorialWorkspace {
  display: grid;

  grid-template-columns:
    minmax(0, .9fr)
    minmax(0, 1.1fr);

  gap: 18px;

  align-items: start;
}

.editorialWorkspace > .group {
  margin-top: 0;
}

@media (max-width: 1050px) {
  .editorialWorkspace {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 900px) {
  .pageBody {
    padding: 24px 20px 70px;
  }

  .statGrid,
  .scoreGrid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

@media (max-width: 600px) {
  .statGrid,
  .scoreGrid {
    grid-template-columns: 1fr;
  }

  .statCard + .statCard {
    border-left: 0 !important;
    border-top: 1px solid var(--border) !important;
  }

  .issueRow {
    align-items: flex-start;
    flex-direction: column;
  }
}
