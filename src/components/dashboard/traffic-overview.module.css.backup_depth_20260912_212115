/* LINEAR_ANALYTICS_PASS */

:global(.recharts-cartesian-grid line) {
  stroke: rgba(255,255,255,.055) !important;
}

:global(.recharts-cartesian-axis-line) {
  stroke: rgba(255,255,255,.075) !important;
}

:global(.recharts-cartesian-axis-tick-line) {
  stroke: rgba(255,255,255,.06) !important;
}

:global(.recharts-cartesian-axis-tick-value) {
  fill: #656970 !important;
  font-size: 10px !important;
}

:global(.recharts-bar-rectangle path),
:global(.recharts-bar-rectangle rect) {
  fill: #178b9b !important;
  fill-opacity: .62 !important;
}

:global(.recharts-tooltip-wrapper) {
  outline: none !important;
}

:global(.recharts-default-tooltip) {
  border: 1px solid rgba(255,255,255,.075) !important;
  border-radius: 7px !important;
  background: #17191c !important;
  box-shadow: 0 18px 50px rgba(0,0,0,.32) !important;
}

:global(.recharts-tooltip-label) {
  color: #a7aab0 !important;
}

:global(.recharts-tooltip-item) {
  color: #d3d4d7 !important;
}

