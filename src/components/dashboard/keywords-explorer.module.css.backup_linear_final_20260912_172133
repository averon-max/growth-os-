.workspace {
  position: relative;

  margin-top: 18px;
  padding: 16px 16px 0;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 12px;

  background:
    radial-gradient(
      620px 240px at 18% -130px,
      rgba(112,117,145,.065),
      transparent 70%
    ),
    linear-gradient(
      180deg,
      rgba(255,255,255,.016),
      rgba(255,255,255,.003)
    ),
    var(--surface);

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.018),
    0 18px 50px rgba(0,0,0,.09);
}

.workspace :global(table) {
  margin-left: -16px;
  width: calc(100% + 32px);

  border: 0;
  border-top: 1px solid var(--border);
  border-radius: 0;

  box-shadow: none;
}

.loading {
  padding: 30px 4px;

  color: var(--secondary);

  font-size: 12px;
}

.filters {
  display: flex;
  gap: 7px;

  margin-bottom: 14px;
}

.select {
  height: 32px;

  padding: 0 10px;

  outline: none;

  border: 1px solid var(--border);
  border-radius: 7px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.025),
      rgba(255,255,255,.005)
    ),
    var(--surface-2);

  color: #adafb5;

  font-size: 11px;
}

.select:hover {
  border-color: var(--border-hover);
}

.searchBox {
  min-height: 32px;

  display: flex;
  align-items: center;
  gap: 7px;

  padding: 0 10px;

  border: 1px solid var(--border);
  border-radius: 7px;

  background: rgba(7,8,9,.45);
}

.searchIcon {
  flex-shrink: 0;

  color: #70747c;
}

.searchInput {
  width: 100%;

  padding: 7px 0;

  outline: none;
  border: 0;

  background: transparent;
  color: var(--primary);

  font-size: 11px;
}

.searchInput::placeholder {
  color: var(--muted);
}

.clickableRow {
  cursor: pointer;
}

.clickableRow:hover {
  background: rgba(255,255,255,.02);
}

.pagination {
  min-height: 48px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;

  margin: 0 -16px;

  border-top: 1px solid var(--border);
}

.pageButton {
  padding: 5px 10px;

  border: 0;

  background: transparent;
  color: #8d9097;

  font-size: 11px;

  cursor: pointer;
}

.pageButton:hover {
  color: #dedee1;
}

.pageButton:disabled {
  color: #50545b;

  cursor: not-allowed;
}

.pageLabel {
  color: #686c74;

  font-family: var(--font-mono);
  font-size: 10px;
}

.emptyRow {
  padding: 38px 0 !important;

  color: var(--secondary) !important;

  text-align: center;
}
