@import "tailwindcss";

:root {
  --background: #08090a;
  --surface: #101113;
  --surface-2: #131416;
  --surface-3: #17181b;

  --border: rgba(255,255,255,.060);
  --border-hover: rgba(255,255,255,.095);
  --border-strong: rgba(255,255,255,.13);

  --primary: #e6e6e8;
  --secondary: #92949a;
  --muted: #5e6067;
  --faint: #414349;

  --accent: #5e6ad2;
  --accent-soft: rgba(94,106,210,.105);
  --accent-violet: #7470df;

  --cyan: #1795a8;
  --success: #4da968;
  --warning: #c9a43d;
  --danger: #d2646d;

  --font-display: var(--font-inter), -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-body: var(--font-inter), -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: "SF Mono", "SFMono-Regular", Menlo, Monaco, Consolas, monospace;

  --bg: var(--background);
  --bg-elevated: var(--surface-2);
  --elevated: var(--surface-2);
  --text: var(--primary);
  --text-dim: var(--secondary);
  --text-faint: var(--muted);
  --positive: var(--success);
  --positive-soft: rgba(77,169,104,.10);
  --negative: var(--danger);
}

* {
  box-sizing: border-box;
}

html {
  background: #08090a;
}

body {
  margin: 0;
  min-height: 100vh;
  background: #08090a;
  color: var(--primary);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  text-rendering: geometricPrecision;
}

button,
input,
select,
textarea {
  font: inherit;
}

a {
  color: inherit;
}

::selection {
  background: rgba(94,106,210,.35);
  color: #fff;
}

:focus-visible {
  outline: 1px solid rgba(116,112,223,.65);
  outline-offset: 2px;
}

.font-mono-num,
.mono {
  font-family: var(--font-mono);
  font-feature-settings: "tnum" 1;
}

* {
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,.11) transparent;
}

*::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

*::-webkit-scrollbar-track {
  background: transparent;
}

*::-webkit-scrollbar-thumb {
  border: 2px solid transparent;
  border-radius: 999px;
  background: rgba(255,255,255,.11);
  background-clip: padding-box;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .001ms !important;
    transition-duration: .001ms !important;
  }
}
