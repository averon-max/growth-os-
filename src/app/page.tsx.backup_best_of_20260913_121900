function CodePane({
  title,
  good,
}: {
  title: string;
  good: boolean;
}) {
  return (
    <div className={styles.codePane}>
      <div className={styles.codeTitle}>
        {title}
      </div>

      <CodeLine number="01">
        <b>import</b> fetchPage from crawler
      </CodeLine>

      <CodeLine number="02">
        <em>const</em> page = await fetchPage()
      </CodeLine>

      <CodeLine number="03" changed good={good}>
        <b>const</b> canonical = {good ? "resolvedUrl" : "pageUrl"}
      </CodeLine>

      <CodeLine number="04">
        <em>const</em> result = analyzePage()
      </CodeLine>

      <CodeLine number="05">
        {" "}
      </CodeLine>

      <CodeLine number="06" changed good={good}>
        {good ? "verifyAfterApply()" : "applyFix()"}
      </CodeLine>

      <CodeLine number="07">
        <b>return</b> result
      </CodeLine>
    </div>
  );
}

function CodeLine({
  number,
  children,
  changed = false,
  good = false,
}: {
  number: string;
  children: ReactNode;
  changed?: boolean;
  good?: boolean;
}) {
  return (
    <div
      className={
        changed
          ? good
            ? styles.codeGood
            : styles.codeBad
          : styles.codeLine
      }
    >
      <span>{number}</span>
      <code>{children}</code>
    </div>
  );
}

