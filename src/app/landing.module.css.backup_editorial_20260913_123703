.page {
  --landing-bg: var(--background, #090a0b);
  --landing-sidebar: var(--sidebar, #0d0f10);
  --landing-workspace: var(--workspace, #101214);
  --landing-surface: var(--surface, #141618);
  --landing-surface-2: var(--surface-2, #181a1d);

  --landing-border: var(--border, rgba(255,255,255,.06));
  --landing-primary: var(--primary, #e6e6e8);
  --landing-secondary: var(--secondary, #73777e);

  min-height: 100vh;

  overflow: hidden;

  background: var(--landing-bg);
  color: var(--landing-primary);
}

.page * {
  box-sizing: border-box;
}

.page a {
  color: inherit;
}

.page button {
  font: inherit;
}

.header {
  position: relative;
  z-index: 20;

  padding: 18px 20px 0;
}

.navShell {
  width: min(1320px, 100%);
  height: 58px;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  margin: 0 auto;
  padding: 0 12px 0 15px;

  border: 1px solid var(--landing-border);
  border-radius: 12px;

  background:
    color-mix(
      in srgb,
      var(--landing-surface) 92%,
      transparent
    );

  box-shadow:
    0 16px 44px rgba(0,0,0,.22);

  backdrop-filter: blur(16px);
}

.brand {
  width: max-content;

  display: inline-flex;
  align-items: center;

  gap: 9px;

  color: var(--landing-primary);

  font-size: 13px;
  font-weight: 600;

  text-decoration: none;
}

.logo {
  width: 20px;
  height: 20px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  gap: 2px;

  padding-left: 4px;

  border: 1px solid var(--landing-border);
  border-radius: 5px;

  background: var(--landing-surface-2);
}

.logo i {
  height: 2px;

  display: block;

  border-radius: 2px;

  background: var(--landing-primary);
}

.logo i:nth-child(1) {
  width: 11px;
}

.logo i:nth-child(2) {
  width: 8px;
}

.logo i:nth-child(3) {
  width: 5px;
}

.nav {
  display: flex;

  gap: 27px;
}

.nav a,
.account > a:first-child {
  color: var(--landing-secondary);

  font-size: 10px;

  text-decoration: none;

  transition: color .18s ease;
}

.nav a:hover,
.account > a:first-child:hover {
  color: var(--landing-primary);
}

.account {
  justify-self: end;

  display: flex;
  align-items: center;

  gap: 18px;
}

.signup,
.primaryButton {
  height: 32px;

  display: inline-flex;
  align-items: center;

  gap: 7px;

  padding: 0 13px;

  border-radius: 6px;

  background: var(--landing-primary);
  color: var(--landing-bg);

  font-size: 9px;
  font-weight: 650;

  text-decoration: none;
}


/* HERO */

.hero {
  position: relative;

  padding: 51px 20px 0;
}

.heroLine {
  width: min(1280px, 100%);

  display: flex;
  align-items: center;
  justify-content: space-between;

  margin: 0 auto 14px;

  color: var(--landing-secondary);

  font-size: 7px;
}

.heroLine > div {
  display: flex;
  align-items: center;

  gap: 7px;
}

.liveDot {
  width: 5px;
  height: 5px;

  display: inline-block;

  border-radius: 50%;

  background: var(--success, #64a879);
}

.productShell {
  width: min(1380px, 97vw);
  height: 650px;

  margin: 0 auto;

  overflow: hidden;

  border: 1px solid var(--landing-border);
  border-radius: 11px;

  background: var(--landing-workspace);

  box-shadow:
    0 44px 120px rgba(0,0,0,.34);

  animation:
    productEnter .75s cubic-bezier(.2,.72,.2,1) both;
}

.productTopbar {
  height: 43px;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  padding: 0 12px;

  border-bottom: 1px solid var(--landing-border);

  background: var(--landing-surface);
}

.topbarBrand,
.topActions,
.websiteSelector {
  display: flex;
  align-items: center;

  gap: 8px;
}

.topbarBrand {
  color: var(--landing-primary);

  font-size: 8px;
}

.topDivider {
  width: 1px;
  height: 15px;

  background: var(--landing-border);
}

.websiteSelector,
.workspaceLabel,
.topActions {
  color: var(--landing-secondary);

  font-size: 7px;
}

.workspaceLabel {
  justify-self: center;
}

.topActions {
  justify-self: end;
}

.avatar {
  width: 21px;
  height: 21px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  border: 1px solid var(--landing-border);
  border-radius: 50%;

  background: var(--landing-surface-2);
}

.productBody {
  height: calc(100% - 43px);

  display: grid;
  grid-template-columns: 195px 1fr;
}

.sidebar {
  position: relative;

  padding: 12px 8px;

  border-right: 1px solid var(--landing-border);

  background: var(--landing-sidebar);
}

.sidebarLink {
  height: 30px;

  display: flex;
  align-items: center;

  gap: 8px;

  padding: 0 8px;

  border-radius: 5px;

  color: var(--landing-secondary);

  font-size: 8px;
}

.sidebarActive {
  background: var(--landing-surface-2);
  color: var(--landing-primary);
}

.sidebarActive svg {
  color: var(--accent, #8b75d7);
}

.sidebarBottom {
  position: absolute;

  left: 8px;
  right: 8px;
  bottom: 12px;
}

.workspace {
  min-width: 0;

  background: var(--landing-workspace);
}

.workspaceHeader {
  min-height: 72px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 17px;

  border-bottom: 1px solid var(--landing-border);
}

.workspaceHeader > div:first-child {
  display: flex;
  flex-direction: column;

  gap: 4px;
}

.workspaceHeader span {
  color: var(--landing-secondary);

  font-size: 7px;
}

.workspaceHeader h1 {
  margin: 0;

  color: var(--landing-primary);

  font-size: 14px;
  font-weight: 560;
}

.workspaceActions {
  display: flex;

  gap: 6px;
}

.workspaceActions button {
  height: 29px;

  display: inline-flex;
  align-items: center;

  gap: 6px;

  padding: 0 9px;

  border: 1px solid var(--landing-border);
  border-radius: 5px;

  background: var(--landing-surface);
  color: var(--landing-secondary);

  font-size: 7px;
}

.workspaceActions button span {
  color: var(--landing-primary);
}

.workspaceActions .syncButton {
  background: var(--landing-primary);
  color: var(--landing-bg);
}

.presetBar {
  min-height: 52px;

  display: flex;
  align-items: center;

  gap: 5px;

  padding: 0 14px;

  overflow-x: auto;

  border-bottom: 1px solid var(--landing-border);
}

.presetBar button {
  height: 27px;

  display: inline-flex;
  align-items: center;

  gap: 6px;

  padding: 0 8px;

  flex: 0 0 auto;

  border: 1px solid var(--landing-border);
  border-radius: 5px;

  background: var(--landing-surface);
  color: var(--landing-secondary);

  font-size: 7px;
}

.workspaceGrid {
  height: calc(100% - 124px);

  display: grid;
  grid-template-columns: 1fr 1.15fr;

  gap: 10px;

  padding: 10px;
}

.realSignals,
.explorer {
  overflow: hidden;

  border: 1px solid var(--landing-border);
  border-radius: 7px;

  background:
    color-mix(
      in srgb,
      var(--landing-sidebar) 74%,
      var(--landing-workspace)
    );
}

.panelHeading {
  height: 48px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 11px;

  border-bottom: 1px solid var(--landing-border);
}

.panelHeading > div {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.panelHeading span {
  color: var(--landing-secondary);

  font-size: 6px;
}

.panelHeading strong {
  color: var(--landing-primary);

  font-size: 8px;
  font-weight: 520;
}

.sourceBadge {
  padding: 4px 6px;

  border: 1px solid var(--landing-border);
  border-radius: 4px;

  background: var(--landing-surface);

  color: var(--landing-secondary) !important;
}

.signalBody {
  padding: 9px;
}

.signalBody :global(.group) {
  margin-bottom: 10px !important;
}

.signalBody :global(.issueRow) {
  min-height: 43px;
}

.explorerControls {
  min-height: 47px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 8px;

  padding: 0 9px;

  border-bottom: 1px solid var(--landing-border);
}

.searchControl {
  width: 210px;
  height: 27px;

  display: flex;
  align-items: center;

  gap: 7px;

  padding: 0 8px;

  border: 1px solid var(--landing-border);
  border-radius: 5px;

  background: var(--landing-sidebar);
  color: var(--landing-secondary);

  font-size: 7px;
}

.explorerControls button {
  height: 27px;

  padding: 0 8px;

  border: 1px solid var(--landing-border);
  border-radius: 5px;

  background: var(--landing-surface);
  color: var(--landing-secondary);

  font-size: 7px;
}

.tableHead {
  height: 35px;

  display: grid;
  grid-template-columns: 1.6fr .7fr .7fr .7fr;
  align-items: center;

  padding: 0 11px;

  border-bottom: 1px solid var(--landing-border);

  color: var(--landing-secondary);

  font-size: 6px;

  text-transform: uppercase;
  letter-spacing: .04em;
}

.emptyExplorer {
  min-height: 260px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 25px;

  text-align: center;
}

.emptyExplorer svg {
  color: var(--landing-secondary);
}

.emptyExplorer strong {
  margin-top: 12px;

  color: var(--landing-primary);

  font-size: 9px;
  font-weight: 520;
}

.emptyExplorer span {
  max-width: 270px;

  margin-top: 7px;

  color: var(--landing-secondary);

  font-size: 7px;
  line-height: 1.6;
}

.heroRail {
  width: min(1280px, 100%);

  display: grid;
  grid-template-columns: repeat(4, 1fr);

  margin: 0 auto;

  border-bottom: 1px solid var(--landing-border);
}

.heroRail > div {
  min-height: 70px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  gap: 7px;

  padding: 0 17px;

  border-right: 1px solid var(--landing-border);
}

.heroRail > div:last-child {
  border-right: 0;
}

.heroRail span {
  color: var(--landing-secondary);

  font-size: 6px;
}

.heroRail strong {
  color: var(--landing-secondary);

  font-size: 8px;
  font-weight: 500;
}


/* SECTIONS */

.section {
  width: min(1280px, calc(100% - 40px));

  margin: 0 auto;
  padding: 120px 0;

  border-bottom: 1px solid var(--landing-border);
}

.sectionIntro {
  display: grid;
  grid-template-columns: 235px 1fr;

  gap: 65px;

  margin-bottom: 48px;
}

.sectionIndex {
  display: flex;

  gap: 13px;

  padding-top: 6px;

  color: var(--landing-secondary);

  font-size: 7px;

  letter-spacing: .06em;
}

.sectionIntro h2 {
  max-width: 620px;

  margin: 0;

  color: var(--landing-primary);

  font-size: clamp(28px, 3vw, 40px);
  font-weight: 500;

  line-height: 1.04;

  letter-spacing: -.043em;
}

.sectionIntro p {
  max-width: 560px;

  margin: 16px 0 0;

  color: var(--landing-secondary);

  font-size: 9px;
  line-height: 1.7;
}


/* SIGNALS */

.signalsScene,
.audienceScene,
.workflowScene {
  overflow: hidden;

  border: 1px solid var(--landing-border);
  border-radius: 9px;

  background: var(--landing-workspace);

  box-shadow:
    0 28px 80px rgba(0,0,0,.2);
}

.sceneHeader {
  height: 43px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 12px;

  border-bottom: 1px solid var(--landing-border);

  background: var(--landing-surface);

  color: var(--landing-secondary);

  font-size: 7px;
}

.sceneHeader > div {
  display: flex;
  align-items: center;

  gap: 7px;

  color: var(--landing-primary);
}

.signalsColumns {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.signalDefinition {
  min-height: 145px;

  display: grid;
  grid-template-columns: 10px 1fr;

  gap: 10px;

  padding: 24px;

  border-right: 1px solid var(--landing-border);
  border-bottom: 1px solid var(--landing-border);
}

.signalDefinition:nth-child(3n) {
  border-right: 0;
}

.signalDefinition:nth-last-child(-n+3) {
  border-bottom: 0;
}

.signalDefinition strong {
  color: var(--landing-primary);

  font-size: 9px;
  font-weight: 520;
}

.signalDefinition p {
  max-width: 270px;

  margin: 8px 0 0;

  color: var(--landing-secondary);

  font-size: 7px;
  line-height: 1.6;
}


/* AUDIENCE */

.rangeTabs {
  display: flex;

  gap: 2px;

  padding: 2px;

  border: 1px solid var(--landing-border);
  border-radius: 5px;

  background: var(--landing-sidebar);
}

.rangeTabs span {
  min-width: 25px;
  height: 21px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 3px;

  color: var(--landing-secondary);

  font-size: 6px;
}

.rangeTabs .rangeActive {
  background: var(--landing-surface-2);
  color: var(--landing-primary);
}

.audienceStatus {
  display: grid;
  grid-template-columns: repeat(4, 1fr);

  border-bottom: 1px solid var(--landing-border);
}

.audienceStat {
  min-height: 66px;

  padding: 12px;

  border-right: 1px solid var(--landing-border);
}

.audienceStat:last-child {
  border-right: 0;
}

.audienceStat > div {
  display: flex;
  align-items: center;

  gap: 6px;

  color: var(--landing-secondary);

  font-size: 7px;
}

.audienceStat strong {
  display: block;

  margin-top: 10px;

  color: var(--landing-primary);

  font-size: 8px;
  font-weight: 500;
}

.audienceBody {
  display: grid;
  grid-template-columns: 1fr 260px;
}

.timeline {
  border-right: 1px solid var(--landing-border);
}

.timelineHeader {
  height: 52px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 13px;

  border-bottom: 1px solid var(--landing-border);
}

.timelineHeader > div {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.timelineHeader span {
  color: var(--landing-secondary);

  font-size: 6px;
}

.timelineHeader strong {
  color: var(--landing-primary);

  font-size: 8px;
  font-weight: 520;
}

.timelineEmpty {
  position: relative;

  height: 290px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  background: var(--landing-sidebar);
}

.gridLines {
  position: absolute;

  inset: 0;

  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

.gridLines i {
  height: 1px;

  background:
    color-mix(
      in srgb,
      var(--landing-border) 60%,
      transparent
    );
}

.dataReady {
  position: relative;
  z-index: 2;

  display: flex;
  align-items: center;

  gap: 7px;

  color: var(--landing-secondary);

  font-size: 7px;
}

.breakdownPane {
  background: var(--landing-workspace);
}

.breakdownBlock {
  min-height: 114px;

  padding: 14px;

  border-bottom: 1px solid var(--landing-border);
}

.breakdownBlock:last-child {
  border-bottom: 0;
}

.breakdownBlock > div {
  display: flex;
  align-items: center;

  gap: 7px;

  color: var(--landing-secondary);

  font-size: 7px;
}

.breakdownBlock strong {
  font-weight: 520;
}

.breakdownBlock > span {
  width: 100%;
  height: 3px;

  display: block;

  margin-top: 10px;

  border-radius: 2px;

  background:
    color-mix(
      in srgb,
      var(--landing-border) 90%,
      transparent
    );
}

.breakdownBlock > span:nth-child(2) {
  width: 82%;
}

.breakdownBlock > span:nth-child(3) {
  width: 61%;
}

.breakdownBlock > span:nth-child(4) {
  width: 43%;
}


/* WORKFLOW */

.workflowGrid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);

  min-height: 270px;

  background-image:
    linear-gradient(
      var(--landing-border) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      var(--landing-border) 1px,
      transparent 1px
    );

  background-size: 28px 28px;
}

.workflowStep {
  position: relative;

  min-height: 270px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  padding: 24px;

  border-right: 1px solid var(--landing-border);

  background:
    color-mix(
      in srgb,
      var(--landing-workspace) 88%,
      transparent
    );
}

.workflowStep:last-child {
  border-right: 0;
}

.workflowStepTop {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 26px;
}

.workflowNumber {
  color: var(--landing-secondary);

  font-size: 6px;
}

.workflowIcon {
  width: 30px;
  height: 30px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid var(--landing-border);
  border-radius: 6px;

  background: var(--landing-surface);
}

.workflowIcon[data-tone="accent"] {
  color: var(--accent);
}

.workflowIcon[data-tone="warning"] {
  color: var(--warning);
}

.workflowIcon[data-tone="success"] {
  color: var(--success);
}

.workflowStep strong {
  color: var(--landing-primary);

  font-size: 10px;
  font-weight: 520;
}

.workflowStep > span:not(.workflowNumber):not(.workflowIcon) {
  margin-top: 6px;

  color: var(--landing-secondary);

  font-size: 7px;
}

.workflowArrow {
  position: absolute;

  right: -7px;
  top: 50%;
  z-index: 3;

  padding: 2px;

  background: var(--landing-workspace);
  color: var(--landing-secondary);
}


/* FINAL */

.final {
  width: min(1280px, calc(100% - 40px));
  min-height: 360px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 60px;

  margin: 0 auto;

  border-bottom: 1px solid var(--landing-border);
}

.final > div:first-child > span {
  color: var(--landing-secondary);

  font-size: 7px;

  letter-spacing: .07em;
}

.final h2 {
  max-width: 600px;

  margin: 13px 0 0;

  color: var(--landing-primary);

  font-size: clamp(29px, 3vw, 41px);
  font-weight: 500;

  letter-spacing: -.043em;
}

.final p {
  margin: 14px 0 0;

  color: var(--landing-secondary);

  font-size: 9px;
}

.finalActions {
  display: flex;

  gap: 7px;
}

.secondaryButton {
  height: 32px;

  display: inline-flex;
  align-items: center;

  padding: 0 12px;

  border: 1px solid var(--landing-border);
  border-radius: 6px;

  background: var(--landing-surface);
  color: var(--landing-secondary);

  font-size: 9px;

  text-decoration: none;
}


/* FOOTER */

.footer {
  width: min(1280px, calc(100% - 40px));
  min-height: 100px;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  margin: 0 auto;

  color: var(--landing-secondary);

  font-size: 7px;
}

.footer > div {
  justify-self: end;

  display: flex;

  gap: 20px;
}

.footer > div a {
  color: var(--landing-secondary);

  text-decoration: none;
}


/* MOTION */

@keyframes productEnter {
  from {
    opacity: 0;
    transform: translateY(22px) scale(.992);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes revealIn {
  from {
    opacity: .2;
    transform: translateY(30px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@supports (animation-timeline: view()) {
  .reveal {
    animation: revealIn linear both;
    animation-timeline: view();
    animation-range: entry 4% cover 27%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .productShell,
  .reveal {
    animation: none !important;
  }
}


/* RESPONSIVE */

@media (max-width: 1000px) {
  .nav {
    display: none;
  }

  .productShell {
    width: 1100px;

    transform: scale(.78);
    transform-origin: top left;
  }

  .hero {
    overflow: hidden;
  }

  .heroRail {
    margin-top: -140px;
  }

  .sectionIntro {
    grid-template-columns: 180px 1fr;
  }
}

@media (max-width: 720px) {
  .header {
    padding-left: 12px;
    padding-right: 12px;
  }

  .account > a:first-child {
    display: none;
  }

  .hero {
    padding-left: 12px;
    padding-right: 12px;
  }

  .heroLine > span:last-child {
    display: none;
  }

  .productShell {
    width: 1080px;
    height: 610px;

    transform: scale(.53);
  }

  .heroRail {
    grid-template-columns: 1fr 1fr;

    margin-top: -280px;
  }

  .heroRail > div:nth-child(2) {
    border-right: 0;
  }

  .section {
    padding: 85px 0;
  }

  .sectionIntro {
    grid-template-columns: 1fr;

    gap: 14px;
  }

  .signalsColumns {
    grid-template-columns: 1fr;
  }

  .signalDefinition,
  .signalDefinition:nth-child(3n) {
    border-right: 0;
    border-bottom: 1px solid var(--landing-border);
  }

  .audienceStatus {
    grid-template-columns: 1fr 1fr;
  }

  .audienceStat:nth-child(2) {
    border-right: 0;
  }

  .audienceBody {
    grid-template-columns: 1fr;
  }

  .timeline {
    border-right: 0;
    border-bottom: 1px solid var(--landing-border);
  }

  .workflowGrid {
    grid-template-columns: 1fr;
  }

  .workflowStep {
    min-height: 145px;

    border-right: 0;
    border-bottom: 1px solid var(--landing-border);
  }

  .workflowArrow {
    display: none;
  }

  .final {
    min-height: 340px;

    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .footer {
    grid-template-columns: 1fr;

    gap: 16px;

    padding: 27px 0;
  }

  .footer > div {
    justify-self: start;
  }
}
