@import "tailwindcss";

:root {
  --background: #08090b;
  --surface: #0d0f12;
  --surface-2: #111318;
  --surface-3: #15181d;

  --border: rgba(255,255,255,.072);
  --border-hover: rgba(255,255,255,.115);
  --border-strong: rgba(255,255,255,.14);

  --primary: #f2f3f5;
  --secondary: #9b9da4;
  --muted: #62656d;
  --faint: #454850;

  --accent: #7c72e8;
  --accent-2: #8d83f4;
  --accent-soft: rgba(124,114,232,.13);

  --blue: #6495ed;
  --cyan: #59b8c8;
  --pink: #c879bf;
  --green: #65b77b;
  --yellow: #d7b45d;

  --success: #65b77b;
  --warning: #d7ad58;
  --danger: #d86672;

  --font-display: var(--font-inter), -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-body: var(--font-inter), -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: "SF Mono", "SFMono-Regular", Menlo, Monaco, Consolas, monospace;

  --bg: var(--background);
  --bg-elevated: var(--surface-2);
  --elevated: var(--surface-2);
  --text: var(--primary);
  --text-dim: var(--secondary);
  --text-faint: var(--muted);
  --positive: var(--success);
  --positive-soft: rgba(101,183,123,.12);
  --negative: var(--danger);
}

* {
  box-sizing: border-box;
}

html {
  background: var(--background);
}

body {
  margin: 0;
  min-height: 100vh;
  background: var(--background);
  color: var(--primary);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  text-rendering: geometricPrecision;
}

button,
input,
select,
textarea {
  font: inherit;
}

a {
  color: inherit;
}

::selection {
  background: rgba(124,114,232,.34);
  color: #fff;
}

:focus-visible {
  outline: 1px solid rgba(139,130,244,.7);
  outline-offset: 2px;
}

.font-display {
  font-family: var(--font-display);
}

.font-mono-num,
.mono {
  font-family: var(--font-mono);
  font-feature-settings: "tnum" 1;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .001ms !important;
    transition-duration: .001ms !important;
  }
}
