import {
  NextRequest,
  NextResponse,
} from "next/server";

import {
  requireUser,
  requireWorkspaceAccess,
  requireWebsiteAccess,
  authErrorResponse,
} from "@/lib/auth-helpers";

import {
  createOAuthState,
} from "@/lib/integrations/google/state";

import {
  buildGoogleAuthUrl,
} from "@/lib/integrations/google/oauth-client";

import {
  GSC_OAUTH_SCOPES,
} from "@/lib/integrations/google/constants";


export async function GET(
  req: NextRequest
) {
  try {
    const user =
      await requireUser();

    const workspaceId =
      req.nextUrl.searchParams
        .get("workspaceId")
        ?.trim();

    const websiteId =
      req.nextUrl.searchParams
        .get("websiteId")
        ?.trim() ||
      null;

    if (!workspaceId) {
      return NextResponse.json(
        {
          error:
            "workspaceId is required.",
        },
        {
          status: 400,
        }
      );
    }

    await requireWorkspaceAccess(
      user.id,
      workspaceId
    );

    if (websiteId) {
      await requireWebsiteAccess(
        user.id,
        websiteId
      );
    }

    const returnTo =
      websiteId
        ? `/dashboard/audience?websiteId=${encodeURIComponent(
            websiteId
          )}&gsc=connected`
        : "/dashboard/audience?gsc=connected";

    const state =
      createOAuthState(
        user.id,
        workspaceId,
        returnTo
      );

    return NextResponse.redirect(
      buildGoogleAuthUrl(
        state,
        GSC_OAUTH_SCOPES
      )
    );
  } catch (error) {
    const {
      status,
      body,
    } =
      authErrorResponse(
        error
      );

    return NextResponse.json(
      body,
      {
        status,
      }
    );
  }
}
