import { NextRequest, NextResponse } from "next/server";
import {
  requireUser,
  requireWebsiteAccess,
  authErrorResponse,
} from "@/lib/auth-helpers";
import { prisma } from "@/lib/prisma";
import { syncCloudflareTraffic } from "@/lib/integrations/cloudflare/sync";

/*
 * Cloudflare's currently available historical window for this dataset
 * is short. Never try to sync 15/30 days directly from this button.
 *
 * We persist every successful day, so the database gradually becomes
 * the historical source for longer 15/30 day views.
 */
const CLOUDFLARE_SYNC_WINDOW_DAYS = 7;

export async function POST(
  req: NextRequest
) {
  try {
    const user =
      await requireUser();

    const body =
      (await req.json()) as {
        websiteId?: string;
      };

    const websiteId =
      body.websiteId?.trim();

    if (!websiteId) {
      return NextResponse.json(
        {
          error:
            "websiteId is required",
        },
        { status: 400 }
      );
    }

    await requireWebsiteAccess(
      user.id,
      websiteId
    );

    const connection =
      await prisma.cloudflareConnection.findUnique({
        where: { websiteId },
        select: {
          id: true,
        },
      });

    if (!connection) {
      return NextResponse.json(
        {
          error:
            "Cloudflare is not connected for this website.",
        },
        { status: 404 }
      );
    }

    const now = new Date();

    const until = new Date(
      Date.UTC(
        now.getUTCFullYear(),
        now.getUTCMonth(),
        now.getUTCDate()
      )
    );

    // Sync only complete days.
    until.setUTCDate(
      until.getUTCDate() - 1
    );

    const since = new Date(until);

    since.setUTCDate(
      since.getUTCDate() -
        (
          CLOUDFLARE_SYNC_WINDOW_DAYS -
          1
        )
    );

    const result =
      await syncCloudflareTraffic({
        websiteId,

        since:
          since.toISOString().slice(0, 10),

        until:
          until.toISOString().slice(0, 10),
      });

    /*
     * Touch connection.updatedAt so UI has a truthful sync timestamp.
     */
    await prisma.cloudflareConnection.update({
      where: {
        websiteId,
      },
      data: {
        updatedAt: new Date(),
      },
    });

    return NextResponse.json({
      ok: true,

      source: "CLOUDFLARE",

      syncWindowDays:
        CLOUDFLARE_SYNC_WINDOW_DAYS,

      requestedRange: {
        start:
          since.toISOString().slice(0, 10),

        end:
          until.toISOString().slice(0, 10),
      },

      ...result,
    });
  } catch (error) {
    const { status, body } =
      authErrorResponse(error);

    if (status !== 500) {
      return NextResponse.json(
        body,
        { status }
      );
    }

    console.error(
      "[traffic sync]",
      error instanceof Error
        ? error.message
        : "Unknown error"
    );

    return NextResponse.json(
      {
        error:
          "Cloudflare sync failed.",
      },
      { status: 502 }
    );
  }
}
