import { NextRequest, NextResponse } from "next/server";
import {
  requireUser,
  requireWebsiteAccess,
  authErrorResponse,
} from "@/lib/auth-helpers";
import { prisma } from "@/lib/prisma";
import { syncCloudflareTraffic } from "@/lib/integrations/cloudflare/sync";

export async function GET(req: NextRequest) {
  try {
    const user = await requireUser();
    const websiteId = req.nextUrl.searchParams.get("websiteId");
    const days = Number(req.nextUrl.searchParams.get("days") ?? "7");

    if (!websiteId) {
      return NextResponse.json({ error: "websiteId is required" }, { status: 400 });
    }

    await requireWebsiteAccess(user.id, websiteId);

    const connection = await prisma.cloudflareConnection.findUnique({
      where: { websiteId },
    });

    if (!connection) {
      return NextResponse.json({ connected: false, snapshots: [] });
    }

    if (!Number.isInteger(days) || ![7, 14, 30].includes(days)) {
      return NextResponse.json(
        { error: "days must be 7, 14, or 30" },
        { status: 400 }
      );
    }

    const today = new Date();
    const until = new Date(
      Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate())
    );
    const since = new Date(until);
    since.setUTCDate(since.getUTCDate() - (days - 1));

    await syncCloudflareTraffic({
      websiteId,
      since: since.toISOString().slice(0, 10),
      until: until.toISOString().slice(0, 10),
    });

    const snapshots = await prisma.trafficSnapshot.findMany({
      where: {
        connectionId: connection.id,
        date: {
          gte: since,
          lte: until,
        },
      },
      orderBy: { date: "asc" },
    });

    const serialized = snapshots.map((s) => ({
      date: s.date.toISOString().slice(0, 10),
      totalRequests: s.totalRequests,
      unclassifiedRequests: s.unclassifiedRequests,
      verifiedBotRequests: s.verifiedBotRequests,
      unverifiedBotRequests: s.unverifiedBotRequests,
      threatsBlocked: s.threatsBlocked,
      uniqueVisitors: s.uniqueVisitors,
      bandwidthBytes: s.bandwidthBytes.toString(),
      countryBreakdown: s.countryBreakdown,
      deviceBreakdown: s.deviceBreakdown,
      botCategoryBreakdown: s.botCategoryBreakdown,
    }));

    return NextResponse.json({ connected: true, snapshots: serialized });
  } catch (error) {
    const safeError = error instanceof Error
      ? { name: error.name, message: error.message, stack: error.stack?.split("\n").slice(0, 6).join("\n") }
      : { name: "UnknownError", message: String(error) };

    console.error("TRAFFIC_ROUTE_ERROR", JSON.stringify(safeError));

    const { status, body } = authErrorResponse(error);
    return NextResponse.json(
      { ...body, debug: process.env.NODE_ENV === "development" ? safeError : undefined },
      { status }
    );
  }
}
