import {
  NextRequest,
  NextResponse,
} from "next/server";

import {
  requireUser,
  requireWebsiteAccess,
  authErrorResponse,
} from "@/lib/auth-helpers";

import {
  getCloudflareConnectionWithToken,
} from "@/lib/integrations/cloudflare/connection-service";

const ENDPOINT =
  "https://api.cloudflare.com/client/v4/graphql";

const MINUTE_QUERY = `
  query LiveMinutes(
    $zoneTag: string
    $start: Time
    $end: Time
  ) {
    viewer {
      zones(
        filter: {
          zoneTag: $zoneTag
        }
      ) {
        minutes: httpRequests1mGroups(
          limit: 1500
          orderBy: [
            datetimeMinute_ASC
          ]
          filter: {
            datetime_geq: $start
            datetime_lt: $end
          }
        ) {
          dimensions {
            datetimeMinute
          }

          sum {
            requests
            bytes
          }

          uniq {
            uniques
          }
        }
      }
    }
  }
`;

const DETAIL_QUERY = `
  query LiveDetail(
    $zoneTag: string
    $start: Time
    $end: Time
  ) {
    viewer {
      zones(
        filter: {
          zoneTag: $zoneTag
        }
      ) {
        totals: httpRequestsAdaptiveGroups(
          limit: 1
          filter: {
            datetime_geq: $start
            datetime_lt: $end
            requestSource: "eyeball"
          }
        ) {
          count

          sum {
            visits
            edgeResponseBytes
          }
        }

        countries: httpRequestsAdaptiveGroups(
          limit: 100
          orderBy: [
            count_DESC
          ]
          filter: {
            datetime_geq: $start
            datetime_lt: $end
            requestSource: "eyeball"
          }
        ) {
          count

          dimensions {
            clientCountryName
          }

          sum {
            visits
            edgeResponseBytes
          }
        }

        devices: httpRequestsAdaptiveGroups(
          limit: 30
          orderBy: [
            count_DESC
          ]
          filter: {
            datetime_geq: $start
            datetime_lt: $end
            requestSource: "eyeball"
          }
        ) {
          count

          dimensions {
            clientDeviceType
          }
        }

        bots: httpRequestsAdaptiveGroups(
          limit: 100
          orderBy: [
            count_DESC
          ]
          filter: {
            datetime_geq: $start
            datetime_lt: $end
            requestSource: "eyeball"
          }
        ) {
          count

          dimensions {
            verifiedBotCategory
          }
        }

        paths: httpRequestsAdaptiveGroups(
          limit: 20
          orderBy: [
            count_DESC
          ]
          filter: {
            datetime_geq: $start
            datetime_lt: $end
            requestSource: "eyeball"
          }
        ) {
          count

          dimensions {
            clientRequestPath
          }
        }

        statuses: httpRequestsAdaptiveGroups(
          limit: 30
          orderBy: [
            count_DESC
          ]
          filter: {
            datetime_geq: $start
            datetime_lt: $end
            requestSource: "eyeball"
          }
        ) {
          count

          dimensions {
            edgeResponseStatus
          }
        }
      }
    }
  }
`;

const REFERRER_QUERY = `
  query LiveReferrers(
    $zoneTag: string
    $start: Time
    $end: Time
  ) {
    viewer {
      zones(
        filter: {
          zoneTag: $zoneTag
        }
      ) {
        referrers: httpRequestsAdaptiveGroups(
          limit: 20
          orderBy: [
            count_DESC
          ]
          filter: {
            datetime_geq: $start
            datetime_lt: $end
            requestSource: "eyeball"
          }
        ) {
          count

          dimensions {
            clientRefererHost
          }
        }
      }
    }
  }
`;

interface MinuteRow {
  dimensions: {
    datetimeMinute: string;
  };

  sum: {
    requests: number;
    bytes: number;
  };

  uniq: {
    uniques: number;
  };
}

interface DetailTotalRow {
  count: number;

  sum: {
    visits: number;
    edgeResponseBytes: number;
  };
}

interface CountryRow {
  count: number;

  dimensions: {
    clientCountryName: string;
  };

  sum: {
    visits: number;
    edgeResponseBytes: number;
  };
}

interface DeviceRow {
  count: number;

  dimensions: {
    clientDeviceType: string;
  };
}

interface BotRow {
  count: number;

  dimensions: {
    verifiedBotCategory: string;
  };
}

interface PathRow {
  count: number;

  dimensions: {
    clientRequestPath: string;
  };
}

interface StatusRow {
  count: number;

  dimensions: {
    edgeResponseStatus: number;
  };
}

interface ReferrerRow {
  count: number;

  dimensions: {
    clientRefererHost: string;
  };
}

interface MinuteData {
  viewer?: {
    zones?: Array<{
      minutes?: MinuteRow[];
    }>;
  };
}

interface DetailData {
  viewer?: {
    zones?: Array<{
      totals?: DetailTotalRow[];
      countries?: CountryRow[];
      devices?: DeviceRow[];
      bots?: BotRow[];
      paths?: PathRow[];
      statuses?: StatusRow[];
    }>;
  };
}

interface ReferrerData {
  viewer?: {
    zones?: Array<{
      referrers?: ReferrerRow[];
    }>;
  };
}

interface GraphQLResponse<T> {
  data?: T;

  errors?: Array<{
    message: string;
  }>;
}

interface Variables {
  zoneTag: string;
  start: string;
  end: string;
}

function n(
  value: unknown
): number {
  const parsed =
    Number(value);

  return Number.isFinite(parsed)
    ? parsed
    : 0;
}

function safeMessage(
  error: unknown
): string {
  return (
    error instanceof Error
      ? error.message
      : "Unknown Cloudflare error"
  )
    .replace(
      /Bearer\s+[^\s]+/gi,
      "Bearer [redacted]"
    )
    .slice(
      0,
      800
    );
}

async function runGraphQL<T>({
  token,
  query,
  variables,
}: {
  token: string;
  query: string;
  variables: Variables;
}): Promise<T> {
  const response =
    await fetch(
      ENDPOINT,
      {
        method: "POST",

        headers: {
          Authorization:
            `Bearer ${token}`,

          "Content-Type":
            "application/json",

          Accept:
            "application/json",
        },

        body:
          JSON.stringify({
            query,
            variables,
          }),

        cache:
          "no-store",
      }
    );

  const json: GraphQLResponse<T> =
    await response.json();

  if (!response.ok) {
    throw new Error(
      `Cloudflare GraphQL HTTP ${response.status}`
    );
  }

  if (
    json.errors &&
    json.errors.length > 0
  ) {
    throw new Error(
      json.errors
        .map(
          (error) =>
            error.message
        )
        .join("; ")
    );
  }

  if (!json.data) {
    throw new Error(
      "Cloudflare returned no GraphQL data."
    );
  }

  return json.data;
}

async function optionalGraphQL<T>(
  args: {
    token: string;
    query: string;
    variables: Variables;
  },
  label: string
): Promise<T | null> {
  try {
    return await runGraphQL<T>(
      args
    );
  } catch (error) {
    console.warn(
      `[traffic live ${label}]`,
      safeMessage(error)
    );

    return null;
  }
}

function countryName(
  value: string
): string {
  if (!value) {
    return "Unknown";
  }

  if (
    value.length !== 2
  ) {
    return value;
  }

  try {
    const names =
      new Intl.DisplayNames(
        ["en"],
        {
          type: "region",
        }
      );

    return (
      names.of(
        value.toUpperCase()
      ) ?? value
    );
  } catch {
    return value;
  }
}

export async function GET(
  req: NextRequest
) {
  try {
    const user =
      await requireUser();

    const websiteId =
      req.nextUrl
        .searchParams
        .get("websiteId")
        ?.trim();

    if (!websiteId) {
      return NextResponse.json(
        {
          error:
            "websiteId query parameter is required.",
        },
        {
          status: 400,
        }
      );
    }

    await requireWebsiteAccess(
      user.id,
      websiteId
    );

    const connection =
      await getCloudflareConnectionWithToken(
        websiteId
      );

    if (!connection) {
      return NextResponse.json(
        {
          error:
            "Cloudflare is not connected for this website.",
        },
        {
          status: 404,
        }
      );
    }

    const end =
      new Date();

    const start =
      new Date(
        end.getTime() -
          24 *
            60 *
            60 *
            1000
      );

    const variables: Variables = {
      zoneTag:
        connection.zoneId,

      start:
        start.toISOString(),

      end:
        end.toISOString(),
    };

    const minuteData =
      await runGraphQL<MinuteData>({
        token:
          connection.apiToken,

        query:
          MINUTE_QUERY,

        variables,
      });

    const [
      detailData,
      referrerData,
    ] =
      await Promise.all([
        optionalGraphQL<DetailData>(
          {
            token:
              connection.apiToken,

            query:
              DETAIL_QUERY,

            variables,
          },
          "detail"
        ),

        optionalGraphQL<ReferrerData>(
          {
            token:
              connection.apiToken,

            query:
              REFERRER_QUERY,

            variables,
          },
          "referrers"
        ),
      ]);

    const minuteRows =
      minuteData.viewer
        ?.zones?.[0]
        ?.minutes ??
      [];

    const detail =
      detailData?.viewer
        ?.zones?.[0];

    const timeline =
      minuteRows.map(
        (row) => ({
          time:
            row.dimensions
              .datetimeMinute,

          requests:
            n(
              row.sum
                ?.requests
            ),

          bandwidthBytes:
            n(
              row.sum
                ?.bytes
            ),

          uniques:
            n(
              row.uniq
                ?.uniques
            ),
        })
      );

    const requests24h =
      timeline.reduce(
        (
          total,
          row
        ) =>
          total +
          row.requests,
        0
      );

    const bandwidth24h =
      timeline.reduce(
        (
          total,
          row
        ) =>
          total +
          row.bandwidthBytes,
        0
      );

    const now =
      end.getTime();

    const requests15m =
      timeline
        .filter(
          (row) =>
            new Date(
              row.time
            ).getTime() >=
            now -
              15 *
                60 *
                1000
        )
        .reduce(
          (
            total,
            row
          ) =>
            total +
            row.requests,
          0
        );

    const requests60m =
      timeline
        .filter(
          (row) =>
            new Date(
              row.time
            ).getTime() >=
            now -
              60 *
                60 *
                1000
        )
        .reduce(
          (
            total,
            row
          ) =>
            total +
            row.requests,
          0
        );

    const totalDetail =
      detail
        ?.totals?.[0];

    const visits24h =
      n(
        totalDetail
          ?.sum?.visits
      );

    const countries =
      (
        detail
          ?.countries ??
        []
      )
        .filter(
          (row) =>
            Boolean(
              row.dimensions
                .clientCountryName
            )
        )
        .map(
          (row) => ({
            country:
              countryName(
                row.dimensions
                  .clientCountryName
              ),

            countryCode:
              row.dimensions
                .clientCountryName,

            requests:
              n(
                row.count
              ),

            visits:
              n(
                row.sum
                  ?.visits
              ),

            bandwidthBytes:
              n(
                row.sum
                  ?.edgeResponseBytes
              ),
          })
        );

    const devices =
      (
        detail
          ?.devices ??
        []
      )
        .filter(
          (row) =>
            Boolean(
              row.dimensions
                .clientDeviceType
            )
        )
        .map(
          (row) => ({
            device:
              row.dimensions
                .clientDeviceType,

            requests:
              n(
                row.count
              ),
          })
        );

    const verifiedBots =
      (
        detail
          ?.bots ??
        []
      )
        .filter(
          (row) =>
            Boolean(
              row.dimensions
                .verifiedBotCategory
            )
        )
        .map(
          (row) => ({
            category:
              row.dimensions
                .verifiedBotCategory,

            requests:
              n(
                row.count
              ),
          })
        );

    const verifiedBotRequests =
      verifiedBots.reduce(
        (
          total,
          row
        ) =>
          total +
          row.requests,
        0
      );

    const paths =
      (
        detail
          ?.paths ??
        []
      )
        .filter(
          (row) =>
            Boolean(
              row.dimensions
                .clientRequestPath
            )
        )
        .map(
          (row) => ({
            path:
              row.dimensions
                .clientRequestPath,

            requests:
              n(
                row.count
              ),
          })
        );

    const statuses =
      (
        detail
          ?.statuses ??
        []
      )
        .map(
          (row) => ({
            status:
              n(
                row.dimensions
                  .edgeResponseStatus
              ),

            requests:
              n(
                row.count
              ),
          })
        )
        .filter(
          (row) =>
            row.status > 0
        );

    const referrers =
      (
        referrerData
          ?.viewer
          ?.zones?.[0]
          ?.referrers ??
        []
      )
        .filter(
          (row) =>
            Boolean(
              row.dimensions
                .clientRefererHost
            )
        )
        .map(
          (row) => ({
            referrer:
              row.dimensions
                .clientRefererHost,

            requests:
              n(
                row.count
              ),
          })
        );

    const hourlyMap =
      new Map<
        string,
        {
          time: string;
          requests: number;
          visits: number;
          bandwidthBytes: number;
        }
      >();

    for (
      const row of
      timeline
    ) {
      const date =
        new Date(
          row.time
        );

      if (
        Number.isNaN(
          date.getTime()
        )
      ) {
        continue;
      }

      date.setUTCMinutes(
        0,
        0,
        0
      );

      const key =
        date.toISOString();

      const current =
        hourlyMap.get(
          key
        ) ?? {
          time:
            key,

          requests:
            0,

          visits:
            0,

          bandwidthBytes:
            0,
        };

      current.requests +=
        row.requests;

      current.visits +=
        row.uniques;

      current.bandwidthBytes +=
        row.bandwidthBytes;

      hourlyMap.set(
        key,
        current
      );
    }

    const hourly =
      Array.from(
        hourlyMap.values()
      ).sort(
        (a, b) =>
          a.time.localeCompare(
            b.time
          )
      );

    return NextResponse.json(
      {
        connected:
          true,

        source:
          "CLOUDFLARE",

        mode:
          "NEAR_REAL_TIME",

        resolution:
          "1_MINUTE",

        refreshedAt:
          end.toISOString(),

        range: {
          start:
            start.toISOString(),

          end:
            end.toISOString(),
        },

        summary: {
          requests24h,
          requests60m,
          requests15m,
          visits24h,
          bandwidth24h,
          verifiedBotRequests,
        },

        timeline:
          timeline.map(
            (row) => ({
              time:
                row.time,

              requests:
                row.requests,

              bandwidthBytes:
                row.bandwidthBytes,
            })
          ),

        hourly,
        countries,
        devices,
        verifiedBots,
        paths,
        referrers,
        statuses,

        detailAvailable:
          detailData !==
          null,
      },
      {
        headers: {
          "Cache-Control":
            "no-store, max-age=0",
        },
      }
    );
  } catch (error) {
    const {
      status,
      body,
    } =
      authErrorResponse(
        error
      );

    if (
      status !== 500
    ) {
      return NextResponse.json(
        body,
        {
          status,
        }
      );
    }

    const message =
      safeMessage(
        error
      );

    console.error(
      "[traffic live]",
      message
    );

    return NextResponse.json(
      {
        error:
          `Live Cloudflare query failed: ${message}`,
      },
      {
        status: 502,
      }
    );
  }
}
