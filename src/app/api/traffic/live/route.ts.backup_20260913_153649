import { NextRequest, NextResponse } from "next/server";
import {
  requireUser,
  requireWebsiteAccess,
  authErrorResponse,
} from "@/lib/auth-helpers";
import {
  getCloudflareConnectionWithToken,
} from "@/lib/integrations/cloudflare/connection-service";

const ENDPOINT =
  "https://api.cloudflare.com/client/v4/graphql";

const LIVE_QUERY = `
  query LiveTraffic(
    $zoneTag: String
    $start: Time
    $end: Time
  ) {
    viewer {
      zones(filter: { zoneTag: $zoneTag }) {
        minutes: httpRequests1mGroups(
          limit: 2000
          filter: {
            datetime_geq: $start
            datetime_lt: $end
          }
          orderBy: [datetimeMinute_ASC]
        ) {
          dimensions {
            datetimeMinute
          }
          sum {
            requests
            bytes
          }
        }

        hours: httpRequestsAdaptiveGroups(
          limit: 200
          filter: {
            datetime_geq: $start
            datetime_lt: $end
            requestSource: "eyeball"
          }
          orderBy: [datetimeHour_ASC]
        ) {
          count
          dimensions {
            datetimeHour
          }
          sum {
            visits
            edgeResponseBytes
          }
        }

        countries: httpRequestsAdaptiveGroups(
          limit: 100
          filter: {
            datetime_geq: $start
            datetime_lt: $end
            requestSource: "eyeball"
          }
          orderBy: [count_DESC]
        ) {
          count
          dimensions {
            clientCountryName
          }
          sum {
            visits
            edgeResponseBytes
          }
        }

        devices: httpRequestsAdaptiveGroups(
          limit: 20
          filter: {
            datetime_geq: $start
            datetime_lt: $end
            requestSource: "eyeball"
          }
          orderBy: [count_DESC]
        ) {
          count
          dimensions {
            clientDeviceType
          }
        }

        bots: httpRequestsAdaptiveGroups(
          limit: 100
          filter: {
            datetime_geq: $start
            datetime_lt: $end
            requestSource: "eyeball"
          }
          orderBy: [count_DESC]
        ) {
          count
          dimensions {
            verifiedBotCategory
          }
        }

        paths: httpRequestsAdaptiveGroups(
          limit: 20
          filter: {
            datetime_geq: $start
            datetime_lt: $end
            requestSource: "eyeball"
          }
          orderBy: [count_DESC]
        ) {
          count
          dimensions {
            clientRequestPath
          }
        }

        referrers: httpRequestsAdaptiveGroups(
          limit: 20
          filter: {
            datetime_geq: $start
            datetime_lt: $end
            requestSource: "eyeball"
          }
          orderBy: [count_DESC]
        ) {
          count
          dimensions {
            clientRefererHost
          }
        }

        statuses: httpRequestsAdaptiveGroups(
          limit: 30
          filter: {
            datetime_geq: $start
            datetime_lt: $end
            requestSource: "eyeball"
          }
          orderBy: [count_DESC]
        ) {
          count
          dimensions {
            edgeResponseStatus
          }
        }
      }
    }
  }
`;

type MinuteRow = {
  dimensions: {
    datetimeMinute: string;
  };
  sum: {
    requests: number;
    bytes: number;
  };
};

type HourRow = {
  count: number;
  dimensions: {
    datetimeHour: string;
  };
  sum: {
    visits: number;
    edgeResponseBytes: number;
  };
};

type CountryRow = {
  count: number;
  dimensions: {
    clientCountryName: string;
  };
  sum: {
    visits: number;
    edgeResponseBytes: number;
  };
};

type DeviceRow = {
  count: number;
  dimensions: {
    clientDeviceType: string;
  };
};

type BotRow = {
  count: number;
  dimensions: {
    verifiedBotCategory: string;
  };
};

type PathRow = {
  count: number;
  dimensions: {
    clientRequestPath: string;
  };
};

type ReferrerRow = {
  count: number;
  dimensions: {
    clientRefererHost: string;
  };
};

type StatusRow = {
  count: number;
  dimensions: {
    edgeResponseStatus: number;
  };
};

type ZoneResult = {
  minutes?: MinuteRow[];
  hours?: HourRow[];
  countries?: CountryRow[];
  devices?: DeviceRow[];
  bots?: BotRow[];
  paths?: PathRow[];
  referrers?: ReferrerRow[];
  statuses?: StatusRow[];
};

type GraphQLResponse = {
  data?: {
    viewer?: {
      zones?: ZoneResult[];
    };
  };
  errors?: Array<{
    message: string;
  }>;
};

function number(value: unknown): number {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : 0;
}

export async function GET(req: NextRequest) {
  try {
    const user = await requireUser();

    const websiteId =
      req.nextUrl.searchParams
        .get("websiteId")
        ?.trim();

    if (!websiteId) {
      return NextResponse.json(
        {
          error:
            "websiteId query parameter is required.",
        },
        { status: 400 }
      );
    }

    await requireWebsiteAccess(
      user.id,
      websiteId
    );

    const connection =
      await getCloudflareConnectionWithToken(
        websiteId
      );

    if (!connection) {
      return NextResponse.json(
        {
          connected: false,
          source: "CLOUDFLARE",
        },
        { status: 404 }
      );
    }

    const end = new Date();
    const start = new Date(
      end.getTime() -
        24 * 60 * 60 * 1000
    );

    const response = await fetch(
      ENDPOINT,
      {
        method: "POST",
        headers: {
          Authorization:
            `Bearer ${connection.apiToken}`,
          "Content-Type":
            "application/json",
        },
        body: JSON.stringify({
          query: LIVE_QUERY,
          variables: {
            zoneTag:
              connection.zoneId,
            start:
              start.toISOString(),
            end:
              end.toISOString(),
          },
        }),
        cache: "no-store",
      }
    );

    if (!response.ok) {
      throw new Error(
        `Cloudflare GraphQL HTTP ${response.status}`
      );
    }

    const json =
      await response.json() as
        GraphQLResponse;

    if (json.errors?.length) {
      throw new Error(
        json.errors
          .map(
            (error) =>
              error.message
          )
          .join("; ")
      );
    }

    const zone =
      json.data?.viewer
        ?.zones?.[0];

    if (!zone) {
      throw new Error(
        "Cloudflare returned no zone analytics."
      );
    }

    const minutes =
      zone.minutes ?? [];

    const hours =
      zone.hours ?? [];

    const countries =
      (zone.countries ?? [])
        .filter(
          (row) =>
            Boolean(
              row.dimensions
                .clientCountryName
            )
        )
        .map((row) => ({
          country:
            row.dimensions
              .clientCountryName,
          requests:
            number(row.count),
          visits:
            number(
              row.sum?.visits
            ),
          bandwidthBytes:
            number(
              row.sum
                ?.edgeResponseBytes
            ),
        }));

    const devices =
      (zone.devices ?? [])
        .filter(
          (row) =>
            Boolean(
              row.dimensions
                .clientDeviceType
            )
        )
        .map((row) => ({
          device:
            row.dimensions
              .clientDeviceType,
          requests:
            number(row.count),
        }));

    const verifiedBots =
      (zone.bots ?? [])
        .filter(
          (row) =>
            Boolean(
              row.dimensions
                .verifiedBotCategory
            )
        )
        .map((row) => ({
          category:
            row.dimensions
              .verifiedBotCategory,
          requests:
            number(row.count),
        }));

    const paths =
      (zone.paths ?? [])
        .filter(
          (row) =>
            Boolean(
              row.dimensions
                .clientRequestPath
            )
        )
        .map((row) => ({
          path:
            row.dimensions
              .clientRequestPath,
          requests:
            number(row.count),
        }));

    const referrers =
      (zone.referrers ?? [])
        .filter(
          (row) =>
            Boolean(
              row.dimensions
                .clientRefererHost
            )
        )
        .map((row) => ({
          referrer:
            row.dimensions
              .clientRefererHost,
          requests:
            number(row.count),
        }));

    const statuses =
      (zone.statuses ?? [])
        .map((row) => ({
          status:
            number(
              row.dimensions
                .edgeResponseStatus
            ),
          requests:
            number(row.count),
        }))
        .filter(
          (row) =>
            row.status > 0
        );

    const timeline =
      minutes.map((row) => ({
        time:
          row.dimensions
            .datetimeMinute,
        requests:
          number(
            row.sum?.requests
          ),
        bandwidthBytes:
          number(
            row.sum?.bytes
          ),
      }));

    const hourly =
      hours.map((row) => ({
        time:
          row.dimensions
            .datetimeHour,
        requests:
          number(row.count),
        visits:
          number(
            row.sum?.visits
          ),
        bandwidthBytes:
          number(
            row.sum
              ?.edgeResponseBytes
          ),
      }));

    const requests24h =
      timeline.reduce(
        (sum, row) =>
          sum +
          row.requests,
        0
      );

    const bandwidth24h =
      timeline.reduce(
        (sum, row) =>
          sum +
          row.bandwidthBytes,
        0
      );

    const visits24h =
      hourly.reduce(
        (sum, row) =>
          sum +
          row.visits,
        0
      );

    const verifiedBotRequests =
      verifiedBots.reduce(
        (sum, row) =>
          sum +
          row.requests,
        0
      );

    const last15Start =
      end.getTime() -
      15 * 60 * 1000;

    const requests15m =
      timeline
        .filter(
          (row) =>
            new Date(
              row.time
            ).getTime() >=
            last15Start
        )
        .reduce(
          (sum, row) =>
            sum +
            row.requests,
          0
        );

    const last60Start =
      end.getTime() -
      60 * 60 * 1000;

    const requests60m =
      timeline
        .filter(
          (row) =>
            new Date(
              row.time
            ).getTime() >=
            last60Start
        )
        .reduce(
          (sum, row) =>
            sum +
            row.requests,
          0
        );

    return NextResponse.json(
      {
        connected: true,
        source: "CLOUDFLARE",

        mode:
          "NEAR_REAL_TIME",

        refreshedAt:
          end.toISOString(),

        range: {
          start:
            start.toISOString(),
          end:
            end.toISOString(),
        },

        summary: {
          requests24h,
          requests60m,
          requests15m,
          visits24h,
          bandwidth24h,
          verifiedBotRequests,
        },

        timeline,
        hourly,
        countries,
        devices,
        verifiedBots,
        paths,
        referrers,
        statuses,
      },
      {
        headers: {
          "Cache-Control":
            "no-store, max-age=0",
        },
      }
    );
  } catch (error) {
    const { status, body } =
      authErrorResponse(error);

    if (status !== 500) {
      return NextResponse.json(
        body,
        { status }
      );
    }

    console.error(
      "[traffic live]",
      error instanceof Error
        ? error.message
        : "Unknown error"
    );

    return NextResponse.json(
      {
        error:
          "Could not load live Cloudflare traffic.",
      },
      { status: 502 }
    );
  }
}
