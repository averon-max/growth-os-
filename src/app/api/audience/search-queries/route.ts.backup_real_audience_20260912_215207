import { NextRequest, NextResponse } from "next/server";
import {
  requireUser,
  requireWebsiteAccess,
  authErrorResponse,
} from "@/lib/auth-helpers";
import { prisma } from "@/lib/prisma";
import { gscProvider } from "@/lib/keywords/gsc-provider";

const ALLOWED_DAYS = new Set([7, 14, 30]);
const MAX_RESULTS = 50;

type RawRow = Awaited<
  ReturnType<typeof gscProvider.fetchSearchPerformance>
>[number];

interface PageBucket {
  page: string;
  clicks: number;
  impressions: number;
}

interface QueryBucket {
  query: string;
  clicks: number;
  impressions: number;
  weightedPosition: number;
  positionWeight: number;
  pages: Map<string, PageBucket>;
}

function round(value: number, digits = 1): number {
  const factor = 10 ** digits;
  return Math.round(value * factor) / factor;
}

function addRow(
  buckets: Map<string, QueryBucket>,
  row: RawRow
) {
  const query = String(row.query ?? "").trim();
  if (!query) return;

  const clicks = Math.max(0, Number(row.clicks ?? 0));
  const impressions = Math.max(0, Number(row.impressions ?? 0));

  const rawPosition = Number(row.position);
  const position =
    Number.isFinite(rawPosition) && rawPosition >= 0
      ? rawPosition
      : null;

  const page = String(row.page ?? "").trim();

  let bucket = buckets.get(query);

  if (!bucket) {
    bucket = {
      query,
      clicks: 0,
      impressions: 0,
      weightedPosition: 0,
      positionWeight: 0,
      pages: new Map(),
    };

    buckets.set(query, bucket);
  }

  bucket.clicks += clicks;
  bucket.impressions += impressions;

  if (position !== null) {
    const weight = Math.max(1, impressions);

    bucket.weightedPosition += position * weight;
    bucket.positionWeight += weight;
  }

  if (page) {
    const existing = bucket.pages.get(page) ?? {
      page,
      clicks: 0,
      impressions: 0,
    };

    existing.clicks += clicks;
    existing.impressions += impressions;

    bucket.pages.set(page, existing);
  }
}

export async function GET(req: NextRequest) {
  try {
    const user = await requireUser();

    const websiteId =
      req.nextUrl.searchParams.get("websiteId");

    const days = Number(
      req.nextUrl.searchParams.get("days") ?? "7"
    );

    if (!websiteId) {
      return NextResponse.json(
        { error: "websiteId is required" },
        { status: 400 }
      );
    }

    if (!ALLOWED_DAYS.has(days)) {
      return NextResponse.json(
        { error: "days must be 7, 14, or 30" },
        { status: 400 }
      );
    }

    await requireWebsiteAccess(user.id, websiteId);

    const website = await prisma.website.findUnique({
      where: { id: websiteId },
      select: {
        url: true,
        business: {
          select: {
            workspaceId: true,
          },
        },
      },
    });

    if (!website) {
      return NextResponse.json(
        { error: "Website not found" },
        { status: 404 }
      );
    }

    const workspaceId = website.business.workspaceId;

    const connection =
      await gscProvider.getConnectionStatus(workspaceId);

    if (connection.status !== "CONNECTED") {
      return NextResponse.json({
        connected: false,
        days,
        range: null,
        summary: null,
        queries: [],
      });
    }

    const now = new Date();

    const endDate = new Date(
      Date.UTC(
        now.getUTCFullYear(),
        now.getUTCMonth(),
        now.getUTCDate()
      )
    );

    const startDate = new Date(endDate);

    startDate.setUTCDate(
      startDate.getUTCDate() - (days - 1)
    );

    const rows =
      await gscProvider.fetchSearchPerformance({
        workspaceId,
        siteUrl: website.url,
        startDate,
        endDate,
      });

    const buckets = new Map<string, QueryBucket>();

    for (const row of rows) {
      addRow(buckets, row);
    }

    const queries = [...buckets.values()]
      .map((bucket) => {
        const topPage =
          [...bucket.pages.values()]
            .sort(
              (a, b) =>
                b.clicks - a.clicks ||
                b.impressions - a.impressions
            )[0]?.page ?? null;

        const ctr =
          bucket.impressions > 0
            ? (bucket.clicks / bucket.impressions) * 100
            : 0;

        const avgPosition =
          bucket.positionWeight > 0
            ? bucket.weightedPosition /
              bucket.positionWeight
            : null;

        return {
          query: bucket.query,
          clicks: bucket.clicks,
          impressions: bucket.impressions,
          ctr: round(ctr, 1),
          avgPosition:
            avgPosition === null
              ? null
              : round(avgPosition, 1),
          topPage,
        };
      })
      .sort(
        (a, b) =>
          b.clicks - a.clicks ||
          b.impressions - a.impressions ||
          (a.avgPosition ?? 999) -
            (b.avgPosition ?? 999)
      );

    const totalClicks = queries.reduce(
      (sum, query) => sum + query.clicks,
      0
    );

    const totalImpressions = queries.reduce(
      (sum, query) => sum + query.impressions,
      0
    );

    const totalPositionWeight = [...buckets.values()]
      .reduce(
        (sum, bucket) =>
          sum + bucket.positionWeight,
        0
      );

    const totalWeightedPosition = [...buckets.values()]
      .reduce(
        (sum, bucket) =>
          sum + bucket.weightedPosition,
        0
      );

    return NextResponse.json({
      connected: true,
      days,
      range: {
        start:
          startDate.toISOString().slice(0, 10),
        end:
          endDate.toISOString().slice(0, 10),
      },
      summary: {
        clicks: totalClicks,
        impressions: totalImpressions,
        ctr:
          totalImpressions > 0
            ? round(
                (totalClicks / totalImpressions) * 100,
                1
              )
            : 0,
        avgPosition:
          totalPositionWeight > 0
            ? round(
                totalWeightedPosition /
                  totalPositionWeight,
                1
              )
            : null,
        uniqueQueries: queries.length,
      },
      queries: queries.slice(0, MAX_RESULTS),
    });
  } catch (error) {
    const { status, body } =
      authErrorResponse(error);

    if (status !== 500) {
      return NextResponse.json(body, { status });
    }

    console.error(
      "AUDIENCE_SEARCH_QUERIES_ERROR",
      error instanceof Error
        ? error.message
        : "Unknown error"
    );

    return NextResponse.json(
      {
        error:
          "Could not load Google Search Console query data.",
      },
      { status: 502 }
    );
  }
}
