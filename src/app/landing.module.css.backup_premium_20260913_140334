.page {
  --bg: var(--background, #090a0b);
  --sidebar: var(--sidebar, #0d0f10);
  --workspace: var(--workspace, #101214);
  --surface: var(--surface, #141618);
  --surface2: var(--surface-2, #181a1d);
  --border: var(--border, rgba(255,255,255,.06));
  --primary: var(--primary, #e6e6e8);
  --secondary: var(--secondary, #74787f);
  --accent: var(--accent, #8b75d7);
  --success: var(--success, #64a879);
  --warning: var(--warning, #cba35c);
  --danger: var(--danger, #c96d72);

  position: relative;

  min-height: 100vh;

  overflow: hidden;

  background: var(--bg);
  color: var(--primary);
}

.page * {
  box-sizing: border-box;
}

.globalGrid {
  position: fixed;
  inset: 0;
  z-index: 0;

  pointer-events: none;

  opacity: .28;

  background-image:
    linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);

  background-size: 64px 64px;

  mask-image:
    radial-gradient(circle at 50% 25%, black, transparent 72%);
}

.header {
  position: relative;
  z-index: 10;

  padding: 18px 20px 0;
}

.navbar {
  width: min(1320px, 100%);
  height: 58px;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  margin: 0 auto;
  padding: 0 13px 0 15px;

  border: 1px solid var(--border);
  border-radius: 12px;

  background: color-mix(in srgb, var(--surface) 93%, transparent);

  box-shadow: 0 18px 55px rgba(0,0,0,.22);

  backdrop-filter: blur(16px);
}

.brand {
  width: max-content;

  display: inline-flex;
  align-items: center;
  gap: 9px;

  color: var(--primary);

  font-size: 13px;
  font-weight: 600;

  text-decoration: none;
}

.logo {
  width: 20px;
  height: 20px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  gap: 2px;

  padding-left: 4px;

  border: 1px solid var(--border);
  border-radius: 5px;

  background: var(--surface2);
}

.logo i {
  height: 2px;

  display: block;

  border-radius: 2px;

  background: var(--primary);
}

.logo i:nth-child(1) { width: 11px; }
.logo i:nth-child(2) { width: 8px; }
.logo i:nth-child(3) { width: 5px; }

.nav {
  display: flex;

  gap: 28px;
}

.nav a,
.account > a:first-child {
  color: var(--secondary);

  font-size: 10px;

  text-decoration: none;
}

.nav a:hover,
.account > a:first-child:hover {
  color: var(--primary);
}

.account {
  justify-self: end;

  display: flex;
  align-items: center;

  gap: 18px;
}

.signup {
  height: 32px;

  display: inline-flex;
  align-items: center;

  padding: 0 13px;

  border-radius: 6px;

  background: var(--primary);
  color: var(--bg);

  font-size: 9px;
  font-weight: 650;

  text-decoration: none;
}


/* HERO */

.hero {
  position: relative;
  z-index: 1;

  padding: 50px 20px 0;
}

.heroMeta {
  width: min(1280px, 100%);

  display: flex;
  justify-content: space-between;
  align-items: center;

  margin: 0 auto 13px;

  color: var(--secondary);

  font-size: 7px;
}

.heroMeta > div {
  display: flex;
  align-items: center;
  gap: 7px;
}

.liveDot {
  width: 5px;
  height: 5px;

  display: inline-block;

  border-radius: 50%;

  background: var(--success);

  box-shadow: 0 0 9px color-mix(in srgb, var(--success) 40%, transparent);
}

.app {
  width: min(1380px, 97vw);
  height: 650px;

  margin: 0 auto;

  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 11px;

  background: var(--workspace);

  box-shadow:
    0 50px 140px rgba(0,0,0,.35);

  animation:
    appIn .75s cubic-bezier(.2,.75,.2,1) both;
}

.appTopbar {
  height: 43px;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  padding: 0 12px;

  border-bottom: 1px solid var(--border);

  background: var(--surface);
}

.appBrand,
.appTools,
.siteSelect {
  display: flex;
  align-items: center;

  gap: 8px;

  font-size: 7px;
}

.appBrand {
  color: var(--primary);
}

.appBrand > i {
  width: 1px;
  height: 14px;

  background: var(--border);
}

.siteSelect,
.workspaceName,
.appTools {
  color: var(--secondary);
}

.workspaceName {
  justify-self: center;

  font-size: 7px;
}

.appTools {
  justify-self: end;
}

.appTools b {
  width: 21px;
  height: 21px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid var(--border);
  border-radius: 50%;

  background: var(--surface2);

  font-size: 7px;
  font-weight: 500;
}

.appBody {
  height: calc(100% - 43px);

  display: grid;
  grid-template-columns: 194px 1fr;
}

.sidebar {
  position: relative;

  padding: 12px 8px;

  border-right: 1px solid var(--border);

  background: var(--sidebar);
}

.sidebarItem {
  height: 30px;

  display: flex;
  align-items: center;

  gap: 8px;

  padding: 0 8px;

  border-radius: 5px;

  color: var(--secondary);

  font-size: 8px;
}

.sidebarActive {
  background: var(--surface2);
  color: var(--primary);
}

.sidebarActive svg {
  color: var(--accent);
}

.sidebarFooter {
  position: absolute;

  left: 8px;
  right: 8px;
  bottom: 12px;
}

.workspace {
  background: var(--workspace);
}

.workspaceTop {
  height: 70px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 16px;

  border-bottom: 1px solid var(--border);
}

.workspaceTop > div:first-child {
  display: flex;
  flex-direction: column;

  gap: 4px;
}

.workspaceTop span {
  color: var(--secondary);

  font-size: 7px;
}

.workspaceTop strong {
  color: var(--primary);

  font-size: 13px;
  font-weight: 560;
}

.controls {
  display: flex;

  gap: 6px;
}

.controls button {
  height: 28px;

  display: flex;
  align-items: center;

  gap: 6px;

  padding: 0 9px;

  border: 1px solid var(--border);
  border-radius: 5px;

  background: var(--surface);
  color: var(--secondary);

  font-size: 7px;
}

.controls .primaryControl {
  background: var(--primary);
  color: var(--bg);
}

.presets {
  height: 50px;

  display: flex;
  align-items: center;

  gap: 5px;

  padding: 0 13px;

  border-bottom: 1px solid var(--border);
}

.presets button {
  height: 26px;

  display: flex;
  align-items: center;

  gap: 5px;

  padding: 0 8px;

  border: 1px solid var(--border);
  border-radius: 5px;

  background: var(--surface);
  color: var(--secondary);

  font-size: 7px;
}

.productContent {
  height: calc(100% - 120px);

  display: grid;
  grid-template-columns: .9fr 1.1fr;

  gap: 9px;

  padding: 9px;
}

.signalPane,
.explorerPane {
  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 7px;

  background: var(--sidebar);
}

.panelTitle {
  height: 47px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 11px;

  border-bottom: 1px solid var(--border);
}

.panelTitle > div {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.panelTitle span {
  color: var(--secondary);

  font-size: 6px;
}

.panelTitle strong {
  color: var(--primary);

  font-size: 8px;
  font-weight: 520;
}

.signalRow {
  min-height: 69px;

  display: grid;
  grid-template-columns: 10px 1fr 12px;
  align-items: center;

  gap: 8px;

  padding: 0 11px;

  border-bottom: 1px solid color-mix(in srgb, var(--border) 65%, transparent);
}

.signalRow:last-child {
  border-bottom: 0;
}

.signalDot {
  width: 7px;
  height: 7px;

  display: block;

  border-radius: 50%;
}

.signalDot[data-tone="success"] {
  background: var(--success);
}

.signalDot[data-tone="warning"] {
  background: var(--warning);
}

.signalDot[data-tone="danger"] {
  background: var(--danger);
}

.signalDot[data-tone="accent"] {
  background: var(--accent);
}

.signalDot[data-tone="muted"] {
  background: var(--secondary);
}

.signalRow > div {
  display: flex;
  flex-direction: column;

  gap: 4px;
}

.signalRow strong {
  color: var(--primary);

  font-size: 8px;
  font-weight: 520;
}

.signalRow span {
  color: var(--secondary);

  font-size: 7px;
}

.signalRow svg {
  color: var(--secondary);
}

.explorerToolbar {
  height: 45px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 9px;

  border-bottom: 1px solid var(--border);
}

.explorerToolbar > div {
  width: 205px;
  height: 26px;

  display: flex;
  align-items: center;

  gap: 6px;

  padding: 0 8px;

  border: 1px solid var(--border);
  border-radius: 5px;

  background: var(--bg);
  color: var(--secondary);

  font-size: 7px;
}

.explorerToolbar button {
  height: 26px;

  padding: 0 8px;

  border: 1px solid var(--border);
  border-radius: 5px;

  background: var(--surface);
  color: var(--secondary);

  font-size: 7px;
}

.tableHead {
  height: 34px;

  display: grid;
  grid-template-columns: 1.5fr .7fr .7fr .7fr;
  align-items: center;

  padding: 0 10px;

  border-bottom: 1px solid var(--border);

  color: var(--secondary);

  font-size: 6px;

  text-transform: uppercase;
  letter-spacing: .04em;
}

.dataState {
  height: 260px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 25px;

  text-align: center;
}

.dataIcon {
  width: 34px;
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid var(--border);
  border-radius: 7px;

  background: var(--surface);
  color: var(--secondary);
}

.dataState strong {
  margin-top: 13px;

  color: var(--primary);

  font-size: 9px;
  font-weight: 520;
}

.dataState span {
  max-width: 280px;

  margin-top: 7px;

  color: var(--secondary);

  font-size: 7px;
  line-height: 1.6;
}

.heroStrip {
  width: min(1280px, 100%);

  display: grid;
  grid-template-columns: repeat(4, 1fr);

  margin: 0 auto;

  border-bottom: 1px solid var(--border);
}

.heroStrip > div {
  min-height: 72px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  gap: 7px;

  padding: 0 18px;

  border-right: 1px solid var(--border);
}

.heroStrip > div:last-child {
  border-right: 0;
}

.heroStrip span {
  color: var(--secondary);

  font-size: 6px;
}

.heroStrip strong {
  color: var(--secondary);

  font-size: 8px;
  font-weight: 500;
}


/* EDITORIAL */

.statement {
  width: min(1280px, calc(100% - 40px));

  display: grid;
  grid-template-columns: 235px 1fr;

  gap: 65px;

  margin: 0 auto;
  padding: 135px 0;

  border-bottom: 1px solid var(--border);
}

.statement > div:first-child {
  padding-top: 7px;

  color: var(--secondary);

  font-size: 7px;

  letter-spacing: .08em;
}

.statement h2,
.sectionCopy h2,
.closing h2 {
  margin: 0;

  color: var(--primary);

  font-size: clamp(29px, 3vw, 41px);
  font-weight: 500;

  line-height: 1.03;

  letter-spacing: -.044em;
}

.statement p,
.sectionCopy p,
.closing p {
  max-width: 560px;

  margin: 17px 0 0;

  color: var(--secondary);

  font-size: 9px;
  line-height: 1.7;
}


/* PRODUCT SECTIONS */

.productSection {
  width: min(1280px, calc(100% - 40px));

  margin: 0 auto;
  padding: 115px 0 130px;

  border-bottom: 1px solid var(--border);
}

.sectionLabel {
  display: flex;

  gap: 13px;

  margin-bottom: 55px;

  color: var(--secondary);

  font-size: 7px;

  letter-spacing: .06em;
}

.sectionLabel strong {
  color: var(--secondary);

  font-weight: 500;
}

.sectionMain {
  display: grid;
  grid-template-columns: 300px 1fr;

  gap: 70px;
}

.sectionCopy h2 {
  font-size: clamp(27px, 2.5vw, 36px);
}

.signalBoard {
  display: grid;
  grid-template-columns: repeat(2, 1fr);

  border-top: 1px solid var(--border);
}

.signalLarge {
  min-height: 135px;

  display: grid;
  grid-template-columns: 10px 1fr;

  gap: 11px;

  padding: 24px 20px;

  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.signalLarge:nth-child(2n) {
  border-right: 0;
}

.signalLarge strong {
  color: var(--primary);

  font-size: 9px;
  font-weight: 520;
}

.signalLarge p {
  margin: 8px 0 0;

  color: var(--secondary);

  font-size: 7px;
  line-height: 1.6;
}


/* AUDIENCE */

.audiencePanel {
  overflow: hidden;

  border: 1px solid var(--border);
  border-radius: 8px;

  background: var(--workspace);
}

.audienceTop {
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 11px;

  border-bottom: 1px solid var(--border);

  background: var(--surface);
}

.audienceTop > div:first-child {
  display: flex;
  align-items: center;

  gap: 7px;

  color: var(--primary);

  font-size: 7px;
}

.periods {
  display: flex;

  gap: 2px;

  padding: 2px;

  border: 1px solid var(--border);
  border-radius: 5px;

  background: var(--sidebar);
}

.periods span {
  width: 25px;
  height: 20px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 3px;

  color: var(--secondary);

  font-size: 6px;
}

.periods .periodActive {
  background: var(--surface2);
  color: var(--primary);
}

.audienceStats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);

  border-bottom: 1px solid var(--border);
}

.audienceMetric {
  min-height: 65px;

  padding: 12px;

  border-right: 1px solid var(--border);
}

.audienceMetric:last-child {
  border-right: 0;
}

.audienceMetric > div {
  display: flex;
  align-items: center;

  gap: 6px;

  color: var(--secondary);

  font-size: 7px;
}

.audienceMetric strong {
  display: block;

  margin-top: 10px;

  color: var(--primary);

  font-size: 8px;
  font-weight: 500;
}

.audienceBody {
  display: grid;
  grid-template-columns: 1fr 230px;
}

.activityPanel {
  border-right: 1px solid var(--border);
}

.activityHeader {
  height: 50px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 12px;

  border-bottom: 1px solid var(--border);
}

.activityHeader > div {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.activityHeader span {
  color: var(--secondary);

  font-size: 6px;
}

.activityHeader strong {
  color: var(--primary);

  font-size: 8px;
  font-weight: 520;
}

.activityCanvas {
  position: relative;

  height: 270px;

  display: flex;
  flex-direction: column;
  justify-content: space-around;

  background: var(--sidebar);
}

.activityCanvas > i {
  width: 100%;
  height: 1px;

  background: color-mix(in srgb, var(--border) 65%, transparent);
}

.syncedState {
  position: absolute;

  left: 50%;
  top: 50%;

  display: flex;
  align-items: center;

  gap: 7px;

  transform: translate(-50%, -50%);

  color: var(--secondary);

  font-size: 7px;
}

.audienceAside {
  background: var(--workspace);
}

.breakdown {
  min-height: 107px;

  padding: 13px;

  border-bottom: 1px solid var(--border);
}

.breakdown:last-child {
  border-bottom: 0;
}

.breakdown > div {
  display: flex;
  align-items: center;

  gap: 6px;

  color: var(--secondary);

  font-size: 7px;
}

.breakdown > i {
  height: 3px;

  display: block;

  margin-top: 10px;

  border-radius: 2px;

  background: color-mix(in srgb, var(--border) 90%, transparent);
}

.breakdown > i:nth-child(2) { width: 82%; }
.breakdown > i:nth-child(3) { width: 61%; }
.breakdown > i:nth-child(4) { width: 43%; }


/* EXECUTION */

.execution {
  display: grid;
  grid-template-columns: repeat(5, 1fr);

  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.executionStep {
  position: relative;

  min-height: 235px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  padding: 22px;

  border-right: 1px solid var(--border);
}

.executionStep:last-child {
  border-right: 0;
}

.executionStep > div:first-child {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 28px;
}

.executionStep > div > span {
  color: var(--secondary);

  font-size: 6px;
}

.executionStep > div > i {
  width: 30px;
  height: 30px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid var(--border);
  border-radius: 6px;

  background: var(--surface);

  font-style: normal;
}

.executionStep > div > i[data-tone="accent"] {
  color: var(--accent);
}

.executionStep > div > i[data-tone="warning"] {
  color: var(--warning);
}

.executionStep > div > i[data-tone="success"] {
  color: var(--success);
}

.executionStep strong {
  color: var(--primary);

  font-size: 10px;
  font-weight: 520;
}

.executionStep p {
  margin: 7px 0 0;

  color: var(--secondary);

  font-size: 7px;
  line-height: 1.6;
}

.executionArrow {
  position: absolute;

  right: -7px;
  top: 50%;
  z-index: 2;

  padding: 2px;

  background: var(--bg);
  color: var(--secondary);
}


/* CLOSING */

.closing {
  width: min(1280px, calc(100% - 40px));
  min-height: 380px;

  display: grid;
  grid-template-columns: 1fr .7fr;

  gap: 80px;

  align-items: center;

  margin: 0 auto;

  border-bottom: 1px solid var(--border);
}

.closing > div:first-child > span {
  color: var(--secondary);

  font-size: 7px;

  letter-spacing: .08em;
}

.closing h2 {
  margin-top: 13px;
}

.closingRight p {
  margin-top: 0;
}

.closingRight > div {
  display: flex;

  gap: 7px;

  margin-top: 20px;
}

.secondaryButton {
  height: 32px;

  display: inline-flex;
  align-items: center;

  padding: 0 12px;

  border: 1px solid var(--border);
  border-radius: 6px;

  background: var(--surface);
  color: var(--secondary);

  font-size: 9px;

  text-decoration: none;
}


/* FOOTER */

.footer {
  width: min(1280px, calc(100% - 40px));
  min-height: 100px;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  margin: 0 auto;

  color: var(--secondary);

  font-size: 7px;
}

.footer > div {
  justify-self: end;

  display: flex;

  gap: 20px;
}

.footer > div a {
  color: var(--secondary);

  text-decoration: none;
}


/* MOTION */

@keyframes appIn {
  from {
    opacity: 0;
    transform: translateY(20px) scale(.993);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (prefers-reduced-motion: reduce) {
  .app {
    animation: none;
  }
}


/* RESPONSIVE */

@media (max-width: 1000px) {
  .nav {
    display: none;
  }

  .app {
    width: 1100px;

    transform: scale(.78);
    transform-origin: top left;
  }

  .hero {
    overflow: hidden;
  }

  .heroStrip {
    margin-top: -145px;
  }

  .sectionMain {
    grid-template-columns: 240px 1fr;

    gap: 45px;
  }
}

@media (max-width: 720px) {
  .header {
    padding-left: 12px;
    padding-right: 12px;
  }

  .account > a:first-child {
    display: none;
  }

  .hero {
    padding-left: 12px;
    padding-right: 12px;
  }

  .heroMeta > span:last-child {
    display: none;
  }

  .app {
    width: 1080px;
    height: 610px;

    transform: scale(.53);
  }

  .heroStrip {
    grid-template-columns: 1fr 1fr;

    margin-top: -285px;
  }

  .statement {
    grid-template-columns: 1fr;

    gap: 15px;

    padding: 90px 0;
  }

  .productSection {
    padding: 85px 0;
  }

  .sectionMain {
    grid-template-columns: 1fr;

    gap: 40px;
  }

  .signalBoard {
    grid-template-columns: 1fr;
  }

  .signalLarge,
  .signalLarge:nth-child(2n) {
    border-right: 0;
  }

  .audienceStats {
    grid-template-columns: 1fr 1fr;
  }

  .audienceMetric:nth-child(2) {
    border-right: 0;
  }

  .audienceBody {
    grid-template-columns: 1fr;
  }

  .activityPanel {
    border-right: 0;
    border-bottom: 1px solid var(--border);
  }

  .execution {
    grid-template-columns: 1fr;
  }

  .executionStep {
    min-height: 145px;

    border-right: 0;
    border-bottom: 1px solid var(--border);
  }

  .executionArrow {
    display: none;
  }

  .closing {
    grid-template-columns: 1fr;

    gap: 30px;

    padding: 90px 0;
  }

  .footer {
    grid-template-columns: 1fr;

    gap: 17px;

    padding: 28px 0;
  }

  .footer > div {
    justify-self: start;
  }
}


/* EDITORIAL_POLISH_V3 */

.page {
  --bg: #08090a;
  --sidebar: #0b0d0f;
  --workspace: #0e1012;
  --surface: #121416;
  --surface2: #17191c;
  --border: rgba(255,255,255,.052);
  --primary: #e8e9eb;
  --secondary: #6f747c;

  background:
    radial-gradient(
      ellipse at 50% -8%,
      rgba(92,108,148,.045),
      transparent 30%
    ),
    var(--bg) !important;
}


/* NAV */

.header {
  padding-top: 15px !important;
}

.navbar {
  width: min(1340px,100%) !important;
  height: 56px !important;

  padding-left: 14px !important;
  padding-right: 10px !important;

  border-color: rgba(255,255,255,.07) !important;
  border-radius: 10px !important;

  background:
    linear-gradient(
      180deg,
      rgba(18,20,23,.96),
      rgba(11,13,15,.96)
    ) !important;

  box-shadow:
    0 16px 48px rgba(0,0,0,.30),
    inset 0 1px 0 rgba(255,255,255,.018) !important;
}

.brand {
  font-size: 12px !important;
}

.nav {
  gap: 30px !important;
}

.nav a,
.account > a:first-child {
  font-size: 9px !important;
}

.signup {
  height: 30px !important;

  padding: 0 12px !important;

  border-radius: 5px !important;
}


/* HERO */

.hero {
  padding-top: 62px !important;
}

.heroMeta {
  width: min(1300px,100%) !important;

  margin-bottom: 12px !important;

  color: #555a62 !important;
}

.heroMeta > div {
  color: #777c84 !important;
}

.app {
  width: min(1420px,98vw) !important;
  height: 680px !important;

  border-color: rgba(255,255,255,.072) !important;
  border-radius: 8px !important;

  background: #0e1012 !important;

  box-shadow:
    0 70px 180px rgba(0,0,0,.46),
    0 0 0 1px rgba(255,255,255,.008) inset !important;
}

.app::after {
  content: "";

  position: absolute;

  left: 11%;
  right: 11%;
  bottom: -90px;

  height: 150px;

  pointer-events: none;

  background:
    radial-gradient(
      ellipse,
      rgba(82,102,145,.08),
      transparent 70%
    );

  filter: blur(55px);
}

.appTopbar {
  height: 40px !important;

  background: #111315 !important;
}

.appBody {
  height: calc(100% - 40px) !important;

  grid-template-columns: 205px 1fr !important;
}

.sidebar {
  background: #0a0c0e !important;
}

.sidebarItem {
  height: 29px !important;

  border-radius: 4px !important;

  transition:
    background .15s ease,
    color .15s ease,
    transform .15s ease;
}

.sidebarItem:hover {
  background: #151719 !important;
  color: #a8abb0 !important;

  transform: translateX(1px);
}

.sidebarActive {
  background: #181a1d !important;
}

.workspace {
  background: #0f1113 !important;
}

.workspaceTop {
  height: 66px !important;

  padding-left: 18px !important;
  padding-right: 18px !important;
}

.workspaceTop strong {
  font-size: 12px !important;
}

.controls button {
  border-radius: 4px !important;

  transition:
    border-color .15s ease,
    background .15s ease;
}

.controls button:hover {
  border-color: rgba(255,255,255,.11) !important;
}

.presets {
  height: 48px !important;

  padding-left: 14px !important;
}

.presets button {
  height: 25px !important;

  border-radius: 4px !important;

  background: #121416 !important;

  transition:
    background .15s ease,
    color .15s ease,
    border-color .15s ease;
}

.presets button:hover {
  background: #181a1d !important;

  border-color: rgba(255,255,255,.095) !important;

  color: #aeb1b6 !important;
}

.productContent {
  height: calc(100% - 114px) !important;

  gap: 8px !important;

  padding: 8px !important;
}

.signalPane,
.explorerPane {
  border-radius: 5px !important;

  background: #0b0d0f !important;
}

.panelTitle {
  height: 44px !important;

  background: #101214 !important;
}

.signalRow {
  min-height: 66px !important;

  transition: background .15s ease;
}

.signalRow:hover {
  background: rgba(255,255,255,.018) !important;
}

.explorerToolbar {
  height: 43px !important;
}

.explorerToolbar > div,
.explorerToolbar button {
  border-radius: 4px !important;
}

.dataState {
  height: 275px !important;
}

.dataIcon {
  border-radius: 6px !important;

  background: #131517 !important;
}


/* HERO STRIP */

.heroStrip {
  width: min(1300px,100%) !important;
}

.heroStrip > div {
  min-height: 64px !important;

  padding-left: 16px !important;
}

.heroStrip strong {
  color: #777b82 !important;
}


/* STATEMENT */

.statement {
  width: min(1300px,calc(100% - 40px)) !important;

  grid-template-columns: 210px 1fr !important;

  gap: 95px !important;

  padding-top: 155px !important;
  padding-bottom: 155px !important;
}

.statement h2 {
  max-width: 660px !important;

  font-size: clamp(31px,3.25vw,45px) !important;

  line-height: 1 !important;
}

.statement p {
  max-width: 500px !important;

  margin-top: 20px !important;
}


/* PRODUCT SECTIONS */

.productSection {
  width: min(1300px,calc(100% - 40px)) !important;

  padding-top: 130px !important;
  padding-bottom: 145px !important;
}

.sectionLabel {
  margin-bottom: 65px !important;

  color: #555a62 !important;
}

.sectionMain {
  grid-template-columns: 280px 1fr !important;

  gap: 90px !important;
}

.sectionCopy {
  padding-top: 3px !important;
}

.sectionCopy h2 {
  max-width: 280px !important;

  font-size: clamp(27px,2.6vw,37px) !important;

  line-height: 1.02 !important;
}

.sectionCopy p {
  max-width: 275px !important;

  margin-top: 18px !important;
}


/* SIGNAL BOARD */

.signalBoard {
  border-color: rgba(255,255,255,.06) !important;
}

.signalLarge {
  min-height: 145px !important;

  padding: 28px 23px !important;

  transition:
    background .18s ease,
    transform .18s ease;
}

.signalLarge:hover {
  background: rgba(255,255,255,.016) !important;
}

.signalLarge strong {
  font-size: 9px !important;
}

.signalLarge p {
  max-width: 300px !important;

  margin-top: 10px !important;

  line-height: 1.65 !important;
}


/* AUDIENCE */

.audiencePanel {
  border-radius: 6px !important;

  background: #0e1012 !important;

  box-shadow:
    0 30px 90px rgba(0,0,0,.24) !important;
}

.audienceTop {
  height: 40px !important;

  background: #111315 !important;
}

.audienceStats {
  background: #0d0f11 !important;
}

.audienceMetric {
  min-height: 63px !important;

  transition: background .15s ease;
}

.audienceMetric:hover {
  background: rgba(255,255,255,.014) !important;
}

.activityHeader {
  height: 47px !important;
}

.activityCanvas {
  height: 290px !important;

  background:
    linear-gradient(
      180deg,
      #0a0c0e,
      #0b0d0f
    ) !important;
}

.syncedState {
  padding: 8px 10px !important;

  border: 1px solid rgba(255,255,255,.055) !important;
  border-radius: 5px !important;

  background: rgba(18,20,22,.75) !important;

  backdrop-filter: blur(8px);
}

.audienceAside {
  background: #0d0f11 !important;
}

.breakdown {
  transition: background .15s ease;
}

.breakdown:hover {
  background: rgba(255,255,255,.014) !important;
}


/* EXECUTION */

.execution {
  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.006),
      transparent
    ) !important;
}

.executionStep {
  min-height: 255px !important;

  padding: 25px !important;

  transition:
    background .18s ease,
    transform .18s ease;
}

.executionStep:hover {
  background: rgba(255,255,255,.014) !important;
}

.executionStep > div > i {
  background: #131517 !important;

  transition:
    transform .18s ease,
    border-color .18s ease;
}

.executionStep:hover > div > i {
  transform: translateY(-2px);

  border-color: rgba(255,255,255,.10) !important;
}


/* CLOSING */

.closing {
  width: min(1300px,calc(100% - 40px)) !important;

  min-height: 420px !important;

  grid-template-columns: 1fr .62fr !important;
}

.closing h2 {
  max-width: 620px !important;

  font-size: clamp(31px,3.2vw,44px) !important;

  line-height: 1.01 !important;
}

.closingRight {
  max-width: 390px !important;
}


/* FOOTER */

.footer {
  width: min(1300px,calc(100% - 40px)) !important;

  min-height: 112px !important;
}


/* REVEAL + MICRO MOTION */

@keyframes polishReveal {
  from {
    opacity: .12;
    transform: translateY(34px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@supports (animation-timeline: view()) {
  .statement,
  .productSection,
  .closing {
    animation:
      polishReveal linear both;

    animation-timeline: view();

    animation-range:
      entry 4% cover 28%;
  }
}

.liveDot {
  animation:
    subtlePulse 2.8s ease-in-out infinite;
}

@keyframes subtlePulse {
  0%,
  100% {
    box-shadow:
      0 0 0 3px color-mix(in srgb,var(--success) 8%,transparent);
  }

  50% {
    box-shadow:
      0 0 0 6px color-mix(in srgb,var(--success) 2%,transparent);
  }
}

@media (prefers-reduced-motion: reduce) {
  .statement,
  .productSection,
  .closing,
  .liveDot {
    animation: none !important;
  }
}

