@import "tailwindcss";

:root {
  --background: #08090a;
  --shell: #0d0f10;
  --sidebar: #0e1011;
  --workspace: #111315;

  --surface: #141618;
  --surface-2: #17191c;
  --surface-3: #1b1d20;
  --raised: #1c1f22;

  --border: rgba(255,255,255,.065);
  --border-hover: rgba(255,255,255,.105);
  --border-strong: rgba(255,255,255,.145);

  --primary: #e8e8ea;
  --secondary: #9a9da4;
  --muted: #666a72;
  --faint: #44484f;

  --accent: #706ee0;
  --accent-soft: rgba(112,110,224,.12);

  --blue: #5b9fe9;
  --cyan: #2eabb9;
  --success: #55b875;
  --warning: #d0ad47;
  --danger: #d96c76;

  --font-body: var(--font-inter), -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-display: var(--font-body);
  --font-mono: "SF Mono", "SFMono-Regular", Menlo, Monaco, Consolas, monospace;

  --bg: var(--background);
  --bg-elevated: var(--surface-2);
  --text: var(--primary);
  --text-dim: var(--secondary);
  --text-faint: var(--muted);
  --positive: var(--success);
  --positive-soft: rgba(85,184,117,.10);
  --negative: var(--danger);
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  min-height: 100%;
  background: var(--background);
}

body {
  color: var(--primary);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  text-rendering: geometricPrecision;
}

button,
input,
select,
textarea {
  font: inherit;
}

a {
  color: inherit;
}

::selection {
  background: rgba(112,110,224,.34);
  color: white;
}

:focus-visible {
  outline: 1px solid rgba(125,122,234,.75);
  outline-offset: 2px;
}

* {
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,.12) transparent;
}

*::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}

*::-webkit-scrollbar-track {
  background: transparent;
}

*::-webkit-scrollbar-thumb {
  border: 2px solid transparent;
  border-radius: 999px;
  background: rgba(255,255,255,.12);
  background-clip: padding-box;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: .001ms !important;
    transition-duration: .001ms !important;
  }
}
