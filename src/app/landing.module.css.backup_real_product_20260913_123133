.page {
  --bg: #08090b;
  --bg-soft: #0b0d10;
  --panel: #0f1114;
  --panel-2: #12151a;
  --panel-3: #171a20;
  --panel-4: #1b1f26;

  --line: rgba(255,255,255,.055);
  --line-strong: rgba(255,255,255,.09);

  --text: #f1f2f4;
  --text-2: #b6bac1;
  --muted: #767b84;
  --dim: #4b5059;

  --blue: #6c91d7;
  --purple: #9179e8;
  --cyan: #65b6c7;
  --green: #62b57c;
  --yellow: #d7ad5b;
  --red: #d16e74;
  --pink: #c67ca8;

  min-height: 100vh;

  overflow: hidden;

  background: var(--bg);
  color: var(--text);
}

.page * {
  box-sizing: border-box;
}

.page button,
.page a {
  font: inherit;
}

.ambient {
  position: fixed;
  z-index: 0;

  inset: 0;

  pointer-events: none;

  background:
    radial-gradient(
      circle at 50% -10%,
      rgba(108,145,215,.055),
      transparent 33%
    ),
    radial-gradient(
      circle at 13% 30%,
      rgba(145,121,232,.025),
      transparent 25%
    );
}


/* NAV */

.header {
  position: relative;
  z-index: 20;

  padding: 19px 20px 0;
}

.navbar {
  width: min(1320px,100%);
  height: 58px;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  margin: 0 auto;
  padding: 0 13px 0 16px;

  border: 1px solid var(--line-strong);
  border-radius: 14px;

  background:
    linear-gradient(
      180deg,
      rgba(19,22,27,.94),
      rgba(12,14,17,.94)
    );

  box-shadow:
    0 14px 45px rgba(0,0,0,.27),
    inset 0 1px 0 rgba(255,255,255,.025);

  backdrop-filter: blur(18px);
}

.brand {
  display: inline-flex;
  align-items: center;

  gap: 9px;

  width: max-content;

  color: #ededf0;

  font-size: 13px;
  font-weight: 590;

  text-decoration: none;
}

.logo {
  width: 20px;
  height: 20px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  gap: 2px;

  padding-left: 4px;

  border: 1px solid rgba(255,255,255,.10);
  border-radius: 5px;

  background: #171a1e;
}

.logo i {
  height: 2px;

  display: block;

  border-radius: 2px;

  background: #cacdd2;
}

.logo i:nth-child(1) {
  width: 11px;
}

.logo i:nth-child(2) {
  width: 8px;
}

.logo i:nth-child(3) {
  width: 5px;
}

.nav {
  display: flex;

  gap: 27px;
}

.nav a,
.account > a:first-child {
  color: #7b8088;

  font-size: 10px;

  text-decoration: none;

  transition:
    color .18s ease,
    opacity .18s ease;
}

.nav a:hover,
.account > a:first-child:hover {
  color: #d7d9dd;
}

.account {
  justify-self: end;

  display: flex;
  align-items: center;

  gap: 18px;
}

.signup,
.primary {
  height: 32px;

  display: inline-flex;
  align-items: center;

  gap: 7px;

  padding: 0 13px;

  border-radius: 6px;

  background: #eff0f2;
  color: #121418;

  font-size: 9px;
  font-weight: 620;

  text-decoration: none;

  box-shadow:
    0 3px 10px rgba(255,255,255,.05);
}


/* HERO */

.hero {
  position: relative;
  z-index: 1;

  padding: 56px 20px 0;
}

.heroMeta {
  width: min(1280px,100%);

  display: flex;
  align-items: center;
  justify-content: space-between;

  margin: 0 auto 18px;

  color: #5d626b;

  font-size: 8px;
}

.heroBadge {
  display: inline-flex;
  align-items: center;

  gap: 7px;

  color: #8b9098;
}

.heroBadge svg {
  color: var(--purple);
}

.heroMeta p {
  margin: 0;
}

.heroScene {
  position: relative;

  width: min(1380px,96vw);
  height: 650px;

  margin: 0 auto;

  overflow: hidden;

  border: 1px solid var(--line);
  border-radius: 14px;

  background:
    linear-gradient(
      180deg,
      #0b0d10,
      #090b0e
    );

  box-shadow:
    0 50px 140px rgba(0,0,0,.42);
}

.sceneGrid {
  position: absolute;

  inset: 0;

  opacity: .55;

  background-image:
    linear-gradient(
      rgba(255,255,255,.027) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.027) 1px,
      transparent 1px
    );

  background-size: 30px 30px;

  mask-image:
    linear-gradient(
      to bottom,
      black,
      rgba(0,0,0,.7) 55%,
      transparent 96%
    );
}

.heroGlow {
  position: absolute;

  left: 20%;
  right: 12%;
  bottom: 30px;

  height: 250px;

  background:
    radial-gradient(
      ellipse,
      rgba(91,112,160,.13),
      rgba(111,86,157,.045) 44%,
      transparent 72%
    );

  filter: blur(80px);
}

.window {
  position: absolute;

  overflow: hidden;

  border: 1px solid var(--line-strong);
  border-radius: 10px;

  background: rgba(15,17,20,.96);

  box-shadow:
    0 35px 100px rgba(0,0,0,.43),
    inset 0 1px 0 rgba(255,255,255,.018);

  backdrop-filter: blur(18px);
}

.queueWindow {
  left: 2%;
  top: 88px;

  width: 46%;
  height: 492px;

  animation:
    sceneLeft .85s cubic-bezier(.2,.75,.2,1) both;
}

.detailWindow {
  z-index: 4;

  right: 2%;
  top: 31px;

  width: 67%;
  height: 510px;

  animation:
    sceneRight .95s .08s cubic-bezier(.2,.75,.2,1) both;
}

.windowBar,
.sceneTop {
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 13px;

  border-bottom: 1px solid var(--line);

  background: #14171b;

  color: #686d76;

  font-size: 8px;
}

.windowBar > div,
.sceneTop > div:first-child {
  display: flex;
  align-items: center;

  gap: 8px;

  color: #92969d;
}

.queueBody {
  padding: 9px 11px;
}

.queueGroup {
  margin-bottom: 4px;
}

.queueTitle {
  height: 29px;

  display: flex;
  align-items: center;

  gap: 7px;

  color: #626771;

  font-size: 7px;
}

.queueTitle > i,
.queueRow > i,
.property i,
.railItem i,
.keywordRow i,
.opportunityGroupTitle i,
.opportunityRow > i {
  width: 7px;
  height: 7px;

  display: block;

  flex: 0 0 auto;

  border-radius: 50%;
}

.queueTitle strong {
  color: #a4a8ae;

  font-size: 8px;
  font-weight: 520;
}

.queueRow {
  min-height: 40px;

  display: grid;
  grid-template-columns: 16px 63px 1fr;
  align-items: center;

  border-bottom: 1px solid rgba(255,255,255,.035);

  color: #5f646d;

  font-size: 7px;
}

.queueRow strong {
  overflow: hidden;

  color: #8e9299;

  font-weight: 500;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.detailBody {
  height: calc(100% - 42px);
}

.detailHead {
  height: 67px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 15px;

  border-bottom: 1px solid var(--line);
}

.detailHead > div {
  display: flex;
  flex-direction: column;

  gap: 4px;
}

.detailKicker {
  color: #555a63;

  font-size: 7px;
}

.detailHead strong {
  color: #b9bcc1;

  font-size: 10px;
  font-weight: 530;
}

.reviewPill {
  padding: 4px 7px;

  border: 1px solid rgba(215,173,91,.19);
  border-radius: 999px;

  background: rgba(215,173,91,.055);
  color: #c3a66b;

  font-size: 6px;
}

.detailGrid {
  display: grid;
  grid-template-columns: 170px 1fr;

  min-height: 305px;
}

.properties {
  padding: 9px;

  border-right: 1px solid var(--line);

  background: #0c0e11;
}

.property {
  height: 49px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  gap: 7px;

  padding: 0 7px;

  border-bottom: 1px solid rgba(255,255,255,.035);
}

.property > span {
  color: #4d525b;

  font-size: 6px;
}

.property > div {
  display: flex;
  align-items: center;

  gap: 6px;
}

.property strong {
  color: #8d9198;

  font-size: 7px;
  font-weight: 520;
}

.diffPanel {
  background: #0e1013;
}

.diffHeader {
  height: 34px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 11px;

  border-bottom: 1px solid var(--line);

  color: #535861;

  font-size: 6px;
}

.codeLine,
.codeGood,
.codeBad {
  height: 42px;

  display: grid;
  grid-template-columns: 32px 1fr;
  align-items: center;

  padding: 0 10px;

  color: #868b93;

  font-size: 9px;
}

.codeLine > span,
.codeGood > span,
.codeBad > span {
  color: #3f444c;

  font-size: 6px;
}

.codeLine code,
.codeGood code,
.codeBad code {
  font-family: var(--font-mono,monospace);
}

.codeLine b,
.codeGood b,
.codeBad b {
  color: var(--purple);
}

.codeLine em,
.codeGood em,
.codeBad em {
  color: var(--blue);
  font-style: normal;
}

.codeBad {
  background: rgba(209,110,116,.10);

  box-shadow:
    inset 2px 0 0 var(--red);
}

.codeGood {
  background: rgba(98,181,124,.085);

  box-shadow:
    inset 2px 0 0 var(--green);
}

.activity {
  min-height: 75px;

  display: flex;
  align-items: center;

  gap: 10px;

  padding: 0 15px;

  border-top: 1px solid var(--line);

  background: #111419;
}

.activityDot {
  width: 8px;
  height: 8px;

  border-radius: 50%;

  background: var(--green);

  box-shadow:
    0 0 0 5px rgba(98,181,124,.08);

  animation:
    pulse 2.4s ease-in-out infinite;
}

.activity > div:last-child {
  display: flex;
  flex-direction: column;

  gap: 4px;
}

.activity strong {
  color: #a7abb2;

  font-size: 8px;
  font-weight: 520;
}

.activity span {
  color: #555a63;

  font-size: 7px;
}

.signalFloat,
.verifiedFloat {
  position: absolute;
  z-index: 7;

  display: flex;
  align-items: center;

  gap: 9px;

  padding: 11px;

  border: 1px solid var(--line-strong);
  border-radius: 8px;

  background: rgba(22,25,30,.94);

  box-shadow:
    0 24px 70px rgba(0,0,0,.37);

  backdrop-filter: blur(18px);
}

.signalFloat {
  left: 7%;
  bottom: 35px;

  width: 255px;

  animation:
    floatUp .9s .35s cubic-bezier(.2,.75,.2,1) both,
    drift 5s 1.3s ease-in-out infinite;
}

.signalFloat > svg {
  color: var(--purple);
}

.signalFloat > div:nth-child(2) {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.signalFloat span,
.verifiedFloat span {
  color: #555a63;

  font-size: 6px;
}

.signalFloat strong,
.verifiedFloat strong {
  color: #aeb1b7;

  font-size: 8px;
  font-weight: 520;
}

.tinySpark {
  height: 24px;

  display: flex;
  align-items: flex-end;

  gap: 2px;

  margin-left: auto;
}

.tinySpark i {
  width: 2px;

  display: block;

  border-radius: 2px;

  background: var(--purple);
}

.tinySpark i:nth-child(1) { height: 20%; }
.tinySpark i:nth-child(2) { height: 35%; }
.tinySpark i:nth-child(3) { height: 30%; }
.tinySpark i:nth-child(4) { height: 55%; }
.tinySpark i:nth-child(5) { height: 48%; }
.tinySpark i:nth-child(6) { height: 72%; }
.tinySpark i:nth-child(7) { height: 92%; }

.verifiedFloat {
  right: 8%;
  bottom: 72px;

  animation:
    floatUp .9s .48s cubic-bezier(.2,.75,.2,1) both;
}

.verifiedFloat svg {
  color: var(--green);
}

.verifiedFloat > div {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.heroRail {
  width: min(1280px,100%);

  display: grid;
  grid-template-columns: repeat(4,1fr);

  margin: 0 auto;

  border-bottom: 1px solid var(--line);
}

.railItem {
  min-height: 76px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  gap: 8px;

  padding: 0 19px;

  border-right: 1px solid var(--line);
}

.railItem:last-child {
  border-right: 0;
}

.railItem > div {
  display: flex;
  align-items: center;

  gap: 7px;

  color: #4f545d;

  font-size: 6px;
}

.railItem strong {
  color: #777c84;

  font-size: 8px;
  font-weight: 500;
}


/* PRINCIPLES */

.principles {
  position: relative;
  z-index: 1;

  width: min(1280px,calc(100% - 40px));

  display: grid;
  grid-template-columns: repeat(3,1fr);

  margin: 0 auto;
  padding: 110px 0 120px;

  border-bottom: 1px solid var(--line);
}

.principle {
  min-height: 160px;

  display: grid;
  grid-template-columns: 42px 1fr;

  gap: 16px;

  padding: 25px 27px;

  border-right: 1px solid var(--line);
}

.principle:last-child {
  border-right: 0;
}

.principleIcon {
  width: 36px;
  height: 36px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid var(--line);
  border-radius: 8px;

  background: var(--panel);

  color: #8a8f98;
}

.principle span {
  color: #50555e;

  font-size: 7px;
}

.principle h3 {
  margin: 7px 0 0;

  color: #aeb1b7;

  font-size: 12px;
  font-weight: 520;
}

.principle p {
  max-width: 270px;

  margin: 8px 0 0;

  color: #5d626b;

  font-size: 8px;
  line-height: 1.6;
}


/* PRODUCT SECTION */

.productSection,
.editorialSection,
.workflowSection {
  position: relative;
  z-index: 1;

  width: min(1280px,calc(100% - 40px));

  margin: 0 auto;
  padding: 125px 0;

  border-bottom: 1px solid var(--line);
}

.sectionIntro {
  display: grid;
  grid-template-columns: 240px 1fr;

  gap: 70px;

  margin-bottom: 52px;
}

.sectionIntro > div:first-child {
  display: flex;

  gap: 14px;

  padding-top: 7px;

  color: #50555e;

  font-size: 7px;

  letter-spacing: .06em;
}

.sectionIntro h2,
.editorialCopy h2,
.workflowCopy h2 {
  max-width: 570px;

  margin: 0;

  color: #e3e5e7;

  font-size: clamp(29px,3vw,41px);
  font-weight: 500;

  line-height: 1.02;

  letter-spacing: -.045em;
}

.sectionIntro p,
.editorialCopy p,
.workflowCopy p {
  max-width: 510px;

  margin: 17px 0 0;

  color: #6c717a;

  font-size: 9px;
  line-height: 1.7;
}

.searchScene,
.audienceScene,
.workflowScene {
  overflow: hidden;

  border: 1px solid var(--line-strong);
  border-radius: 11px;

  background: var(--panel);

  box-shadow:
    0 35px 100px rgba(0,0,0,.24);
}

.sceneActions {
  display: flex;

  gap: 5px;
}

.sceneActions button,
.runButton,
.opportunityTop button {
  height: 26px;

  display: inline-flex;
  align-items: center;

  gap: 5px;

  padding: 0 8px;

  border: 1px solid var(--line);
  border-radius: 5px;

  background: #191c21;
  color: #70757d;

  font-size: 7px;
}


/* SEARCH */

.searchSceneBody {
  display: grid;
  grid-template-columns: 1.6fr .55fr;
}

.keywordArea {
  border-right: 1px solid var(--line);
}

.keywordToolbar {
  height: 51px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 12px;

  border-bottom: 1px solid var(--line);
}

.fakeSearch {
  width: 235px;
  height: 27px;

  display: flex;
  align-items: center;

  gap: 7px;

  padding: 0 9px;

  border: 1px solid var(--line);
  border-radius: 5px;

  background: #0c0e11;
  color: #4f545d;

  font-size: 7px;
}

.keywordToolbar > span {
  color: #484d56;

  font-size: 6px;
}

.keywordHeader,
.keywordRow {
  display: grid;
  grid-template-columns: 1.5fr .8fr .7fr .7fr;
  align-items: center;

  padding: 0 12px;
}

.keywordHeader {
  height: 35px;

  border-bottom: 1px solid var(--line);

  background: #111419;
  color: #474c55;

  font-size: 6px;

  letter-spacing: .05em;
  text-transform: uppercase;
}

.keywordRow {
  min-height: 58px;

  border-bottom: 1px solid rgba(255,255,255,.035);

  color: #6f747c;

  font-size: 7px;
}

.keywordRow:last-child {
  border-bottom: 0;
}

.keywordRow > div {
  display: flex;
  align-items: center;

  gap: 8px;
}

.keywordRow strong {
  color: #a6aab0;

  font-weight: 520;
}

.marketAside {
  background: #0c0e11;
}

.asideHead {
  height: 59px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 12px;

  border-bottom: 1px solid var(--line);
}

.asideHead > div {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.asideHead span,
.asideFooter span {
  color: #474c55;

  font-size: 6px;
}

.asideHead strong,
.asideFooter strong {
  color: #858a92;

  font-size: 8px;
  font-weight: 520;
}

.asideHead svg {
  color: var(--purple);
}

.marketBar {
  padding: 13px 12px;

  border-bottom: 1px solid rgba(255,255,255,.035);
}

.marketBar > span {
  color: #656a73;

  font-size: 7px;
}

.marketBar > div {
  height: 3px;

  margin-top: 8px;

  border-radius: 3px;

  background: #202329;
}

.marketBar i {
  height: 100%;

  display: block;

  border-radius: 3px;
}

.asideFooter {
  display: flex;
  flex-direction: column;

  gap: 4px;

  padding: 15px 12px;
}


/* AUDIENCE */

.live {
  display: flex;
  align-items: center;

  gap: 6px;

  color: #626770;

  font-size: 7px;
}

.live i {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: var(--green);

  box-shadow:
    0 0 10px rgba(98,181,124,.3);
}

.metricsRow {
  display: grid;
  grid-template-columns: repeat(4,1fr);

  border-bottom: 1px solid var(--line);
}

.metric {
  min-height: 66px;

  padding: 12px;

  border-right: 1px solid var(--line);
}

.metric:last-child {
  border-right: 0;
}

.metric > span {
  color: #4f545d;

  font-size: 6px;
}

.metric > div {
  display: flex;
  align-items: center;

  gap: 6px;

  margin-top: 12px;
}

.metric strong {
  color: #8b8f96;

  font-size: 7px;
  font-weight: 520;
}

.audienceMain {
  display: grid;
  grid-template-columns: 1fr 250px;
}

.chartPanel {
  position: relative;

  height: 340px;

  border-right: 1px solid var(--line);

  background: #0c0e11;
}

.chartHeader {
  height: 54px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 13px;

  border-bottom: 1px solid var(--line);
}

.chartHeader > div {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.chartHeader span {
  color: #4f545d;

  font-size: 6px;
}

.chartHeader strong {
  color: #898e95;

  font-size: 8px;
  font-weight: 520;
}

.chartGrid {
  position: absolute;

  inset: 54px 0 0;

  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

.chartGrid i {
  height: 1px;

  background: rgba(255,255,255,.025);
}

.chartBars {
  position: absolute;

  inset: 78px 16px 18px;

  display: flex;
  align-items: flex-end;

  gap: 7px;
}

.chartBars span {
  flex: 1;

  height: 100%;

  display: flex;
  align-items: flex-end;
}

.chartBars i {
  width: 100%;
  min-height: 4px;

  display: block;

  border-radius: 3px 3px 0 0;

  background: #454a53;

  transform-origin: bottom;

  animation:
    barGrow .85s ease both;
}

.chartBars span:nth-child(2n) i {
  animation-delay: .06s;
}

.chartBars span:nth-child(3n) i {
  animation-delay: .11s;
}

.chartPurple {
  background: var(--purple) !important;
}

.chartGreen {
  background: var(--green) !important;
}

.chartBlue {
  background: var(--blue) !important;
}

.breakdownPanel {
  padding: 8px;

  background: #101318;
}

.breakdown {
  min-height: 96px;

  padding: 12px;

  border-bottom: 1px solid rgba(255,255,255,.04);
}

.breakdown:last-child {
  border-bottom: 0;
}

.breakdown strong {
  color: #787d85;

  font-size: 7px;
  font-weight: 520;
}

.breakdown > span {
  height: 3px;

  display: block;

  margin-top: 9px;

  border-radius: 3px;

  background: #22262c;
}

.breakdown > span i {
  height: 100%;

  display: block;

  border-radius: 3px;
}


/* OPPORTUNITIES */

.editorialSection {
  display: grid;
  grid-template-columns: .62fr 1.38fr;

  gap: 72px;

  align-items: center;
}

.editorialCopy > span,
.workflowCopy > span {
  color: #50555e;

  font-size: 7px;

  letter-spacing: .06em;
}

.editorialCopy h2,
.workflowCopy h2 {
  margin-top: 14px;
}

.editorialCopy > a {
  display: inline-flex;
  align-items: center;

  gap: 7px;

  margin-top: 20px;

  color: #9a9ea5;

  font-size: 8px;

  text-decoration: none;
}

.opportunityScene {
  position: relative;

  min-height: 530px;

  display: grid;
  grid-template-columns: 150px 1fr;

  overflow: hidden;

  border: 1px solid var(--line-strong);
  border-radius: 11px;

  background: var(--panel);

  box-shadow:
    0 35px 100px rgba(0,0,0,.25);
}

.miniSidebar {
  position: relative;

  padding: 12px 8px;

  border-right: 1px solid var(--line);

  background: #0b0d10;
}

.sidebarBrand {
  display: flex;
  align-items: center;

  gap: 8px;

  margin: 0 5px 16px;

  color: #8a8f97;

  font-size: 8px;
}

.sidebarRow {
  height: 29px;

  display: flex;
  align-items: center;

  gap: 8px;

  padding: 0 8px;

  border-radius: 5px;

  color: #555a63;

  font-size: 7px;
}

.sidebarActive {
  background: #181b20;
  color: #c2c5c9;
}

.sidebarActive svg {
  color: var(--purple);
}

.sidebarSettings {
  position: absolute;

  left: 8px;
  right: 8px;
  bottom: 12px;

  height: 29px;

  display: flex;
  align-items: center;

  gap: 8px;

  padding: 0 8px;

  color: #50555e;

  font-size: 7px;
}

.opportunityMain {
  background: #101318;
}

.opportunityTop {
  height: 61px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 14px;

  border-bottom: 1px solid var(--line);
}

.opportunityTop > div {
  display: flex;
  flex-direction: column;

  gap: 4px;
}

.opportunityTop span {
  color: #4f545d;

  font-size: 6px;
}

.opportunityTop strong {
  color: #aaaeb4;

  font-size: 9px;
  font-weight: 520;
}

.opportunityGroup {
  padding: 8px 12px 0;
}

.opportunityGroupTitle {
  height: 30px;

  display: flex;
  align-items: center;

  gap: 7px;

  color: #5a5f68;

  font-size: 7px;
}

.opportunityGroupTitle strong {
  color: #858a92;

  font-weight: 520;
}

.opportunityRow {
  min-height: 43px;

  display: grid;
  grid-template-columns: 15px 58px 1fr 28px;
  align-items: center;

  border-bottom: 1px solid rgba(255,255,255,.035);

  color: #545962;

  font-size: 7px;
}

.opportunityRow strong {
  color: #90949b;

  font-weight: 500;
}

.owner {
  width: 20px;
  height: 20px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid var(--line);
  border-radius: 50%;

  background: #191c21;
  color: #737881;

  font-size: 6px;
}

.opportunityFloat {
  position: absolute;

  right: 22px;
  bottom: 20px;

  display: flex;
  align-items: center;

  gap: 9px;

  padding: 11px;

  border: 1px solid rgba(145,121,232,.18);
  border-radius: 7px;

  background: rgba(24,27,32,.96);

  box-shadow:
    0 22px 60px rgba(0,0,0,.34);

  animation:
    drift 5.5s ease-in-out infinite;
}

.opportunityFloat svg {
  color: var(--purple);
}

.opportunityFloat > div {
  display: flex;
  flex-direction: column;

  gap: 3px;
}

.opportunityFloat span {
  color: #535861;

  font-size: 6px;
}

.opportunityFloat strong {
  color: #9b9fa6;

  font-size: 7px;
  font-weight: 520;
}


/* WORKFLOW */

.workflowCopy {
  max-width: 600px;

  margin-bottom: 50px;
}

.workflowCanvas {
  position: relative;

  height: 490px;

  background-color: #0b0d10;

  background-image:
    linear-gradient(
      rgba(255,255,255,.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.025) 1px,
      transparent 1px
    );

  background-size: 28px 28px;
}

.workflowNode {
  position: absolute;
  z-index: 3;

  width: 148px;
  min-height: 72px;

  display: grid;
  grid-template-columns: 31px 1fr;
  grid-template-rows: 1fr 1fr;
  align-items: center;

  padding: 9px;

  border: 1px solid var(--line-strong);
  border-radius: 7px;

  background: #171a1f;

  box-shadow:
    0 18px 50px rgba(0,0,0,.34);

  transition:
    transform .2s ease,
    border-color .2s ease;
}

.workflowNode:hover {
  transform: translateY(-3px);

  border-color: rgba(255,255,255,.14);
}

.nodeIcon {
  grid-row: 1 / 3;

  width: 27px;
  height: 27px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 5px;

  background: #20242a !important;
}

.workflowNode strong {
  color: #a8acb2;

  font-size: 8px;
  font-weight: 520;
}

.workflowNode > span {
  color: #545962;

  font-size: 6px;
}

.node1 {
  left: 5%;
  top: 42%;
}

.node2 {
  left: 25%;
  top: 18%;
}

.node3 {
  left: 45%;
  top: 42%;
}

.node4 {
  left: 65%;
  top: 18%;
}

.node5 {
  right: 5%;
  top: 42%;
}

.flow1,
.flow2,
.flow3,
.flow4 {
  position: absolute;
  z-index: 1;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      #30343b,
      #464b55
    );

  transform-origin: left center;
}

.flow1 {
  width: 24%;
  left: 16%;
  top: 47%;
  transform: rotate(-24deg);
}

.flow2 {
  width: 24%;
  left: 36%;
  top: 29%;
  transform: rotate(24deg);
}

.flow3 {
  width: 24%;
  left: 56%;
  top: 47%;
  transform: rotate(-24deg);
}

.flow4 {
  width: 23%;
  left: 76%;
  top: 29%;
  transform: rotate(24deg);
}


/* FINAL */

.final {
  position: relative;
  z-index: 1;

  width: min(1280px,calc(100% - 40px));
  min-height: 390px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 60px;

  margin: 0 auto;

  border-bottom: 1px solid var(--line);
}

.final > div:first-child > span {
  color: #4f545d;

  font-size: 7px;

  letter-spacing: .08em;
}

.final h2 {
  margin: 13px 0 0;

  color: #e5e6e8;

  font-size: clamp(30px,3.2vw,43px);
  font-weight: 500;

  letter-spacing: -.045em;
}

.final p {
  max-width: 500px;

  margin: 15px 0 0;

  color: #686d76;

  font-size: 9px;
  line-height: 1.7;
}

.finalActions {
  display: flex;

  gap: 7px;
}

.secondary {
  height: 32px;

  display: inline-flex;
  align-items: center;

  padding: 0 12px;

  border: 1px solid var(--line-strong);
  border-radius: 6px;

  background: #14171b;
  color: #858a92;

  font-size: 9px;

  text-decoration: none;
}


/* FOOTER */

.footer {
  position: relative;
  z-index: 1;

  width: min(1280px,calc(100% - 40px));
  min-height: 105px;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  margin: 0 auto;

  color: #525761;

  font-size: 7px;
}

.footer > div {
  justify-self: end;

  display: flex;

  gap: 20px;
}

.footer > div a {
  color: #626770;

  text-decoration: none;
}


/* TONES */

.blue {
  color: var(--blue) !important;
  background: var(--blue) !important;
}

.purple {
  color: var(--purple) !important;
  background: var(--purple) !important;
}

.cyan {
  color: var(--cyan) !important;
  background: var(--cyan) !important;
}

.green {
  color: var(--green) !important;
  background: var(--green) !important;
}

.yellow {
  color: var(--yellow) !important;
  background: var(--yellow) !important;
}

.red {
  color: var(--red) !important;
  background: var(--red) !important;
}

.pink {
  color: var(--pink) !important;
  background: var(--pink) !important;
}

.muted {
  color: #535861 !important;
  background: #535861 !important;
}


/* ANIMATION */

@keyframes sceneLeft {
  from {
    opacity: 0;
    transform: translate3d(-28px,30px,0) scale(.985);
  }

  to {
    opacity: 1;
    transform: translate3d(0,0,0) scale(1);
  }
}

@keyframes sceneRight {
  from {
    opacity: 0;
    transform: translate3d(34px,24px,0) scale(.98);
  }

  to {
    opacity: 1;
    transform: translate3d(0,0,0) scale(1);
  }
}

@keyframes floatUp {
  from {
    opacity: 0;
    transform: translateY(18px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes drift {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-6px);
  }
}

@keyframes pulse {
  0%,
  100% {
    box-shadow:
      0 0 0 4px rgba(98,181,124,.06);
  }

  50% {
    box-shadow:
      0 0 0 8px rgba(98,181,124,.015);
  }
}

@keyframes barGrow {
  from {
    transform: scaleY(.05);
    opacity: .2;
  }

  to {
    transform: scaleY(1);
    opacity: 1;
  }
}

@keyframes revealSection {
  from {
    opacity: .25;
    transform: translateY(38px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@supports (animation-timeline: view()) {
  .reveal {
    animation:
      revealSection linear both;

    animation-timeline: view();
    animation-range:
      entry 5% cover 30%;
  }
}


/* RESPONSIVE */

@media (max-width: 1050px) {
  .nav {
    display: none;
  }

  .heroScene {
    width: 1100px;

    transform: scale(.82);
    transform-origin: top left;
  }

  .hero {
    overflow: hidden;
  }

  .heroRail {
    margin-top: -110px;
  }

  .editorialSection {
    grid-template-columns: 1fr;

    gap: 45px;
  }

  .sectionIntro {
    grid-template-columns: 180px 1fr;
  }

  .searchSceneBody {
    grid-template-columns: 1fr 230px;
  }
}

@media (max-width: 720px) {
  .header {
    padding-left: 12px;
    padding-right: 12px;
  }

  .navbar {
    height: 54px;
  }

  .account > a:first-child {
    display: none;
  }

  .hero {
    padding-left: 12px;
    padding-right: 12px;
  }

  .heroMeta p {
    display: none;
  }

  .heroScene {
    width: 1080px;
    height: 520px;

    transform: scale(.53);
  }

  .heroRail {
    grid-template-columns: 1fr 1fr;

    margin-top: -240px;
  }

  .railItem:nth-child(2) {
    border-right: 0;
  }

  .principles {
    grid-template-columns: 1fr;

    padding-top: 80px;
  }

  .principle {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .sectionIntro {
    grid-template-columns: 1fr;

    gap: 15px;
  }

  .productSection,
  .editorialSection,
  .workflowSection {
    padding: 90px 0;
  }

  .searchSceneBody,
  .audienceMain {
    grid-template-columns: 1fr;
  }

  .marketAside,
  .breakdownPanel {
    border-top: 1px solid var(--line);
  }

  .metricsRow {
    grid-template-columns: 1fr 1fr;
  }

  .metric:nth-child(2) {
    border-right: 0;
  }

  .opportunityScene {
    grid-template-columns: 58px 1fr;
  }

  .sidebarBrand span,
  .sidebarRow span,
  .sidebarSettings {
    font-size: 0;
  }

  .workflowCanvas {
    height: 620px;
  }

  .workflowNode {
    left: 50% !important;
    right: auto !important;

    transform: translateX(-50%);
  }

  .workflowNode:hover {
    transform: translateX(-50%) translateY(-3px);
  }

  .node1 { top: 30px; }
  .node2 { top: 140px; }
  .node3 { top: 250px; }
  .node4 { top: 360px; }
  .node5 { top: 470px; }

  .flow1,
  .flow2,
  .flow3,
  .flow4 {
    display: none;
  }

  .final {
    min-height: 360px;

    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .footer {
    grid-template-columns: 1fr;

    gap: 18px;

    padding: 28px 0;
  }

  .footer > div {
    justify-self: start;
  }
}

@media (prefers-reduced-motion: reduce) {
  .queueWindow,
  .detailWindow,
  .signalFloat,
  .verifiedFloat,
  .activityDot,
  .chartBars i,
  .reveal {
    animation: none !important;
  }
}
