}: {
  side: "before" | "after";
}) {
  const after = side === "after";

  return (
    <div className={styles.codeColumn}>
      <div className={styles.codeColumnTitle}>
        {after ? "After" : "Before"}
      </div>

      <CodeLine n="01">
        <span className={styles.codePink}>import</span>{" "}
        <span className={styles.codeOrange}>{"{"}</span>{" "}
        <span className={styles.codeYellow}>fetchPage</span>{" "}
        <span className={styles.codeOrange}>{"}"}</span>
      </CodeLine>

      <CodeLine n="02">
        <span className={styles.codePink}>import</span>{" "}
        <span className={styles.codeBlue}>SEOIssue</span>
      </CodeLine>

      <CodeLine
        n="03"
        changed
        good={after}
      >
        <span className={styles.codePink}>const</span>{" "}
        <span className={styles.codeCyan}>
          canonical
        </span>{" "}
        ={" "}
        <span className={styles.codeYellow}>
          {after ? "resolvedCanonical" : "pageUrl"}
        </span>
      </CodeLine>

      <CodeLine n="04">
        <span className={styles.codePink}>const</span>{" "}
        result = analyzePage()
      </CodeLine>

      <CodeLine n="05">
        {" "}
      </CodeLine>

      <CodeLine
        n="06"
        changed
        good={after}
      >
        <span className={styles.codePurple}>
          {after ? "verifyAfterApply()" : "applyFix()"}
        </span>
      </CodeLine>

      <CodeLine n="07">
        <span className={styles.codePink}>return</span>{" "}
        result
      </CodeLine>

      <CodeLine n="08">
        {"}"}
      </CodeLine>
    </div>
  );
}

function CodeLine({
  n,
  children,
  changed = false,
  good = false,
}: {
  n: string;
  children: React.ReactNode;
  changed?: boolean;
  good?: boolean;
}) {
  return (
    <div
      className={
        changed
          ? good
            ? styles.codeGood
            : styles.codeBad
          : styles.codeLine
      }
    >
      <span>{n}</span>
      <code>{children}</code>
    </div>
  );
}

