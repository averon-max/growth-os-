import Link from "next/link";

import {
  FileText,
  Globe,
  ShieldCheck,
} from "lucide-react";

import {
  requireUser,
} from "@/lib/auth-helpers";

import {
  prisma,
} from "@/lib/prisma";

import {
  Topbar,
} from "@/components/dashboard/topbar";

import {
  EmptyState,
} from "@/components/dashboard/ui";

import {
  ContentExplorer,
} from "@/components/dashboard/content-explorer";

import {
  ContentCreateButton,
} from "@/components/dashboard/content-create-button";

import {
  ContentGovernancePanel,
} from "@/components/dashboard/content-governance-panel";

import {
  OutcomeActionResumePanel,
} from "@/components/dashboard/outcome-action-resume-panel";

import styles from "@/components/dashboard/ui.module.css";

export default async function ContentPage({
  searchParams,
}: {
  searchParams:
    Promise<{
      websiteId?: string;
      outcomeActionId?: string;
    }>;
}) {
  const user =
    await requireUser();

  const {
    websiteId,
    outcomeActionId,
  } =
    await searchParams;

  const membership =
    await prisma.workspaceMember.findFirst({
      where: {
        userId:
          user.id,
      },
      select: {
        workspaceId:
          true,
      },
    });

  const website =
    membership
      ? websiteId
        ? await prisma.website.findFirst({
            where: {
              id:
                websiteId,
              business: {
                workspaceId:
                  membership.workspaceId,
              },
            },
          })
        : await prisma.website.findFirst({
            where: {
              business: {
                workspaceId:
                  membership.workspaceId,
              },
            },
            orderBy: {
              createdAt:
                "asc",
            },
          })
      : null;

  if (!website) {
    return (
      <>
        <Topbar title="Content" />

        <div className={styles.pageBody}>
          <EmptyState
            icon={Globe}
            title="No website"
            description="Add a website before creating content."
            actionLabel="Add website"
            actionHref="/dashboard/add-website"
          />
        </div>
      </>
    );
  }

  const resumeAction =
    outcomeActionId &&
    membership
      ? await prisma.keywordOutcomeAction.findFirst({
          where: {
            id:
              outcomeActionId,
            websiteId:
              website.id,
            workspaceId:
              membership.workspaceId,
          },
          select: {
            id:
              true,
            keywordText:
              true,
            decision:
              true,
            status:
              true,
            compatibilityStatus:
              true,
            compatibilityReason:
              true,
          },
        })
      : null;

  const analysis =
    await prisma.analysis.findFirst({
      where: {
        websiteId:
          website.id,
      },
      orderBy: {
        createdAt:
          "desc",
      },
    });

  const opportunities =
    analysis
      ? await prisma.opportunity.findMany({
          where: {
            analysisId:
              analysis.id,
          },
          orderBy: {
            score:
              "desc",
          },
          take:
            50,
        })
      : [];


  const articles =
    await prisma.contentArticle.findMany({
      where: {
        brief: {
          websiteId:
            website.id,
        },
      },

      select: {
        id:
          true,

        title:
          true,

        status:
          true,

        publishedUrl:
          true,

        updatedAt:
          true,

        brief: {
          select: {
            topic:
              true,

            primaryKeyword:
              true,
          },
        },
      },

      orderBy: {
        updatedAt:
          "desc",
      },

      take:
        25,
    });

  return (
    <>
      <Topbar
        title="Content"
        subtitle={website.url}
        websiteSwitcher={
          membership
            ? {
                workspaceId:
                  membership.workspaceId,
                currentWebsiteId:
                  website.id,
              }
            : undefined
        }
      />

      <div className={styles.pageBody}>
        <div className={styles.compactHeader}>
          <div>
            <h1 className={styles.compactTitle}>
              Content
            </h1>

            <div className={styles.compactMeta}>
              Plan, create, review and publish
            </div>
          </div>

          <a
            href="#content-workspace"
            className={styles.primaryButton}
          >
            <Plus size={13} />
            Create content
          </a>
        </div>

        <div className={styles.contentTabs}>
          <a
            href="#content-workspace"
            className={styles.contentTab}
          >
            Pipeline
          </a>

          <a
            href="#content-opportunities"
            className={styles.contentTab}
          >
            Opportunities
            <span className={styles.tabCount}>
              {opportunities.length}
            </span>
          </a>

          <a
            href="#content-articles"
            className={styles.contentTab}
          >
            Articles
          </a>

          <a
            href="#business-facts"
            className={styles.contentTab}
          >
            Business facts
          </a>
        </div>

        {resumeAction ? (
          <div className={styles.resumeSurface}>
            <OutcomeActionResumePanel
              websiteId={website.id}
              initialAction={resumeAction}
            />
          </div>
        ) : null}

        <section
          id="content-opportunities"
          className={styles.contentSection}
        >
          <div className={styles.contentSectionHeader}>
            <div>
              <div className={styles.contentSectionTitle}>
                Opportunities
              </div>

              <div className={styles.contentSectionMeta}>
                Pages and topics worth acting on
              </div>
            </div>

            <span className={styles.sectionCount}>
              {opportunities.length}
            </span>
          </div>

          {opportunities.length ? (
            <div className={styles.contentOpportunityList}>
              {opportunities
                .slice(0, 8)
                .map((opportunity) => (
                  <div
                    key={opportunity.id}
                    className={styles.contentOpportunityRow}
                  >
                    <div className={styles.contentOpportunityMain}>
                      <span
                        className={styles.contentPriorityDot}
                        data-priority={
                          opportunity.priority
                        }
                      />

                      <div>
                        <div className={styles.dataTitle}>
                          {opportunity.title}
                        </div>

                        <div className={styles.dataSecondary}>
                          {opportunity.reason}
                        </div>
                      </div>
                    </div>

                    <div className={styles.contentOpportunityMeta}>
                      <span>
                        {opportunity.priority}
                      </span>

                      <strong>
                        {opportunity.score}
                      </strong>
                    </div>
                  </div>
                ))}
            </div>
          ) : (
            <div className={styles.contentEmptyRow}>
              No open opportunities
            </div>
          )}
        </section>

        <section
          id="content-workspace"
          className={styles.contentSection}
        >
          <div className={styles.contentSectionHeader}>
            <div>
              <div className={styles.contentSectionTitle}>
                Content pipeline
              </div>

              <div className={styles.contentSectionMeta}>
                {opportunities.length} SEO opportunities available
              </div>
            </div>

            <FileText
              size={14}
              className={styles.sectionIcon}
            />
          </div>

          <div
            id="content-articles"
            className={styles.contentSurface}
          >
            <ContentExplorer
              websiteId={website.id}
              opportunities={opportunities}
            />
          </div>
        </section>

        <details
          id="business-facts"
          className={styles.technicalDisclosure}
        >
          <summary className={styles.technicalSummary}>
            <div className={styles.summaryIdentity}>
              <ShieldCheck size={14} />

              <div>
                <strong>
                  Business facts & evidence
                </strong>

                <span>
                  Verification, provenance and evidence history
                </span>
              </div>
            </div>

            <span className={styles.summaryAction}>
              View evidence
            </span>
          </summary>

          <div className={styles.technicalBody}>
            <ContentGovernancePanel
              websiteId={website.id}
            />
          </div>
        </details>
      </div>
    </>
  );
}
