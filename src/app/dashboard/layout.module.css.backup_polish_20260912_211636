.shell {
  display: flex;

  width: 100%;
  height: 100vh;
  min-height: 0;

  overflow: hidden;

  background: var(--background);
  color: var(--primary);
}

.main {
  position: relative;
  isolation: isolate;

  flex: 1;

  min-width: 0;
  min-height: 0;

  overflow-x: hidden;
  overflow-y: auto;

  background:
    radial-gradient(
      900px 520px at 78% -160px,
      rgba(118,123,145,.075),
      transparent 68%
    ),
    radial-gradient(
      650px 520px at -5% 52%,
      rgba(100,105,124,.035),
      transparent 68%
    ),
    var(--workspace);
}

.main::before {
  content: "";

  position: fixed;
  z-index: -1;

  top: 50px;
  right: 0;
  bottom: 0;
  left: 246px;

  pointer-events: none;

  background:
    linear-gradient(
      90deg,
      rgba(255,255,255,.012),
      transparent 18%,
      transparent 78%,
      rgba(0,0,0,.15)
    );
}

.main::after {
  content: "";

  position: fixed;
  z-index: 50;

  right: 0;
  bottom: 0;
  left: 246px;

  height: 110px;

  pointer-events: none;

  background:
    linear-gradient(
      180deg,
      transparent,
      rgba(9,10,11,.58)
    );

  opacity: .42;
}

@media (max-width: 900px) {
  .shell {
    height: auto;
    display: block;
  }

  .main {
    min-height: 100vh;
  }

  .main::before,
  .main::after {
    left: 0;
  }
}
