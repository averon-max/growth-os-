.shell {
  display: flex;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  background: var(--background);
  color: var(--primary);
}

.main {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;

  background:
    radial-gradient(
      900px 320px at 53% -220px,
      rgba(117,122,155,.055),
      transparent 72%
    ),
    var(--workspace);
}

@media (max-width: 900px) {
  .shell {
    display: block;
    height: auto;
    overflow: visible;
  }

  .main {
    min-height: 100vh;
  }
}
