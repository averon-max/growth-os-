.shell {
  display: flex;

  width: 100%;
  height: 100vh;

  min-height: 0;

  overflow: hidden;

  background: #090a0b;
  color: var(--primary);
}

.main {
  position: relative;
  isolation: isolate;

  flex: 1;

  min-width: 0;
  min-height: 0;

  overflow-x: hidden;
  overflow-y: auto;

  background:
    radial-gradient(
      1050px 520px at 70% -200px,
      rgba(150,154,171,.07),
      transparent 67%
    ),
    radial-gradient(
      720px 520px at -120px 55%,
      rgba(107,112,132,.025),
      transparent 72%
    ),
    #101214;
}

.main::before {
  content: "";

  position: fixed;
  z-index: -1;

  top: 50px;
  right: 0;
  bottom: 0;
  left: 246px;

  pointer-events: none;

  background:
    linear-gradient(
      90deg,
      rgba(255,255,255,.008),
      transparent 23%,
      transparent 80%,
      rgba(0,0,0,.12)
    );
}

@media (max-width: 900px) {
  .shell {
    height: auto;
    display: block;
  }

  .main {
    min-height: 100vh;
  }

  .main::before {
    left: 0;
  }
}
