.shell {
  position: relative;

  display: flex;

  height: calc(100vh - 20px);
  min-height: 0;

  margin: 10px;

  overflow: hidden;

  border: 1px solid rgba(255,255,255,.075);
  border-radius: 14px;

  background: var(--shell);

  color: var(--primary);

  box-shadow:
    0 0 0 1px rgba(0,0,0,.45),
    0 28px 90px rgba(0,0,0,.44);
}

.shell::after {
  content: "";

  position: absolute;
  z-index: 40;
  inset: 0;

  pointer-events: none;

  border-radius: inherit;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.025),
    inset 0 0 80px rgba(0,0,0,.12);
}

.main {
  position: relative;
  isolation: isolate;

  flex: 1;

  min-width: 0;
  min-height: 0;

  overflow-x: hidden;
  overflow-y: auto;

  background:
    radial-gradient(
      1000px 560px at 72% -120px,
      rgba(119,126,153,.085),
      transparent 68%
    ),
    radial-gradient(
      720px 500px at 15% 24%,
      rgba(67,79,106,.035),
      transparent 72%
    ),
    var(--workspace);
}

.main::before {
  content: "";

  position: fixed;
  z-index: -1;

  width: 620px;
  height: 420px;

  top: 80px;
  right: 5%;

  pointer-events: none;

  background:
    radial-gradient(
      circle,
      rgba(126,132,159,.045),
      transparent 68%
    );

  filter: blur(24px);
}

@media (max-width: 900px) {
  .shell {
    height: auto;
    min-height: 100vh;

    margin: 0;

    display: block;

    border: 0;
    border-radius: 0;
  }

  .main {
    min-height: 100vh;
  }
}
