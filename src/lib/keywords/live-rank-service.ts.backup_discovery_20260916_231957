import type {
  Prisma,
} from "@prisma/client";

import {
  prisma,
} from "@/lib/prisma";

import {
  fetchKeywordDifficulty,
  fetchRelatedKeywords,
  fetchSearchVolume,
} from "@/lib/keywords/dataforseo-provider";

import {
  fetchLiveOrganicSerp,
} from "@/lib/content/serp-intelligence";

const CACHE_SOURCE =
  "DATAFORSEO_LIVE_RANK_V1";

const CACHE_TTL_MS =
  24 * 60 * 60 * 1000;

const DAILY_REFRESH_LIMIT =
  3;

const LIVE_KEYWORD_LIMIT =
  6;

const LIVE_SERP_CONCURRENCY =
  2;

export type LiveRankStatus =
  | "TOP_3"
  | "FIRST_PAGE"
  | "NEAR_FIRST_PAGE"
  | "BUILDING"
  | "LOW_VISIBILITY"
  | "NOT_TOP_100"
  | "CHECK_FAILED";

export type LiveRankPriority =
  | "HIGH"
  | "MEDIUM"
  | "LOW";

export interface LiveRankCompetitor {
  rank: number;
  domain: string;
  url: string;
  title: string;
}

export interface LiveRankKeyword {
  keyword: string;
  rank: number | null;
  rankingUrl: string | null;
  searchVolume: number | null;
  difficulty: number | null;
  status: LiveRankStatus;
  priority: LiveRankPriority;
  competitors: LiveRankCompetitor[];
}

export interface LiveRankReport {
  domain: string;
  market: string;
  marketLabel: string;
  seed: string;
  checkedAt: string;
  device: "desktop";
  depth: 100;
  keywords: LiveRankKeyword[];
}

const MARKETS = {
  US: {
    locationName:
      "United States",
    label:
      "United States",
    languageName:
      "English",
  },

  CA: {
    locationName:
      "Canada",
    label:
      "Canada",
    languageName:
      "English",
  },

  GB: {
    locationName:
      "United Kingdom",
    label:
      "United Kingdom",
    languageName:
      "English",
  },

  AU: {
    locationName:
      "Australia",
    label:
      "Australia",
    languageName:
      "English",
  },
} as const;

export class LiveRankRateLimitError extends Error {
  constructor() {
    super(
      "Live position checks are limited to 3 refreshes per day."
    );

    this.name =
      "LiveRankRateLimitError";
  }
}

export function normalizeSiteDomain(
  input: string
): string {
  const clean =
    input
      .trim()
      .toLowerCase();

  if (!clean) {
    return "";
  }

  try {
    const url =
      new URL(
        clean.includes(
          "://"
        )
          ? clean
          : `https://${clean}`
      );

    return url.hostname
      .replace(
        /^www\./,
        ""
      );
  } catch {
    return clean
      .replace(
        /^https?:\/\//,
        ""
      )
      .replace(
        /^www\./,
        ""
      )
      .replace(
        /\/.*$/,
        ""
      );
  }
}

export function isDomainMatch(
  candidate: string | null | undefined,
  targetDomain: string
): boolean {
  if (!candidate) {
    return false;
  }

  const candidateDomain =
    normalizeSiteDomain(
      candidate
    );

  const target =
    normalizeSiteDomain(
      targetDomain
    );

  return (
    candidateDomain ===
      target ||
    candidateDomain.endsWith(
      `.${target}`
    )
  );
}

export function classifyLiveRank(
  rank: number | null
): LiveRankStatus {
  if (rank === null) {
    return "NOT_TOP_100";
  }

  if (rank <= 3) {
    return "TOP_3";
  }

  if (rank <= 10) {
    return "FIRST_PAGE";
  }

  if (rank <= 20) {
    return "NEAR_FIRST_PAGE";
  }

  if (rank <= 50) {
    return "BUILDING";
  }

  return "LOW_VISIBILITY";
}

export function classifyPriority(
  rank: number | null,
  searchVolume: number | null,
  difficulty: number | null
): LiveRankPriority {
  const volume =
    searchVolume ??
    0;

  const kd =
    difficulty ??
    50;

  if (
    rank !== null &&
    rank >= 4 &&
    rank <= 20 &&
    volume > 0 &&
    kd <= 70
  ) {
    return "HIGH";
  }

  if (
    rank !== null &&
    rank <= 50 &&
    volume > 0
  ) {
    return "MEDIUM";
  }

  if (
    rank === null &&
    volume >= 500 &&
    kd <= 60
  ) {
    return "MEDIUM";
  }

  return "LOW";
}

function cacheKey({
  domain,
  seed,
  market,
}: {
  domain: string;
  seed: string;
  market: string;
}): string {
  return [
    normalizeSiteDomain(
      domain
    ),
    market.toUpperCase(),
    seed
      .trim()
      .toLowerCase(),
  ].join(
    ":"
  );
}

function isFresh(
  fetchedAt: Date
): boolean {
  return (
    Date.now() -
      fetchedAt.getTime() <
    CACHE_TTL_MS
  );
}

async function checkDailyLimit(
  workspaceId: string
): Promise<void> {
  const today =
    new Date();

  today.setUTCHours(
    0,
    0,
    0,
    0
  );

  const counter =
    await prisma.apiUsageCounter.upsert({
      where: {
        workspaceId_counterType_date: {
          workspaceId,
          counterType:
            "LIVE_RANK_CHECK",
          date:
            today,
        },
      },

      create: {
        workspaceId,
        counterType:
          "LIVE_RANK_CHECK",
        date:
          today,
        count:
          1,
      },

      update: {
        count: {
          increment:
            1,
        },
      },
    });

  if (
    counter.count >
    DAILY_REFRESH_LIMIT
  ) {
    throw new LiveRankRateLimitError();
  }
}

async function mapWithConcurrency<
  T,
  R
>(
  items: T[],
  concurrency: number,
  worker: (
    item: T
  ) => Promise<R>
): Promise<R[]> {
  const output =
    new Array<R>(
      items.length
    );

  let nextIndex =
    0;

  async function run() {
    for (;;) {
      const index =
        nextIndex;

      nextIndex +=
        1;

      if (
        index >=
        items.length
      ) {
        return;
      }

      output[index] =
        await worker(
          items[index]
        );
    }
  }

  await Promise.all(
    Array.from(
      {
        length:
          Math.min(
            concurrency,
            items.length
          ),
      },
      () =>
        run()
    )
  );

  return output;
}

export async function getCachedLiveRankReport({
  siteUrl,
  seed,
  market,
}: {
  siteUrl: string;
  seed: string;
  market: string;
}): Promise<LiveRankReport | null> {
  const normalizedMarket =
    market.toUpperCase();

  const key =
    cacheKey({
      domain:
        siteUrl,
      seed,
      market:
        normalizedMarket,
    });

  const cached =
    await prisma.keywordSuggestionCache.findUnique({
      where: {
        normalized_source: {
          normalized:
            key,
          source:
            CACHE_SOURCE,
        },
      },
    });

  if (
    !cached ||
    !isFresh(
      cached.fetchedAt
    )
  ) {
    return null;
  }

  return cached.payload as unknown as LiveRankReport;
}

export async function refreshLiveRankReport({
  workspaceId,
  siteUrl,
  seed,
  market,
}: {
  workspaceId: string;
  siteUrl: string;
  seed: string;
  market: string;
}): Promise<LiveRankReport> {
  await checkDailyLimit(
    workspaceId
  );

  const normalizedMarket =
    market.toUpperCase();

  const marketConfig =
    MARKETS[
      normalizedMarket as keyof typeof MARKETS
    ] ??
    MARKETS.US;

  const domain =
    normalizeSiteDomain(
      siteUrl
    );

  if (!domain) {
    throw new Error(
      "Website domain is missing."
    );
  }

  const cleanSeed =
    seed.trim();

  if (!cleanSeed) {
    throw new Error(
      "Business search topic is missing."
    );
  }

  let related:
    Awaited<
      ReturnType<
        typeof fetchRelatedKeywords
      >
    > =
    [];

  try {
    related =
      await fetchRelatedKeywords(
        cleanSeed,
        marketConfig.locationName,
        marketConfig.languageName,
        1,
        12
      );
  } catch {
    related =
      [];
  }

  const [
    seedVolumeResult,
    seedDifficultyResult,
  ] =
    await Promise.all([
      fetchSearchVolume(
        [
          cleanSeed,
        ],
        marketConfig.locationName,
        marketConfig.languageName
      ).catch(
        () =>
          []
      ),

      fetchKeywordDifficulty(
        [
          cleanSeed,
        ],
        marketConfig.locationName,
        marketConfig.languageName
      ).catch(
        () =>
          []
      ),
    ]);

  const candidates =
    [
      {
        keyword:
          cleanSeed,

        searchVolume:
          seedVolumeResult[0]
            ?.searchVolume ??
          null,

        keywordDifficulty:
          seedDifficultyResult[0]
            ?.keywordDifficulty ??
          null,
      },

      ...related.map(
        (
          item
        ) => ({
          keyword:
            item.keyword,

          searchVolume:
            item.searchVolume,

          keywordDifficulty:
            item.keywordDifficulty,
        })
      ),
    ];

  const deduped =
    new Map<
      string,
      {
        keyword: string;
        searchVolume: number | null;
        keywordDifficulty: number | null;
      }
    >();

  for (
    const candidate of
    candidates
  ) {
    const normalized =
      candidate.keyword
        .trim()
        .toLowerCase();

    if (
      !normalized ||
      deduped.has(
        normalized
      )
    ) {
      continue;
    }

    deduped.set(
      normalized,
      candidate
    );
  }

  const selected =
    Array.from(
      deduped.values()
    )
      .sort(
        (
          a,
          b
        ) =>
          (
            b.searchVolume ??
            0
          ) -
          (
            a.searchVolume ??
            0
          )
      )
      .slice(
        0,
        LIVE_KEYWORD_LIMIT
      );

  const keywords =
    await mapWithConcurrency(
      selected,
      LIVE_SERP_CONCURRENCY,
      async (
        candidate
      ): Promise<LiveRankKeyword> => {
        try {
          const results =
            await fetchLiveOrganicSerp({
              keyword:
                candidate.keyword,

              locationName:
                marketConfig.locationName,

              languageName:
                marketConfig.languageName,

              depth:
                100,
            });

          const ownResult =
            results.find(
              (
                item
              ) =>
                isDomainMatch(
                  item.domain ||
                    item.url,
                  domain
                )
            );

          const rank =
            ownResult?.rank &&
            ownResult.rank <= 100
              ? ownResult.rank
              : null;

          const competitors =
            results
              .filter(
                (
                  item
                ) =>
                  !isDomainMatch(
                    item.domain ||
                      item.url,
                    domain
                  )
              )
              .slice(
                0,
                5
              )
              .map(
                (
                  item
                ) => ({
                  rank:
                    item.rank,

                  domain:
                    normalizeSiteDomain(
                      item.domain ||
                        item.url
                    ),

                  url:
                    item.url,

                  title:
                    item.title,
                })
              );

          return {
            keyword:
              candidate.keyword,

            rank,

            rankingUrl:
              ownResult?.url ??
              null,

            searchVolume:
              candidate.searchVolume,

            difficulty:
              candidate.keywordDifficulty,

            status:
              classifyLiveRank(
                rank
              ),

            priority:
              classifyPriority(
                rank,
                candidate.searchVolume,
                candidate.keywordDifficulty
              ),

            competitors,
          };
        } catch {
          return {
            keyword:
              candidate.keyword,

            rank:
              null,

            rankingUrl:
              null,

            searchVolume:
              candidate.searchVolume,

            difficulty:
              candidate.keywordDifficulty,

            status:
              "CHECK_FAILED",

            priority:
              "LOW",

            competitors:
              [],
          };
        }
      }
    );

  const priorityWeight = {
    HIGH:
      3,
    MEDIUM:
      2,
    LOW:
      1,
  } as const;

  keywords.sort(
    (
      a,
      b
    ) =>
      priorityWeight[
        b.priority
      ] -
        priorityWeight[
          a.priority
        ] ||
      (
        b.searchVolume ??
        0
      ) -
        (
          a.searchVolume ??
          0
        )
  );

  const report:
    LiveRankReport =
    {
      domain,
      market:
        normalizedMarket,
      marketLabel:
        marketConfig.label,
      seed:
        cleanSeed,
      checkedAt:
        new Date().toISOString(),
      device:
        "desktop",
      depth:
        100,
      keywords,
    };

  const key =
    cacheKey({
      domain,
      seed:
        cleanSeed,
      market:
        normalizedMarket,
    });

  await prisma.keywordSuggestionCache.upsert({
    where: {
      normalized_source: {
        normalized:
          key,
        source:
          CACHE_SOURCE,
      },
    },

    create: {
      normalized:
        key,
      source:
        CACHE_SOURCE,
      payload:
        report as unknown as Prisma.InputJsonValue,
    },

    update: {
      payload:
        report as unknown as Prisma.InputJsonValue,
      fetchedAt:
        new Date(),
    },
  });

  return report;
}
