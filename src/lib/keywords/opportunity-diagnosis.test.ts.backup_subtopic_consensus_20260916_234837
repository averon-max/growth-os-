import {
  describe,
  expect,
  it,
  vi,
} from "vitest";

vi.mock(
  "server-only",
  () => ({})
);

import {
  findConsensusTopicGaps,
  scorePageRelevance,
} from "./opportunity-diagnosis";

describe(
  "opportunity diagnosis",
  () => {
    it(
      "prefers a page that clearly matches the search",
      () => {
        const strong =
          scorePageRelevance(
            "credit monitoring",
            {
              title:
                "Credit Monitoring Service",
              h1:
                "Credit Monitoring",
              h2s: [
                "How credit monitoring works",
              ],
              h3s:
                [],
              bodyText:
                "Credit monitoring alerts help you watch important changes.",
            }
          );

        const weak =
          scorePageRelevance(
            "credit monitoring",
            {
              title:
                "About our company",
              h1:
                "About us",
              h2s: [
                "Our story",
              ],
              h3s:
                [],
              bodyText:
                "Learn about our company and team.",
            }
          );

        expect(
          strong
        ).toBeGreaterThan(
          weak
        );

        expect(
          strong
        ).toBeGreaterThanOrEqual(
          0.7
        );
      }
    );

    it(
      "finds subtopics covered by multiple competitors but missing from our page",
      () => {
        const gaps =
          findConsensusTopicGaps(
            {
              title:
                "Credit Monitoring",
              h1:
                "Monitor your credit",
              h2s: [
                "Credit alerts",
              ],
              h3s:
                [],
              bodyText:
                "Monitor changes to your credit.",
            },
            [
              {
                title:
                  "Credit Monitoring Service",
                h1:
                  "Credit Monitoring",
                h2s: [
                  "How credit monitoring works",
                  "What credit monitoring can detect",
                ],
                h3s:
                  [],
                bodyText:
                  "Credit monitoring can detect important report changes.",
              },
              {
                title:
                  "Credit Monitoring Guide",
                h1:
                  "Credit Monitoring",
                h2s: [
                  "How does credit monitoring work",
                  "What can credit monitoring detect",
                ],
                h3s:
                  [],
                bodyText:
                  "Learn what credit monitoring can detect.",
              },
            ]
          );

        expect(
          gaps.length
        ).toBeGreaterThan(
          0
        );

        expect(
          gaps.some(
            (
              gap
            ) =>
              gap.competitorCoverage >=
              2
          )
        ).toBe(
          true
        );
      }
    );

    it(
      "does not invent a consensus from one competitor",
      () => {
        const gaps =
          findConsensusTopicGaps(
            null,
            [
              {
                title:
                  "Credit Monitoring",
                h1:
                  "Credit Monitoring",
                h2s: [
                  "Unique topic",
                ],
                h3s:
                  [],
                bodyText:
                  "Unique topic",
              },
            ]
          );

        expect(
          gaps
        ).toEqual(
          []
        );
      }
    );
  }
);


