import {
  Prisma,
} from "@prisma/client";

import {
  prisma,
} from "@/lib/prisma";

import {
  fetchCloudflareTraffic,
  type SkippedDay,
} from "./client";

import {
  getCloudflareConnectionWithToken,
} from "./connection-service";

interface SyncParams {
  websiteId: string;
  since: string;
  until: string;
}

export interface SyncResult {
  connectionId: string;
  requestedDays: number;
  syncedDays: number;
  detailDays: number;
  skippedDays: SkippedDay[];
  availableFrom: string | null;
  availableTo: string | null;
}

export async function syncCloudflareTraffic({
  websiteId,
  since,
  until,
}: SyncParams): Promise<SyncResult> {
  const connection =
    await getCloudflareConnectionWithToken(
      websiteId
    );

  if (!connection) {
    throw new Error(
      "NO_CONNECTION: Cloudflare is not connected for this website"
    );
  }

  const {
    days: dailyTraffic,
    skippedDays,
  } =
    await fetchCloudflareTraffic({
      zoneId:
        connection.zoneId,

      apiToken:
        connection.apiToken,

      since,
      until,
    });

  for (
    const day of
    dailyTraffic
  ) {
    const sortedCountries =
      [...day.byCountry].sort(
        (a, b) =>
          b.requests -
          a.requests
      );

    const sortedDevices =
      [...day.byDevice].sort(
        (a, b) =>
          b.requests -
          a.requests
      );

    const sortedBotCategories =
      [...day.byBotCategory].sort(
        (a, b) =>
          b.requests -
          a.requests
      );

    const verifiedBotRequests =
      day.detailAvailable
        ? sortedBotCategories
            .filter(
              (bot) =>
                bot.category !== ""
            )
            .reduce(
              (
                sum,
                bot
              ) =>
                sum +
                bot.requests,
              0
            )
        : 0;

    const unclassifiedRequests =
      day.detailAvailable
        ? Math.max(
            0,
            day.detailTotalRequests -
              verifiedBotRequests
          )
        : 0;

    const createData = {
      connectionId:
        connection.id,

      date:
        new Date(
          `${day.date}T00:00:00Z`
        ),

      totalRequests:
        day.totalRequests,

      unclassifiedRequests,

      verifiedBotRequests,

      unverifiedBotRequests:
        null,

      threatsBlocked:
        null,

      bandwidthBytes:
        BigInt(
          Math.round(
            day.bandwidthBytes
          )
        ),

      uniqueVisitors:
        day.uniqueVisitors,

      countryBreakdown:
        day.detailAvailable
          ? (
              sortedCountries as unknown
                as Prisma.InputJsonValue
            )
          : Prisma.JsonNull,

      deviceBreakdown:
        day.detailAvailable
          ? (
              sortedDevices as unknown
                as Prisma.InputJsonValue
            )
          : Prisma.JsonNull,

      botCategoryBreakdown:
        day.detailAvailable
          ? (
              sortedBotCategories as unknown
                as Prisma.InputJsonValue
            )
          : Prisma.JsonNull,
    };

    const updateData:
      Prisma.TrafficSnapshotUpdateInput =
      {
        totalRequests:
          day.totalRequests,

        bandwidthBytes:
          BigInt(
            Math.round(
              day.bandwidthBytes
            )
          ),

        uniqueVisitors:
          day.uniqueVisitors,
      };

    if (
      day.detailAvailable
    ) {
      Object.assign(
        updateData,
        {
          unclassifiedRequests,

          verifiedBotRequests,

          unverifiedBotRequests:
            null,

          threatsBlocked:
            null,

          countryBreakdown:
            sortedCountries as unknown
              as Prisma.InputJsonValue,

          deviceBreakdown:
            sortedDevices as unknown
              as Prisma.InputJsonValue,

          botCategoryBreakdown:
            sortedBotCategories as unknown
              as Prisma.InputJsonValue,
        }
      );
    }

    await prisma
      .trafficSnapshot
      .upsert({
        where: {
          connectionId_date: {
            connectionId:
              connection.id,

            date:
              new Date(
                `${day.date}T00:00:00Z`
              ),
          },
        },

        create:
          createData,

        update:
          updateData,
      });
  }

  const syncedDates =
    dailyTraffic
      .map(
        (day) =>
          day.date
      )
      .sort();

  return {
    connectionId:
      connection.id,

    requestedDays:
      Math.round(
        (
          new Date(
            `${until}T00:00:00Z`
          ).getTime() -
          new Date(
            `${since}T00:00:00Z`
          ).getTime()
        ) /
          86_400_000
      ) + 1,

    syncedDays:
      dailyTraffic.length,

    detailDays:
      dailyTraffic.filter(
        (day) =>
          day.detailAvailable
      ).length,

    skippedDays,

    availableFrom:
      syncedDates[0] ??
      null,

    availableTo:
      syncedDates[
        syncedDates.length - 1
      ] ?? null,
  };
}
