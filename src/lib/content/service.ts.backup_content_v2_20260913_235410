import {
  prisma,
} from "@/lib/prisma";

import type {
  Prisma,
} from "@prisma/client";

import type {
  ContentGenerator,
} from "./generator";

import type {
  CMSProvider,
} from "@/lib/cms/provider";

import {
  ContentGenerationError,
} from "./generator";

import type {
  ContentBriefInput,
  ContentStrategy,
} from "./types";

import {
  buildContentStrategy,
  normalizeOutline,
} from "./seo-strategy";

import {
  auditArticle,
  repairGeneratedArticle,
} from "./content-quality";


export interface CreateBriefInput {
  websiteId: string;
  opportunityId?: string;
  topic: string;
  reason: string;
  recommendation: string;
  businessName: string;
  websiteUrl: string;
}


function strategyInstruction(
  strategy:
    ContentStrategy
): string {
  const secondary =
    strategy.secondary
      .map(
        (item) =>
          item.keyword
      )
      .join(", ");

  const supporting =
    strategy.supporting
      .map(
        (item) =>
          item.keyword
      )
      .join(", ");

  return [
    "SEO/GEO strategy constraints:",
    `Search intent: ${strategy.searchIntent}.`,
    `Primary keyword: ${strategy.primary.keyword}.`,
    secondary
      ? `Secondary keyword cluster: ${secondary}.`
      : "",
    supporting
      ? `Supporting concepts: ${supporting}.`
      : "",
    `Use exactly one H1. The article body must use only H2/H3 below it.`,
    `Use approximately ${strategy.headingBudget.h2Min}-${strategy.headingBudget.h2Max} meaningful H2 sections only when the subject requires them.`,
    `Use at most ${strategy.headingBudget.h3MaxPerH2} H3 subsections beneath any H2.`,
    "Do not create headings merely to repeat keywords.",
    "Answer the core query directly and early.",
    "Avoid keyword stuffing and awkward exact-match repetition.",
    "Keep closely related queries in one article instead of creating duplicate sections with the same intent.",
    "Use concrete evidence or source attribution for claims that require verification.",
    "Structure answers so search engines and AI retrieval systems can extract concise facts without sacrificing readability.",
  ]
    .filter(
      Boolean
    )
    .join("\n");
}


export async function createContentBrief(
  generator:
    ContentGenerator,
  input:
    CreateBriefInput
) {
  const strategy =
    await buildContentStrategy({
      websiteId:
        input.websiteId,

      topic:
        input.topic,

      businessName:
        input.businessName,
    });

  const relatedKeywords:
    ContentBriefInput["relatedKeywords"] =
      [
        strategy.primary,
        ...strategy.secondary,
        ...strategy.supporting,
      ]
        .slice(
          0,
          15
        )
        .map(
          (keyword) => ({
            keyword:
              keyword.keyword,

            searchVolume:
              keyword.searchVolume,

            cpc:
              keyword.cpc,

            keywordDifficulty:
              keyword.difficulty,
          })
        );

  const briefInput:
    ContentBriefInput = {
      topic:
        input.topic,

      reason:
        input.reason,

      recommendation:
        [
          input.recommendation,
          strategyInstruction(
            strategy
          ),
        ].join(
          "\n\n"
        ),

      businessName:
        input.businessName,

      websiteUrl:
        input.websiteUrl,

      relatedKeywords,

      strategy,
  };

  const generated =
    await generator.generateBrief(
      briefInput
    );

  const outline =
    normalizeOutline(
      generated.outline,
      strategy
    );

  return prisma.contentBrief.create({
    data: {
      websiteId:
        input.websiteId,

      opportunityId:
        input.opportunityId,

      topic:
        input.topic,

      searchIntent:
        strategy.searchIntent,

      primaryKeyword:
        strategy.primary
          .keyword,

      secondaryKeywords:
        strategy.secondary.map(
          (item) =>
            item.keyword
        ),

      outline:
        outline as unknown as
          Prisma.InputJsonValue,

      status:
        "READY",

      generatedBy:
        generator.modelName,
    },
  });
}


export async function generateArticleFromBrief(
  generator:
    ContentGenerator,
  briefId:
    string
) {
  const brief =
    await prisma.contentBrief.findUnique({
      where: {
        id:
          briefId,
      },

      include: {
        website: {
          include: {
            business:
              true,
          },
        },
      },
    });

  if (!brief) {
    throw new Error(
      "Content brief not found"
    );
  }

  const pendingArticle =
    await prisma.contentArticle.create({
      data: {
        briefId:
          brief.id,

        title:
          "",

        metaDescription:
          "",

        h1:
          "",

        bodyMarkdown:
          "",

        status:
          "GENERATING",

        generatedBy:
          generator.modelName,
      },
    });

  try {
    const outline =
      brief.outline as Array<{
        heading: string;
        level: 2 | 3;
        summary: string;
      }>;

    const generated =
      await generator.generateArticle({
        topic:
          brief.topic,

        reason:
          "Produce the strongest single page for this search intent without creating cannibalizing duplicate content.",

        recommendation: [
          `Primary keyword: ${brief.primaryKeyword}.`,
          `Search intent: ${brief.searchIntent}.`,
          "Use the supplied outline as the semantic structure.",
          "Exactly one H1 is stored separately from bodyMarkdown.",
          "bodyMarkdown must not contain a Markdown H1.",
          "Use H2 for major intent sections and H3 only as children of an H2.",
          "Give a direct answer near the beginning.",
          "Use primary and secondary keywords naturally, not mechanically.",
          "Prefer clear factual statements, definitions, steps, comparisons, and evidence where appropriate.",
          "Do not invent statistics, studies, citations, product claims, or security claims.",
        ].join(
          "\n"
        ),

        businessName:
          brief.website
            .business
            .name,

        websiteUrl:
          brief.website.url,

        searchIntent:
          brief.searchIntent,

        primaryKeyword:
          brief.primaryKeyword,

        secondaryKeywords:
          brief.secondaryKeywords,

        outline,
      });

    const repaired =
      repairGeneratedArticle(
        generated
      );

    const audit =
      auditArticle({
        article:
          repaired,

        primaryKeyword:
          brief.primaryKeyword,
      });

    console.info(
      "[content quality]",
      {
        briefId:
          brief.id,

        score:
          audit.score,

        wordCount:
          audit.wordCount,

        h2:
          audit.h2Count,

        h3:
          audit.h3Count,

        keywordDensityPct:
          audit.keywordDensityPct,

        issues:
          audit.issues,
      }
    );

    return prisma.contentArticle.update({
      where: {
        id:
          pendingArticle.id,
      },

      data: {
        title:
          repaired.title,

        metaDescription:
          repaired.metaDescription,

        h1:
          repaired.h1,

        bodyMarkdown:
          repaired.bodyMarkdown,

        status:
          "DRAFT",
      },
    });
  } catch (error) {
    const message =
      error instanceof
      ContentGenerationError
        ? error.message
        : "Article generation failed";

    return prisma.contentArticle.update({
      where: {
        id:
          pendingArticle.id,
      },

      data: {
        status:
          "REJECTED",

        publishError:
          message,
      },
    });
  }
}


export async function approveArticle(
  articleId:
    string
) {
  return prisma.contentArticle.update({
    where: {
      id:
        articleId,
    },

    data: {
      status:
        "APPROVED",
    },
  });
}


export async function publishArticle(
  provider:
    CMSProvider,
  articleId:
    string
) {
  const article =
    await prisma.contentArticle.findUnique({
      where: {
        id:
          articleId,
      },

      include: {
        brief:
          true,
      },
    });

  if (!article) {
    throw new Error(
      "Article not found"
    );
  }

  if (
    article.status !==
    "APPROVED"
  ) {
    throw new Error(
      "Only approved articles can be published"
    );
  }

  const result =
    await provider.publishContent(
      article.brief
        .websiteId,
      {
        title:
          article.title,

        metaDescription:
          article.metaDescription,

        h1:
          article.h1,

        bodyMarkdown:
          article.bodyMarkdown,
      }
    );

  return prisma.contentArticle.update({
    where: {
      id:
        articleId,
    },

    data: {
      status:
        result.status ===
        "SUCCESS"
          ? "PUBLISHED"
          : "PUBLISH_FAILED",

      publishedUrl:
        result.publishedUrl,

      publishedAt:
        result.status ===
        "SUCCESS"
          ? new Date()
          : null,

      publishError:
        result.errorMessage,
    },
  });
}
