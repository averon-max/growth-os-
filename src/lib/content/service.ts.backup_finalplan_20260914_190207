export interface CreateBriefInput {
  websiteId: string;
  opportunityId?: string;
  topic: string;
  reason: string;
  recommendation: string;
  businessName: string;
  websiteUrl: string;
}


function strategyPrompt(
  strategy:
    ContentStrategy
): string {
  const secondary =
    strategy.secondary
      .map(
        (item) =>
          item.keyword
      )
      .join(", ");

  const supporting =
    strategy.supporting
      .map(
        (item) =>
          item.keyword
      )
      .join(", ");

  return [
    "CONTENT STRATEGY:",
    `Intent: ${strategy.searchIntent}`,
    `Primary keyword: ${strategy.primary.keyword}`,
    secondary
      ? `Secondary keywords: ${secondary}`
      : "",
    supporting
      ? `Supporting concepts: ${supporting}`
      : "",
    `Page decision: ${strategy.action.type}`,
    `Use exactly one H1.`,
    `Use ${strategy.headingBudget.h2Min}-${strategy.headingBudget.h2Max} meaningful H2 sections only if required by the intent.`,
    `Use at most ${strategy.headingBudget.h3MaxPerH2} H3 subsections under each H2.`,
    "Do not create headings solely to repeat keywords.",
    "Answer the main query directly near the beginning.",
    "Avoid keyword stuffing.",
    "Keep synonymous queries with the same intent on one page.",
    "Do not invent facts, statistics, sources, security claims, or studies.",
    "Prefer concise definitions, direct answers, lists, steps, comparisons, and extractable factual statements where appropriate.",
  ]
    .filter(Boolean)
    .join("\n");
}


export async function createContentBrief(
  generator:
    ContentGenerator,
  input:
    CreateBriefInput
) {
  const [
    strategy,
    context,
  ] =
    await Promise.all([
      buildContentStrategy({
        websiteId:
          input.websiteId,

        topic:
          input.topic,

        businessName:
          input.businessName,
      }),

      getWebsiteKeywordContext(
        input.websiteId
      ).catch(
        () => null
      ),
    ]);

  const relatedKeywords:
    ContentBriefInput["relatedKeywords"] =
      [
        strategy.primary,
        ...strategy.secondary,
        ...strategy.supporting,
      ]
        .slice(0, 15)
        .map(
          (keyword) => ({
            keyword:
              keyword.keyword,

            searchVolume:
              keyword.searchVolume,

            cpc:
              keyword.cpc,

            keywordDifficulty:
              keyword.difficulty,
          })
        );

  const briefInput:
    ContentBriefInput = {
      topic:
        input.topic,

      reason:
        input.reason,

      recommendation:
        [
          input.recommendation,
          strategyPrompt(
            strategy
          ),
        ].join(
          "\n\n"
        ),

      businessName:
        input.businessName,

      websiteUrl:
        input.websiteUrl,

      topKeywords:
        context?.topKeywords,

      relatedKeywords,

      strategy,
    };

  const generated =
    await generator.generateBrief(
      briefInput
    );

  const outline =
    normalizeOutline(
      generated.outline,
      strategy
    );

  return prisma.contentBrief.create({
    data: {
      websiteId:
        input.websiteId,

      opportunityId:
        input.opportunityId,

      topic:
        input.topic,

      searchIntent:
        strategy.searchIntent,

      primaryKeyword:
        strategy.primary
          .keyword,

      secondaryKeywords:
        strategy.secondary.map(
          (item) =>
            item.keyword
        ),

      outline:
        outline as unknown as
          Prisma.InputJsonValue,

      status:
        "READY",

      generatedBy:
        generator.modelName,
    },
  });
}


export async function generateArticleFromBrief(
  generator:
    ContentGenerator,
  briefId:
    string
) {
  const brief =
    await prisma.contentBrief.findUnique({
      where: {
        id:
          briefId,
      },

      include: {
        website: {
          include: {
            business:
              true,
          },
        },
      },
    });

  if (!brief) {
    throw new Error(
      "Content brief not found"
    );
  }

  const pendingArticle =
    await prisma.contentArticle.create({
      data: {
        briefId:
          brief.id,

        title:
          "",

        metaDescription:
          "",

        h1:
          "",

        bodyMarkdown:
          "",

        status:
          "GENERATING",

        generatedBy:
          generator.modelName,
      },
    });

  try {
    const generated =
      await generator.generateArticle({
        topic:
          brief.topic,

        reason:
          "Create the strongest single page for this exact search intent without cannibalizing closely related content.",

        recommendation: [
          `Primary keyword: ${brief.primaryKeyword}.`,
          `Search intent: ${brief.searchIntent}.`,
          "Exactly one H1 exists outside bodyMarkdown.",
          "Do not place an H1 inside bodyMarkdown.",
          "Use H2 for major intent sections.",
          "Use H3 only underneath a relevant H2.",
          "Answer the core question early.",
          "Use keywords naturally.",
          "Do not invent statistics, citations, claims, or sources.",
          "Write for humans first while making facts and answers easy for search engines and retrieval systems to extract.",
        ].join(
          "\n"
        ),

        businessName:
          brief.website
            .business
            .name,

        websiteUrl:
          brief.website.url,

        searchIntent:
          brief.searchIntent,

        primaryKeyword:
          brief.primaryKeyword,

        secondaryKeywords:
          brief.secondaryKeywords,

        outline:
          brief.outline as {
            heading: string;
            level: 2 | 3;
            summary: string;
          }[],
      });

    const repaired =
      repairGeneratedArticle(
        generated
      );

    const audit =
      auditArticle({
        article:
          repaired,

        primaryKeyword:
          brief.primaryKeyword,
      });

    console.info(
      "[content quality]",
      {
        briefId:
          brief.id,

        score:
          audit.score,

        words:
          audit.wordCount,

        h2:
          audit.h2Count,

        h3:
          audit.h3Count,

        primaryKeywordDensityPct:
          audit.primaryKeywordDensityPct,

        issues:
          audit.issues,
      }
    );

    return prisma.contentArticle.update({
      where: {
        id:
          pendingArticle.id,
      },

      data: {
        title:
          repaired.title,

        metaDescription:
          repaired.metaDescription,

        h1:
          repaired.h1,

        bodyMarkdown:
          repaired.bodyMarkdown,

        status:
          "DRAFT",
      },
    });
  } catch (error) {
    const message =
      error instanceof
      ContentGenerationError
        ? error.message
        : "Article generation failed";

    return prisma.contentArticle.update({
      where: {
        id:
          pendingArticle.id,
      },

      data: {
        status:
          "REJECTED",

        publishError:
          message,
      },
    });
  }
}


export async function approveArticle(
  articleId:
    string
) {
  return prisma.contentArticle.update({
    where: {
      id:
        articleId,
    },

    data: {
      status:
        "APPROVED",
    },
  });
}


export async function publishArticle(
  provider:
    CMSProvider,
  articleId:
    string
) {
  const article =
    await prisma.contentArticle.findUnique({
      where: {
        id:
          articleId,
      },

      include: {
        brief:
          true,
      },
    });

  if (!article) {
    throw new Error(
      "Article not found"
    );
  }

  if (
    article.status !==
    "APPROVED"
  ) {
    throw new Error(
      "Only approved articles can be published"
    );
  }

  const result =
    await provider.publishContent(
      article.brief
        .websiteId,
      {
        title:
          article.title,

        metaDescription:
          article.metaDescription,

        h1:
          article.h1,

        bodyMarkdown:
          article.bodyMarkdown,
      }
    );

  return prisma.contentArticle.update({
    where: {
      id:
        articleId,
    },

    data: {
      status:
        result.status ===
        "SUCCESS"
          ? "PUBLISHED"
          : "PUBLISH_FAILED",

      publishedUrl:
        result.publishedUrl,

      publishedAt:
        result.status ===
        "SUCCESS"
          ? new Date()
          : null,

      publishError:
        result.errorMessage,
    },
  });
}
