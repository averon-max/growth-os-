import {
  readFileSync,
} from "node:fs";

import {
  describe,
  expect,
  it,
} from "vitest";


function serviceSource():
string {
  return readFileSync(
    new URL(
      "./service.ts",
      import.meta.url
    ),
    "utf8"
  );
}


function generationFunctionSource():
string {
  const source =
    serviceSource();

  const start =
    source.indexOf(
      "export async function generateArticleFromBrief("
    );

  const end =
    source.indexOf(
      "export async function approveArticle(",
      start
    );


  if (
    start <
      0 ||
    end <
      0
  ) {
    throw new Error(
      "Could not isolate generateArticleFromBrief production source."
    );
  }


  return source.slice(
    start,
    end
  );
}


describe(
  "Production Master Article Critic Boundary",
  () => {
    it(
      "runs the critic system exactly once after Master Writer",
      () => {
        const source =
          generationFunctionSource();


        expect(
          source.match(
            /await executeMasterWriterV1\(\{/g
          ) ??
          []
        ).toHaveLength(
          1
        );


        expect(
          source.match(
            /await executeMasterArticleCriticsV1\(\{/g
          ) ??
          []
        ).toHaveLength(
          1
        );


        expect(
          source.match(
            /assertMasterArticleCriticExecutionPassed\(/g
          ) ??
          []
        ).toHaveLength(
          1
        );
      }
    );


    it(
      "builds critic context from validated persisted MasterRuntime",
      () => {
        const source =
          generationFunctionSource();


        expect(
          source
        ).toMatch(
          /buildMasterArticleSemanticCriticContextV1\([\s\S]*?masterRuntimeInspection[\s\S]*?\.runtime[\s\S]*?\)/
        );


        expect(
          source
        ).toMatch(
          /executeMasterArticleCriticsV1\(\{[\s\S]*contract:\s*articleGenerationContract[\s\S]*run:\s*masterWriterRun[\s\S]*generator,[\s\S]*context:\s*masterCriticContext/
        );
      }
    );


    it(
      "orders writer, context, critic fusion and assertion before DRAFT",
      () => {
        const source =
          generationFunctionSource();


        const writer =
          source.indexOf(
            "await executeMasterWriterV1({"
          );

        const context =
          source.indexOf(
            "buildMasterArticleSemanticCriticContextV1("
          );

        const critics =
          source.indexOf(
            "await executeMasterArticleCriticsV1({"
          );

        const assertion =
          source.indexOf(
            "assertMasterArticleCriticExecutionPassed("
          );

        const draft =
          source.indexOf(
            '"DRAFT"'
          );


        expect(
          writer
        ).toBeGreaterThanOrEqual(
          0
        );

        expect(
          context
        ).toBeGreaterThan(
          writer
        );

        expect(
          critics
        ).toBeGreaterThan(
          context
        );

        expect(
          assertion
        ).toBeGreaterThan(
          critics
        );

        expect(
          draft
        ).toBeGreaterThan(
          assertion
        );
      }
    );


    it(
      "does not synthesize critic comparison context inside service",
      () => {
        const source =
          generationFunctionSource();


        expect(
          source
        ).not.toMatch(
          /originalityReferences\s*:\s*\[/
        );

        expect(
          source
        ).not.toMatch(
          /cannibalizationCandidates\s*:\s*\[/
        );

        expect(
          source
        ).not.toMatch(
          /evaluateUrlOwnership\(/
        );
      }
    );


    it(
      "keeps a blocked critic execution inside the existing rejection transaction",
      () => {
        const source =
          generationFunctionSource();

        const tryIndex =
          source.indexOf(
            "try {"
          );

        const criticAssert =
          source.indexOf(
            "assertMasterArticleCriticExecutionPassed("
          );

        const catchIndex =
          source.lastIndexOf(
            "} catch (error) {"
          );

        const rejectedIndex =
          source.lastIndexOf(
            '"REJECTED"'
          );


        expect(
          tryIndex
        ).toBeGreaterThanOrEqual(
          0
        );

        expect(
          criticAssert
        ).toBeGreaterThan(
          tryIndex
        );

        expect(
          catchIndex
        ).toBeGreaterThan(
          criticAssert
        );

        expect(
          rejectedIndex
        ).toBeGreaterThan(
          catchIndex
        );
      }
    );


    it(
      "does not allow editorial findings to bypass the whole-article rewrite lock",
      () => {
        const source =
          generationFunctionSource();


        expect(
          source
        ).toMatch(
          /allowLegacyWholeArticleRewrite\s*&&\s*\([\s\S]*shouldRewriteArticle\s*\([\s\S]*\|\|[\s\S]*shouldRewriteEditorialFindings/
        );


        expect(
          source
        ).not.toMatch(
          /allowLegacyWholeArticleRewrite\s*&&\s*shouldRewriteArticle\s*\(/
        );
      }
    );


    it(
      "does not re-enable the legacy one-shot writer or whole-article rewrite",
      () => {
        const source =
          generationFunctionSource();


        expect(
          source
        ).not.toMatch(
          /generator\.generateArticle\s*\(/
        );


        expect(
          source
        ).toMatch(
          /allowLegacyWholeArticleRewrite\s*=\s*false/
        );
      }
    );
  }
);
