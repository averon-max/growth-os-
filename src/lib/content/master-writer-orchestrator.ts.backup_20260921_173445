import type {
  ArticleGenerationContractV1,
} from "./article-generation-contract";

import type {
  GeneratedSectionV1,
  MasterArticleGenerator,
} from "./master-article-generator";

import {
  supportsMasterArticleGenerator,
} from "./master-article-generator";

import type {
  GeneratedArticleShellV1,
  MasterArticleShellGenerator,
} from "./master-article-shell-generator";

import {
  supportsMasterArticleShellGenerator,
} from "./master-article-shell-generator";

import type {
  ComposedMasterArticleV1,
} from "./master-article-composer";

import {
  composeMasterArticleV1,
} from "./master-article-composer";

import type {
  SectionClaimReconciliationV1,
} from "./section-claim-reconciliation";

import {
  assertSectionClaimReconciliationPassed,
  reconcileGeneratedSectionClaimsV1,
} from "./section-claim-reconciliation";

import type {
  MasterSectionSemanticVerifier,
  SectionSemanticVerificationV1,
} from "./master-section-semantic-verifier";

import {
  assertSectionSemanticVerificationPassed,
  supportsMasterSectionSemanticVerifier,
} from "./master-section-semantic-verifier";

import {
  ContentGenerationError,
} from "./generator";


export interface MasterWriterGenerator
  extends
    MasterArticleGenerator,
    MasterArticleShellGenerator,
    MasterSectionSemanticVerifier {}


export interface MasterWriterRunProvenanceV1 {
  sourceContractVersion:
    "ARTICLE_GENERATION_CONTRACT_V1";

  sourceRuntimeVersion:
    "MASTER_RUNTIME_SNAPSHOT_V1";

  generatorModelName:
    string;

  shellModelName:
    string;

  sectionModelNames:
    readonly string[];

  sectionCount:
    number;

  reconciliationCount:
    number;

  reconciliationWarnCount:
    number;

  reconciliationBlockCount:
    0;

  semanticVerificationCount:
    number;

  semanticWarnCount:
    number;

  semanticBlockCount:
    0;

  executionMode:
    "SEQUENTIAL";
}


export interface MasterWriterRunV1 {
  version:
    "MASTER_WRITER_RUN_V1";

  shell:
    Readonly<GeneratedArticleShellV1>;

  sections:
    readonly Readonly<GeneratedSectionV1>[];

  reconciliations:
    readonly Readonly<
      SectionClaimReconciliationV1
    >[];

  semanticVerifications:
    readonly Readonly<
      SectionSemanticVerificationV1
    >[];

  article:
    Readonly<ComposedMasterArticleV1>;

  provenance:
    Readonly<MasterWriterRunProvenanceV1>;
}


function failureMessage(
  error:
    unknown
): string {
  if (
    error instanceof
    Error
  ) {
    return error.message;
  }

  return String(
    error
  );
}


function assertContractExecutionOrder(
  contract:
    Readonly<ArticleGenerationContractV1>
): void {
  const sections =
    contract.sectionContracts;

  if (
    sections.length ===
    0
  ) {
    throw new ContentGenerationError(
      "MASTER_WRITER_BLOCKED:NO_SECTION_CONTRACTS"
    );
  }

  sections.forEach(
    (
      section,
      index
    ) => {
      if (
        section.version !==
        "SECTION_GENERATION_CONTRACT_V1"
      ) {
        throw new ContentGenerationError(
          `MASTER_WRITER_BLOCKED:INVALID_SECTION_CONTRACT_VERSION:${index}`
        );
      }

      if (
        section.sectionIndex !==
        index
      ) {
        throw new ContentGenerationError(
          `MASTER_WRITER_BLOCKED:SECTION_INDEX_MISMATCH:${index}`
        );
      }

      if (
        section.sectionNumber !==
        index + 1
      ) {
        throw new ContentGenerationError(
          `MASTER_WRITER_BLOCKED:SECTION_NUMBER_MISMATCH:${index}`
        );
      }

      if (
        section.totalSections !==
        sections.length
      ) {
        throw new ContentGenerationError(
          `MASTER_WRITER_BLOCKED:TOTAL_SECTION_COUNT_MISMATCH:${index}`
        );
      }
    }
  );
}


function assertShellProvenance({
  shell,
  contract,
  generator,
}: {
  shell:
    Readonly<GeneratedArticleShellV1>;

  contract:
    Readonly<ArticleGenerationContractV1>;

  generator:
    Readonly<MasterWriterGenerator>;
}): void {
  if (
    shell.version !==
    "ARTICLE_SHELL_V1"
  ) {
    throw new ContentGenerationError(
      "MASTER_WRITER_SHELL_INVALID_VERSION"
    );
  }

  if (
    shell.provenance
      .sourceContractVersion !==
    "ARTICLE_GENERATION_CONTRACT_V1"
  ) {
    throw new ContentGenerationError(
      "MASTER_WRITER_SHELL_INVALID_CONTRACT_PROVENANCE"
    );
  }

  if (
    shell.provenance
      .sourceRuntimeVersion !==
    contract.sourceRuntimeVersion
  ) {
    throw new ContentGenerationError(
      "MASTER_WRITER_SHELL_RUNTIME_PROVENANCE_MISMATCH"
    );
  }

  if (
    shell.provenance
      .modelName !==
    generator.modelName
  ) {
    throw new ContentGenerationError(
      "MASTER_WRITER_SHELL_MODEL_PROVENANCE_MISMATCH"
    );
  }

  if (
    shell.provenance
      .h1Mission !==
    contract.h1Mission
  ) {
    throw new ContentGenerationError(
      "MASTER_WRITER_SHELL_H1_MISSION_MISMATCH"
    );
  }
}


function assertSectionProvenance({
  section,
  index,
  contract,
  generator,
}: {
  section:
    Readonly<GeneratedSectionV1>;

  index:
    number;

  contract:
    Readonly<ArticleGenerationContractV1>;

  generator:
    Readonly<MasterWriterGenerator>;
}): void {
  if (
    section.version !==
    "GENERATED_SECTION_V1"
  ) {
    throw new ContentGenerationError(
      `MASTER_WRITER_SECTION_INVALID_VERSION:${index}`
    );
  }

  if (
    section.provenance
      .sourceContractVersion !==
    "SECTION_GENERATION_CONTRACT_V1"
  ) {
    throw new ContentGenerationError(
      `MASTER_WRITER_SECTION_INVALID_CONTRACT_PROVENANCE:${index}`
    );
  }

  if (
    section.provenance
      .sectionIndex !==
    index
  ) {
    throw new ContentGenerationError(
      `MASTER_WRITER_SECTION_PROVENANCE_MISMATCH:${index}`
    );
  }

  if (
    section.provenance
      .sectionNumber !==
    index + 1
  ) {
    throw new ContentGenerationError(
      `MASTER_WRITER_SECTION_NUMBER_PROVENANCE_MISMATCH:${index}`
    );
  }

  if (
    section.provenance
      .totalSections !==
    contract.sectionContracts
      .length
  ) {
    throw new ContentGenerationError(
      `MASTER_WRITER_SECTION_TOTAL_PROVENANCE_MISMATCH:${index}`
    );
  }

  if (
    section.provenance
      .modelName !==
    generator.modelName
  ) {
    throw new ContentGenerationError(
      `MASTER_WRITER_SECTION_MODEL_PROVENANCE_MISMATCH:${index}`
    );
  }
}


export function supportsMasterWriterGenerator(
  value:
    unknown
): value is MasterWriterGenerator {
  return (
    supportsMasterArticleGenerator(
      value
    ) &&
    supportsMasterArticleShellGenerator(
      value
    ) &&
    supportsMasterSectionSemanticVerifier(
      value
    )
  );
}


export async function executeMasterWriterV1({
  contract,
  generator,
}: {
  contract:
    Readonly<ArticleGenerationContractV1>;

  generator:
    unknown;
}): Promise<
  Readonly<MasterWriterRunV1>
> {
  if (
    contract.version !==
    "ARTICLE_GENERATION_CONTRACT_V1"
  ) {
    throw new ContentGenerationError(
      "MASTER_WRITER_BLOCKED:INVALID_ARTICLE_GENERATION_CONTRACT"
    );
  }

  if (
    !supportsMasterWriterGenerator(
      generator
    )
  ) {
    throw new ContentGenerationError(
      "MASTER_WRITER_BLOCKED:FULL_MASTER_GENERATOR_UNAVAILABLE"
    );
  }

  assertContractExecutionOrder(
    contract
  );


  // ========================================================
  // ARTICLE SHELL
  // ========================================================

  let shell:
    Readonly<GeneratedArticleShellV1>;

  try {
    shell =
      await generator
        .generateArticleShell(
          contract
        );
  } catch (
    error
  ) {
    throw new ContentGenerationError(
      [
        "MASTER_WRITER_SHELL_GENERATION_FAILED",
        failureMessage(
          error
        ),
      ].join(
        ":"
      )
    );
  }

  assertShellProvenance({
    shell,
    contract,
    generator,
  });


  // ========================================================
  // SECTIONS
  //
  // Deliberately sequential.
  //
  // A generated section is NOT accepted merely because the
  // provider returned structurally valid JSON.
  //
  // It must pass:
  //
  // generation validation
  // → provenance validation
  // → deterministic claim/evidence reconciliation
  //
  // before it can enter deterministic composition.
  // ========================================================

  const generatedSections:
    Readonly<GeneratedSectionV1>[] =
      [];

  const reconciliations:
    Readonly<
      SectionClaimReconciliationV1
    >[] =
      [];

  const semanticVerifications:
    Readonly<
      SectionSemanticVerificationV1
    >[] =
      [];


  for (
    let index = 0;
    index <
    contract.sectionContracts.length;
    index +=
      1
  ) {
    const sectionContract =
      contract.sectionContracts[
        index
      ];

    if (
      !sectionContract
    ) {
      throw new ContentGenerationError(
        `MASTER_WRITER_BLOCKED:SECTION_CONTRACT_MISSING:${index}`
      );
    }


    // ------------------------------------------------------
    // 1. GENERATE EXACTLY ONE SECTION
    // ------------------------------------------------------

    let generated:
      Readonly<GeneratedSectionV1>;

    try {
      generated =
        await generator
          .generateSection(
            sectionContract
          );

      assertSectionProvenance({
        section:
          generated,

        index,

        contract,

        generator,
      });
    } catch (
      error
    ) {
      throw new ContentGenerationError(
        [
          "MASTER_WRITER_SECTION_GENERATION_FAILED",
          String(
            index
          ),
          failureMessage(
            error
          ),
        ].join(
          ":"
        )
      );
    }


    // ------------------------------------------------------
    // 2. DETERMINISTIC CLAIM/EVIDENCE RECONCILIATION
    //
    // This is intentionally outside the generation error
    // boundary so provenance failures and factual-evidence
    // failures are distinguishable operationally.
    // ------------------------------------------------------

    let reconciliation:
      Readonly<
        SectionClaimReconciliationV1
      >;

    try {
      reconciliation =
        reconcileGeneratedSectionClaimsV1({
          contract:
            sectionContract,

          section:
            generated,
        });

      assertSectionClaimReconciliationPassed(
        reconciliation
      );
    } catch (
      error
    ) {
      throw new ContentGenerationError(
        [
          "MASTER_WRITER_SECTION_RECONCILIATION_FAILED",
          String(
            index
          ),
          failureMessage(
            error
          ),
        ].join(
          ":"
        )
      );
    }


    // ------------------------------------------------------
    // 3. SEMANTIC PROSE CLAIM VERIFICATION
    //
    // Deterministic reconciliation proves that the IDs declared
    // by the writer are internally valid.
    //
    // This independent pass verifies the ACTUAL prose units
    // against the authoritative Claim Ledger / Evidence Graph.
    //
    // Every deterministic prose unit must receive a decision.
    //
    // UNSUPPORTED / CONTRADICTED = fail closed.
    // NARROWER = allowed but preserved as WARN.
    // ------------------------------------------------------

    let semanticVerification:
      Readonly<
        SectionSemanticVerificationV1
      >;

    try {
      semanticVerification =
        await generator
          .verifySectionClaims({
            contract:
              sectionContract,

            section:
              generated,
          });

      if (
        semanticVerification
          .sectionIndex !==
        index
      ) {
        throw new ContentGenerationError(
          `SECTION_SEMANTIC_PROVENANCE_INDEX_MISMATCH:${index}`
        );
      }

      if (
        semanticVerification
          .sectionNumber !==
        index + 1
      ) {
        throw new ContentGenerationError(
          `SECTION_SEMANTIC_PROVENANCE_NUMBER_MISMATCH:${index}`
        );
      }

      if (
        semanticVerification
          .provenance
          .sourceContractVersion !==
        "SECTION_GENERATION_CONTRACT_V1"
      ) {
        throw new ContentGenerationError(
          `SECTION_SEMANTIC_CONTRACT_PROVENANCE_MISMATCH:${index}`
        );
      }

      if (
        semanticVerification
          .provenance
          .generatedSectionVersion !==
        "GENERATED_SECTION_V1"
      ) {
        throw new ContentGenerationError(
          `SECTION_SEMANTIC_SECTION_PROVENANCE_MISMATCH:${index}`
        );
      }

      if (
        semanticVerification
          .provenance
          .modelName !==
        generator.modelName
      ) {
        throw new ContentGenerationError(
          `SECTION_SEMANTIC_MODEL_PROVENANCE_MISMATCH:${index}`
        );
      }

      assertSectionSemanticVerificationPassed(
        semanticVerification
      );
    } catch (
      error
    ) {
      throw new ContentGenerationError(
        [
          "MASTER_WRITER_SECTION_SEMANTIC_VERIFICATION_FAILED",
          String(
            index
          ),
          failureMessage(
            error
          ),
        ].join(
          ":"
        )
      );
    }


    // ------------------------------------------------------
    // 4. ACCEPT SECTION ONLY AFTER:
    //
    // structural validation
    // + deterministic claim/evidence reconciliation
    // + semantic prose verification
    // ------------------------------------------------------

    generatedSections.push(
      generated
    );

    reconciliations.push(
      reconciliation
    );

    semanticVerifications.push(
      semanticVerification
    );
  }


  // ========================================================
  // FREEZE ACCEPTED SECTIONS / RECONCILIATIONS
  // ========================================================

  const frozenSections =
    Object.freeze([
      ...generatedSections,
    ]);

  const frozenReconciliations =
    Object.freeze([
      ...reconciliations,
    ]);

  const frozenSemanticVerifications =
    Object.freeze([
      ...semanticVerifications,
    ]);


  if (
    frozenSections.length !==
    frozenReconciliations.length
  ) {
    throw new ContentGenerationError(
      "MASTER_WRITER_RECONCILIATION_COUNT_MISMATCH"
    );
  }

  if (
    frozenSections.length !==
    frozenSemanticVerifications.length
  ) {
    throw new ContentGenerationError(
      "MASTER_WRITER_SEMANTIC_VERIFICATION_COUNT_MISMATCH"
    );
  }


  // ========================================================
  // COMPOSITION
  //
  // Composition can only see sections that survived the
  // deterministic reconciliation boundary.
  // ========================================================

  const article =
    composeMasterArticleV1({
      contract,

      shell,

      sections:
        frozenSections,
    });


  const sectionModelNames =
    Object.freeze(
      Array.from(
        new Set(
          frozenSections.map(
            (
              section
            ) =>
              section.provenance
                .modelName
          )
        )
      )
    );


  const reconciliationWarnCount =
    frozenReconciliations
      .filter(
        (result) =>
          result.status ===
          "WARN"
      )
      .length;

  const semanticWarnCount =
    frozenSemanticVerifications
      .filter(
        (result) =>
          result.status ===
          "WARN"
      )
      .length;


  return Object.freeze({
    version:
      "MASTER_WRITER_RUN_V1" as const,

    shell,

    sections:
      frozenSections,

    reconciliations:
      frozenReconciliations,

    semanticVerifications:
      frozenSemanticVerifications,

    article,

    provenance:
      Object.freeze({
        sourceContractVersion:
          "ARTICLE_GENERATION_CONTRACT_V1" as const,

        sourceRuntimeVersion:
          contract.sourceRuntimeVersion,

        generatorModelName:
          generator.modelName,

        shellModelName:
          shell.provenance
            .modelName,

        sectionModelNames,

        sectionCount:
          frozenSections.length,

        reconciliationCount:
          frozenReconciliations.length,

        reconciliationWarnCount,

        reconciliationBlockCount:
          0 as const,

        semanticVerificationCount:
          frozenSemanticVerifications
            .length,

        semanticWarnCount,

        semanticBlockCount:
          0 as const,

        executionMode:
          "SEQUENTIAL" as const,
      }),
  });
}
