import {
  describe,
  expect,
  it,
} from "vitest";

import {
  inferTargetFormat,
  isBenchmarkEligible,
} from "./final-content-plan";

import type {
  CompetitorPageAnalysis,
  SerpOrganicResult,
} from "./serp-intelligence";


describe(
  "final content planner",
  () => {
    it(
      "filters empty social/search pages from structural benchmarks",
      () => {
        const empty:
          CompetitorPageAnalysis = {
            rank: 2,
            domain:
              "reddit.com",
            url:
              "https://reddit.com/example",
            fetched:
              true,
            statusCode:
              200,
            pageType:
              "OTHER",
            title:
              "Reddit",
            h1:
              null,
            h2:
              [],
            h3:
              [],
            wordCount:
              0,
            error:
              null,
          };

        expect(
          isBenchmarkEligible(
            empty
          )
        ).toBe(
          false
        );
      }
    );

    it(
      "accepts substantive competitor pages",
      () => {
        const page:
          CompetitorPageAnalysis = {
            rank: 3,
            domain:
              "example.com",
            url:
              "https://example.com/checker",
            fetched:
              true,
            statusCode:
              200,
            pageType:
              "TOOL",
            title:
              "Email Breach Checker",
            h1:
              "Check Your Email",
            h2: [
              "How it works",
              "What to do next",
              "FAQ",
            ],
            h3: [
              "Enter email",
              "Review breaches",
              "Change passwords",
            ],
            wordCount:
              1600,
            error:
              null,
          };

        expect(
          isBenchmarkEligible(
            page
          )
        ).toBe(
          true
        );
      }
    );

    it(
      "detects mixed tool plus guide SERPs",
      () => {
        const make = (
          rank:
            number,
          url:
            string,
          title:
            string
        ): SerpOrganicResult => ({
          rank,
          absoluteRank:
            rank,
          domain:
            new URL(
              url
            ).hostname,
          url,
          title,
          description:
            null,
          featuredSnippet:
            false,
        });

        expect(
          inferTargetFormat([
            make(
              1,
              "https://a.com/checker",
              "Free Email Breach Checker"
            ),
            make(
              2,
              "https://b.com/hackcheck",
              "Check If Your Email Was Hacked"
            ),
            make(
              3,
              "https://c.com/blog/guide",
              "How to Check If Your Email Was Compromised"
            ),
          ])
        ).toBe(
          "HYBRID_TOOL_GUIDE"
        );
      }
    );
  }
);
