export type SerpPageType =
  | "ARTICLE"
  | "GUIDE"
  | "LISTICLE"
  | "COMPARISON"
  | "PRODUCT"
  | "TOOL"
  | "CATEGORY"
  | "HOMEPAGE"
  | "OTHER";


export function classifyPageType(
  url: string,
  title: string
): SerpPageType {
  let pathname =
    "";

  try {
    pathname =
      new URL(url)
        .pathname
        .toLowerCase();
  } catch {
    pathname =
      url.toLowerCase();
  }

  const text =
    `${pathname} ${title}`
      .toLowerCase();

  if (
    pathname === "/" ||
    pathname === ""
  ) {
    return "HOMEPAGE";
  }

  if (
    /\b(vs|versus|compare|comparison)\b/.test(
      text
    )
  ) {
    return "COMPARISON";
  }

  if (
    /\b(best|top\s+\d+|top ten)\b/.test(
      text
    )
  ) {
    return "LISTICLE";
  }

  if (
    /\b(checker|calculator|scanner|generator|tool)\b/.test(
      text
    )
  ) {
    return "TOOL";
  }

  if (
    /\/(product|products|pricing|plans|buy|shop)(\/|$)/.test(
      pathname
    )
  ) {
    return "PRODUCT";
  }

  if (
    /\/(category|categories|topics|resources)(\/|$)/.test(
      pathname
    )
  ) {
    return "CATEGORY";
  }

  if (
    /\b(how to|guide|tutorial|steps|explained)\b/.test(
      text
    )
  ) {
    return "GUIDE";
  }

  if (
    /\/(blog|article|articles|learn|news|resources)\//.test(
      pathname
    )
  ) {
    return "ARTICLE";
  }

  return "OTHER";
}
