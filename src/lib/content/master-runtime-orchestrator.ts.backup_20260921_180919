import {
  inspectMasterRuntimeSnapshot,
  type MasterRuntimeSnapshotV1,
} from "./master-runtime-adapter";


export type MasterRuntimeArtifacts =
  Omit<
    MasterRuntimeSnapshotV1,
    "version"
  >;


export interface MasterRuntimePersistenceEnvelope {
  version:
    "MASTER_RUNTIME_PERSISTENCE_ENVELOPE_V1";

  masterRuntime:
    unknown;
}


function isRecord(
  value: unknown
): value is Record<string, unknown> {
  return (
    typeof value ===
      "object" &&
    value !==
      null &&
    !Array.isArray(
      value
    )
  );
}


function persistedClone(
  value: unknown
): unknown {
  return JSON.parse(
    JSON.stringify(
      value
    )
  ) as unknown;
}


export function buildMasterRuntimeSnapshot(
  artifacts:
    MasterRuntimeArtifacts
): Readonly<MasterRuntimeSnapshotV1> {
  /*
   * This orchestrator NEVER derives Stage 1–8 artifacts
   * from legacy finalPlan, strategy, informationGain,
   * searchBlueprintShadow, keyword strings, industry,
   * business name, SERP snippets, or competitor content.
   *
   * Its only job is to assemble artifacts that already exist.
   */

  const candidate:
    MasterRuntimeSnapshotV1 = {
      version:
        "MASTER_RUNTIME_SNAPSHOT_V1",

      mission:
        artifacts.mission,

      queryGraph:
        artifacts.queryGraph,

      serpResearch:
        artifacts.serpResearch,

      expectedCoverage:
        artifacts.expectedCoverage,

      gaps:
        artifacts.gaps,

      originalValue:
        artifacts.originalValue,

      evidenceGraph:
        artifacts.evidenceGraph,

      claimLedger:
        artifacts.claimLedger,

      searchBlueprint:
        artifacts.searchBlueprint,

      sectionBlueprints:
        artifacts.sectionBlueprints,

      internalLinkPlan:
        artifacts.internalLinkPlan,

      styleRules:
        artifacts.styleRules,
    };

  const inspection =
    inspectMasterRuntimeSnapshot({
      masterRuntime:
        candidate,
    });

  if (
    !inspection.runtime
  ) {
    throw new Error(
      `MASTER_RUNTIME_ORCHESTRATION_BLOCKED:${inspection.blockers.join(",")}`
    );
  }

  /*
   * A structurally valid runtime is persistable even when
   * writer eligibility is BLOCKED by NO_GO, claim evidence,
   * or original-value gates.
   */
  return inspection.runtime;
}


export function serializeMasterRuntimeForPersistence(
  runtime:
    Readonly<MasterRuntimeSnapshotV1>
): unknown {
  /*
   * Simulate the exact JSON boundary used by Prisma Json:
   * Date -> ISO string.
   */
  const persisted =
    persistedClone(
      runtime
    );

  /*
   * Prove BEFORE DB persistence that the JSON representation
   * survives the same adapter/hydration path used after DB read.
   */
  const inspection =
    inspectMasterRuntimeSnapshot({
      masterRuntime:
        persisted,
    });

  if (
    !inspection.runtime
  ) {
    throw new Error(
      `MASTER_RUNTIME_PERSISTENCE_ROUND_TRIP_BLOCKED:${inspection.blockers.join(",")}`
    );
  }

  return persisted;
}


export function buildMasterRuntimePersistenceEnvelope(
  artifacts:
    MasterRuntimeArtifacts
): Readonly<MasterRuntimePersistenceEnvelope> {
  const runtime =
    buildMasterRuntimeSnapshot(
      artifacts
    );

  const persisted =
    serializeMasterRuntimeForPersistence(
      runtime
    );

  return Object.freeze({
    version:
      "MASTER_RUNTIME_PERSISTENCE_ENVELOPE_V1" as const,

    masterRuntime:
      persisted,
  });
}


export function attachMasterRuntimeToPlan({
  legacyPlan,
  artifacts,
}: {
  legacyPlan:
    unknown;

  artifacts:
    MasterRuntimeArtifacts;
}): Readonly<Record<string, unknown>> {
  if (
    !isRecord(
      legacyPlan
    )
  ) {
    throw new Error(
      "MASTER_RUNTIME_LEGACY_PLAN_INVALID"
    );
  }

  const envelope =
    buildMasterRuntimePersistenceEnvelope(
      artifacts
    );

  /*
   * Preserve the existing plan during migration.
   *
   * masterRuntime is additive for now.
   * The writer migration happens later.
   */
  return Object.freeze({
    ...legacyPlan,

    masterRuntime:
      envelope.masterRuntime,
  });
}
