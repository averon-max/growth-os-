import {
  readFileSync,
} from "node:fs";

import {
  describe,
  expect,
  it,
} from "vitest";


function read(
  relative:
    string
): string {
  return readFileSync(
    new URL(
      relative,
      import.meta.url
    ),
    "utf8"
  );
}


const service =
  read(
    "./service.ts"
  );

const replayRepository =
  read(
    "./serp-replay-artifact.ts"
  );

const replayEngine =
  read(
    "./serp-replay.ts"
  );

const replayPrompt =
  read(
    "./serp-replay-prompt.ts"
  );

const publishGate =
  read(
    "./publish-gate.ts"
  );

const schema =
  read(
    "../../../prisma/schema.prisma"
  );

const approveRoute =
  read(
    "../../app/api/content/articles/[id]/approve/route.ts"
  );

const publishRoute =
  read(
    "../../app/api/content/articles/[id]/publish/route.ts"
  );


function between(
  source:
    string,
  start:
    string,
  end?:
    string
): string {
  const a =
    source.indexOf(
      start
    );

  if (
    a < 0
  ) {
    throw new Error(
      `AUDIT_TOKEN_MISSING:${start}`
    );
  }


  const b =
    end
      ? source.indexOf(
          end,
          a
        )
      : source.length;


  if (
    end &&
    b < 0
  ) {
    throw new Error(
      `AUDIT_END_TOKEN_MISSING:${end}`
    );
  }


  return source.slice(
    a,
    b
  );
}


function assertOrdered(
  source:
    string,
  tokens:
    readonly string[]
): void {
  let previous =
    -1;


  for (
    const token
    of tokens
  ) {
    const current =
      source.indexOf(
        token
      );


    expect(
      current,
      `Missing production token: ${token}`
    ).toBeGreaterThanOrEqual(
      0
    );


    expect(
      current,
      `Out-of-order production token: ${token}`
    ).toBeGreaterThan(
      previous
    );


    previous =
      current;
  }
}


describe(
  "Stage 9M — Final Content/Search Intelligence architecture",
  () => {
    it(
      "preserves the canonical production generation order",
      () => {
        const generation =
          between(
            service,
            "export async function generateArticleFromBrief(",
            "export async function approveArticle("
          );


        assertOrdered(
          generation,
          [
            "await executeMasterWriterV1({",
            "await executeMasterArticleCriticsV1({",
            "await executeMasterArticleCriticRepairReplayV1({",
            "const acceptedMasterWriterRun =",
            "await executeSerpReplayV1({",
            "await createSerpReplayArtifactV1({",
            "const generated = {",
          ]
        );
      }
    );


    it(
      "SERP Replay consumes the post-critic accepted article",
      () => {
        const generation =
          between(
            service,
            "export async function generateArticleFromBrief(",
            "export async function approveArticle("
          );


        expect(
          generation
        ).toMatch(
          /await executeSerpReplayV1\(\{[\s\S]*?run:\s*acceptedMasterWriterRun/
        );
      }
    );


    it(
      "successful replay persistence happens before downstream article projection",
      () => {
        const generation =
          between(
            service,
            "export async function generateArticleFromBrief(",
            "export async function approveArticle("
          );


        const replay =
          generation.indexOf(
            "await executeSerpReplayV1({"
          );

        const persistence =
          generation.indexOf(
            "await createSerpReplayArtifactV1({"
          );

        const projection =
          generation.indexOf(
            "const generated = {"
          );


        expect(
          persistence
        ).toBeGreaterThan(
          replay
        );

        expect(
          projection
        ).toBeGreaterThan(
          persistence
        );
      }
    );


    it(
      "does not return to the legacy one-shot writer",
      () => {
        const generation =
          between(
            service,
            "export async function generateArticleFromBrief(",
            "export async function approveArticle("
          );


        expect(
          generation
        ).not.toMatch(
          /\bgenerator\s*\.\s*generateArticle\s*\(/
        );
      }
    );


    it(
      "keeps legacy whole-article rewrite disabled",
      () => {
        const generation =
          between(
            service,
            "export async function generateArticleFromBrief(",
            "export async function approveArticle("
          );


        expect(
          generation
        ).toContain(
          "const allowLegacyWholeArticleRewrite = false as const"
        );


        expect(
          generation
        ).not.toMatch(
          /allowLegacyWholeArticleRewrite\s*&&\s*shouldRewriteArticle\([^)]*\)\s*\|\|/
        );
      }
    );


    it(
      "keeps SERP Replay non-predictive",
      () => {
        const source =
          [
            replayEngine,
            replayPrompt,
            publishGate,
          ].join(
            "\n"
          );


        expect(
          source
        ).not.toMatch(
          /chanceToRank/
        );

        expect(
          source
        ).not.toMatch(
          /probabilityOfRanking/
        );

        expect(
          source
        ).not.toMatch(
          /rankingProbability\s*[:=]\s*[0-9]/
        );

        expect(
          source
        ).not.toMatch(
          /rankingScore\s*[:=]\s*[0-9]/
        );
      }
    );


    it(
      "does not use competitor word count or backlinks as replay content-quality inputs",
      () => {
        expect(
          replayEngine
        ).not.toContain(
          "result.wordCount"
        );

        expect(
          replayEngine
        ).not.toContain(
          "result.backlinks"
        );

        expect(
          replayEngine
        ).not.toContain(
          "result.referringDomains"
        );
      }
    );


    it(
      "keeps replay artifacts append-only",
      () => {
        expect(
          replayRepository.match(
            /prisma\.serpReplayArtifact\.create\(\{/g
          ) ??
          []
        ).toHaveLength(
          2
        );


        expect(
          replayRepository
        ).not.toMatch(
          /serpReplayArtifact\.(?:update|updateMany|upsert|delete|deleteMany)\(/
        );
      }
    );


    it(
      "keeps replay artifact schema immutable",
      () => {
        const model =
          between(
            schema,
            "model SerpReplayArtifact {",
            "\n}"
          );


        expect(
          model
        ).not.toContain(
          "@updatedAt"
        );

        expect(
          model
        ).not.toContain(
          "@@unique"
        );


        expect(
          model
        ).toContain(
          "articleFingerprint"
        );

        expect(
          model
        ).toContain(
          "serpSnapshotFingerprint"
        );
      }
    );


    it(
      "protects approval with the explicit stored-replay publish gate",
      () => {
        const approve =
          between(
            service,
            "export async function approveArticle(",
            "export async function publishArticle("
          );


        assertOrdered(
          approve,
          [
            "assertContentGatePassed(",
            "assertArticlePublicationPolicyPassed(",
            "prisma.serpReplayArtifact.findFirst({",
            "evaluateExplicitPublishGateV1({",
            "assertExplicitPublishGatePassedV1(",
            '"APPROVED"',
          ]
        );


        expect(
          approve
        ).not.toContain(
          "executeSerpReplayV1("
        );
      }
    );


    it(
      "protects CMS publishing with the same stored-replay gate",
      () => {
        const publish =
          between(
            service,
            "export async function publishArticle("
          );


        assertOrdered(
          publish,
          [
            "assertContentGatePassed(",
            "assertArticlePublicationPolicyPassed(",
            "prisma.serpReplayArtifact.findFirst({",
            "evaluateExplicitPublishGateV1({",
            "assertExplicitPublishGatePassedV1(",
            "await provider.publishContent(",
          ]
        );


        expect(
          publish
        ).not.toContain(
          "executeSerpReplayV1("
        );
      }
    );


    it(
      "keeps the explicit publish gate pure",
      () => {
        expect(
          publishGate
        ).not.toMatch(
          /prisma\./
        );

        expect(
          publishGate
        ).not.toContain(
          "fetch("
        );

        expect(
          publishGate
        ).not.toContain(
          "generateArticle("
        );

        expect(
          publishGate
        ).not.toContain(
          "rewriteArticle("
        );

        expect(
          publishGate
        ).not.toContain(
          "repairSection("
        );
      }
    );


    it(
      "requires exact article fingerprint integrity at publish time",
      () => {
        expect(
          publishGate
        ).toContain(
          "buildSerpReplayArticleFingerprintV1("
        );

        expect(
          publishGate
        ).toContain(
          "SERP_REPLAY_ARTICLE_FINGERPRINT_MISMATCH"
        );
      }
    );


    it(
      "blocks missing and failed stored replay attempts",
      () => {
        expect(
          publishGate
        ).toContain(
          "SERP_REPLAY_MISSING"
        );

        expect(
          publishGate
        ).toContain(
          "SERP_REPLAY_EXECUTION_FAILED"
        );
      }
    );


    it(
      "keeps SERP comparative BLOCK diagnostic rather than ranking prediction",
      () => {
        expect(
          publishGate
        ).toContain(
          "SERP_REPLAY_DIAGNOSTIC_BLOCK"
        );


        expect(
          publishGate
        ).toMatch(
          /replay\.replayStatus\s*===\s*"BLOCK"[\s\S]*?warnings\.push/
        );
      }
    );


    it(
      "does not allow API routes to bypass the service approval/publish boundary",
      () => {
        expect(
          approveRoute
        ).toContain(
          "approveArticle"
        );

        expect(
          publishRoute
        ).toContain(
          "publishArticle"
        );


        expect(
          approveRoute
        ).not.toContain(
          "prisma.contentArticle.update"
        );

        expect(
          publishRoute
        ).not.toContain(
          "provider.publishContent("
        );
      }
    );


    it(
      "keeps authenticated website access checks on approve and publish routes",
      () => {
        for (
          const route
          of [
            approveRoute,
            publishRoute,
          ]
        ) {
          expect(
            route
          ).toContain(
            "requireUser"
          );

          expect(
            route
          ).toContain(
            "requireWebsiteAccess"
          );
        }
      }
    );
  }
);
