import {
  describe,
  expect,
  it,
} from "vitest";

import type {
  ArticleGenerationContractV1,
  SectionGenerationContractV1,
} from "./article-generation-contract";

import {
  finalizeGeneratedSectionV1,
  type MasterArticleGenerator,
} from "./master-article-generator";

import {
  finalizeGeneratedArticleShellV1,
  type MasterArticleShellGenerator,
} from "./master-article-shell-generator";

import {
  executeMasterWriterV1,
  supportsMasterWriterGenerator,
  type MasterWriterGenerator,
} from "./master-writer-orchestrator";


function sectionContract({
  index,
  total,
  heading,
}: {
  index:
    number;

  total:
    number;

  heading:
    string;
}):
SectionGenerationContractV1 {
  return {
    version:
      "SECTION_GENERATION_CONTRACT_V1",

    sectionIndex:
      index,

    sectionNumber:
      index + 1,

    totalSections:
      total,

    blueprint: {
      heading,

      mission:
        `Explain ${heading}.`,

      queryNodeIds:
        [],

      requiredClaims:
        [],

      forbiddenClaims:
        [],

      evidenceIds:
        [],

      internalLinks:
        [],

      expectedOutcome:
        `Reader understands ${heading}.`,
    },

    hardRules: {
      canonicalH1OwnedByArticle:
        true,

      bodyMayContainH1:
        false,

      mayInventMetrics:
        false,

      mayInventEvidence:
        false,

      mayInventClaims:
        false,

      mayInventHeadingTargets:
        false,

      preserveSectionOrder:
        true,
    },
  } as unknown as
    SectionGenerationContractV1;
}


function contract(
  headings: string[] = [
    "What Credit Monitoring Does",
    "What Credit Monitoring Doesn't Do",
  ]
):
ArticleGenerationContractV1 {
  const total =
    headings.length;

  return {
    version:
      "ARTICLE_GENERATION_CONTRACT_V1",

    sourceRuntimeVersion:
      "MASTER_RUNTIME_SNAPSHOT_V1",

    h1Mission:
      "Explain credit monitoring clearly and directly.",

    sectionContracts:
      headings.map(
        (
          heading,
          index
        ) =>
          sectionContract({
            index,
            total,
            heading,
          })
      ),
  } as unknown as
    ArticleGenerationContractV1;
}


function successfulGenerator({
  calls = [],
}: {
  calls?:
    string[];
} = {}):
MasterWriterGenerator {
  return {
    modelName:
      "test-model",

    async generateArticleShell(
      input
    ) {
      calls.push(
        "shell"
      );

      return finalizeGeneratedArticleShellV1({
        contract:
          input,

        modelName:
          "test-model",

        candidate: {
          title:
            "Credit Monitoring Explained",

          metaDescription:
            "Understand what credit monitoring does and where its limitations begin.",

          h1:
            "What Is Credit Monitoring?",
        },
      });
    },

    async generateSection(
      input
    ) {
      calls.push(
        `section:${input.sectionIndex}`
      );

      return finalizeGeneratedSectionV1({
        contract:
          input,

        modelName:
          "test-model",

        candidate: {
          bodyMarkdown:
            `Generated body for section ${input.sectionNumber}.`,
        },
      });
    },
  };
}


describe(
  "Master Writer Orchestrator V1",
  () => {
    it(
      "generates shell first and then every approved section in deterministic order",
      async () => {
        const calls:
          string[] =
            [];

        const result =
          await executeMasterWriterV1({
            contract:
              contract(),

            generator:
              successfulGenerator({
                calls,
              }),
          });

        expect(
          calls
        ).toEqual([
          "shell",
          "section:0",
          "section:1",
        ]);

        expect(
          result.sections
        ).toHaveLength(
          2
        );

        expect(
          result.shell.h1
        ).toBe(
          "What Is Credit Monitoring?"
        );

        expect(
          result.provenance
            .executionMode
        ).toBe(
          "SEQUENTIAL"
        );
      }
    );


    it(
      "produces the complete deterministic article without an external shell argument",
      async () => {
        const result =
          await executeMasterWriterV1({
            contract:
              contract(),

            generator:
              successfulGenerator(),
          });

        expect(
          result.article.title
        ).toBe(
          "Credit Monitoring Explained"
        );

        expect(
          result.article.h1
        ).toBe(
          "What Is Credit Monitoring?"
        );

        expect(
          result.article
            .bodyMarkdown
        ).toContain(
          "## What Credit Monitoring Does"
        );

        expect(
          result.article
            .bodyMarkdown
        ).toContain(
          "## What Credit Monitoring Doesn't Do"
        );

        expect(
          result.article
            .provenance
            .sectionCount
        ).toBe(
          2
        );
      }
    );


    it(
      "passes the exact ArticleGenerationContract to shell generation",
      async () => {
        const approved =
          contract();

        let received:
          ArticleGenerationContractV1 |
          null =
            null;

        const generator =
          successfulGenerator();

        const wrapped:
          MasterWriterGenerator = {
            ...generator,

            async generateArticleShell(
              input
            ) {
              received =
                input;

              return generator
                .generateArticleShell(
                  input
                );
            },
          };

        await executeMasterWriterV1({
          contract:
            approved,

          generator:
            wrapped,
        });

        expect(
          received
        ).toBe(
          approved
        );
      }
    );


    it(
      "passes each exact approved section contract to section generation",
      async () => {
        const approved =
          contract();

        const received:
          SectionGenerationContractV1[] =
            [];

        const generator =
          successfulGenerator();

        const wrapped:
          MasterWriterGenerator = {
            ...generator,

            async generateSection(
              input
            ) {
              received.push(
                input
              );

              return generator
                .generateSection(
                  input
                );
            },
          };

        await executeMasterWriterV1({
          contract:
            approved,

          generator:
            wrapped,
        });

        expect(
          received[0]
        ).toBe(
          approved
            .sectionContracts[0]
        );

        expect(
          received[1]
        ).toBe(
          approved
            .sectionContracts[1]
        );
      }
    );


    it(
      "fails before section generation when shell generation fails",
      async () => {
        const calls:
          string[] =
            [];

        const generator:
          MasterWriterGenerator = {
            modelName:
              "test-model",

            async generateArticleShell() {
              calls.push(
                "shell"
              );

              throw new Error(
                "shell provider failed"
              );
            },

            async generateSection(
              input
            ) {
              calls.push(
                `section:${input.sectionIndex}`
              );

              return finalizeGeneratedSectionV1({
                contract:
                  input,

                modelName:
                  "test-model",

                candidate: {
                  bodyMarkdown:
                    "Body.",
                },
              });
            },
          };

        await expect(
          executeMasterWriterV1({
            contract:
              contract(),

            generator,
          })
        ).rejects.toThrow(
          "MASTER_WRITER_SHELL_GENERATION_FAILED:shell provider failed"
        );

        expect(
          calls
        ).toEqual([
          "shell",
        ]);
      }
    );


    it(
      "stops immediately when one section generation fails",
      async () => {
        const calls:
          string[] =
            [];

        const base =
          successfulGenerator({
            calls,
          });

        const generator:
          MasterWriterGenerator = {
            ...base,

            async generateSection(
              input
            ) {
              calls.push(
                `section:${input.sectionIndex}`
              );

              if (
                input.sectionIndex ===
                1
              ) {
                throw new Error(
                  "provider failed"
                );
              }

              return finalizeGeneratedSectionV1({
                contract:
                  input,

                modelName:
                  "test-model",

                candidate: {
                  bodyMarkdown:
                    "Valid body.",
                },
              });
            },
          };

        await expect(
          executeMasterWriterV1({
            contract:
              contract([
                "Section A",
                "Section B",
                "Section C",
              ]),

            generator,
          })
        ).rejects.toThrow(
          "MASTER_WRITER_SECTION_GENERATION_FAILED:1:provider failed"
        );

        expect(
          calls
        ).toEqual([
          "shell",
          "section:0",
          "section:1",
        ]);
      }
    );


    it(
      "blocks corrupted execution order before contacting the model",
      async () => {
        const bad =
          contract();

        const corrupted = {
          ...bad,

          sectionContracts: [
            {
              ...bad
                .sectionContracts[0],

              sectionIndex:
                1,
            },

            bad
              .sectionContracts[1],
          ],
        } as
          ArticleGenerationContractV1;

        const calls:
          string[] =
            [];

        await expect(
          executeMasterWriterV1({
            contract:
              corrupted,

            generator:
              successfulGenerator({
                calls,
              }),
          })
        ).rejects.toThrow(
          "MASTER_WRITER_BLOCKED:SECTION_INDEX_MISMATCH:0"
        );

        expect(
          calls
        ).toEqual(
          []
        );
      }
    );


    it(
      "requires both shell and section generation capabilities",
      () => {
        const sectionOnly:
          MasterArticleGenerator = {
            modelName:
              "section-only",

            async generateSection(
              input
            ) {
              return finalizeGeneratedSectionV1({
                contract:
                  input,

                modelName:
                  "section-only",

                candidate: {
                  bodyMarkdown:
                    "Body.",
                },
              });
            },
          };

        const shellOnly:
          MasterArticleShellGenerator = {
            modelName:
              "shell-only",

            async generateArticleShell(
              input
            ) {
              return finalizeGeneratedArticleShellV1({
                contract:
                  input,

                modelName:
                  "shell-only",

                candidate: {
                  title:
                    "Title",

                  metaDescription:
                    "Description",

                  h1:
                    "H1",
                },
              });
            },
          };

        expect(
          supportsMasterWriterGenerator(
            successfulGenerator()
          )
        ).toBe(
          true
        );

        expect(
          supportsMasterWriterGenerator(
            sectionOnly
          )
        ).toBe(
          false
        );

        expect(
          supportsMasterWriterGenerator(
            shellOnly
          )
        ).toBe(
          false
        );
      }
    );


    it(
      "blocks forged shell provenance before generating any sections",
      async () => {
        const calls:
          string[] =
            [];

        const base =
          successfulGenerator({
            calls,
          });

        const generator:
          MasterWriterGenerator = {
            ...base,

            async generateArticleShell(
              input
            ) {
              calls.push(
                "forged-shell"
              );

              const valid =
                finalizeGeneratedArticleShellV1({
                  contract:
                    input,

                  modelName:
                    "test-model",

                  candidate: {
                    title:
                      "Title",

                    metaDescription:
                      "Description",

                    h1:
                      "H1",
                  },
                });

              return {
                ...valid,

                provenance: {
                  ...valid.provenance,

                  modelName:
                    "forged-model",
                },
              };
            },
          };

        await expect(
          executeMasterWriterV1({
            contract:
              contract(),

            generator,
          })
        ).rejects.toThrow(
          "MASTER_WRITER_SHELL_MODEL_PROVENANCE_MISMATCH"
        );

        expect(
          calls
        ).toEqual([
          "forged-shell",
        ]);
      }
    );


    it(
      "freezes the complete full-writer run and records shell plus section model provenance",
      async () => {
        const result =
          await executeMasterWriterV1({
            contract:
              contract(),

            generator:
              successfulGenerator(),
          });

        expect(
          result.version
        ).toBe(
          "MASTER_WRITER_RUN_V1"
        );

        expect(
          Object.isFrozen(
            result
          )
        ).toBe(
          true
        );

        expect(
          Object.isFrozen(
            result.sections
          )
        ).toBe(
          true
        );

        expect(
          Object.isFrozen(
            result.provenance
          )
        ).toBe(
          true
        );

        expect(
          result.provenance
            .generatorModelName
        ).toBe(
          "test-model"
        );

        expect(
          result.provenance
            .shellModelName
        ).toBe(
          "test-model"
        );

        expect(
          result.provenance
            .sectionModelNames
        ).toEqual([
          "test-model",
        ]);

        expect(
          result.provenance
            .sectionCount
        ).toBe(
          2
        );
      }
    );
  }
);
