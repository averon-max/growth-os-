import type {
  Prisma,
} from "@prisma/client";

import {
  prisma,
} from "@/lib/prisma";

import type {
  BusinessFactRegistry,
} from "./business-facts";

function asJson(
  value: unknown
): Prisma.InputJsonValue {
  return JSON.parse(
    JSON.stringify(value)
  ) as Prisma.InputJsonValue;
}

export async function createContentEvidenceSnapshot({
  briefId,
  websiteId,
  topic,
  primaryKeyword,
  searchIntent,
  plan,
  businessFacts,
  keywordContext,
  generatorModel,
}: {
  briefId: string;
  websiteId: string;
  topic: string;
  primaryKeyword: string;
  searchIntent: string;
  plan: unknown;
  businessFacts: BusinessFactRegistry;
  keywordContext: unknown;
  generatorModel: string;
}) {
  return prisma.contentEvidenceSnapshot.create({
    data: {
      briefId,
      websiteId,
      topic,
      primaryKeyword,
      searchIntent,
      plan:
        asJson(plan),
      businessFacts:
        asJson(businessFacts),
      keywordContext:
        keywordContext == null
          ? undefined
          : asJson(
              keywordContext
            ),
      plannerVersion:
        "CONTENT_PLAN_V2",
      gateVersion:
        "CONTENT_GATE_V1",
      generatorModel,
    },
  });
}
