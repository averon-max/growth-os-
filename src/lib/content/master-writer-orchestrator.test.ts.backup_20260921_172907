import {
  describe,
  expect,
  it,
} from "vitest";

import type {
  ArticleGenerationContractV1,
  SectionGenerationContractV1,
} from "./article-generation-contract";

import {
  finalizeGeneratedSectionV1,
  type MasterArticleGenerator,
} from "./master-article-generator";

import {
  finalizeGeneratedArticleShellV1,
  type MasterArticleShellGenerator,
} from "./master-article-shell-generator";

import {
  executeMasterWriterV1,
  supportsMasterWriterGenerator,
  type MasterWriterGenerator,
} from "./master-writer-orchestrator";


function sectionContract({
  index,
  total,
  heading,
}: {
  index:
    number;

  total:
    number;

  heading:
    string;
}):
SectionGenerationContractV1 {
  return {
    version:
      "SECTION_GENERATION_CONTRACT_V1",

    sectionIndex:
      index,

    sectionNumber:
      index + 1,

    totalSections:
      total,

    blueprint: {
      heading,

      mission:
        `Explain ${heading}.`,

      queryNodeIds:
        [],

      requiredClaims:
        [],

      forbiddenClaims:
        [],

      evidenceIds:
        [],

      internalLinks:
        [],

      expectedOutcome:
        `Reader understands ${heading}.`,
    },

    claimLedger: {
      version:
        "CLAIM_LEDGER_V1",

      claims:
        [],

      counts: {
        VERIFIED:
          0,

        PARTIAL:
          0,

        UNSUPPORTED:
          0,

        CONTRADICTED:
          0,

        STALE:
          0,

        JURISDICTION_MISMATCH:
          0,
      },

      verified:
        0,

      unsupported:
        0,

      blockingCandidateCount:
        0,
    },

    evidenceGraph: {
      version:
        "EVIDENCE_GRAPH_V1",

      sources:
        [],

      claimEvidence:
        [],
    },

    hardRules: {
      canonicalH1OwnedByArticle:
        true,

      bodyMayContainH1:
        false,

      mayInventMetrics:
        false,

      mayInventEvidence:
        false,

      mayInventClaims:
        false,

      mayInventHeadingTargets:
        false,

      preserveSectionOrder:
        true,
    },
  } as unknown as
    SectionGenerationContractV1;
}


function claimSectionContract({
  status,
  index = 0,
  total = 1,
}: {
  status:
    | "VERIFIED"
    | "PARTIAL"
    | "CONTRADICTED";

  index?:
    number;

  total?:
    number;
}):
SectionGenerationContractV1 {
  const relation =
    status ===
    "CONTRADICTED"
      ? "CONTRADICTS"
      : "SUPPORTS";

  return {
    ...sectionContract({
      index,
      total,
      heading:
        "Claim Section",
    }),

    blueprint: {
      heading:
        "Claim Section",

      mission:
        "Explain the verified claim.",

      queryNodeIds:
        [],

      requiredClaims: [
        "claim-1",
      ],

      forbiddenClaims:
        [],

      evidenceIds: [
        "ev-1",
      ],

      internalLinks:
        [],

      expectedOutcome:
        "Reader understands the claim.",
    },

    claimLedger: {
      version:
        "CLAIM_LEDGER_V1",

      claims: [
        {
          id:
            "claim-1",

          text:
            "Credit monitoring can detect changes in a credit report.",

          category:
            "FINANCIAL",

          risk:
            "HIGH",

          jurisdiction:
            "US",

          evidenceIds: [
            "ev-1",
          ],

          status,
        },
      ],

      counts: {
        VERIFIED:
          status ===
          "VERIFIED"
            ? 1
            : 0,

        PARTIAL:
          status ===
          "PARTIAL"
            ? 1
            : 0,

        UNSUPPORTED:
          0,

        CONTRADICTED:
          status ===
          "CONTRADICTED"
            ? 1
            : 0,

        STALE:
          0,

        JURISDICTION_MISMATCH:
          0,
      },

      verified:
        status ===
        "VERIFIED"
          ? 1
          : 0,

      unsupported:
        0,

      blockingCandidateCount:
        status ===
        "CONTRADICTED"
          ? 1
          : 0,
    },

    evidenceGraph: {
      version:
        "EVIDENCE_GRAPH_V1",

      sources: [
        {
          id:
            "source-1",

          url:
            "https://example.com/source",

          publisher:
            "Example",

          sourceType:
            "PRIMARY_OFFICIAL",

          authorityTier:
            "B",

          jurisdiction:
            "US",

          retrievedAt:
            new Date(
              "2026-09-21T00:00:00.000Z"
            ),
        },
      ],

      claimEvidence: [
        {
          id:
            "ev-1",

          claimId:
            "claim-1",

          sourceId:
            "source-1",

          relation,

          kind:
            "VERIFIED_EXCERPT",

          excerpt:
            status ===
            "CONTRADICTED"
              ? "This evidence contradicts the claim."
              : "This evidence supports the claim.",
        },
      ],
    },
  } as unknown as
    SectionGenerationContractV1;
}


function contract(
  headings: string[] = [
    "What Credit Monitoring Does",
    "What Credit Monitoring Doesn't Do",
  ]
):
ArticleGenerationContractV1 {
  const total =
    headings.length;

  return {
    version:
      "ARTICLE_GENERATION_CONTRACT_V1",

    sourceRuntimeVersion:
      "MASTER_RUNTIME_SNAPSHOT_V1",

    h1Mission:
      "Explain credit monitoring clearly and directly.",

    sectionContracts:
      headings.map(
        (
          heading,
          index
        ) =>
          sectionContract({
            index,
            total,
            heading,
          })
      ),
  } as unknown as
    ArticleGenerationContractV1;
}


function contractFromSections(
  sections:
    SectionGenerationContractV1[]
):
ArticleGenerationContractV1 {
  return {
    version:
      "ARTICLE_GENERATION_CONTRACT_V1",

    sourceRuntimeVersion:
      "MASTER_RUNTIME_SNAPSHOT_V1",

    h1Mission:
      "Explain credit monitoring clearly and directly.",

    sectionContracts:
      sections,
  } as unknown as
    ArticleGenerationContractV1;
}


function successfulGenerator({
  calls = [],
}: {
  calls?:
    string[];
} = {}):
MasterWriterGenerator {
  return {
    modelName:
      "test-model",

    async generateArticleShell(
      input
    ) {
      calls.push(
        "shell"
      );

      return finalizeGeneratedArticleShellV1({
        contract:
          input,

        modelName:
          "test-model",

        candidate: {
          title:
            "Credit Monitoring Explained",

          metaDescription:
            "Understand what credit monitoring does and where its limitations begin.",

          h1:
            "What Is Credit Monitoring?",
        },
      });
    },

    async generateSection(
      input
    ) {
      calls.push(
        `section:${input.sectionIndex}`
      );

      return finalizeGeneratedSectionV1({
        contract:
          input,

        modelName:
          "test-model",

        candidate: {
          bodyMarkdown:
            `Generated body for section ${input.sectionNumber}.`,
        },
      });
    },
  };
}


function claimAwareGenerator({
  calls = [],
}: {
  calls?:
    string[];
} = {}):
MasterWriterGenerator {
  return {
    modelName:
      "test-model",

    async generateArticleShell(
      input
    ) {
      calls.push(
        "shell"
      );

      return finalizeGeneratedArticleShellV1({
        contract:
          input,

        modelName:
          "test-model",

        candidate: {
          title:
            "Credit Monitoring Explained",

          metaDescription:
            "Understand credit monitoring.",

          h1:
            "What Is Credit Monitoring?",
        },
      });
    },

    async generateSection(
      input
    ) {
      calls.push(
        `section:${input.sectionIndex}`
      );

      const requiredClaims =
        input.blueprint
          .requiredClaims ??
        [];

      const evidenceIds =
        input.blueprint
          .evidenceIds ??
        [];

      return finalizeGeneratedSectionV1({
        contract:
          input,

        modelName:
          "test-model",

        candidate: {
          bodyMarkdown:
            "Credit monitoring can detect changes in a credit report.",

          referencedClaimIds:
            requiredClaims,

          referencedEvidenceIds:
            evidenceIds,
        },
      });
    },
  };
}


describe(
  "Master Writer Orchestrator V1",
  () => {
    it(
      "generates shell first and then every approved section in deterministic order",
      async () => {
        const calls:
          string[] =
            [];

        const result =
          await executeMasterWriterV1({
            contract:
              contract(),

            generator:
              successfulGenerator({
                calls,
              }),
          });

        expect(
          calls
        ).toEqual([
          "shell",
          "section:0",
          "section:1",
        ]);

        expect(
          result.sections
        ).toHaveLength(
          2
        );

        expect(
          result.shell.h1
        ).toBe(
          "What Is Credit Monitoring?"
        );

        expect(
          result.provenance
            .executionMode
        ).toBe(
          "SEQUENTIAL"
        );
      }
    );


    it(
      "produces the complete deterministic article without an external shell argument",
      async () => {
        const result =
          await executeMasterWriterV1({
            contract:
              contract(),

            generator:
              successfulGenerator(),
          });

        expect(
          result.article.title
        ).toBe(
          "Credit Monitoring Explained"
        );

        expect(
          result.article.h1
        ).toBe(
          "What Is Credit Monitoring?"
        );

        expect(
          result.article
            .bodyMarkdown
        ).toContain(
          "## What Credit Monitoring Does"
        );

        expect(
          result.article
            .bodyMarkdown
        ).toContain(
          "## What Credit Monitoring Doesn't Do"
        );

        expect(
          result.article
            .provenance
            .sectionCount
        ).toBe(
          2
        );
      }
    );


    it(
      "passes the exact ArticleGenerationContract to shell generation",
      async () => {
        const approved =
          contract();

        let received:
          ArticleGenerationContractV1 |
          null =
            null;

        const generator =
          successfulGenerator();

        const wrapped:
          MasterWriterGenerator = {
            ...generator,

            async generateArticleShell(
              input
            ) {
              received =
                input;

              return generator
                .generateArticleShell(
                  input
                );
            },
          };

        await executeMasterWriterV1({
          contract:
            approved,

          generator:
            wrapped,
        });

        expect(
          received
        ).toBe(
          approved
        );
      }
    );


    it(
      "passes each exact approved section contract to section generation",
      async () => {
        const approved =
          contract();

        const received:
          SectionGenerationContractV1[] =
            [];

        const generator =
          successfulGenerator();

        const wrapped:
          MasterWriterGenerator = {
            ...generator,

            async generateSection(
              input
            ) {
              received.push(
                input
              );

              return generator
                .generateSection(
                  input
                );
            },
          };

        await executeMasterWriterV1({
          contract:
            approved,

          generator:
            wrapped,
        });

        expect(
          received[0]
        ).toBe(
          approved
            .sectionContracts[0]
        );

        expect(
          received[1]
        ).toBe(
          approved
            .sectionContracts[1]
        );
      }
    );


    it(
      "fails before section generation when shell generation fails",
      async () => {
        const calls:
          string[] =
            [];

        const generator:
          MasterWriterGenerator = {
            modelName:
              "test-model",

            async generateArticleShell() {
              calls.push(
                "shell"
              );

              throw new Error(
                "shell provider failed"
              );
            },

            async generateSection(
              input
            ) {
              calls.push(
                `section:${input.sectionIndex}`
              );

              return finalizeGeneratedSectionV1({
                contract:
                  input,

                modelName:
                  "test-model",

                candidate: {
                  bodyMarkdown:
                    "Body.",
                },
              });
            },
          };

        await expect(
          executeMasterWriterV1({
            contract:
              contract(),

            generator,
          })
        ).rejects.toThrow(
          "MASTER_WRITER_SHELL_GENERATION_FAILED:shell provider failed"
        );

        expect(
          calls
        ).toEqual([
          "shell",
        ]);
      }
    );


    it(
      "stops immediately when one section generation fails",
      async () => {
        const calls:
          string[] =
            [];

        const base =
          successfulGenerator();

        const generator:
          MasterWriterGenerator = {
            ...base,

            async generateArticleShell(
              input
            ) {
              calls.push(
                "shell"
              );

              return base
                .generateArticleShell(
                  input
                );
            },

            async generateSection(
              input
            ) {
              calls.push(
                `section:${input.sectionIndex}`
              );

              if (
                input.sectionIndex ===
                1
              ) {
                throw new Error(
                  "provider failed"
                );
              }

              return finalizeGeneratedSectionV1({
                contract:
                  input,

                modelName:
                  "test-model",

                candidate: {
                  bodyMarkdown:
                    "Valid body.",
                },
              });
            },
          };

        await expect(
          executeMasterWriterV1({
            contract:
              contract([
                "Section A",
                "Section B",
                "Section C",
              ]),

            generator,
          })
        ).rejects.toThrow(
          "MASTER_WRITER_SECTION_GENERATION_FAILED:1:provider failed"
        );

        expect(
          calls
        ).toEqual([
          "shell",
          "section:0",
          "section:1",
        ]);
      }
    );


    it(
      "blocks corrupted execution order before contacting the model",
      async () => {
        const bad =
          contract();

        const corrupted = {
          ...bad,

          sectionContracts: [
            {
              ...bad
                .sectionContracts[0],

              sectionIndex:
                1,
            },

            bad
              .sectionContracts[1],
          ],
        } as
          ArticleGenerationContractV1;

        const calls:
          string[] =
            [];

        await expect(
          executeMasterWriterV1({
            contract:
              corrupted,

            generator:
              successfulGenerator({
                calls,
              }),
          })
        ).rejects.toThrow(
          "MASTER_WRITER_BLOCKED:SECTION_INDEX_MISMATCH:0"
        );

        expect(
          calls
        ).toEqual(
          []
        );
      }
    );


    it(
      "requires both shell and section generation capabilities",
      () => {
        const sectionOnly:
          MasterArticleGenerator = {
            modelName:
              "section-only",

            async generateSection(
              input
            ) {
              return finalizeGeneratedSectionV1({
                contract:
                  input,

                modelName:
                  "section-only",

                candidate: {
                  bodyMarkdown:
                    "Body.",
                },
              });
            },
          };

        const shellOnly:
          MasterArticleShellGenerator = {
            modelName:
              "shell-only",

            async generateArticleShell(
              input
            ) {
              return finalizeGeneratedArticleShellV1({
                contract:
                  input,

                modelName:
                  "shell-only",

                candidate: {
                  title:
                    "Title",

                  metaDescription:
                    "Description",

                  h1:
                    "H1",
                },
              });
            },
          };

        expect(
          supportsMasterWriterGenerator(
            successfulGenerator()
          )
        ).toBe(
          true
        );

        expect(
          supportsMasterWriterGenerator(
            sectionOnly
          )
        ).toBe(
          false
        );

        expect(
          supportsMasterWriterGenerator(
            shellOnly
          )
        ).toBe(
          false
        );
      }
    );


    it(
      "blocks forged shell provenance before generating any sections",
      async () => {
        const calls:
          string[] =
            [];

        const base =
          successfulGenerator();

        const generator:
          MasterWriterGenerator = {
            ...base,

            async generateArticleShell(
              input
            ) {
              calls.push(
                "forged-shell"
              );

              const valid =
                finalizeGeneratedArticleShellV1({
                  contract:
                    input,

                  modelName:
                    "test-model",

                  candidate: {
                    title:
                      "Title",

                    metaDescription:
                      "Description",

                    h1:
                      "H1",
                  },
                });

              return {
                ...valid,

                provenance: {
                  ...valid.provenance,

                  modelName:
                    "forged-model",
                },
              };
            },
          };

        await expect(
          executeMasterWriterV1({
            contract:
              contract(),

            generator,
          })
        ).rejects.toThrow(
          "MASTER_WRITER_SHELL_MODEL_PROVENANCE_MISMATCH"
        );

        expect(
          calls
        ).toEqual([
          "forged-shell",
        ]);
      }
    );


    it(
      "reconciles every accepted section before deterministic composition",
      async () => {
        const result =
          await executeMasterWriterV1({
            contract:
              contract(),

            generator:
              successfulGenerator(),
          });

        expect(
          result.reconciliations
        ).toHaveLength(
          result.sections.length
        );

        expect(
          result.reconciliations.map(
            (item) =>
              item.status
          )
        ).toEqual([
          "PASS",
          "PASS",
        ]);

        expect(
          result.provenance
            .reconciliationCount
        ).toBe(
          2
        );

        expect(
          result.provenance
            .reconciliationWarnCount
        ).toBe(
          0
        );

        expect(
          result.provenance
            .reconciliationBlockCount
        ).toBe(
          0
        );
      }
    );


    it(
      "stops immediately when a section fails deterministic claim reconciliation",
      async () => {
        const calls:
          string[] =
            [];

        const first =
          claimSectionContract({
            status:
              "CONTRADICTED",

            index:
              0,

            total:
              2,
          });

        const second =
          sectionContract({
            index:
              1,

            total:
              2,

            heading:
              "Second Section",
          });

        await expect(
          executeMasterWriterV1({
            contract:
              contractFromSections([
                first,
                second,
              ]),

            generator:
              claimAwareGenerator({
                calls,
              }),
          })
        ).rejects.toThrow(
          "MASTER_WRITER_SECTION_RECONCILIATION_FAILED:0"
        );

        expect(
          calls
        ).toEqual([
          "shell",
          "section:0",
        ]);
      }
    );


    it(
      "permits WARN reconciliation while preserving it in master writer provenance",
      async () => {
        const result =
          await executeMasterWriterV1({
            contract:
              contractFromSections([
                claimSectionContract({
                  status:
                    "PARTIAL",
                }),
              ]),

            generator:
              claimAwareGenerator(),
          });

        expect(
          result.reconciliations
        ).toHaveLength(
          1
        );

        expect(
          result.reconciliations[0]
            ?.status
        ).toBe(
          "WARN"
        );

        expect(
          result.provenance
            .reconciliationWarnCount
        ).toBe(
          1
        );

        expect(
          result.article
            .bodyMarkdown
        ).toContain(
          "## Claim Section"
        );
      }
    );


    it(
      "passes verified claim/evidence provenance into accepted section reconciliation",
      async () => {
        const result =
          await executeMasterWriterV1({
            contract:
              contractFromSections([
                claimSectionContract({
                  status:
                    "VERIFIED",
                }),
              ]),

            generator:
              claimAwareGenerator(),
          });

        const reconciliation =
          result.reconciliations[0];

        expect(
          reconciliation
            ?.status
        ).toBe(
          "PASS"
        );

        expect(
          reconciliation
            ?.verifiedSupport
        ).toEqual([
          {
            claimId:
              "claim-1",

            evidenceIds: [
              "ev-1",
            ],

            sourceIds: [
              "source-1",
            ],
          },
        ]);
      }
    );


    it(
      "freezes the complete full-writer run including reconciliation provenance",
      async () => {
        const result =
          await executeMasterWriterV1({
            contract:
              contract(),

            generator:
              successfulGenerator(),
          });

        expect(
          result.version
        ).toBe(
          "MASTER_WRITER_RUN_V1"
        );

        expect(
          Object.isFrozen(
            result
          )
        ).toBe(
          true
        );

        expect(
          Object.isFrozen(
            result.sections
          )
        ).toBe(
          true
        );

        expect(
          Object.isFrozen(
            result.reconciliations
          )
        ).toBe(
          true
        );

        expect(
          Object.isFrozen(
            result.provenance
          )
        ).toBe(
          true
        );

        expect(
          result.provenance
            .generatorModelName
        ).toBe(
          "test-model"
        );

        expect(
          result.provenance
            .shellModelName
        ).toBe(
          "test-model"
        );

        expect(
          result.provenance
            .sectionModelNames
        ).toEqual([
          "test-model",
        ]);

        expect(
          result.provenance
            .sectionCount
        ).toBe(
          2
        );

        expect(
          result.provenance
            .reconciliationCount
        ).toBe(
          2
        );
      }
    );
  }
);
