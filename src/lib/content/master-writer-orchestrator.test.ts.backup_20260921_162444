import {
  describe,
  expect,
  it,
} from "vitest";

import type {
  ArticleGenerationContractV1,
  SectionGenerationContractV1,
} from "./article-generation-contract";

import {
  finalizeGeneratedSectionV1,
  type MasterArticleGenerator,
} from "./master-article-generator";

import {
  buildArticleShellV1,
} from "./master-article-composer";

import {
  executeMasterWriterV1,
} from "./master-writer-orchestrator";


function sectionContract({
  index,
  total,
  heading,
}: {
  index:
    number;

  total:
    number;

  heading:
    string;
}):
SectionGenerationContractV1 {
  return {
    version:
      "SECTION_GENERATION_CONTRACT_V1",

    sectionIndex:
      index,

    sectionNumber:
      index + 1,

    totalSections:
      total,

    blueprint: {
      heading,

      mission:
        `Explain ${heading}.`,

      queryNodeIds:
        [],

      requiredClaims:
        [],

      forbiddenClaims:
        [],

      evidenceIds:
        [],

      internalLinks:
        [],

      expectedOutcome:
        `Reader understands ${heading}.`,
    },

    hardRules: {
      canonicalH1OwnedByArticle:
        true,

      bodyMayContainH1:
        false,

      mayInventMetrics:
        false,

      mayInventEvidence:
        false,

      mayInventClaims:
        false,

      mayInventHeadingTargets:
        false,

      preserveSectionOrder:
        true,
    },
  } as unknown as
    SectionGenerationContractV1;
}


function contract(
  headings: string[] = [
    "What Credit Monitoring Does",
    "What Credit Monitoring Doesn't Do",
  ]
):
ArticleGenerationContractV1 {
  const total =
    headings.length;

  return {
    version:
      "ARTICLE_GENERATION_CONTRACT_V1",

    sourceRuntimeVersion:
      "MASTER_RUNTIME_SNAPSHOT_V1",

    sectionContracts:
      headings.map(
        (
          heading,
          index
        ) =>
          sectionContract({
            index,
            total,
            heading,
          })
      ),
  } as unknown as
    ArticleGenerationContractV1;
}


function shell() {
  return buildArticleShellV1({
    title:
      "Credit Monitoring Explained",

    metaDescription:
      "Understand what credit monitoring does and where its limitations begin.",

    h1:
      "What Is Credit Monitoring?",
  });
}


function successfulGenerator(
  calls:
    number[] = []
):
MasterArticleGenerator {
  return {
    modelName:
      "test-model",

    async generateSection(
      input
    ) {
      calls.push(
        input.sectionIndex
      );

      return finalizeGeneratedSectionV1({
        contract:
          input,

        modelName:
          "test-model",

        candidate: {
          bodyMarkdown:
            `Generated body for section ${input.sectionNumber}.`,
        },
      });
    },
  };
}


describe(
  "Master Writer Orchestrator V1",
  () => {
    it(
      "executes every approved section exactly once in deterministic order",
      async () => {
        const calls:
          number[] =
            [];

        const result =
          await executeMasterWriterV1({
            contract:
              contract(),

            shell:
              shell(),

            generator:
              successfulGenerator(
                calls
              ),
          });

        expect(
          calls
        ).toEqual([
          0,
          1,
        ]);

        expect(
          result.sections
        ).toHaveLength(
          2
        );

        expect(
          result.provenance
            .executionMode
        ).toBe(
          "SEQUENTIAL"
        );
      }
    );


    it(
      "produces the deterministic composed article after section generation",
      async () => {
        const result =
          await executeMasterWriterV1({
            contract:
              contract(),

            shell:
              shell(),

            generator:
              successfulGenerator(),
          });

        expect(
          result.article
            .bodyMarkdown
        ).toContain(
          "## What Credit Monitoring Does"
        );

        expect(
          result.article
            .bodyMarkdown
        ).toContain(
          "## What Credit Monitoring Doesn't Do"
        );

        expect(
          result.article.h1
        ).toBe(
          "What Is Credit Monitoring?"
        );

        expect(
          result.article
            .provenance
            .sectionCount
        ).toBe(
          2
        );
      }
    );


    it(
      "passes the exact approved section contract to the generator",
      async () => {
        const approved =
          contract();

        const received:
          SectionGenerationContractV1[] =
            [];

        const generator:
          MasterArticleGenerator = {
            modelName:
              "test-model",

            async generateSection(
              input
            ) {
              received.push(
                input
              );

              return finalizeGeneratedSectionV1({
                contract:
                  input,

                modelName:
                  "test-model",

                candidate: {
                  bodyMarkdown:
                    "Valid body.",
                },
              });
            },
          };

        await executeMasterWriterV1({
          contract:
            approved,

          shell:
            shell(),

          generator,
        });

        expect(
          received[0]
        ).toBe(
          approved
            .sectionContracts[0]
        );

        expect(
          received[1]
        ).toBe(
          approved
            .sectionContracts[1]
        );
      }
    );


    it(
      "stops immediately when one section generation fails",
      async () => {
        const calls:
          number[] =
            [];

        const generator:
          MasterArticleGenerator = {
            modelName:
              "test-model",

            async generateSection(
              input
            ) {
              calls.push(
                input.sectionIndex
              );

              if (
                input.sectionIndex ===
                1
              ) {
                throw new Error(
                  "provider failed"
                );
              }

              return finalizeGeneratedSectionV1({
                contract:
                  input,

                modelName:
                  "test-model",

                candidate: {
                  bodyMarkdown:
                    "Valid body.",
                },
              });
            },
          };

        await expect(
          executeMasterWriterV1({
            contract:
              contract([
                "Section A",
                "Section B",
                "Section C",
              ]),

            shell:
              shell(),

            generator,
          })
        ).rejects.toThrow(
          "MASTER_WRITER_SECTION_GENERATION_FAILED:1:provider failed"
        );

        expect(
          calls
        ).toEqual([
          0,
          1,
        ]);
      }
    );


    it(
      "preserves the original provider error inside the section failure",
      async () => {
        const generator:
          MasterArticleGenerator = {
            modelName:
              "test-model",

            async generateSection() {
              throw new Error(
                "Gemini API error 503: overloaded"
              );
            },
          };

        await expect(
          executeMasterWriterV1({
            contract:
              contract(),

            shell:
              shell(),

            generator,
          })
        ).rejects.toThrow(
          /Gemini API error 503/
        );
      }
    );


    it(
      "blocks legacy-only generators",
      async () => {
        await expect(
          executeMasterWriterV1({
            contract:
              contract(),

            shell:
              shell(),

            generator: {
              modelName:
                "legacy-model",

              async generateArticle() {
                return {};
              },
            },
          })
        ).rejects.toThrow(
          "MASTER_WRITER_BLOCKED:SECTION_GENERATOR_UNAVAILABLE"
        );
      }
    );


    it(
      "blocks corrupted execution order before contacting the model",
      async () => {
        const bad =
          contract();

        const corrupted = {
          ...bad,

          sectionContracts: [
            {
              ...bad
                .sectionContracts[0],

              sectionIndex:
                1,
            },

            bad
              .sectionContracts[1],
          ],
        } as
          ArticleGenerationContractV1;

        const calls:
          number[] =
            [];

        await expect(
          executeMasterWriterV1({
            contract:
              corrupted,

            shell:
              shell(),

            generator:
              successfulGenerator(
                calls
              ),
          })
        ).rejects.toThrow(
          "MASTER_WRITER_BLOCKED:SECTION_INDEX_MISMATCH:0"
        );

        expect(
          calls
        ).toEqual(
          []
        );
      }
    );


    it(
      "freezes the final run and orchestration provenance",
      async () => {
        const result =
          await executeMasterWriterV1({
            contract:
              contract(),

            shell:
              shell(),

            generator:
              successfulGenerator(),
          });

        expect(
          result.version
        ).toBe(
          "MASTER_WRITER_RUN_V1"
        );

        expect(
          Object.isFrozen(
            result
          )
        ).toBe(
          true
        );

        expect(
          Object.isFrozen(
            result.sections
          )
        ).toBe(
          true
        );

        expect(
          Object.isFrozen(
            result.provenance
          )
        ).toBe(
          true
        );

        expect(
          result.provenance
            .generatorModelName
        ).toBe(
          "test-model"
        );

        expect(
          result.provenance
            .sectionCount
        ).toBe(
          2
        );
      }
    );
  }
);
